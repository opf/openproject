{
  "name": "@openproject/service-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.22.1",
    "npm": "^11.12.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "serve": "node build.mjs --dev --watch",
    "build:watch": "node build.mjs --dev --watch --outdir=../../public/assets/frontend",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.spec.json",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "esbuild": "0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-headers": "^1.3.5",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
