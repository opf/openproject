#!/bin/bash
set -e

. ${INSTALLER_DIR}/wizard

CLI="${APP_NAME}"
OSFAMILY="$(wiz_fact osfamily)"
OSVERSION="$(wiz_fact osversion)"
edition="$(wiz_get "openproject/edition")"

tmpdir="$(mktemp -d)"
cleanup() {
	rm -rf "$tmpdir"
}

trap cleanup INT TERM EXIT

# Remove the legacy .NET-based xeokit-metadata installed by OpenProject < 18.0.
# The dotnet-runtime-6.0 system package is left in place, as other software may depend on it.
rm -f "$APP_HOME/bin/xeokit-metadata"
rm -rf "$APP_HOME/vendor/xeokit-metadata"
${CLI} config:unset DOTNET_ROOT

if [ "$edition" = "bim" ]; then
	${CLI} config:set OPENPROJECT_EDITION="$edition"

	cd $tmpdir

	if ! ${CLI} run which COLLADA2GLTF &>/dev/null ; then
		echo "Installing COLLADA2GLTF..."
		cp "$APP_HOME/vendor/bim/COLLADA2GLTF-v2.1.5-linux.zip" .
		unzip -qq COLLADA2GLTF-v2.1.5-linux.zip
		mv COLLADA2GLTF-bin "$APP_HOME/bin/COLLADA2GLTF"
	fi

	if ! ${CLI} run which IfcConvert &>/dev/null ||
	   ! echo "aadeb16abb97602761afba1b732899e82628017c5ab79ea3c7fa654fef7d63e9  $(${CLI} run which IfcConvert)" | sha256sum -c - ; then
		echo "Installing IfcConvert..."
		cp "$APP_HOME/vendor/bim/IfcConvert-v0.8.5-a51b2c5-linux64.zip" .
		unzip -qq IfcConvert-v0.8.5-a51b2c5-linux64.zip
		mv -f IfcConvert "$APP_HOME/bin/IfcConvert"
	fi

	metadata_prefix="$APP_HOME/vendor/web-ifc-xeokit-metadata"
	if ! grep -qs '"version": "0.0.1"' "$metadata_prefix/lib/node_modules/@openproject/web-ifc-xeokit-metadata/package.json"; then
		echo "Installing web-ifc-xeokit-metadata..."
		rm -rf "$metadata_prefix"
		${CLI} run npm install --global --prefix "$metadata_prefix" --offline --no-audit --no-fund --ignore-scripts \
			"$APP_HOME/vendor/bim/web-ifc-0.0.77.tgz" \
			"$APP_HOME/vendor/bim/web-ifc-xeokit-metadata-0.0.1.tgz"
	fi
	ln -fs "$metadata_prefix/bin/web-ifc-xeokit-metadata" "$APP_HOME/bin/web-ifc-xeokit-metadata"

	rm -rf "$tmpdir"
else
	${CLI} config:unset OPENPROJECT_EDITION
fi
