{
  "name": "OpenProject with KeyCloak and Traefik",
  "dockerComposeFile": [
    "../docker-compose.yaml"
  ],
  "containerEnv": {
    "PROFILES": "keycloak traefik"
  },
  "runServices": [
    "step", "ca-bundle",
    "traefik",
    "keycloak-db", "keycloak", "keycloak_client_setup",
    "postgresql", "openproject",
  ],
  "service": "openproject",
  "workspaceFolder": "/home/dev/openproject",
  "containerUser": "dev",
  "updateRemoteUserUID": true,
  "updateContentCommand": "/home/dev/openproject/.devcontainer/update.sh",
  "postStartCommand": "/home/dev/openproject/.devcontainer/start.sh",
  "forwardPorts": [
    "3000/tcp",
    "4200/tcp"
  ],
  "portsAttributes": {
    "3000/tcp": {
      "label": "Backend"
    },
    "4200/tcp": {
      "label": "Frontend"
    }
  }
}
