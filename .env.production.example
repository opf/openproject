# =============================================================================
# OpenProject - PRODUCTION environment file
#
#   cp .env.production.example .env.production
#   $EDITOR .env.production
#   docker compose --env-file .env.production -f docker-compose.production.yml up -d --build
#
# NEVER commit .env.production (.gitignore already excludes it).
# Generate secrets with:  openssl rand -hex 64
# =============================================================================

# --- Image (built from this repository) ---
TAG=17
BUILD_TARGET=production
POSTGRES_VERSION=17-alpine
# Hocuspocus image, built from ./extensions/op-blocknote-hocuspocus
# (pins @tiptap/* to patched 3.31.3 - GHSA-j95f-988m-3j2f, GHSA-cp6q-959q-f8rh).
HOCUSPOCUS_TAG=17.9.1-patched

# deunhealth (optional sidecar, enable with --profile deunhealth)
# DEUNHEALTH_TAG=local
# Group id of the Docker socket owner (Linux: stat -c %g /var/run/docker.sock)
# DOCKER_GID=0

# --- Public endpoint ---
OPENPROJECT_HOST__NAME=openproject.example.com
OPENPROJECT_HTTPS=true
OPENPROJECT_HSTS=true
OPENPROJECT_LOG__LEVEL=info
# Caddy terminates TLS and obtains certificates for OPENPROJECT_HOST__NAME.
# Ports 80 and 443 must be reachable from the internet.
HTTP_PORT=80
HTTPS_PORT=443
# Caddy site address. Defaults to OPENPROJECT_HOST__NAME (automatic HTTPS).
# CADDY_SITE_ADDRESS=openproject.example.com
# ACME directory. Defaults to the Let's Encrypt production directory.
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
# Extra Host headers allowed by OpenProject. "web" is required so the bundled
# hocuspocus service can reach the app over the internal network.
OPENPROJECT_ADDITIONAL__HOST__NAMES=web
# Sub-path deployment, e.g. /openproject. Leave empty for root.
OPENPROJECT_RAILS__RELATIVE__URL__ROOT=
COLLABORATIVE_SERVER_URL=wss://openproject.example.com/hocuspocus
OPENPROJECT_URL=http://web:8080

# --- Secrets (REQUIRED - replace before starting) ---
SECRET_KEY_BASE=
COLLABORATIVE_SERVER_SECRET=
POSTGRES_PASSWORD=

# --- Database ---
# Leave empty to derive from POSTGRES_PASSWORD above.
# DATABASE_URL=postgres://postgres:CHANGE_ME@db/openproject?pool=20&encoding=unicode&reconnect=true
PGDATA=pgdata
OPDATA=opdata

# --- Rails / Puma ---
RAILS_MIN_THREADS=4
RAILS_MAX_THREADS=16

# --- Incoming email (optional) ---
IMAP_ENABLED=false
# IMAP_HOST=
# IMAP_USERNAME=
# IMAP_PASSWORD=

# --- Microsoft Entra ID (OIDC) - REQUIRED ---
# Register redirect URI: https://openproject.example.com/auth/entra/callback
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_DISPLAY_NAME=Microsoft
