<div style="max-width: 300px;">
  <%= render(Primer::Beta::Heading.new(tag: :h2, display: :flex, classes: "min-width-0")) do %>
    <%= render(
          OpPrimer::ExpandableTextComponent.new(
            tag: :span,
            expansion: :dialog,
            dialog_id: "expandable-text-heading-dialog",
            render_dialog: false
          )
        ) do %>
      Sprint 42: Finalize the project management software release
    <% end %>
  <% end %>

  <%= render(
        Primer::Alpha::Dialog.new(
          id: "expandable-text-heading-dialog",
          title: I18n.t("js.label_expand_text"),
          visually_hide_title: true
        )
      ) do |dialog| %>
    <% dialog.with_header %>
    <% dialog.with_body_content("Sprint 42: Finalize the project management software release") %>
  <% end %>
</div>
