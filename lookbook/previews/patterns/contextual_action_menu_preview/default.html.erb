<%=
  render(
    Primer::Box.new(
      p: 3,
      border: true,
      border_radius: 2,
      display: :flex,
      align_items: :center,
      justify_content: :space_between,
      tabindex: 0,
      aria: { label: "Example card", keyshortcuts: "Shift+F10" },
      data: { controller: "contextual-action-menu" }
    )
  ) do
%>
  <%= render(Primer::Box.new(display: :flex, direction: :column)) do %>
    <%= render(Primer::Beta::Text.new(font_weight: :bold)) { "Right-click anywhere on this card" } %>
    <%= render(Primer::Beta::Link.new(href: "https://www.openproject.org")) { "…but not on this link" } %>
  <% end %>

  <%= render(Primer::Alpha::ActionMenu.new) do |menu| %>
    <% menu.with_show_button(icon: "kebab-horizontal", "aria-label": "More", scheme: :invisible) %>
    <% menu.with_item(label: "Open details") do |item| %>
      <% item.with_leading_visual_icon(icon: :"op-view-split") %>
    <% end %>
    <% menu.with_item(label: "Copy link") do |item| %>
      <% item.with_leading_visual_icon(icon: :copy) %>
    <% end %>
  <% end %>
<% end %>
