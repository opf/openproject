<%
  the_form = Class.new(ApplicationForm) do
    form do |f|
      f.radio_button_group(name: :project_specific_values, label: "Project-specific values") do |group|
        group.radio_button(
          value: "",
          label: "Show the same values for all projects",
          data: { input_confirmation_target: "input" }
        )
        group.radio_button(value: "allow", label: "Manually choose the values for each project", checked: true)
      end
    end
  end
%>

<div data-controller="input-confirmation" data-input-confirmation-trigger-value="checked">
  <%=
    primer_form_with(url: "/abc", method: :post) do |f|
      render(the_form.new(f))
    end
  %>

  <%=
    render(
      Primer::OpenProject::DangerDialog.new(
        id: "input-confirmation-radio-button-preview-dialog",
        title: "Show the same values for all projects",
        confirm_button_text: "Apply",
        data: { input_confirmation_target: "dialog" }
      )
    ) do |dialog|
      dialog.with_confirmation_message do |message|
        message.with_heading(tag: :h2) { "Show the same values for all projects?" }
        message.with_description_content("All values enabled per project will be removed.")
      end
    end
  %>
</div>
