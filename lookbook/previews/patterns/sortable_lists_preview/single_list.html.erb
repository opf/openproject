<div id="sortable-lists-preview-single"
     data-controller="sortable-lists"
     data-sortable-lists-move-url-template-value="/lookbook/sortable-lists-preview/{id}/drop"
     data-sortable-lists-sortable-lists--list-outlet="#sortable-lists-preview-single [data-controller~='sortable-lists--list']"
     data-sortable-lists-sortable-lists--item-outlet="#sortable-lists-preview-single [data-controller~='sortable-lists--item']">
  <%=
    render(
      OpPrimer::BorderBoxListComponent.new(
        container: "sortable-lists-preview",
        data: {
          controller: "sortable-lists--list",
          sortable_lists__list_type_value: "task",
          sortable_lists__list_accepted_type_value: "task",
          sortable_lists__list_name_value: "Tasks"
        }
      )
    ) do |list|
      list.with_header(title: "Tasks")

      ["Write the spec", "Review the design", "Ship it"].each_with_index do |title, index|
        list.with_item(
          data: {
            controller: "sortable-lists--item",
            sortable_lists__item_id_value: index + 1,
            sortable_lists__item_type_value: "task",
            sortable_lists__item_label_value: title
          }
        ) do
          render(Primer::Box.new(display: :flex, align_items: :center)) do
            concat(
              render(
                Primer::OpenProject::DragHandle.new(
                  classes: "handle",
                  mr: 2,
                  data: { sortable_lists__item_target: "handle" }
                )
              )
            )
            concat(render(Primer::Beta::Text.new(flex: 1)) { title })
            concat(
              render(Primer::Alpha::ActionMenu.new(anchor_align: :end)) do |menu|
                menu.with_show_button(icon: "kebab-horizontal", "aria-label": "Actions for #{title}", scheme: :invisible)
                SortableLists::MoveMenu::DIRECTIONS.each do |move|
                  menu.with_item(label: t(move.label), tag: :button, data: move.item_data) do |item|
                    item.with_leading_visual_icon(icon: move.icon)
                  end
                end
              end
            )
          end
        end
      end
    end
  %>
</div>
