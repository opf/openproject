require "find"
require "optparse"
require "strscan"
require "yaml"

class CopyCop
  CONFIG_FILE = ".copycop.yml"
  FNMATCH_FLAGS = File::FNM_PATHNAME | File::FNM_DOTMATCH | File::FNM_EXTGLOB | File::FNM_CASEFOLD
  HEAD_BYTES = 32768

  Patterns = Data.define(:list) do
    def match?(path)
      list.any? { |pattern| File.fnmatch?(pattern, path, FNMATCH_FLAGS) }
    end
  end

  module Comment
    Line = Data.define(:prefix) do
      attr_reader :regexp

      def initialize(prefix:)
        @regexp = /([ \t]*#{Regexp.escape(prefix)}.*(\n|\z))+/

        super
      end

      def build(copyright_text)
        <<~COPYRIGHT.chomp
          #{prefix}-- copyright
          #{copyright_text.gsub(/^.*/) { it.empty? ? prefix : "#{prefix} #{it}" }}
          #{prefix}++
        COPYRIGHT
      end
    end

    Block = Data.define(:open, :close) do
      attr_reader :regexp

      def initialize(open:, close:)
        @regexp = /[ \t]*#{Regexp.escape(open)}.*?#{Regexp.escape(close)}[ \t]*\n?/m

        super
      end

      def build(copyright_text)
        <<~COPYRIGHT.chomp
          #{open}-- copyright
          #{copyright_text}
          ++#{close}
        COPYRIGHT
      end
    end

    def self.parse(spec)
      case spec
      in String => prefix
        Line.new(prefix:)
      in [String => open, String => close]
        Block.new(open:, close:)
      else
        abort "Expected a string for prefix comment or 2 element array for open-close comment"
      end
    end
  end

  class Style
    SHEBANG_PATTERN = /\A\#!.*\n/
    BLANK_PATTERN = /([ \t]*\n)+/

    def self.parse(entry, copyright_text)
      new(
        patterns: Patterns.new(Array(entry.fetch("include"))),
        comment: Comment.parse(entry["comment"]),
        alternative_comments: Array(entry["alternative_comments"]).map { Comment.parse(it) },
        copyright_text:
      )
    end

    attr_reader :patterns, :comment_content

    def initialize(patterns:, comment:, alternative_comments:, copyright_text:)
      @patterns = patterns
      @comments = [comment, *alternative_comments]
      @comment_content = comment.build(copyright_text)
      @regexp = build_regexp(comment:, alternative_comments:)
    end

    def match(content)
      chunks = parse_head_chunks(content)

      @regexp.match(content)
    end

    private

    def parse_head_chunks(content)
      scanner = StringScanner.new(content)

      chunks = [scanner.scan(SHEBANG_PATTERN)].compact

      while scanner.scan(BLANK_PATTERN) || @comments.any?{ scanner.scan(it.regexp) }
        chunks << scanner.matched
      end

      chunks
    end

    def build_regexp(comment:, alternative_comments:)
      case comment
      in Comment::Line(prefix:)
        escaped_comment = Regexp.escape(prefix)

        /
          \A
          (?<before>(.*\n)*) # content and whitespace before
          (?<copyright_header>
            \s*#{escaped_comment}\s*--\s*(?i:copyright)\b.*\n # start marker
            (\s*#{escaped_comment}.*\n)*? # copyright text
            \s*#{escaped_comment}\s*\+\+.*$ # end marker
          )
          (?<whitespace_after>(\s*\n)?) # whitespace after
        |
          \A
          (?<before>
            (
              (
                \#!.*\n # shebang
              |
                # TODO: this is ruby only magic comment
                #{escaped_comment}[ ]*(?i:frozen_string_literal|coding|encoding)[ ]*:.*\n
              )
              (#{escaped_comment}.*\n)* # rest of comment block
            )?
            (\s*\n)?
          )
        /x
      in Comment::Block(open:, close:)
        escaped_open = Regexp.escape(open)
        escaped_close = Regexp.escape(close)

        /
          \A
          (?<before>(.*\n)*) # content and whitespace before
          (?<copyright_header>
            \s*#{escaped_open}\s*--\s*(?i:copyright)\b.*\n # start marker
            (.*\n)*? # copyright text
            .*#{escaped_close} # end marker
          )
          (?<whitespace_after>(\s*\n)?) # whitespace after
        |
          \A
          (?<before>(\s*\n)?)
        /x
      end
    end
  end

  def self.call(...) = new(...).call

  def initialize(args = ARGV) # rubocop:todo Metrics/AbcSize
    @autocorrect = false
    @verbose = false

    op = OptionParser.new do |opts|
      opts.banner = "Usage: #$0 [-a|--autocorrect] [path ...]"
      opts.on("-a", "--autocorrect", "Automatically insert or update headers") do
        @autocorrect = true
      end
      opts.on("-v", "--verbose", "Show verbose output") do
        @verbose = true
      end
    end

    rest = begin
      op.parse(args)
    rescue OptionParser::ParseError => e
      abort "#{e.message}\n#{op.help}"
    end
    @args = rest.empty? ? %w[.] : rest

    @root = find_root(Dir.pwd)

    config = read_config || {}
    @ignore = Patterns.new(Array(config.fetch("ignore", [])))
    @styles = parse_styles(config)
  end

  def call
    success = true

    each_path do |path:, style:|
      if @autocorrect
        autocorrect!(path:, style:)
      else
        success = false unless valid?(path:, style:)
      end
    end

    success
  end

  private

  def autocorrect!(path:, style:) # rubocop:todo Metrics/AbcSize
    content = File.read(path)
    match = style.match(content)
    before = match[:before].rstrip
    after = match.post_match

    parts = []
    parts << before << "\n\n" unless before.empty?
    parts << style.comment_content
    parts << (after.empty? ? "\n" : "\n\n")
    expected = parts.join
    return if expected == match.to_s

    File.open(path, "w") { it << expected << after }
    verbose "Corrected #{path}"
  end

  def valid?(path:, style:)
    head = File.read(path, HEAD_BYTES)
    match = style.match(head)
    offences = offences(match, style)

    puts "#{path}: #{offences.join(', ')}" unless offences.empty?

    offences.empty?
  end

  def offences(match, style)
    return ["missing copyright header"] unless match[:copyright_header]

    offences = []

    unless match[:copyright_header] == style.comment_content
      offences << "malformed copyright header"
    end

    unless match[:before].empty?
      offences << whitespace_offence(match[:before][/\s*\z/], "\n\n", "before")
    end

    expected_after = match.post_match.empty? ? "\n" : "\n\n"
    offences << whitespace_offence(match[:whitespace_after], expected_after, "after")

    offences.compact
  end

  def whitespace_offence(whitespace, expected, position)
    return if whitespace == expected

    if whitespace.include?(expected)
      "extra whitespace #{position} copyright header"
    else
      "no empty line #{position} copyright header"
    end
  end

  def find_root(dir)
    until File.exist?(File.join(dir, CONFIG_FILE))
      parent = File.dirname(dir)
      return File.expand_path("..", __dir__) if parent == dir

      dir = parent
    end

    dir
  end

  def read_config
    path = File.join(@root, CONFIG_FILE)

    YAML.load_file(path) if File.exist?(path)
  end

  def parse_styles(config) # rubocop:todo Metrics/AbcSize
    list = config["styles"]
    abort "No styles defined" if !list.is_a?(Array) || list.empty?

    copyright_file = config["copyright"]
    abort "No copyright file defined" if !copyright_file.is_a?(String) || copyright_file.empty?

    copyright_path = File.join(@root, copyright_file)
    abort "No copyright file found #{copyright_path}" unless File.file?(copyright_path)

    copyright_text = File.read(copyright_path).chomp

    list.map { Style.parse(it, copyright_text) }
  end

  def verbose(message)
    warn message if @verbose
  end

  def each_path(&)
    seen = Set.new

    each_matching_path do |path, root_relative, stat|
      next unless seen.add?([stat.dev, stat.ino])
      next verbose "Ignoring empty #{path}" if stat.zero?

      style = @styles.find { it.patterns.match?(root_relative) }
      next verbose "No style for #{path}" unless style

      yield path:, style:
    end
  end

  def each_matching_path(&)
    @args.uniq.each do |arg|
      stat = stat?(arg)
      abort "No such file or directory #{arg}" unless stat

      if stat.directory?
        walk(arg, &)
      elsif stat.file?
        root_relative = make_root_relative(arg)

        if @ignore.match?(root_relative)
          warn "Ignored #{arg}"
        else
          yield arg, root_relative, stat
        end
      else
        abort "Not a file or directory #{arg}"
      end
    end
  end

  def walk(dir)
    Find.find(dir) do |path|
      stat = stat?(path)
      next unless stat

      if stat.directory?
        Find.prune if @ignore.match?("#{make_root_relative(path)}/")
      elsif stat.file?
        root_relative = make_root_relative(path)
        next if @ignore.match?(root_relative)

        yield path.delete_prefix("./"), root_relative, stat
      end
    end
  end

  def stat?(path)
    File.stat(path)
  rescue Errno::ENOENT
    nil
  end

  def make_root_relative(path) = File.expand_path(path).delete_prefix("#{@root}/")
end

exit CopyCop.call if __FILE__ == $0
