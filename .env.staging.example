# =============================================================================
# OpenProject - STAGING environment file
#
#   cp .env.staging.example .env.staging
#   $EDITOR .env.staging
#   docker compose --env-file .env.staging -f docker-compose.staging.yml up -d --build
#
# Use a separate host name and a separate Entra ID app registration than
# production. NEVER commit .env.staging (.gitignore already excludes it).
# Generate secrets with:  openssl rand -hex 64
# =============================================================================

# --- Image (built from this repository) ---
TAG=staging
BUILD_TARGET=staging
POSTGRES_VERSION=17-alpine
# Hocuspocus image, built from ./extensions/op-blocknote-hocuspocus
# (pins @tiptap/* to patched 3.31.3 - GHSA-j95f-988m-3j2f, GHSA-cp6q-959q-f8rh).
HOCUSPOCUS_TAG=17.9.1-patched

# deunhealth (optional sidecar, enable with --profile deunhealth)
# DEUNHEALTH_TAG=local
# Group id of the Docker socket owner (Linux: stat -c %g /var/run/docker.sock)
# DOCKER_GID=0

# --- Public endpoint ---
OPENPROJECT_HOST__NAME=staging.openproject.example.com
OPENPROJECT_HTTPS=true
OPENPROJECT_HSTS=false
OPENPROJECT_LOG__LEVEL=debug
# Caddy terminates TLS and obtains certificates for OPENPROJECT_HOST__NAME.
HTTP_PORT=80
HTTPS_PORT=443
# ACME directory. Staging defaults to the Let's Encrypt staging directory to
# avoid production rate limits. Remove this line to use the production CA.
ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
OPENPROJECT_ADDITIONAL__HOST__NAMES=web
OPENPROJECT_RAILS__RELATIVE__URL__ROOT=
COLLABORATIVE_SERVER_URL=wss://staging.openproject.example.com/hocuspocus
OPENPROJECT_URL=http://web:8080

# --- Secrets (REQUIRED - replace before starting) ---
SECRET_KEY_BASE=
COLLABORATIVE_SERVER_SECRET=
POSTGRES_PASSWORD=

# --- Database ---
# DATABASE_URL=postgres://postgres:CHANGE_ME@db/openproject?pool=20&encoding=unicode&reconnect=true
PGDATA=pgdata
OPDATA=opdata

# --- Rails / Puma ---
RAILS_MIN_THREADS=2
RAILS_MAX_THREADS=8

# --- Incoming email (optional) ---
IMAP_ENABLED=false

# --- Microsoft Entra ID (OIDC) - REQUIRED ---
# Register redirect URI: https://staging.openproject.example.com/auth/entra/callback
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_DISPLAY_NAME=Microsoft
