FROM golang:1.25-alpine3.22 AS build
ARG TARGETOS=linux
ARG TARGETARCH
ARG VERSION=unknown
ARG CREATED="an unknown date"
ARG COMMIT=unknown
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOFLAGS=-mod=readonly
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download && go mod verify
COPY cmd/ ./cmd/
COPY internal/ ./internal/
RUN GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath -buildvcs=false \
    -ldflags="-s -w -X 'main.version=${VERSION}' -X 'main.buildDate=${CREATED}' -X 'main.commit=${COMMIT}'" \
    -o /out/app ./cmd/app

# static = no libc/shell/package manager; ships CA certs, tzdata, /etc/passwd with nonroot (65532)
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/app /app
USER 65532:65532
ENV LOG_LEVEL=info \
    HEALTH_SERVER_ADDRESS=127.0.0.1:9999
ENTRYPOINT ["/app"]
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=2 CMD ["/app","healthcheck"]
LABEL org.opencontainers.image.title="deunhealth" \
      org.opencontainers.image.source="https://github.com/qdm12/deunhealth"
