#!/bin/bash

set -e



PUBLIC_PROJECTS_ONLY=false
SKIP_BASTION_CHECK=false
POSITIONAL_ARGS=()
for arg in "$@"; do
  case "$arg" in
    --public-projects-only) PUBLIC_PROJECTS_ONLY=true ;;
    --skip-bastion-check) SKIP_BASTION_CHECK=true ;;
    *) POSITIONAL_ARGS+=("$arg") ;;
  esac
done
set -- "${POSITIONAL_ARGS[@]}"

if [ "$SKIP_BASTION_CHECK" = true ]; then
  WORK_DB=anonymize_sql_dump
else
  WORK_DB=tmp
fi

DUMPFILE="${1:?Pass the dump file to anonymize as first argument. Add --public-projects-only to keep only public projects with their content in clear text}"
if [ -n "$2" ]; then
  OPENPROJECT_DEV_DIR="$2"
  [ -f "$OPENPROJECT_DEV_DIR/Gemfile" ] || { echo "OpenProject dev directory $OPENPROJECT_DEV_DIR is not an OpenProject repository"; exit 1; }
elif [ -f "$HOME/openproject/dev/Gemfile" ]; then
  OPENPROJECT_DEV_DIR="$HOME/openproject/dev"
elif [ -f "$HOME/openproject/Gemfile" ]; then
  OPENPROJECT_DEV_DIR="$HOME/openproject"
# maybe parent directory of this script is an OpenProject repository?
elif [ -f "$(cd "$(dirname $0)/.." && pwd)/Gemfile" ]; then
  OPENPROJECT_DEV_DIR="$(cd "$(dirname $0)/.." && pwd)"
else
  OPENPROJECT_DEV_DIR="${2:?Pass the openproject dev directory as second argument (needed to create the admin user)}"
  [ -f "$OPENPROJECT_DEV_DIR/Gemfile" ] || { echo "OpenProject dev directory $OPENPROJECT_DEV_DIR is not an OpenProject repository"; exit 1; }
fi
echo "Using non-anonymized dump file $DUMPFILE"
echo "Using OpenProject dev directory $OPENPROJECT_DEV_DIR"
echo "Keeping only public projects: $PUBLIC_PROJECTS_ONLY"
echo "Using work database $WORK_DB (it is dropped and created again)"



echo_header() {
  echo "--"
  echo "-- $*"
  echo "--"
}



echo_header "CHECKING THAT WE ARE ON THE EC2 BASTION HOST"
VPN_IP_ADDRESS="52.29.160.234"
if [ "$SKIP_BASTION_CHECK" = true ]; then
  echo "Skipped with --skip-bastion-check. Use it only for dumps that contain no customer data."
elif [[ $(hostname) != *.compute.internal ]] || [[ $(curl --silent ip.me) == "$VPN_IP_ADDRESS" ]]; then
  cat <<EOT
It looks like you're not on an EC2 instance.
This script is meant to be run in the cloud so that customer data never reaches a dev machine.

Please run it on the bastion host which is a EC2 instance dedicated to that kind of task.
There are bastion hosts for production and edge environments.

Ask help to ops team for the right bastion hosts.
EOT
  exit 1
fi



echo_header "INSTALLING OpenProject DEPENDENCIES"

cd "$OPENPROJECT_DEV_DIR"
bundle check || bundle install
cd -



echo_header "IMPORTING DUMP FILE $DUMPFILE"

dropdb --if-exists "$WORK_DB"
createdb "$WORK_DB"
if grep -qE '^CREATE SCHEMA ' "$DUMPFILE"; then
  psql --quiet --dbname "$WORK_DB" --command "DROP SCHEMA public;"
fi
psql --quiet --dbname "$WORK_DB" --command "CREATE EXTENSION IF NOT EXISTS btree_gist WITH SCHEMA pg_catalog;"
psql --quiet --dbname "$WORK_DB" --command "CREATE EXTENSION IF NOT EXISTS pg_trgm WITH SCHEMA pg_catalog;"
psql --quiet --dbname "$WORK_DB" < $DUMPFILE



SCHEMA=$(psql --tuples-only --quiet --dbname "$WORK_DB" --command "select schema_name from information_schema.schemata WHERE schema_owner != 'postgres' AND schema_name <> 'information_schema' AND schema_name NOT LIKE 'pg\_%';" | tr -d '[:space:]')
if [ "$SCHEMA" != "public" ]; then
  echo_header "RENAMING SCHEMA $SCHEMA to public"
  psql --quiet --dbname "$WORK_DB" --command "ALTER SCHEMA \"$SCHEMA\" RENAME TO \"public\";"
fi
psql --quiet --dbname "$WORK_DB" --command "UPDATE settings SET value = 'localhost:3000' WHERE name = 'host_name'"



if [ "$PUBLIC_PROJECTS_ONLY" = true ]; then
  echo_header "REMOVING ALL DATA OUTSIDE OF PUBLIC PROJECTS"

  psql --quiet --dbname "$WORK_DB" --single-transaction --set ON_ERROR_STOP=1 <<'SQL'
SET client_min_messages TO NOTICE;

CREATE FUNCTION pg_temp.table_exists(tbl text) RETURNS boolean LANGUAGE sql AS $$
  SELECT to_regclass(format('public.%I', tbl)) IS NOT NULL
$$;

CREATE FUNCTION pg_temp.column_exists(tbl text, col text) RETURNS boolean LANGUAGE sql AS $$
  SELECT EXISTS (SELECT FROM information_schema.columns
                 WHERE table_schema = 'public' AND table_name = tbl AND column_name = col)
$$;

CREATE FUNCTION pg_temp.report(affected bigint, message text) RETURNS bigint LANGUAGE plpgsql AS $$
BEGIN
  IF affected > 0 THEN
    RAISE NOTICE '%: %', message, affected;
  END IF;
  RETURN affected;
END $$;

CREATE FUNCTION pg_temp.delete_all(tbl text) RETURNS bigint LANGUAGE plpgsql AS $$
DECLARE affected bigint;
BEGIN
  IF NOT pg_temp.table_exists(tbl) THEN
    RETURN 0;
  END IF;
  EXECUTE format('DELETE FROM %I', tbl);
  GET DIAGNOSTICS affected = ROW_COUNT;
  RETURN pg_temp.report(affected, format('Deleted all of %s', tbl));
END $$;

CREATE FUNCTION pg_temp.prune(tbl text, col text, parent text, nullify boolean DEFAULT false) RETURNS bigint LANGUAGE plpgsql AS $$
DECLARE affected bigint;
BEGIN
  IF NOT pg_temp.column_exists(tbl, col) OR NOT pg_temp.table_exists(parent) THEN
    RETURN 0;
  END IF;
  IF nullify THEN
    EXECUTE format('UPDATE %1$I c SET %2$I = NULL WHERE c.%2$I IS NOT NULL AND NOT EXISTS (SELECT FROM %3$I p WHERE p.id = c.%2$I)', tbl, col, parent);
  ELSE
    EXECUTE format('DELETE FROM %1$I c WHERE c.%2$I IS NOT NULL AND NOT EXISTS (SELECT FROM %3$I p WHERE p.id = c.%2$I)', tbl, col, parent);
  END IF;
  GET DIAGNOSTICS affected = ROW_COUNT;
  RETURN pg_temp.report(affected, format('%s %s.%s without %s', CASE WHEN nullify THEN 'Unlinked' ELSE 'Deleted' END, tbl, col, parent));
END $$;

CREATE FUNCTION pg_temp.prune_everywhere(col text, parent text, nullify_in text[] DEFAULT '{}', skip text[] DEFAULT '{}',
                                         with_journal_tables boolean DEFAULT false) RETURNS bigint LANGUAGE plpgsql AS $$
DECLARE tbl text; total bigint := 0;
BEGIN
  FOR tbl IN
    SELECT c.table_name::text FROM information_schema.columns c
    JOIN information_schema.tables t ON t.table_schema = c.table_schema AND t.table_name = c.table_name
    WHERE c.table_schema = 'public' AND t.table_type = 'BASE TABLE' AND c.column_name = col
      AND c.table_name::text <> ALL (skip)
      AND (with_journal_tables OR c.table_name::text NOT LIKE '%\_journals')
    ORDER BY 1
  LOOP
    total := total + pg_temp.prune(tbl, col, parent, tbl = ANY (nullify_in));
  END LOOP;
  RETURN total;
END $$;

CREATE FUNCTION pg_temp.prune_unlinked(tbl text, link_table text, link_col text) RETURNS bigint LANGUAGE plpgsql AS $$
DECLARE affected bigint;
BEGIN
  IF NOT pg_temp.table_exists(tbl) OR NOT pg_temp.column_exists(link_table, link_col) THEN
    RETURN 0;
  END IF;
  EXECUTE format('DELETE FROM %1$I r WHERE NOT EXISTS (SELECT FROM %2$I l WHERE l.%3$I = r.id)', tbl, link_table, link_col);
  GET DIAGNOSTICS affected = ROW_COUNT;
  RETURN pg_temp.report(affected, format('Deleted %s without %s', tbl, link_table));
END $$;

CREATE TEMP TABLE polymorphic_types (type text PRIMARY KEY, table_name text NOT NULL);
INSERT INTO polymorphic_types VALUES
