  'webhooks_logs',
  'webhooks_projects',
  'webhooks_webhooks',
  'wiki_page_links',
  'wiki_providers'
]), 'delete';

DO $$
DECLARE unknown text;
BEGIN
  SELECT string_agg(t.table_name::text, ', ' ORDER BY t.table_name) INTO unknown
  FROM information_schema.tables t
  WHERE t.table_schema = 'public' AND t.table_type = 'BASE TABLE'
    AND NOT EXISTS (SELECT FROM table_manifest m WHERE m.table_name = t.table_name::text);
  IF unknown IS NOT NULL THEN
    RAISE EXCEPTION 'Tables without a treatment in table_manifest: %. Classify them before you share a dump.', unknown;
  END IF;

  SELECT string_agg(c.column_name::text, ', ' ORDER BY c.column_name) INTO unknown
  FROM information_schema.columns c
  WHERE c.table_schema = 'public' AND c.table_name = 'users'
    AND c.column_name::text <> ALL (ARRAY[
      'id', 'login', 'firstname', 'lastname', 'mail', 'admin', 'status', 'last_login_on', 'language', 'ldap_auth_source_id',
      'created_at', 'updated_at', 'type', 'identity_url', 'mail_notification', 'first_login', 'failed_login_count',
      'last_failed_login_on', 'force_password_change', 'consented_at', 'webauthn_id']);
  IF unknown IS NOT NULL THEN
    RAISE EXCEPTION 'Columns of users that the anonymization does not know: %. Anonymize or allow them before you share a dump.', unknown;
  END IF;
END $$;

CREATE TEMP TABLE dropped_foreign_keys AS
  SELECT conrelid::regclass::text AS tbl, conname, pg_get_constraintdef(oid) AS definition
  FROM pg_constraint
  WHERE contype = 'f' AND connamespace = 'public'::regnamespace;

DO $$
DECLARE fk record;
BEGIN
  FOR fk IN SELECT * FROM dropped_foreign_keys LOOP
    EXECUTE format('ALTER TABLE %s DROP CONSTRAINT %I', fk.tbl, fk.conname);
  END LOOP;
END $$;

DO $$
DECLARE affected bigint;
BEGIN
  PERFORM pg_temp.delete_all(table_name) FROM table_manifest WHERE treatment = 'delete' ORDER BY table_name;

  DELETE FROM settings WHERE name IN (
    'collaborative_editing_hocuspocus_secret',
    'consent_decline_mail',
    'hashed_token_pepper',
    'health_checks_authentication_password',
    'mail_handler_api_key',
    'mail_handler_body_delimiter_regex',
    'plugin_openproject_auth_saml',
    'plugin_openproject_github_integration',
    'plugin_openproject_gitlab_integration',
    'plugin_openproject_openid_connect',
    'plugin_openproject_recaptcha',
    'plugin_openproject_slack',
    'plugin_openproject_two_factor_authentication',
    'seed_admin_user_password',
    'seed_enterprise_token',
    'smtp_password',
    'smtp_user_name',
    'sys_api_key'
  );

  DELETE FROM rates WHERE type IN ('HourlyRate', 'DefaultHourlyRate');
  GET DIAGNOSTICS affected = ROW_COUNT;
  RAISE NOTICE 'Deleted hourly rates: %', affected;
  UPDATE time_entries SET rate_id = NULL, costs = NULL, overridden_costs = NULL;
  UPDATE time_entry_journals SET rate_id = NULL, costs = NULL, overridden_costs = NULL;
  UPDATE labor_budget_items SET amount = NULL;

  UPDATE users SET ldap_auth_source_id = NULL;
  UPDATE users
  SET login = 'user' || id, firstname = 'User', lastname = id::text, mail = 'user' || id || '@example.com', identity_url = NULL
  WHERE type = 'User';
  GET DIAGNOSTICS affected = ROW_COUNT;
  RAISE NOTICE 'Anonymized users: %', affected;
  UPDATE users SET lastname = 'Placeholder ' || id WHERE type = 'PlaceholderUser';
  IF pg_temp.column_exists('meeting_participants', 'email') THEN
    UPDATE meeting_participants SET email = 'participant' || id || '@example.com' WHERE email IS NOT NULL;
  END IF;
  IF pg_temp.column_exists('gitlab_users', 'gitlab_email') THEN
    UPDATE gitlab_users SET gitlab_email = 'gitlab-user' || id || '@example.com' WHERE gitlab_email IS NOT NULL;
  END IF;
  IF pg_temp.column_exists('repositories', 'password') THEN
    UPDATE repositories SET login = NULL, password = NULL;
  END IF;

  DELETE FROM projects p
  WHERE EXISTS (SELECT FROM projects a WHERE a.lft <= p.lft AND a.rgt >= p.rgt AND NOT a.public);
  GET DIAGNOSTICS affected = ROW_COUNT;
  RAISE NOTICE 'Deleted projects that are not public or are below a project that is not public: %', affected;

  IF pg_temp.column_exists('journals', 'restricted') THEN
    DELETE FROM journals WHERE restricted;
    GET DIAGNOSTICS affected = ROW_COUNT;
    RAISE NOTICE 'Deleted internal comments: %', affected;
  END IF;
END $$;

DO $$
DECLARE pass integer := 0; affected bigint;
BEGIN
  LOOP
    pass := pass + 1;
    affected := pg_temp.prune_pass();
    RAISE NOTICE 'Pass %: deleted or unlinked % rows', pass, affected;
    EXIT WHEN affected = 0;
  END LOOP;
END $$;

DO $$
DECLARE fk record;
BEGIN
  FOR fk IN SELECT * FROM dropped_foreign_keys LOOP
    EXECUTE format('ALTER TABLE %s ADD CONSTRAINT %I %s', fk.tbl, fk.conname, fk.definition);
  END LOOP;
  RAISE NOTICE 'Kept public projects: %', (SELECT count(*) FROM projects);
END $$;
SQL
fi



echo_header "ANONYMIZING DATA"
cleanup_sql_file=$(mktemp /tmp/cleanup.sql.XXXXXX)

cat <<SQL > "$cleanup_sql_file"
DELETE FROM sessions;
DELETE FROM user_passwords;
DELETE FROM two_factor_authentication_devices;
DELETE FROM tokens;
DELETE FROM enterprise_tokens;
DELETE FROM recaptcha_entries;
