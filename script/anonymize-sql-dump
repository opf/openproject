echo_header "DUMPING ANONYMIZED DATA TO $(pwd)/tmp.dump.sql"
pg_dump --no-owner --format=plain "$WORK_DB" > tmp.dump.sql



if [ "$PUBLIC_PROJECTS_ONLY" = true ]; then
  echo_header "SCANNING DUMP FOR SECRETS AND PERSONAL DATA"

  SECRET_PATTERN='-----BEGIN [A-Z ]*PRIVATE KEY-----|gh[pousr]_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{22,}|glpat-[A-Za-z0-9_-]{20}|xox[abprs]-[A-Za-z0-9-]{10,}|AKIA[0-9A-Z]{16}'
  EMAIL_PATTERN='[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}'
  CREDENTIAL_URL_PATTERN='[a-z][a-z0-9+.-]*://[^/[:space:]:@]+:[^/[:space:]@]+@'
  CONTENT_TABLES='^public[.](attachments|attachment_journals|budgets|budget_journals|changesets|changeset_journals|comments|cost_entries|custom_comments|custom_comment_journals|custom_values|customizable_journals|documents|document_journals|github_check_runs|github_pull_requests|gitlab_issues|gitlab_merge_requests|gitlab_pipelines|grid_widgets|journals|meeting_agenda_items|meeting_agenda_item_journals|meeting_journals|meeting_outcomes|meeting_sections|meetings|message_journals|messages|news|news_journals|project_journals|projects|time_entries|time_entry_journals|type_variants|versions|wiki_page_journals|wiki_pages|work_package_journals|work_packages)$'

  findings=$(
    {
      grep -noE -e "$SECRET_PATTERN" tmp.dump.sql | sed 's/^\([0-9]*\):.*/\1 secret/'
      grep -noE -e "$EMAIL_PATTERN" tmp.dump.sql \
        | grep -vE -e '@example\.(com|net|org)$' -e '^[0-9]+:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}@' \
        | sed 's/^\([0-9]*\):.*/\1 email/'
      grep -noE -e "$CREDENTIAL_URL_PATTERN" tmp.dump.sql | sed 's/^\([0-9]*\):.*/\1 credential-url/'
    } | sort -n | awk -v content="$CONTENT_TABLES" '
      NR == FNR {
        split($0, parts, ":")
        marker_line[++markers] = parts[1]
        if (parts[2] ~ /^COPY /) { split(parts[2], words, " "); marker_table[markers] = words[2] }
        else { marker_table[markers] = "(schema)" }
        next
      }
      {
        table = "(schema)"
        for (i = 1; i <= markers && marker_line[i] < $1; i++) table = marker_table[i]
        print (table ~ content ? "content" : "other"), $2, table
      }
    ' <(grep -n -e '^COPY ' -e '^\\\.$' tmp.dump.sql) -
  )

  echo "Matches in user-written content of public projects (review only):"
  echo "$findings" | awk '$1 == "content" { print $2, $3 }' | sort | uniq -c
  rejected_findings=$(echo "$findings" | awk '$1 == "other" { print $2, $3 }' | sort | uniq -c)

  if [ -n "$rejected_findings" ]; then
    mv tmp.dump.sql tmp.dump.sql.rejected
    echo "Matches outside of user-written content:"
    echo "$rejected_findings"
    echo "The dump is saved as $(pwd)/tmp.dump.sql.rejected. Do not share it."
    echo "Anonymize or delete these columns in the script, then run it again."
    exit 1
  fi
fi



echo_header "DONE"
echo "Anonymized database dump saved to $(pwd)/tmp.dump.sql"
echo "Copy it to your machine and load it like this:"
echo "  DB_NAME=openproject_debug_me"
echo '  dropdb --if-exists --force $DB_NAME'
echo '  createdb --owner=openproject $DB_NAME'
echo '  psql --username=openproject $DB_NAME < tmp.dump.sql'
