CREATE FUNCTION pg_temp.prune_polymorphic(tbl text, assoc text) RETURNS bigint LANGUAGE plpgsql AS $$
DECLARE type_col text := assoc || '_type'; id_col text := assoc || '_id'; record_type text; target text; affected bigint; total bigint := 0;
BEGIN
  IF NOT pg_temp.column_exists(tbl, type_col) THEN
    RETURN 0;
  END IF;
  FOR record_type IN EXECUTE format('SELECT DISTINCT %1$I FROM %2$I WHERE %1$I IS NOT NULL', type_col, tbl) LOOP
    SELECT pt.table_name INTO target FROM polymorphic_types pt WHERE pt.type = record_type;
    IF NOT FOUND THEN
      RAISE EXCEPTION 'Unknown type % in %.%. Add it to polymorphic_types.', record_type, tbl, type_col;
    END IF;
    IF pg_temp.table_exists(target) THEN
      EXECUTE format('DELETE FROM %1$I c WHERE c.%2$I = %3$L AND NOT EXISTS (SELECT FROM %4$I p WHERE p.id = c.%5$I)',
                     tbl, type_col, record_type, target, id_col);
    ELSE
      EXECUTE format('DELETE FROM %1$I WHERE %2$I = %3$L', tbl, type_col, record_type);
    END IF;
    GET DIAGNOSTICS affected = ROW_COUNT;
    total := total + pg_temp.report(affected, format('Deleted %s.%s of %s without record', tbl, assoc, record_type));
  END LOOP;
  RETURN total;
END $$;

CREATE FUNCTION pg_temp.prune_journal_data() RETURNS bigint LANGUAGE plpgsql AS $$
DECLARE tbl text; data_types text[]; affected bigint; total bigint := 0;
BEGIN
  FOR tbl IN
    SELECT t.table_name::text FROM information_schema.tables t
    WHERE t.table_schema = 'public' AND t.table_type = 'BASE TABLE'
      AND t.table_name::text LIKE '%\_journals'
      AND NOT pg_temp.column_exists(t.table_name::text, 'journal_id')
    ORDER BY 1
  LOOP
    SELECT coalesce(array_agg(DISTINCT j.data_type), '{}') INTO data_types FROM journals j
    WHERE lower(regexp_replace(regexp_replace(j.data_type, '^Journal::', ''), '([a-z0-9])([A-Z])', '\1_\2', 'g')) || 's' = tbl;
    EXECUTE format('DELETE FROM %1$I d WHERE NOT EXISTS (SELECT FROM journals j WHERE j.data_id = d.id AND j.data_type = ANY (%2$L))',
                   tbl, data_types);
    GET DIAGNOSTICS affected = ROW_COUNT;
    total := total + pg_temp.report(affected, format('Deleted %s without journal', tbl));
  END LOOP;
  RETURN total;
END $$;

CREATE FUNCTION pg_temp.prune_pass() RETURNS bigint LANGUAGE plpgsql AS $$
DECLARE total bigint := 0;
BEGIN
  total := total + pg_temp.prune_everywhere('project_id', 'projects', skip => ARRAY['gitlab_pipelines']);
  total := total + pg_temp.prune('projects', 'parent_id', 'projects');
  total := total + pg_temp.prune('projects', 'template_id', 'projects', true);
  total := total + pg_temp.prune('subproject_template_assignments', 'template_id', 'projects');

  total := total + pg_temp.prune_everywhere('work_package_id', 'work_packages',
                                            nullify_in => ARRAY['meeting_agenda_items', 'meeting_outcomes']);
  total := total + pg_temp.prune('work_packages', 'parent_id', 'work_packages', true);
  total := total + pg_temp.prune('work_packages', 'version_id', 'versions', true);
  total := total + pg_temp.prune('work_packages', 'category_id', 'categories', true);
  total := total + pg_temp.prune('work_packages', 'budget_id', 'budgets', true);
  total := total + pg_temp.prune('work_packages', 'sprint_id', 'sprints', true);
  total := total + pg_temp.prune('work_packages', 'backlog_bucket_id', 'backlog_buckets', true);
  total := total + pg_temp.prune('work_package_hierarchies', 'ancestor_id', 'work_packages');
  total := total + pg_temp.prune('work_package_hierarchies', 'descendant_id', 'work_packages');
  total := total + pg_temp.prune('relations', 'from_id', 'work_packages');
  total := total + pg_temp.prune('relations', 'to_id', 'work_packages');
  total := total + pg_temp.prune('work_package_versions', 'version_id', 'versions');
  total := total + pg_temp.prune('version_settings', 'version_id', 'versions');
  total := total + pg_temp.prune('time_entries', 'rate_id', 'rates', true);
  total := total + pg_temp.prune('cost_entries', 'rate_id', 'rates', true);

  total := total + pg_temp.prune('wiki_pages', 'wiki_id', 'wikis');
  total := total + pg_temp.prune('wiki_pages', 'parent_id', 'wiki_pages', true);
  total := total + pg_temp.prune('wiki_redirects', 'wiki_id', 'wikis');
  total := total + pg_temp.prune('menu_items', 'navigatable_id', 'wikis');
  total := total + pg_temp.prune('menu_items', 'parent_id', 'menu_items');

  total := total + pg_temp.prune('messages', 'forum_id', 'forums');
  total := total + pg_temp.prune('messages', 'parent_id', 'messages');
  total := total + pg_temp.prune('messages', 'last_reply_id', 'messages', true);
  total := total + pg_temp.prune('forums', 'last_message_id', 'messages', true);

  total := total + pg_temp.prune('meetings', 'recurring_meeting_id', 'recurring_meetings', true);
  total := total + pg_temp.prune('recurring_meeting_historic_schedules', 'recurring_meeting_id', 'recurring_meetings');
  total := total + pg_temp.prune('recurring_meeting_interim_responses', 'recurring_meeting_id', 'recurring_meetings');
  total := total + pg_temp.prune('scheduled_meetings', 'recurring_meeting_id', 'recurring_meetings');
  total := total + pg_temp.prune('scheduled_meetings', 'meeting_id', 'meetings');
  total := total + pg_temp.prune('meeting_sections', 'meeting_id', 'meetings');
  total := total + pg_temp.prune('meeting_agenda_items', 'meeting_id', 'meetings');
  total := total + pg_temp.prune('meeting_participants', 'meeting_id', 'meetings');
  total := total + pg_temp.prune('meeting_agenda_items', 'meeting_section_id', 'meeting_sections');
  total := total + pg_temp.prune('meeting_outcomes', 'meeting_agenda_item_id', 'meeting_agenda_items');

  total := total + pg_temp.prune('member_roles', 'member_id', 'members');
  total := total + pg_temp.prune('labor_budget_items', 'budget_id', 'budgets');
  total := total + pg_temp.prune('material_budget_items', 'budget_id', 'budgets');
  total := total + pg_temp.prune('grid_widgets', 'grid_id', 'grids');
  total := total + pg_temp.prune('views', 'query_id', 'queries');
  total := total + pg_temp.prune('export_settings', 'query_id', 'queries');
  total := total + pg_temp.prune('ical_token_query_assignments', 'query_id', 'queries');
  total := total + pg_temp.prune('ordered_work_packages', 'query_id', 'queries');
  total := total + pg_temp.prune('ordered_persisted_query_entities', 'persisted_query_id', 'persisted_queries');
  total := total + pg_temp.prune('persisted_views', 'parent_id', 'persisted_views');
  total := total + pg_temp.prune('sprint_goals', 'sprint_id', 'sprints');
  total := total + pg_temp.prune('changesets', 'repository_id', 'repositories');
  total := total + pg_temp.prune('changes', 'changeset_id', 'changesets');
  total := total + pg_temp.prune('changesets_work_packages', 'changeset_id', 'changesets');
  total := total + pg_temp.prune('issue_form_fields', 'issue_form_id', 'issue_forms');
  total := total + pg_temp.prune('workflows', 'type_variant_id', 'type_variants');
  total := total + pg_temp.prune('custom_fields_types', 'type_variant_id', 'type_variants');
  total := total + pg_temp.prune('project_custom_field_type_mappings', 'type_variant_id', 'type_variants');
  total := total + pg_temp.prune('project_types', 'variant_id', 'type_variants');
  total := total + pg_temp.prune('bcf_viewpoints', 'issue_id', 'bcf_issues');
  total := total + pg_temp.prune('bcf_comments', 'issue_id', 'bcf_issues');
  total := total + pg_temp.prune('bcf_comments', 'viewpoint_id', 'bcf_viewpoints', true);
  total := total + pg_temp.prune('reminder_notifications', 'reminder_id', 'reminders');
  total := total + pg_temp.prune('reminder_notifications', 'notification_id', 'notifications');

  total := total + pg_temp.prune_unlinked('github_pull_requests', 'github_pull_requests_work_packages', 'github_pull_request_id');
  total := total + pg_temp.prune('github_check_runs', 'github_pull_request_id', 'github_pull_requests');
  total := total + pg_temp.prune('deploy_status_checks', 'github_pull_request_id', 'github_pull_requests');
  total := total + pg_temp.prune_unlinked('gitlab_merge_requests', 'gitlab_merge_requests_work_packages', 'gitlab_merge_request_id');
  total := total + pg_temp.prune('gitlab_pipelines', 'gitlab_merge_request_id', 'gitlab_merge_requests');
  total := total + pg_temp.prune_unlinked('gitlab_issues', 'gitlab_issues_work_packages', 'gitlab_issue_id');

  total := total + pg_temp.prune_polymorphic('attachments', 'container');
  total := total + pg_temp.prune_polymorphic('comments', 'commented');
  total := total + pg_temp.prune_polymorphic('custom_values', 'customized');
  total := total + pg_temp.prune_polymorphic('custom_comments', 'customized');
  total := total + pg_temp.prune_polymorphic('calculated_value_errors', 'customized');
  total := total + pg_temp.prune_polymorphic('watchers', 'watchable');
  total := total + pg_temp.prune_polymorphic('emoji_reactions', 'reactable');
  total := total + pg_temp.prune_polymorphic('favorites', 'favorited');
  total := total + pg_temp.prune_polymorphic('notifications', 'resource');
  total := total + pg_temp.prune_polymorphic('reminders', 'remindable');
  total := total + pg_temp.prune_polymorphic('members', 'entity');
  total := total + pg_temp.prune_polymorphic('time_entries', 'entity');
  total := total + pg_temp.prune_polymorphic('cost_entries', 'entity');
  total := total + pg_temp.prune_polymorphic('resource_allocations', 'entity');
  total := total + pg_temp.prune_polymorphic('grids', 'linked');
  total := total + pg_temp.prune_polymorphic('friendly_id_slugs', 'sluggable');
  total := total + pg_temp.prune_polymorphic('wiki_page_links', 'linkable');
  total := total + pg_temp.prune_polymorphic('ordered_persisted_query_entities', 'entity');
  total := total + pg_temp.prune_polymorphic('persisted_views', 'query');
  total := total + pg_temp.prune_polymorphic('journals', 'journable');

  total := total + pg_temp.prune_everywhere('journal_id', 'journals', with_journal_tables => true);
  total := total + pg_temp.prune_journal_data();
  RETURN total;
END $$;

