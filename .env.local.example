# =============================================================================
# OpenProject - LOCAL environment file
#
#   cp .env.local.example .env.local
#   docker compose --env-file .env.local -f docker-compose.local.yml up -d --build
#
# Local only - never reuse these values elsewhere. Plain HTTP, SSRF relaxed.
# Register the Entra ID redirect URI http://localhost:8080/auth/entra/callback
# =============================================================================

# --- Image (built from this repository) ---
TAG=local
BUILD_TARGET=local
POSTGRES_VERSION=17-alpine
# Hocuspocus image, built from ./extensions/op-blocknote-hocuspocus
# (pins @tiptap/* to patched 3.31.3 - GHSA-j95f-988m-3j2f, GHSA-cp6q-959q-f8rh).
HOCUSPOCUS_TAG=17.9.1-patched

# deunhealth (optional sidecar, enable with --profile deunhealth)
# DEUNHEALTH_TAG=local
# Group id of the Docker socket owner (Linux: stat -c %g /var/run/docker.sock)
# DOCKER_GID=0

# --- Public endpoint ---
OPENPROJECT_HOST__NAME=localhost:8080
# Host port Caddy listens on. Serves plain HTTP (CADDY_SITE_ADDRESS defaults to :8080).
PORT=8080
OPENPROJECT_HTTPS=false
OPENPROJECT_HSTS=false
OPENPROJECT_LOG__LEVEL=info
OPENPROJECT_ADDITIONAL__HOST__NAMES=web
OPENPROJECT_RAILS__RELATIVE__URL__ROOT=
COLLABORATIVE_SERVER_URL=ws://localhost:8080/hocuspocus
OPENPROJECT_URL=http://web:8080

# --- Local integrations (Nextcloud, ...) ---
OPENPROJECT_SSRF_PROTECTION_IP_ALLOWLIST=0.0.0.0/0,::0/0

# --- Local-only secrets ---
SECRET_KEY_BASE=local-dev-secret-key-base-not-for-production
COLLABORATIVE_SERVER_SECRET=local-hocuspocus-secret
POSTGRES_PASSWORD=local-db-password
# DATABASE_URL=postgres://postgres:local-db-password@db/openproject?pool=20&encoding=unicode&reconnect=true
PGDATA=pgdata
OPDATA=opdata

# --- Rails / Puma ---
RAILS_MIN_THREADS=1
RAILS_MAX_THREADS=4

# --- Incoming email (optional) ---
IMAP_ENABLED=false

# --- Microsoft Entra ID (OIDC) - REQUIRED ---
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_DISPLAY_NAME=Microsoft
