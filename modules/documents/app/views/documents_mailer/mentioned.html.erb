<%= render layout: "mailer/spacer_table" do %>
  <%= render partial: "mailer/mailer_header",
             locals: {
               summary: I18n.t(:"documents.mail.mentioned.mentioned_by", user: @author),
               button_href: document_url(@document),
               button_text: I18n.t(:"documents.mail.mentioned.open_document"),
               user: @user
             } %>

  <a style="text-decoration: none;display: block;"
     href="<%= document_url(@document) %>"
     target="_blank">
    <%= render layout: "mailer/border_table" do %>
      <tr>
        <%= placeholder_cell("12px", vertical: true) %>
        <td width="100%" style="color: #878787;">
          <%= @document.project.name %>
        </td>
        <%= placeholder_cell("12px", vertical: true) %>
      </tr>
      <tr>
        <%= placeholder_cell("12px", vertical: true) %>
        <%= placeholder_cell("16px", vertical: false) %>
        <%= placeholder_cell("12px", vertical: true) %>
      </tr>
      <tr>
        <%= placeholder_cell("12px", vertical: true) %>
        <td width="100%" style="color: #333333;font-size:16px;font-weight:bold;">
          <%= @document.title %>
        </td>
        <%= placeholder_cell("12px", vertical: true) %>
      </tr>
    <% end %>
  </a>

  <table <%= placeholder_table_styles %>>
    <tr>
      <%= placeholder_cell("24px", vertical: false) %>
    </tr>
  </table>

  <%= render partial: "mailer/notification_settings_table",
             locals: {
               button_url: my_notifications_url(tab: "reminders"),
               button_text: I18n.t(:"mail.notification.settings")
             } %>
<% end %>
