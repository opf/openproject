<%=
  render(Primer::Alpha::Dialog.new(title: t(".title"), size: :medium_portrait)) do |dialog|
    dialog.with_body do
      flex_layout do |container|
        container.with_row(mb: 3) do
          render(Primer::OpenProject::InputGroup.new) do |menu|
            menu.with_text_input(
              name: :branch_name,
              label: t(".branch_name"),
              value: branch_name,
              data: { test_selector: "gitlab-snippets-branch-name" }
            )
            menu.with_trailing_action_clipboard_copy_button(
              id: :copy_branch_name,
              value: branch_name,
              aria: { label: t(".copy_branch_name") }
            )
          end
        end

        container.with_row { render(Primer::Beta::Text.new(font_weight: :bold)) { t(".commit_message") } }
        container.with_row(mb: 3) do
          render(OpPrimer::InsetBoxComponent.new(data: { test_selector: "gitlab-snippets-commit-message" })) do |box|
            box.with_clipboard_copy_button(value: commit_message, aria: { label: t(".copy_commit_message") })

            concat(render(Primer::Beta::Text.new(tag: :p, mb: 3)) { commit_message_lines[0] })
            concat(render(Primer::Beta::Text.new(tag: :p, mb: 0)) { commit_message_lines[1] })
          end
        end

        container.with_row { render(Primer::Beta::Text.new(font_weight: :bold)) { t(".create_branch_with_empty_commit") } }
        container.with_row do
          render(OpPrimer::InsetBoxComponent.new(data: { test_selector: "gitlab-snippets-create-branch-command" })) do |box|
            box.with_clipboard_copy_button(value: create_branch_command, aria: { label: t(".copy_create_branch_command") })

            create_branch_command_text.each do |line|
              concat(render(Primer::Beta::Text.new(tag: :div, classes: "git-command-line")) { line })
            end
          end
        end
      end
    end
  end
%>
