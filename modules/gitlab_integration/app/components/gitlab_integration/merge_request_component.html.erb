<%=
  flex_layout do |container|
    container.with_row(mb: 1) do
      flex_layout(align_items: :center) do |row|
        row.with_column(mr: 2) do
          render(Primer::Beta::Text.new(color: :muted, font_weight: :bold)) { merge_request.repository }
        end

        row.with_column(mr: 2) do
          # TODO: check which columns indicates real merge request number
          render(Primer::Beta::Text.new(color: :muted)) { "##{merge_request.gitlab_id}" }
        end

        row.with_column(mr: 2) do
          render(GitlabIntegration::StatusComponent.new(status: merge_request_status)) do
            render(Primer::Beta::Text.new) { state_label }
          end
        end

        if latest_pipeline.present?
          row.with_column do
            render(Primer::Beta::Link.new(href: latest_pipeline.gitlab_html_url, data: { allow_external_link: true })) do
              render(GitlabIntegration::StatusComponent.new(status: pipeline_status)) do
                render(Primer::Beta::Text.new) { pipeline_status_label }
              end
            end
          end
        end
      end
    end

    container.with_row(mb: 1) do
      render(
        Primer::Beta::Link.new(
          href: merge_request.gitlab_html_url,
          font_weight: :bold,
          scheme: :primary,
          data: { allow_external_link: true }
        )
      ) { merge_request.title }
    end

    if merge_request.labels.any?
      container.with_row do
        flex_layout(flex_wrap: :wrap) do |row|
          merge_request.labels.each do |label|
            row.with_column(mr: 2, mb: 1) do
              render(GitlabIntegration::LabelComponent.new(title: label.fetch("title"), color: label.fetch("color")))
            end
          end
        end
      end
    end

    container.with_row do
      render(Primer::Beta::Text.new(color: :muted)) do
        [
          t(".created_by", name: merge_request.gitlab_user.gitlab_name),
          t(".updated_at", date_time: format_time(merge_request.gitlab_updated_at))
        ].join(" ")
      end
    end
  end
%>
