<%=
  flex_layout do |container|
    container.with_row(mb: 1) do
      flex_layout(align_items: :center) do |row|
        row.with_column(mr: 2) do
          render(Primer::Beta::Text.new(color: :muted, font_weight: :bold)) { commit.repository }
        end

        row.with_column(mr: 2) do
          render(Primer::Beta::Text.new(color: :muted)) { commit.sha[..7] }
        end

        row.with_column do
          render(Primer::Beta::ClipboardCopy.new(value: commit.sha, "aria-label": t(".copy_sha")))
        end
      end
    end

    container.with_row(mb: 1) do
      render(
        Primer::Beta::Link.new(
          href: commit.gitlab_html_url,
          font_weight: :bold,
          scheme: :primary,
          data: { allow_external_link: true }
        )
      ) { commit.message.lines.first || t(".empty_message") }
    end

    container.with_row do
      render(Primer::Beta::Text.new(color: :muted)) do
        [
          t(".created_by", name: commit.author_name),
          t(".authored_at", date_time: format_time(commit.authored_at))
        ].join(" ")
      end
    end
  end
%>
