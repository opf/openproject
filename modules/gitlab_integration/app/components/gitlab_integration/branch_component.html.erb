<%=
  flex_layout do |container|
    container.with_row(mb: 1) do
      render(Primer::Beta::Text.new(color: :muted, font_weight: :bold)) { branch.repository }
    end

    container.with_row(mb: 1) do
      render(Primer::Alpha::Stack.new(direction: :horizontal, gap: :condensed, align: :center)) do
        concat(
          render(Primer::Beta::Truncate.new) do |truncate|
            truncate.with_item do
              render(
                Primer::Beta::Link.new(
                  href: branch.html_url,
                  font_weight: :bold,
                  scheme: :primary,
                  title: branch.name,
                  data: { allow_external_link: true }
                )
              ) { branch.name }
            end
          end
        )

        concat(render(Primer::Beta::ClipboardCopy.new(value: branch.name, "aria-label": t(".copy_name"))))
      end
    end

    container.with_row(mb: 2) do
      render(Primer::Beta::Text.new(color: :muted)) { meta_text }
    end

    container.with_row do
      render(
        Primer::Beta::Button.new(
          tag: :a,
          href: branch.new_merge_request_url,
          data: { allow_external_link: true }
        )
      ) do |button|
        button.with_leading_visual_icon(icon: :plus)
        button.with_trailing_visual_icon(icon: :"link-external")
        t(".create_merge_request")
      end
    end
  end
%>
