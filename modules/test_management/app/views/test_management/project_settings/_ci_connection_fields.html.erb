<% ci_t = ->(key, **args) { t("test_management.project_settings.ci.#{key}", **args) } %>
<% attr = ->(name) { TestManagement::CiConnection.human_attribute_name(name) } %>
<% prefix = connection.persisted? ? "tm-ci-#{connection.id}" : "tm-ci-new" %>
<div class="tm-ci-form--grid">
  <div class="form--field">
    <%= f.label :name, attr.(:name), class: "form--label", for: "#{prefix}-name" %>
    <%= f.text_field :name, id: "#{prefix}-name", class: "form--text-field", maxlength: 255, required: true %>
  </div>
  <div class="form--field">
    <%= f.label :provider, attr.(:provider), class: "form--label", for: "#{prefix}-provider" %>
    <%= f.select :provider, TestManagement::CiConnection::PROVIDERS.map { [ci_t.("providers.#{it}"), it] }, {},
                 id: "#{prefix}-provider", class: "form--select" %>
  </div>
  <div class="form--field">
    <%= f.label :repository, attr.(:repository), class: "form--label", for: "#{prefix}-repository" %>
    <%= f.text_field :repository, id: "#{prefix}-repository", class: "form--text-field", maxlength: 255, required: true,
                                  placeholder: "my-org/shop" %>
    <p class="form--field-instructions"><%= ci_t.("repository_hint") %></p>
  </div>
  <div class="form--field">
    <%= f.label :ingest_mode, attr.(:ingest_mode), class: "form--label", for: "#{prefix}-mode" %>
    <%= f.select :ingest_mode, TestManagement::CiConnection::INGEST_MODES.map { [ci_t.("ingest_modes.#{it}"), it] }, {},
                 id: "#{prefix}-mode", class: "form--select" %>
  </div>
  <div class="form--field">
    <%= f.label :target_run_name, attr.(:target_run_name), class: "form--label", for: "#{prefix}-target" %>
    <%= f.text_field :target_run_name, id: "#{prefix}-target", class: "form--text-field", maxlength: 255 %>
    <p class="form--field-instructions"><%= ci_t.("target_run_name_hint") %></p>
  </div>
  <div class="form--field">
    <%= f.label :token, attr.(:token), class: "form--label", for: "#{prefix}-token" %>
    <%= f.password_field :token, id: "#{prefix}-token", value: nil, class: "form--text-field", autocomplete: "new-password",
                                 data: { test_selector: "#{prefix}-token" } %>
    <p class="form--field-instructions">
      <%= ci_t.("token_hint") %>
      <% if connection.token_set? %><%= ci_t.("token_keep_hint") %><% end %>
    </p>
    <% if connection.token_set? %>
      <label class="form--label-with-check-box">
        <%= f.check_box :remove_token, { id: "#{prefix}-remove-token" }, "1", "0" %>
        <%= ci_t.("remove_token") %>
      </label>
    <% end %>
  </div>
  <div class="form--field">
    <%= f.label :workflow, attr.(:workflow), class: "form--label", for: "#{prefix}-workflow" %>
    <%= f.text_field :workflow, id: "#{prefix}-workflow", class: "form--text-field", maxlength: 255,
                                placeholder: "op-tests.yml" %>
    <p class="form--field-instructions"><%= ci_t.("workflow_hint") %></p>
  </div>
  <div class="form--field">
    <%= f.label :trigger_ref, attr.(:trigger_ref), class: "form--label", for: "#{prefix}-ref" %>
    <%= f.text_field :trigger_ref, id: "#{prefix}-ref", class: "form--text-field", maxlength: 255, placeholder: "main" %>
  </div>
  <div class="form--field">
    <label class="form--label-with-check-box">
      <%= f.check_box :active, id: "#{prefix}-active" %>
      <%= attr.(:active) %>
    </label>
  </div>
</div>
