<% html_title(t("test_management.project_settings.heading")) %>
<% can_manage_general = User.current.allowed_in_project?(:manage_test_management, @project) %>

<%=
  render(Primer::OpenProject::PageHeader.new) do |header|
    header.with_title { t("test_management.project_settings.heading") }
    header.with_breadcrumbs(
      [
        { href: project_overview_path(@project.id), text: @project.name },
        t(:label_project_settings),
        t("test_management.project_settings.heading")
      ]
    )
  end
%>

<% if can_manage_general %>
  <%= form_with model: @setting,
                scope: :project_setting,
                url: project_test_management_project_settings_path(@project),
                method: :patch,
                local: true,
                data: { test_selector: "tm-project-settings-form" } do |f| %>
    <fieldset class="form--fieldset">
      <legend><%= t("test_management.project_settings.general") %></legend>

      <div class="form--field">
        <%= f.label :display_prefix, t("activerecord.attributes.test_management/project_setting.display_prefix") %>
        <div class="form--field-container">
          <%= f.text_field :display_prefix, class: "form--text-field" %>
        </div>
        <div class="form--field-instructions">
          <%= t("test_management.project_settings.display_prefix_hint") %>
        </div>
      </div>

      <div class="form--field">
        <%= f.label :folder_tree_layout, t("test_management.project_settings.folder_tree_layout") %>
        <div class="form--field-container">
          <%= f.select :folder_tree_layout,
                       [
                         [t("test_management.project_settings.layout_split_pane"), "split_pane"],
                         [t("test_management.project_settings.layout_sidebar"), "sidebar"]
                       ],
                       {},
                       class: "form--select",
                       data: { test_selector: "tm-folder-tree-layout" } %>
        </div>
        <div class="form--field-instructions">
          <%= t("test_management.project_settings.folder_tree_layout_hint") %>
        </div>
      </div>
    </fieldset>

    <fieldset class="form--fieldset">
      <legend><%= t("test_management.project_settings.features") %></legend>
      <label class="form--label-with-check-box">
        <%= f.check_box :enable_ci %>
        <%= t("test_management.project_settings.enable_ci") %>
      </label>
      <label class="form--label-with-check-box">
        <%= f.check_box :enable_milestones, checked: @setting.milestones_enabled?, data: { test_selector: "tm-enable-milestones" } %>
        <%= t("test_management.project_settings.enable_milestones") %>
      </label>
      <div class="form--field-instructions"><%= t("test_management.project_settings.enable_milestones_hint") %></div>
      <label class="form--label-with-check-box">
        <%= f.check_box :enable_test_plans, checked: @setting.plans_enabled?, data: { test_selector: "tm-enable-test-plans" } %>
        <%= t("test_management.project_settings.enable_test_plans") %>
      </label>
      <div class="form--field-instructions"><%= t("test_management.project_settings.enable_test_plans_hint") %></div>
      <label class="form--label-with-check-box">
        <%= f.check_box :enable_test_assistant, checked: @setting.test_assistant_enabled?, data: { test_selector: "tm-enable-test-assistant" } %>
        <%= t("test_management.project_settings.enable_test_assistant") %>
      </label>
      <div class="form--field-instructions"><%= t("test_management.project_settings.enable_test_assistant_hint") %></div>
    </fieldset>

    <%= f.submit t(:button_save), class: "button -primary", data: { test_selector: "tm-project-settings-save" } %>
  <% end %>

  <%= render partial: "test_management/project_settings/labels" %>

  <%= render partial: "test_management/project_settings/configurations" %>
<% end %>

<%= render partial: "test_management/project_settings/ci_connections" %>
