<% html_title(t("test_management.admin.heading")) %>

<%=
  render(Primer::OpenProject::PageHeader.new) do |header|
    header.with_title { t("test_management.admin.heading") }
    header.with_breadcrumbs([t(:label_administration), t("test_management.admin.heading")])
  end
%>

<%= form_with url: test_management_admin_settings_path, method: :patch, local: true do %>
  <fieldset class="form--fieldset">
    <legend><%= t("test_management.admin.general") %></legend>
    <div class="form--field">
      <label for="default_display_prefix"><%= t("test_management.admin.default_display_prefix") %></label>
      <div class="form--field-container">
        <%= text_field_tag :default_display_prefix,
                           @settings[:default_display_prefix],
                           class: "form--text-field",
                           autocomplete: "off" %>
      </div>
    </div>
  </fieldset>

  <fieldset class="form--fieldset" data-test-selector="tm-admin-hotkeys">
    <legend><%= t("test_management.admin.hotkeys.heading") %></legend>
    <% TestManagement::Admin::SettingsController::HOTKEY_SETTINGS.each do |key| %>
      <div class="form--field">
        <label class="form--label" for="<%= key %>"><%= t("test_management.admin.hotkeys.#{key}") %></label>
        <div class="form--field-container">
          <%= hidden_field_tag key, "0", id: nil %>
          <%= check_box_tag key, "1", @settings[key].nil? || ActiveModel::Type::Boolean.new.cast(@settings[key]) != false,
                            class: "form--check-box", data: { test_selector: "tm-admin-#{key}" } %>
        </div>
        <div class="form--field-instructions"><%= t("test_management.admin.hotkeys.#{key}_hint") %></div>
      </div>
    <% end %>
  </fieldset>

  <fieldset class="form--fieldset">
    <legend><%= t("test_management.admin.integrations") %></legend>
    <p><%= t("test_management.admin.integrations_hint") %></p>
    <p>
      <%= link_to "GitHub", github_integration_admin_settings_path, class: "button" %>
      <%= link_to "GitLab", gitlab_integration_admin_settings_path, class: "button" %>
    </p>
  </fieldset>

  <fieldset class="form--fieldset">
    <legend><%= t("test_management.admin.import") %></legend>
    <p><%= t("test_management.admin.import_hint") %></p>
  </fieldset>

  <%= submit_tag t(:button_save), class: "button -primary" %>
<% end %>

<%# 0021: saved providers (outside the settings form: the row actions are forms of their own). %>
<%= render partial: "test_management/admin/assistant_providers/list", locals: { providers: @providers } %>
