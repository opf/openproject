<%# Milestone pages + the milestone section of the work package Testing tab. %>
<style>
  .tm-ms-list--row { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }
  .tm-ms-list--row.-child { padding-left: 40px; }
  .tm-ms-list--main { flex: 1 1 280px; min-width: 0; }
  .tm-ms-list--name { font-weight: 600; }
  .tm-ms-list--meta { font-size: 12px; }
  .tm-ms-list--progress { flex: 0 1 260px; display: flex; flex-direction: column; gap: 4px; min-width: 160px; }
  .tm-ms-list--percent { font-size: 12px; }
  .tm-ms-bar { display: block; border-radius: 4px; overflow: hidden; }
  .tm-ms-donut--label { font-size: 15px; font-weight: 600; fill: currentColor; }
  .tm-ms-summary { display: flex; gap: 24px; align-items: flex-start; flex-wrap: wrap; margin-bottom: 16px; }
  .tm-ms-summary--chart { flex: 0 0 auto; }
  .tm-ms-summary--side { flex: 1 1 240px; min-width: 0; display: flex; flex-direction: column; gap: 8px; }
  .tm-ms-counts { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  .tm-ms-counts--item { display: grid; grid-template-columns: 1fr auto 3.5em; gap: 8px; align-items: center; font-size: 13px; }
  .tm-ms-counts--count, .tm-ms-counts--pct { text-align: right; font-variant-numeric: tabular-nums; }
  .tm-ms-counts--pct { color: var(--fgColor-muted, #57606a); }
  .tm-ms-meta { display: grid; grid-template-columns: max-content 1fr; gap: 4px 16px; margin: 0 0 16px; }
  .tm-ms-meta dt { font-weight: 600; }
  .tm-ms-meta dd { margin: 0; }
  .tm-ms-form .form--field-container select { max-width: 32rem; }
  .tm-ms-form--actions { margin-top: 16px; display: flex; gap: 8px; }
</style>
