<% html_title t(:label_administration), t("field_rules.plural"), t("field_rules.confirm.title") %>
<%=
  render Primer::OpenProject::PageHeader.new do |header|
    header.with_title { t("field_rules.confirm.title") }
    header.with_breadcrumbs([{ href: admin_index_path, text: t(:label_administration) },
                             { href: admin_field_rule_schemes_path, text: t("field_rules.schemes.plural") },
                             t("field_rules.confirm.title")])
  end
%>
<%= render(Primer::Beta::Flash.new(scheme: :warning, mb: 3)) { t("field_rules.confirm.scheme_in_use", count: @impact[:project_count]) } %>
<%= form_tag admin_field_rule_scheme_path(@scheme), method: :patch do %>
  <%= hidden_field_tag :confirm, "1" %>
  <% @scheme_params.to_h.except("types").each do |key, value| %>
    <%= hidden_field_tag "scheme[#{key}]", value, id: nil %>
  <% end %>
  <% (@scheme_params[:types] || {}).to_h.each do |type_id, rule_set_id| %>
    <%= hidden_field_tag "scheme[types][#{type_id}]", rule_set_id, id: nil %>
  <% end %>
  <%= submit_tag t(:button_confirm), class: "button -primary" %>
  <%= link_to t(:button_cancel), admin_field_rule_schemes_path, class: "button" %>
<% end %>
