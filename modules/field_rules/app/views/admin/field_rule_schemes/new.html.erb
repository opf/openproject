<% html_title t(:label_administration), t("field_rules.plural"), t("field_rules.schemes.new") %>
<%=
  render Primer::OpenProject::PageHeader.new do |header|
    header.with_title { t("field_rules.schemes.new") }
    header.with_breadcrumbs([{ href: admin_index_path, text: t(:label_administration) },
                             { href: admin_field_rule_schemes_path, text: t("field_rules.schemes.plural") },
                             t("field_rules.schemes.new")])
  end
%>
<%= form_tag admin_field_rule_schemes_path, method: :post do %>
  <%= render "form_fields", scheme: @scheme %>
  <%= submit_tag t(:button_create), class: "button -primary" %>
  <%= link_to t(:button_cancel), admin_field_rule_schemes_path, class: "button" %>
<% end %>
