<% html_title t(:label_administration), t("field_rules.plural"), t("field_rules.confirm.title") %>
<%=
  render Primer::OpenProject::PageHeader.new do |header|
    header.with_title { t("field_rules.confirm.title") }
    header.with_breadcrumbs([{ href: admin_index_path, text: t(:label_administration) },
                             { href: admin_field_rule_sets_path, text: t("field_rules.rule_sets.plural") },
                             t("field_rules.confirm.title")])
  end
%>
<%= render(Primer::Beta::Flash.new(scheme: :warning, mb: 3)) { t("field_rules.confirm.rule_set_in_use", schemes: @impact[:scheme_count], projects: @impact[:project_count], work_packages: @impact[:work_package_count]) } %>
<%= form_tag admin_field_rule_set_path(@rule_set), method: :patch do %>
  <%= hidden_field_tag :confirm, "1" %>
  <% @rule_set_params.to_h.except("rules").each do |key, value| %>
    <%= hidden_field_tag "rule_set[#{key}]", value, id: nil %>
  <% end %>
  <% (@rule_set_params[:rules] || {}).to_h.each do |field, attrs| %>
    <% attrs.each do |key, value| %>
      <%= hidden_field_tag "rule_set[rules][#{field}][#{key}]", value, id: nil %>
    <% end %>
  <% end %>
  <%= submit_tag t(:button_confirm), class: "button -primary" %>
  <%= link_to t(:button_cancel), admin_field_rule_sets_path, class: "button" %>
<% end %>
