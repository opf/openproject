<% html_title t(:label_administration), t("field_rules.plural") %>
<%=
  render Primer::OpenProject::PageHeader.new do |header|
    header.with_title { t("field_rules.rule_sets.plural") }
    header.with_breadcrumbs([{ href: admin_index_path, text: t(:label_administration) },
                             t("field_rules.rule_sets.plural")])
  end
%>
<%= render Primer::Beta::Text.new(tag: :p, color: :muted) { t("field_rules.rule_sets.description") } %>
<%= render Primer::Beta::Button.new(tag: :a, href: new_admin_field_rule_set_path, scheme: :primary, mb: 3) { t("field_rules.rule_sets.new") } %>
<%= render Primer::Beta::Button.new(tag: :a, href: admin_field_rule_schemes_path, mb: 3, ml: 2) { t("field_rules.schemes.plural") } %>

<% if @rule_sets.empty? %>
  <%=
    render Primer::Beta::Blankslate.new(border: true) do |blankslate|
      blankslate.with_visual_icon(icon: :checklist)
      blankslate.with_heading(tag: :h2).with_content(t("field_rules.rule_sets.blank_heading"))
      blankslate.with_description { t("field_rules.rule_sets.blank_description") }
    end
  %>
<% else %>
  <div class="generic-table--container">
    <div class="generic-table--results-container">
      <table class="generic-table">
        <caption class="sr-only"><%= t("field_rules.rule_sets.plural") %></caption>
        <thead>
          <tr>
            <th scope="col"><%= t(:label_name) %></th>
            <th scope="col"><%= t("field_rules.rule_sets.rules") %></th>
            <th scope="col"><%= t("field_rules.rule_sets.schemes") %></th>
            <th scope="col"><%= t(:label_status) %></th>
            <th scope="col"><span class="sr-only"><%= t("field_rules.actions") %></span></th>
          </tr>
        </thead>
        <tbody>
          <% @rule_sets.each do |rule_set| %>
            <% scheme_count = @scheme_counts.fetch(rule_set.id, 0) %>
            <tr>
              <th scope="row">
                <%= link_to rule_set.name, edit_admin_field_rule_set_path(rule_set) %>
                <% if rule_set.description.present? %>
                  <div class="color-fg-muted"><%= rule_set.description %></div>
                <% end %>
              </th>
              <td><%= rule_set.rules.size %></td>
              <td><%= scheme_count %></td>
              <td><%= rule_set.active ? t(:label_active) : t(:label_inactive) %></td>
              <td>
                <%= render(Primer::Beta::Button.new(tag: :a, href: edit_admin_field_rule_set_path(rule_set), size: :small, mr: 2, mb: 1, "aria-label": t("field_rules.action_on", action: t(:button_edit), name: rule_set.name))) { t(:button_edit) } %>
                <%= render "action", name: rule_set.name, path: clone_admin_field_rule_set_path(rule_set), caption: t("field_rules.clone"), confirm: nil %>
                <% if rule_set.active %>
                  <%= render "action", name: rule_set.name, path: deactivate_admin_field_rule_set_path(rule_set), caption: t("field_rules.deactivate"),
                                       confirm: t("field_rules.rule_sets.deactivate_confirm", count: scheme_count) %>
                <% else %>
                  <%= render "action", name: rule_set.name, path: activate_admin_field_rule_set_path(rule_set), caption: t("field_rules.activate"), confirm: nil %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
