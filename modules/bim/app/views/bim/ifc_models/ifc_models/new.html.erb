<%=
  render Primer::OpenProject::PageHeader.new do |header|
    header.with_title { t("ifc_models.label_new_ifc_model") }
    header.with_breadcrumbs(
      [{ href: project_overview_path(@project.id), text: @project.name },
       { href: defaults_bcf_project_ifc_models_path(@project.identifier), text: I18n.t(:"bcf.label_bcf") },
       { href: bcf_project_ifc_models_path(@project.identifier), text: I18n.t(:"ifc_models.label_ifc_models") },
       t("ifc_models.label_new_ifc_model")]
    )
  end
%>

<% if OpenProject::Configuration.direct_uploads? %>
  <%=
    primer_form_with(
      model: @ifc_model,
      url: @form[:uri],
      multipart: true,
      authenticity_token: false,
      data: {
        controller: "bim--ifc-model-direct-upload",
        "bim--ifc-model-direct-upload-set-default-model-url-value": set_direct_upload_default_value_bcf_project_ifc_models_path,
        "bim--ifc-model-direct-upload-set-model-title-url-value": set_direct_upload_file_name_bcf_project_ifc_models_path,
        "bim--ifc-model-direct-upload-target": "form"
      }
    ) do |f|
  %>
    <% @form.except(:uri).each do |key, value| %>
      <input type="hidden" name="<%= key %>" value="<%= value %>">
    <% end %>

    <div class="FormControl mb-3">
      <label for="ifc-direct-upload-file-input" class="FormControl-label">
        <%= Bim::IfcModels::IfcModel.human_attribute_name(:ifc_attachment) %>
        <span aria-hidden="true">*</span>
      </label>
      <input id="ifc-direct-upload-file-input"
             type="file"
             name="file"
             accept=".ifc"
             class="FormControl-input FormControl-medium border-0"
             data-action="change->bim--ifc-model-direct-upload#setSessionModelTitle"
             data-bim--ifc-model-direct-upload-target="fileInput"
             required>
    </div>

    <%=
      render_inline_form(f) do |form|
        form.check_box(
          name: :is_default,
          label: Bim::IfcModels::IfcModel.human_attribute_name(:is_default),
          data: {
            action: "change->bim--ifc-model-direct-upload#setSessionDefaultValue"
          }
        )
        form.submit(name: :save, label: I18n.t(:button_create), scheme: :primary)
      end
    %>
  <% end %>
<% else %>
  <%=
    primer_form_with(
      model: @ifc_model,
      url: bcf_project_ifc_models_path(@project),
      method: :post,
      multipart: true
    ) do |f|
      render_inline_form(f) do |form|
        form.text_field(
          name: :ifc_attachment,
          type: :file,
          label: Bim::IfcModels::IfcModel.human_attribute_name(:ifc_attachment),
          border: 0,
          accept: ".ifc",
          input_width: :medium,
          required: true
        )
        form.check_box(name: :is_default, label: Bim::IfcModels::IfcModel.human_attribute_name(:is_default))
        form.submit(name: :save, label: I18n.t(:button_create), scheme: :primary)
      end
    end
  %>
<% end %>
