<% content_for :header_tags do %>
  <%= tag :meta,
          name: "openproject_ifc_models",
          data: {
            models: ifc_model_data_object(@ifc_models, @shown_model_ids).to_json
          }
  %>
<% end %>
<% unconverted = @shown_ifc_models.reject(&:converted?) %>

<% if unconverted.any? %>
  <%= render partial: "unconverted_notice", locals: { unconverted: unconverted } %>
<% end %>

<% content_for :content_body do %>
  <%= angular_component_tag "opce-ifc-viewer-view" %>
<% end %>

<% content_for :content_body_right do %>
  <% if render_work_package_split_view? %>
    <%= render(split_view_instance) %>
  <% elsif render_work_package_split_create? %>
    <%= render(split_create_instance) %>
  <% else %>
    <%= angular_component_tag "opce-bcf-content-right" %>
  <% end %>
<% end %>
