<% html_title t(:label_project_settings), t(:project_module_squashtm) %>

<%=
  render(Primer::OpenProject::PageHeader.new) do |header|
    header.with_title { t(:project_module_squashtm) }
    header.with_description { t(".description") }
    header.with_breadcrumbs(
      [{ href: project_overview_path(@project.id), text: @project.name },
       { href: project_settings_general_path(@project.id), text: t(:label_project_settings) },
       t(:project_module_squashtm)]
    )
  end
%>

<%=
  render(
    SquashTMIntegration::ProjectSettings::StatusBannerComponent.new(
      server: @server, project_link: @project_link, squashtm_projects: @squashtm_projects
    )
  )
%>

<% if @project_link.errors[:base].any? %>
  <%= render(Primer::Alpha::Banner.new(scheme: :danger, icon: :stop, mb: 3)) { @project_link.errors.full_messages_for(:base).to_sentence } %>
<% end %>

<% if @project_link.persisted? %>
  <%=
    render(
      SquashTMIntegration::ProjectSettings::LinkedProjectComponent.new(
        project: @project, project_link: @project_link, server: @server
      )
    )
  %>
<% elsif @server.nil? %>
  <%=
    render(Primer::Beta::Text.new(tag: :p, color: :subtle)) do
      t(".not_linked")
    end
  %>
<% elsif @squashtm_projects %>
  <%=
    primer_form_with(
      model: @project_link,
      scope: :squashtm_project_link,
      url: project_settings_squashtm_path(@project),
      method: :patch
    ) do |form|
      render(SquashTMIntegration::ProjectSettings::ProjectLinkForm.new(form, squashtm_projects: @squashtm_projects))
    end
  %>
<% end %>
