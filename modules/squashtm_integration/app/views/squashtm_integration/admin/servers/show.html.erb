<% html_title t(:label_administration), t("squashtm_integration.admin.title") %>

<%=
  render(Primer::OpenProject::PageHeader.new) do |header|
    header.with_title { t("squashtm_integration.admin.title") }
    header.with_description { t("squashtm_integration.admin.servers.show.description") }
    header.with_breadcrumbs(
      [{ href: admin_index_path, text: t(:label_administration) },
       t("squashtm_integration.admin.title")]
    )

    if @server.persisted?
      header.with_action_button(
        tag: :a,
        href: test_connection_squashtm_integration_admin_server_path,
        data: { turbo_method: :post },
        mobile_icon: :plug,
        mobile_label: t("squashtm_integration.admin.servers.show.test_connection"),
        test_selector: "squashtm-server--test-connection"
      ) do |button|
        button.with_leading_visual_icon(icon: :plug)
        t("squashtm_integration.admin.servers.show.test_connection")
      end

      header.with_action_button(
        tag: :a,
        scheme: :danger,
        href: destroy_dialog_squashtm_integration_admin_server_path,
        data: { controller: "async-dialog" },
        mobile_icon: :trash,
        mobile_label: t(:button_delete),
        test_selector: "squashtm-server--delete"
      ) do |button|
        button.with_leading_visual_icon(icon: :trash)
        t(:button_delete)
      end
    end
  end
%>

<%=
  primer_form_with(
    model: @server,
    scope: :squashtm_server,
    url: squashtm_integration_admin_server_path,
    method: :patch
  ) do |form|
    render(SquashTMIntegration::Admin::ServerForm.new(form))
  end
%>
