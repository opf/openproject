<% html_title t(:label_administration), t(".title") %>

<%=
  render(Primer::OpenProject::PageHeader.new) do |header|
    header.with_title { t(".title") }
    header.with_description { t(".description") }
    header.with_breadcrumbs(
      [{ href: admin_index_path, text: t(:label_administration) },
       t(".title")]
    )
  end
%>

<% if @server.persisted? %>
  <%=
    render(Primer::Alpha::Banner.new(scheme: :success, mb: 3, test_selector: "squashtm--linked-server")) do
      server_link = render(Primer::Beta::Link.new(href: @server.base_url, target: "_blank", rel: "noopener noreferrer", data: { allow_external_link: true })) do |link|
        link.with_trailing_visual_icon(icon: :"link-external")
        @server.base_url
      end

      t(".linked_html", url: server_link)
    end
  %>

  <%=
    flex_layout(direction: :row, flex_wrap: :wrap) do |actions|
      actions.with_column(mr: 2) do
        render(
          Primer::Beta::Button.new(
            tag: :a,
            href: test_connection_squashtm_integration_admin_server_path,
            data: {
              turbo_method: :post,
              controller: "disable-when-clicked",
              disable_when_clicked_text_value: t(".testing_connection")
            },
            test_selector: "squashtm--test-server-connection"
          )
        ) do |button|
          button.with_leading_visual_icon(icon: :plug)
          t(".test_connection")
        end
      end

      actions.with_column do
        render(
          Primer::Beta::Button.new(
            tag: :a,
            scheme: :danger,
            href: destroy_dialog_squashtm_integration_admin_server_path,
            data: { controller: "async-dialog" },
            test_selector: "squashtm--delete-server"
          )
        ) do |button|
          button.with_leading_visual_icon(icon: :unlink)
          t(".unlink")
        end
      end
    end
  %>
<% else %>
  <% if @server.errors[:base].any? %>
    <%= render(Primer::Alpha::Banner.new(scheme: :danger, icon: :stop, mb: 3)) { @server.errors.full_messages_for(:base).to_sentence } %>
  <% end %>

  <%=
    primer_form_with(
      model: @server,
      scope: :squashtm_server,
      url: squashtm_integration_admin_server_path,
      method: :patch
    ) do |form|
      render(SquashTMIntegration::Admin::ServerForm.new(form))
    end
  %>
<% end %>
