<%=
  flex_layout(test_selector: "op-work-package-squashtm-tab--linked") do |container|
    container.with_row(mb: 3) do
      render(OpenProject::Common::BorderBoxListComponent.new(container: :squashtm_requirement, padding: :condensed)) do |list|
        list.with_header(title: t(".requirement")) do |header|
          if can_manage_links?
            header.with_action_icon_button(
              tag: :a,
              icon: :unlink,
              scheme: :invisible,
              aria: { label: t(".unlink") },
              tooltip_direction: :w,
              href: destroy_dialog_project_work_package_squashtm_requirement_link_path(project, work_package),
              data: { controller: "async-dialog" },
              test_selector: "op-work-package-squashtm-tab--unlink"
            )
          end
        end

        list.with_item do
          render(Primer::Beta::Text.new(test_selector: "op-work-package-squashtm-tab--requirement")) do
            work_package_link.squashtm_requirement_name
          end
        end
      end
    end
  end
%>
