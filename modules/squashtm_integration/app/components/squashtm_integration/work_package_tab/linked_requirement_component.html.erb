<%=
  flex_layout(test_selector: "op-work-package-squashtm-tab--linked") do |container|
    case requirement_error
    when :not_found
      container.with_row(mb: 3) do
        render(Primer::Alpha::Banner.new(scheme: :warning, icon: :alert, test_selector: "op-work-package-squashtm-tab--requirement-missing")) do
          t(".requirement_missing")
        end
      end
    when :unavailable
      container.with_row(mb: 3) do
        render(Primer::Alpha::Banner.new(scheme: :danger, icon: :stop, test_selector: "op-work-package-squashtm-tab--unavailable")) do
          t(".unavailable")
        end
      end
    end

    container.with_row(mb: 3) do
      render(OpPrimer::BorderBoxListComponent.new(container: :squashtm_requirement, padding: :condensed)) do |list|
        list.with_header(title: t(".requirement")) do |header|
          if can_manage_links?
            header.with_action_icon_button(
              tag: :a,
              icon: :unlink,
              scheme: :invisible,
              aria: { label: t(".unlink") },
              tooltip_direction: :w,
              href: destroy_dialog_project_work_package_squashtm_requirement_link_path(project, work_package),
              data: { controller: "async-dialog" },
              test_selector: "op-work-package-squashtm-tab--unlink"
            )
          end
        end

        list.with_item do
          render(SquashTMIntegration::WorkPackageTab::RequirementComponent.new(tab_state))
        end
      end
    end

    if requirement
      container.with_row(mb: 3) do
        render(
          OpPrimer::BorderBoxListComponent.new(
            container: :squashtm_test_cases,
            collapsible: true,
            padding: :condensed,
            test_selector: "op-work-package-squashtm-tab--test-cases"
          )
        ) do |list|
          list.with_header(title: t(".test_cases"), count: requirement.test_cases.size)
          list.with_empty_state(title: t(".no_test_cases.title"), description: t(".no_test_cases.description"), icon: :beaker)

          requirement.test_cases.each do |test_case|
            list.with_item do
              render(SquashTMIntegration::WorkPackageTab::TestCaseComponent.new(test_case, server:))
            end
          end
        end
      end
    end
  end
%>
