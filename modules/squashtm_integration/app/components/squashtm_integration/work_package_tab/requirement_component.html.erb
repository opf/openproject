<%=
  flex_layout(test_selector: "op-work-package-squashtm-tab--requirement") do |container|
    container.with_row(mb: 1) do
      flex_layout(align_items: :center) do |row|
        if requirement&.reference
          row.with_column(mr: 2) do
            render(Primer::Beta::Text.new(color: :muted, font_weight: :bold)) { requirement.reference }
          end
        end

        row.with_column(mr: 2) do
          render(Primer::Beta::Text.new(color: :muted)) { "##{requirement_id}" }
        end

        if requirement&.status
          row.with_column do
            render(Primer::Beta::Label.new(size: :large)) { status_label }
          end
        end
      end
    end

    container.with_row do
      render(
        Primer::Beta::Link.new(href: url, font_weight: :bold, scheme: :primary, target: "_blank", rel: "noopener noreferrer")
      ) do |link|
        link.with_trailing_visual_icon(icon: :"link-external")
        name
      end
    end
  end
%>
