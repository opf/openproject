<%=
  flex_layout(test_selector: "op-work-package-squashtm-tab--test-case-#{test_case.id}") do |container|
    container.with_row(mb: 1) do
      flex_layout(align_items: :center) do |row|
        if test_case.reference
          row.with_column(mr: 2) do
            render(Primer::Beta::Text.new(color: :muted, font_weight: :bold)) { test_case.reference }
          end
        end

        row.with_column(mr: 2) do
          render(Primer::Beta::Text.new(color: :muted)) { "##{test_case.id}" }
        end

        row.with_column do
          render(SquashTMIntegration::WorkPackageTab::ExecutionStatusComponent.new(test_case))
        end
      end
    end

    container.with_row(mb: 1) do
      render(
        Primer::Beta::Link.new(href: url, font_weight: :bold, scheme: :primary, target: "_blank", rel: "noopener noreferrer")
      ) do |link|
        link.with_trailing_visual_icon(icon: :"link-external")
        test_case.name
      end
    end

    if test_case.description
      container.with_row(mb: 1, classes: "op-uc-container", test_selector: "op-work-package-squashtm-tab--test-case-description") do
        description
      end
    end

    container.with_row do
      render(Primer::Beta::Text.new(color: :muted)) { execution_details }
    end
  end
%>
