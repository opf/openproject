<%=
  flex_layout do |container|
    container.with_row(mb: 3) do
      render(
        OpPrimer::BorderBoxListComponent.new(
          container: :squashtm_requirement,
          padding: :condensed,
          test_selector: "squashtm--requirement-not-linked"
        )
      ) do |list|
        list.with_header(title: t(".requirement"))
        list.with_empty_state(title: t(".blankslate.heading"), description: t(".blankslate.description"), icon: :"op-logo-squashtm")
      end
    end

    if work_package_link.errors[:base].any?
      container.with_row(mb: 3) do
        render(Primer::Alpha::Banner.new(scheme: :danger, icon: :stop)) do
          work_package_link.errors.full_messages_for(:base).to_sentence
        end
      end
    end

    if can_manage_links?
      container.with_row do
        render(
          SquashTMIntegration::WorkPackageTab::LazyFrameComponent.new(
            id: SquashTMIntegration::WorkPackageTab::RequirementLinkFormComponent::TURBO_FRAME_ID,
            src: requirement_options_project_work_package_squashtm_tab_index_path(project, work_package)
          )
        )
      end
    end
  end
%>
