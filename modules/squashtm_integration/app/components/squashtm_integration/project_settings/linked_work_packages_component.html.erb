<%= render(Primer::Beta::Text.new(tag: :p, mb: 2)) { t(".linked", count:) } %>

<% if work_packages.any? %>
  <ul class="mb-2 pl-4">
    <% work_packages.each do |work_package| %>
      <li>
        <%= render(Primer::Beta::Link.new(href: work_package_path(work_package), target: "_blank", rel: "noopener noreferrer")) { "##{work_package.id} #{work_package.subject}" } %>
      </li>
    <% end %>
  </ul>
<% end %>

<% if show_remaining? %>
  <%= render(Primer::Beta::Text.new(tag: :p, color: :muted, test_selector: "squashtm-project-link--more-work-packages")) { t(".more", count: remaining_count) } %>
<% end %>
