<%=
  render(Primer::Alpha::Banner.new(scheme: :success, mb: 3, test_selector: "squashtm--linked-project")) do
    t(".linked_to_html", name: project_link_or_name)
  end
%>

<%=
  render(
    Primer::Beta::Button.new(
      tag: :a,
      scheme: :danger,
      href: destroy_dialog_project_settings_squashtm_path(@project),
      data: { controller: "async-dialog" },
      test_selector: "squashtm--delete-project-link"
    )
  ) do |button|
    button.with_leading_visual_icon(icon: :unlink)
    t(".unlink")
  end
%>
