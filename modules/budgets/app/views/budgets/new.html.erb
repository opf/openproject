<% html_title(t(:label_budget_new)) %>

<%=
  render(Primer::OpenProject::PageHeader.new) do |header|
    header.with_title { t(:label_budget_new) }
    header.with_breadcrumbs(
      [{ href: project_overview_path(@project.id), text: @project.name },
       { href: projects_budgets_path(@project.id), text: t(:label_budget_plural) },
       t(:label_budget_new)]
    )
  end
%>

<%= error_messages_for @budget %>

<%=
  primer_form_with(
    model: @budget,
    as: :budget,
    url: projects_budgets_path(@project),
    html: { multipart: true, id: "budget_form" }
  ) do |f|
    render(
      Primer::Forms::FormList.new(
        Budgets::Form.new(f),
        Budgets::MaterialBudgetItems::SubformComponent.new(form: f, budget: @budget, project: @project),
        Budgets::LaborBudgetItems::SubformComponent.new(form: f, budget: @budget, project: @project),
        Budgets::CreateOrContinue.new(f)
      )
    )
  end
%>
