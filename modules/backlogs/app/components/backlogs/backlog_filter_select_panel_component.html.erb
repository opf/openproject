<%= render(
      Primer::Alpha::SelectPanel.new(
        select_variant: :multiple,
        fetch_strategy: :local,
        title: t(".select_panel_title"),
        data: {
          controller: "backlogs--filter-select-panel",
          backlogs__filter_select_panel_filter_key_value: filter_field,
          backlogs__filter_select_panel_base_url_value: project_backlogs_backlog_path(project),
          action: "itemActivated->backlogs--filter-select-panel#refreshButtons \
                   panelClosed->backlogs--filter-select-panel#revertOnClose"
        }
      )
    ) do |panel| %>
  <% panel.with_show_button(**show_button_arguments) do |button| %>
    <% button.with_trailing_visual_counter(**counter_arguments) %>
    <% button.with_trailing_action_icon(icon: :"triangle-down", color: :default) %>
    <%= t(".label_#{filter_field_name}_filter", count:) %>
  <% end %>

  <% items.each do |item|
       panel.with_item(
         label: item.name,
         active: selected_ids&.include?(item.id) || false,
         content_arguments: { data: { value: item.id } }
       )
     end %>

  <% panel.with_footer(show_divider: true) do %>
    <%= render(
          Primer::Beta::Button.new(
            scheme: :secondary,
            type: :button,
            disabled: selected_ids.blank?,
            data: {
              action: "click->backlogs--filter-select-panel#clear",
              backlogs__filter_select_panel_target: "clearButton"
            }
          )
        ) { t(:button_clear) } %>

    <%= render(
          Primer::Beta::Button.new(
            scheme: :primary,
            type: :button,
            disabled: true,
            data: {
              action: "click->backlogs--filter-select-panel#apply",
              backlogs__filter_select_panel_target: "applyButton"
            }
          )
        ) { t(:button_apply) } %>
  <% end %>
<% end %>
