<%= render(OpPrimer::InsetBoxComponent.new(**@system_arguments)) do %>
  <%=
    render(
      Primer::Beta::Heading.new(
        tag: :h2,
        id: description_id,
        font_size: :small,
        font_weight: :bold,
        mb: 2
      )
    ) { t(".label", count: work_packages.size) }
  %>

  <% work_packages.each do |work_package| %>
    <%=
      render(
        WorkPackages::InfoLineComponent.new(
          work_package:,
          show_subject: true,
          show_status: false,
          my: 1
        )
      )
    %>
  <% end %>
<% end %>
