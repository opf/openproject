<%=
  render(
    Primer::Box.new(
      classes: "op-sprint-planning-container",
      aria: { hidden: true },
      test_selector: "op-backlogs-skeleton"
    )
  ) do
%>
  <% %i[backlog sprints].each do |column| %>
    <%= render(Primer::Box.new(classes: "op-sprint-planning-lists")) do %>
      <%=
        render(Primer::Beta::Subhead.new(hide_border: true, pb: 0)) do |head|
          head.with_heading(tag: :h3, size: :medium, font_weight: :bold, display: :inline_flex, align_items: :center) do
            render(Primer::Alpha::SkeletonBox.new(width: "120px", height: "1lh"))
          end
        end
      %>

      <%= render(Primer::OpenProject::FlexLayout.new(justify_content: :space_between, align_items: :center)) do |flex| %>
        <% flex.with_column do %>
          <%= render(Primer::Alpha::SkeletonBox.new(width: "120px", height: "32px")) %>
        <% end %>
        <% flex.with_column do %>
          <%= render(Primer::Alpha::SkeletonBox.new(width: "100px", height: "32px")) %>
        <% end %>
      <% end %>

      <% if column == :backlog %>
        <%=
          render(
            OpPrimer::BorderBoxListComponent.new(
              container: :backlogs_skeleton,
              scheme: :transparent,
              padding: :condensed,
              header_padding: :condensed,
              empty_state_behavior: :none
            )
          ) do |list|
            list.with_header(title_arguments: { font_size: 4 }) do |header|
              header.with_title { render(Primer::Alpha::SkeletonBox.new(width: "140px", height: "1lh")) }
              header.with_action_icon_button(
                icon: :"kebab-horizontal",
                scheme: :invisible,
                aria: { label: t(:label_loading) },
                classes: "v-hidden"
              )
            end
            list.with_item do
              render(Primer::Beta::Blankslate.new(spacious: true)) do |blankslate|
                with_placeholder_content(blankslate, icon: :"op-backlogs")
              end
            end
          end
        %>
      <% else %>
        <%=
          render(Primer::Beta::Blankslate.new(border: true, spacious: true)) do |blankslate|
            with_placeholder_content(blankslate, icon: :zap)
          end
        %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
