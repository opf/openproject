<%=
  widget_wrapper do |container|
    if burndown.present?
      container.with_body do
        helpers.angular_component_tag "opce-burndown-chart", "chart-data": chart_data, class: "d-block"
      end
    else
      container.with_body do
        render(Primer::Beta::Blankslate.new(spacious: true)) do |blankslate|
          blankslate.with_visual_icon(icon: :graph)
          blankslate.with_heading(tag: :h3).with_content(t("backlogs.burndown_chart.show.blankslate_title"))
          blankslate.with_description_content(t("backlogs.burndown_chart.show.blankslate_description"))
        end
      end
    end
  end
%>
