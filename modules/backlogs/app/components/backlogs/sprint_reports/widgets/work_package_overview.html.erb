<%=
  widget_wrapper do |container|
    container.with_body do
      flex_layout(align_items: :center) do |flex|
        flex.with_column(w: :full, mr: 3) do
          render(
            Primer::Beta::ProgressBar.new(
              size: :large,
              bg: :danger_emphasis
            )
          ) do |bar|
            bar.with_item(
              percentage: resolved_percentage
            # TODO: consider aria-label -> what to insert here?
            )
          end
        end

        flex.with_column(w: :fit) do
          render(Primer::Beta::Text.new) { resolved_summary_text }
        end
      end
    end
  end
%>
