<%=
  widget_wrapper do |container|
    if show_widget_content?
      container.with_body do
        concat(
          render(
            Primer::Beta::Subhead.new(hide_border: true, pt: 3, pb: 3)
          ) do |head|
            head.with_heading(
              tag: :h3,
              size: :medium,
              font_size: 4,
              font_weight: :bold,
              display: :inline_flex,
              align_items: :center,
              classes: "gap-2"
            ) do
              concat title_text
              concat(
                render(
                  Primer::Beta::Counter.new(
                    scheme: :primary,
                    count: total_work_packages_count,
                    round: true,
                    limit: 1_000,
                    hide_if_zero: true
                  )
                )
              )
            end
          end
        )

        concat(
          flex_layout(align_items: :center) do |flex|
            flex.with_column(flex: 1, mr: 3) do
              render(
                Primer::Beta::ProgressBar.new(
                  size: :large
                )
              ) do |bar|
                bar.with_item(
                  percentage: resolved_percentage,
                  aria: { label: t(".closed_work_packages") }
                )
              end
            end

            flex.with_column(mr: 3) do
              render(Primer::Beta::Text.new(tag: :div, font_size: :small)) do
                resolved_summary_text
              end
            end
          end
        )

        if breakdown_blocks.any?
          concat(
            render(Primer::Box.new(classes: "op-wp-overview--blocks", mt: 3)) do
              breakdown_blocks.each do |block|
                concat(
                  render(Primer::Box.new) do
                    safe_join(
                      [
                        flex_layout(align_items: :center) do |flex|
                          flex.with_column(mr: 3) do
                            render(Primer::Beta::Text.new(tag: :h4, font_weight: :bold)) { block[:heading] }
                          end
                          flex.with_column do
                            render(Primer::Beta::Link.new(href: block[:show_all_path], data: { turbo: false })) do
                              t(".blocks.show_all")
                            end
                          end
                        end,
                        render(Primer::Beta::Text.new(tag: :p, mb: 0, font_size: 1, font_weight: :bold, color: block[:count_color])) do
                          prefix = block[:count_prefix] && block[:count].positive? ? "+" : ""

                          "#{prefix}#{block[:count]}"
                        end,
                        render(Primer::Beta::Text.new(tag: :p, color: :muted, mb: 2)) do
                          t("backlogs.story_points", count: block[:story_points])
                        end
                      ]
                    )
                  end
                )
              end
            end
          )
        end
      end
    else
      container.with_body do
        render(Primer::Beta::Blankslate.new(spacious: true)) do |blankslate|
          blankslate.with_visual_icon(icon: :"op-work-packages")
          blankslate.with_heading(tag: :h3).with_content(t(".blankslate.heading"))
          blankslate.with_description_content(t(".blankslate.description"))
        end
      end
    end
  end
%>
