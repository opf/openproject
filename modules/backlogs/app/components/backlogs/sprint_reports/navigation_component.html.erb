<%= render(Primer::Box.new(classes: "op-sprint-report-navigation", display: :flex, mb: 3, test_selector: "sprint-report-navigation")) do %>
  <% if previous_sprint %>
    <%= render(Primer::Box.new(classes: "op-sprint-report-navigation--item", display: :flex, direction: :column, align_items: :flex_start)) do %>
      <%= render(
            Primer::Beta::Button.new(
              tag: :a,
              href: project_backlogs_sprint_report_path(@project, previous_sprint),
              test_selector: "sprint-report-previous",
              scheme: :invisible
            )
          ) do |button| %>
        <% button.with_leading_visual_icon(icon: :"chevron-left") %>
        <%= t(".previous") %>
      <% end %>
      <%= render(Primer::Beta::Text.new(color: :muted, pl: 3, mt: 2, test_selector: "sprint-report-previous-name")) do %>
        <%= previous_sprint.name %>
      <% end %>
    <% end %>
  <% end %>

  <% if next_sprint %>
    <%= render(Primer::Box.new(classes: "op-sprint-report-navigation--item", display: :flex, direction: :column, align_items: :flex_end, ml: :auto)) do %>
      <%= render(
            Primer::Beta::Button.new(
              tag: :a,
              href: project_backlogs_sprint_report_path(@project, next_sprint),
              test_selector: "sprint-report-next",
              scheme: :invisible
            )
          ) do |button| %>
        <% button.with_trailing_visual_icon(icon: :"chevron-right") %>
        <%= t(".next") %>
      <% end %>
      <%= render(Primer::Beta::Text.new(color: :muted, text_align: :right, pr: 3, mt: 2, test_selector: "sprint-report-next-name")) do %>
        <%= next_sprint.name %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
