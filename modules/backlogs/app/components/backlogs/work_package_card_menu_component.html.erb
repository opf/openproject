<%=
  render(Primer::Alpha::ActionMenu::List.new(menu_id:)) do |list|
    list.with_group(data: { sortable_lists__item_target: "invokerGroup" }) do |group|
      group.with_item(
        id: dom_target(work_package, :menu, :open_details),
        label: t(:"js.button_open_details"),
        content_arguments: {
          tag: :a,
          href: project_backlogs_backlog_details_path(project, work_package),
          tabindex: -1,
          data: { action: "backlogs--work-package#openSplitPane:prevent" }
        }
      ) do |item|
        item.with_leading_visual_icon(icon: :"op-view-split")
      end

      group.with_item(
        id: dom_target(work_package, :menu, :open_fullscreen),
        label: t(:"js.button_open_fullscreen"),
        content_arguments: {
          tag: :a,
          href: work_package_path(work_package),
          tabindex: -1,
          data: { turbo_frame: "_top" }
        }
      ) do |item|
        item.with_leading_visual_icon(icon: :"screen-full")
      end

      group.with_item(
        id: dom_target(work_package, :menu, :copy_url_to_clipboard),
        label: t(".action_menu.copy_url_to_clipboard"),
        content_arguments: { tag: :"clipboard-copy", value: work_package_url(work_package), tabindex: -1 }
      ) do |item|
        item.with_leading_visual_icon(icon: :copy)
      end

      group.with_item(
        id: dom_target(work_package, :menu, :copy_work_package_id),
        label: t(".action_menu.copy_work_package_id"),
        content_arguments: { tag: :"clipboard-copy", value: work_package.display_id, tabindex: -1 }
      ) do |item|
        item.with_leading_visual_icon(icon: :hash)
      end
    end

    if show_move_submenu?
      list.with_divider(data: { sortable_lists__item_target: "groupDivider" })

      list.with_group(data: { sortable_lists__item_target: "batchGroup" }) do |group|
        if show_move_to_inbox?
          group.with_item(
            id: dom_target(work_package, :menu, :move_to_inbox),
            label: t(".action_menu.move_to_inbox"),
            data: destination_data(inbox_list_type, []).merge(
              action: "click->sortable-lists--item#moveToDestination:prevent"
            ),
            content_arguments: { tabindex: -1 }
          ) do |item|
            item.with_leading_visual_icon(icon: :inbox)
          end
        end

        if show_move_to_backlog_bucket?
          group.with_item(
            id: dom_target(work_package, :menu, :move_to_backlog_bucket),
            label: t(".action_menu.move_to_backlog_bucket"),
            href: move_to_bucket_dialog_project_backlogs_work_packages_path(project),
            form_arguments: { method: :post },
            content_arguments: {
              tabindex: -1,
              data: {
                controller: "async-dialog",
                action: "async-dialog:beforeLoad->sortable-lists--item#prepareDialog"
              }
            },
            data: destination_data(bucket_list_type, bucket_ids)
          ) do |item|
            item.with_leading_visual_icon(icon: :package)
          end
        end

        if show_move_to_sprint?
          group.with_item(
            id: dom_target(work_package, :menu, :move_to_sprint),
            label: t(".action_menu.move_to_sprint"),
            href: move_to_sprint_dialog_project_backlogs_work_packages_path(project),
            form_arguments: { method: :post },
            content_arguments: {
              tabindex: -1,
              data: {
                controller: "async-dialog",
                action: "async-dialog:beforeLoad->sortable-lists--item#prepareDialog"
              }
            },
            data: destination_data(sprint_list_type, sprint_ids)
          ) do |item|
            item.with_leading_visual_icon(icon: :zap)
          end
        end

        if show_move_items?
          group.with_item(
            component_klass: Primer::Alpha::ActionMenu::SubMenuItem,
            label: t(".action_menu.move_menu"),
            select_variant: :none,
            form_arguments: {},
            content_arguments: { tabindex: -1 },
            data: { sortable_lists__item_target: "moveMenu" }
          ) do |move_menu|
            move_menu.with_leading_visual_icon(icon: :"op-arrow-in")

            move_menu_items.render_into(move_menu)
          end
        end
      end
    end
  end
%>
