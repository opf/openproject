<% if setting_available? %>
  <% if too_many_active_sprints? %>
    <%=
      flex_layout(mb: 3, color: :attention) do |flex|
        flex.with_column do
          render(Primer::Beta::Octicon.new(mr: 2, icon: :alert))
        end
        flex.with_column do
          render(Primer::Beta::Text.new) do
            t(".cannot_turn_off")
          end
        end
      end
    %>
  <% end %>

  <%=
    render(
      Primer::Forms::ToggleSwitchForm.new(
        name: :allow_multiple_active_sprints,
        label: Project.human_attribute_name(:allow_multiple_active_sprints),
        src: toggle_multiple_active_sprints_project_settings_backlog_multiple_active_sprints_path(project),
        csrf_token: form_authenticity_token,
        status_label_position: :start,
        checked: checked?,
        enabled: enabled?,
        data: { turbo: true },
        mb: 3
      )
    )
  %>
<% else %>
  <%=
    flex_layout(mb: 3) do |flex|
      flex.with_column do
        render(Primer::Beta::Octicon.new(mr: 2, icon: :alert))
      end
      flex.with_column do
        render(Primer::Beta::Text.new) do
          t(".not_available_html", sprint_sharing_url: project_settings_backlog_sharing_path(project))
        end
      end
    end
  %>
<% end %>
