<%# Attributes on this frame tag are ignored; only its children are reconciled — set them in show.html.erb. %>
<%= turbo_frame_tag "backlogs_container" do %>
  <div class="op-sprint-planning-container">
    <div id="owner_backlogs_container" class="op-sprint-planning-lists" data-controller="sortable-lists--scrollable">
      <%=
        render Backlogs::BacklogComponent.new(
          buckets: @backlog_buckets,
          work_packages_by_backlog_id: @work_packages_by_backlog_id,
          project: @project
        )
      %>
    </div>
    <div id="sprint_backlogs_container" class="op-sprint-planning-lists" data-controller="sortable-lists--scrollable">
      <%=
        render Backlogs::SprintsComponent.new(
          sprints: @sprints,
          project: @project,
          work_packages_by_sprint_id: @work_packages_by_sprint_id,
          active_sprints: @active_sprints
        )
      %>
    </div>
  </div>
<% end %>
