<% html_title t(:label_administration), t(:label_github_integration), t(:label_deploy_target_new) %>

<%=
  render(Primer::OpenProject::PageHeader.new) do |header|
    header.with_title { t(:label_deploy_target_new) }
    header.with_breadcrumbs(
      [{ href: admin_index_path, text: t("label_administration") },
       { href: deploy_targets_path, text: t(:label_github_integration) },
       t(:label_deploy_target_new)]
    )
  end
%>

<%=
  settings_primer_form_with(model: @deploy_target, url: deploy_targets_path) do |f|
    render_inline_settings_form(f) do |form|
      form.object.text_field(
        name: :host,
        label: t("attributes.host"),
        value: @deploy_target.host,
        disabled: false,
        required: true,
        input_width: :medium
      )

      form.select_list(
        name: :type,
        label: t("attributes.type"),
        required: true,
        disabled: true,
        input_width: :small,
        caption: t(:text_deploy_target_type_info)
      ) do |list|
        list.option(value: "OpenProject", label: "OpenProject", selected: true)
      end

      # This field is specific to the only type of DeployTarget we support for now, which is OpenProject.
      form.object.text_field(
        name: :api_key,
        label: t("attributes.api_key"),
        value: @deploy_target.api_key,
        disabled: false,
        required: true,
        input_width: :large,
        caption: link_translate(
          :text_deploy_target_api_key_info,
          links: { docs_url: %i[api authentication_basic_auth] }
        )
      )

      form.submit(label: I18n.t(:button_save))
    end
  end
%>
