<% html_title t(:label_administration), t("screens.schemes.plural"), t("screens.confirm.title") %>
<%=
  render Primer::OpenProject::PageHeader.new do |header|
    header.with_title { t("screens.confirm.title") }
    header.with_breadcrumbs([{ href: admin_index_path, text: t(:label_administration) },
                             { href: admin_screen_schemes_path, text: t("screens.schemes.plural") },
                             { href: edit_admin_screen_scheme_path(@scheme), text: @scheme.name },
                             t("screens.confirm.title")])
  end
%>
<%= render(Primer::Beta::Flash.new(scheme: :warning, mb: 3)) do %>
  <%= t("field_rules.confirm.scheme_in_use", count: @impact[:project_count]) %>
<% end %>
<%= form_tag admin_screen_scheme_path(@scheme), method: :patch do %>
  <%= hidden_field_tag :confirm, "1" %>
  <%= hidden_field_tag "scheme[name]", @scheme_params[:name], id: nil %>
  <%= hidden_field_tag "scheme[description]", @scheme_params[:description], id: nil %>
  <% (@scheme_params[:types] || {}).to_h.each do |type_id, row| %>
    <% next unless row.respond_to?(:each_pair) %>
    <% row.each do |slot, value| %>
      <%= hidden_field_tag "scheme[types][#{type_id}][#{slot}]", value, id: nil %>
    <% end %>
  <% end %>
  <div class="form--field">
    <%= render(Primer::Beta::Button.new(scheme: :primary, type: :submit)) { t(:button_confirm) } %>
    <%= render(Primer::Beta::Button.new(tag: :a, href: admin_screen_schemes_path, scheme: :invisible)) { t(:button_cancel) } %>
  </div>
<% end %>
