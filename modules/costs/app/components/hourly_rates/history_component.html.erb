<%= flex_layout do |flex| %>
  <% flex.with_row(mb: 3) do %>
    <%= render(Primer::OpenProject::CollapsibleSection.new(test_selector: "rate-history-default", collapsed: true)) do |section| %>
      <% section.with_title { User.human_attribute_name(:default_rates) } %>
      <% section.with_caption { default_caption } if default_caption %>
      <% section.with_collapsible_content do %>
        <%= render(HourlyRates::TableComponent.new(rows: default_rates, current_rate: current_default_rate)) %>
      <% end %>
    <% end %>
  <% end %>

  <% project_rates.each do |project, rates| %>
    <% caption = project_caption(project) %>
    <% flex.with_row(mb: 3) do %>
      <%= render(Primer::OpenProject::CollapsibleSection.new(test_selector: "rate-history-project-#{project.id}", collapsed: true)) do |section| %>
        <% section.with_title { project.name } %>
        <% section.with_caption { caption } if caption %>
        <% section.with_collapsible_content do %>
          <%= render(HourlyRates::TableComponent.new(rows: rates, current_rate: current_rate_for(project))) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
