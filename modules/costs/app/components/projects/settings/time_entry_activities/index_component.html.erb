<%= render(
      OpPrimer::BorderBoxListComponent.new(
        container: "project-time-entry-activities"
      )
    ) do |list| %>
  <% list.with_header(title: TimeEntryActivity.model_name.human(count: 2)) %>

  <% activities.each do |activity| %>
    <% list.with_item do %>
      <%=
        flex_layout(
          align_items: :center, justify_content: :space_between,
          classes: "op-project-time-entry-activity",
          data: { test_selector: "project-time-entry-activity-#{activity.id}" }
        ) do |row|
          row.with_column(flex: 1) do
            if User.current.admin?
              render(
                Primer::Beta::Link.new(font_weight: :bold, href: edit_admin_settings_time_entry_activity_path(activity))
              ) { activity.name }
            else
              render(Primer::Beta::Text.new) { activity.name }
            end
          end

          row.with_column(py: 1, mr: 2) do
            render(
              Primer::Alpha::ToggleSwitch.new(
                src: toggle_path(activity),
                csrf_token: form_authenticity_token,
                data: toggle_data_attributes(activity),
                checked: toggle_checked?(activity),
                size: :small,
                status_label_position: :start,
                classes: "op-primer-adjustments__toggle-switch--hidden-loading-indicator"
              )
            )
          end
        end
      %>
    <% end %>
  <% end %>

  <% list.with_empty_state(
       title: I18n.t("cost_types.settings.time_entry_activities.heading"),
       description: I18n.t("projects.settings.activities.no_results_title_text"),
       icon: :checklist
     ) %>
<% end %>
