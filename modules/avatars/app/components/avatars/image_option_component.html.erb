<%= file_field_tag :file,
                   id: "avatar_file_input",
                   accept: "image/jpeg,image/png,image/gif",
                   class: "sr-only",
                   aria: { label: t(:label_choose_avatar) },
                   data: { "avatars--settings-target": "file", action: "change->avatars--settings#upload" } %>
<%= render(Primer::Beta::Button.new(type: :button, data: { action: "avatars--settings#chooseImage" })) { t(:label_choose_avatar) } %>
<%= render(Primer::Beta::Text.new(tag: :p, color: :muted, mt: 2, font_size: :small)) { t("avatars.image_hint") } %>
<p class="avatars--error-pane" role="alert" data-avatars--settings-target="uploadError" hidden><%= t(:wrong_file_format) %></p>
<% if helpers.local_avatar?(@principal) %>
  <%= render(
        Primer::Beta::Button.new(
          tag: :a,
          href: @target_avatar_path,
          scheme: :danger,
          test_selector: "avatar-delete-link",
          data: { turbo: true, turbo_method: :delete, turbo_confirm: t(:are_you_sure_delete_avatar) }
        )
      ) { t("avatars.delete_image") } %>
<% end %>
