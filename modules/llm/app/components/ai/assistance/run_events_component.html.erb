<%= render(Primer::Beta::Details.new(mt: 2, data: { test_selector: "ai-assistance-run-events" })) do |details| %>
  <% details.with_summary(button: false, color: :muted, font_size: :small) do %>
    <%= t("ai_assistance.events.title") %>
  <% end %>
  <% details.with_body do %>
    <div class="mt-2">
      <% events.each do |event| %>
        <%= render(Primer::Beta::TimelineItem.new(condensed: true)) do |item| %>
          <% item.with_badge(icon: icon(event)) %>
          <% item.with_body do %>
            <%= render(Primer::Beta::Text.new(color: :muted, font_size: :small, mr: 2)) { time(event) } %>
            <%= render(Primer::Beta::Text.new(font_size: :small)) { summary(event) } %>
            <% blocks(event).each do |label, text| %>
              <%= render(Primer::Beta::Details.new(mt: 1)) do |block| %>
                <% block.with_summary(button: false) do %>
                  <%= render(Primer::Beta::Text.new(color: :accent, font_size: :small)) { t("ai_assistance.events.show", what: label) } %>
                <% end %>
                <% block.with_body do %>
                  <pre class="mt-1 p-2 color-bg-subtle rounded-2 overflow-auto" style="white-space: pre-wrap; max-height: 24rem;"><%= text %></pre>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>
<% end %>
