<%= component_wrapper(**wrapper_data_attrs) do %>
  <%= render(Primer::Box.new(mt: 3)) do %>
    <%= render(Primer::Box.new(display: :flex, align_items: :center, mb: 2)) do %>
      <%= render(Primer::Box.new(display: :flex, mr: 2, test_selector: "reindex-state-#{state}")) do %>
        <% case state %>
        <% when :running %>
          <%= render(Primer::Beta::Spinner.new(size: :small, "aria-label": t("admin.work_package_embeddings.status.state.running"))) %>
        <% when :succeeded %>
          <%= render(Primer::Beta::Octicon.new(icon: :"check-circle-fill", color: :success, "aria-label": t("admin.work_package_embeddings.status.state.succeeded"))) %>
        <% when :failed %>
          <%= render(Primer::Beta::Octicon.new(icon: :"x-circle-fill", color: :danger, "aria-label": t("admin.work_package_embeddings.status.state.failed"))) %>
        <% end %>
      <% end %>

      <%= render(Primer::Beta::ProgressBar.new(flex: 1)) { |bar| bar.with_item(percentage:, bg: progress_color) } %>
    <% end %>

    <% if failed_count.positive? %>
      <%= render(Primer::Alpha::Banner.new(scheme: :danger, mb: 2, icon: :alert)) do %>
        <%= t("admin.work_package_embeddings.status.failed", count: failed_count) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
