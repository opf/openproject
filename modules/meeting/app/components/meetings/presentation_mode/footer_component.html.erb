<%= component_wrapper(
      class: "op-meeting-presentation--footer",
      data: { "test-selector": "meeting-presentation-footer" }
    ) do %>
  <div class="op-meeting-presentation--footer-left">
    <%= render(
          Primer::Box.new(display: :flex, align_items: :center, justify_content: :flex_start)
        ) do %>
      <%= render(
            Primer::Beta::Button.new(
              tag: :a,
              scheme: :link,
              color: has_previous? ? :default : :subtle,
              underline: false,
              href: navigation_path("previous"),
              data: { "meetings--presentation-target": "previousButton" },
              disabled: !has_previous?
            )
          ) do |button| %>
        <% button.with_leading_visual_icon(icon: :"chevron-left") %>
        <%= t("meeting.presentation_mode.previous") %>
      <% end %>
      <% if previous_presenter %>
        <%= render(
              Users::AvatarComponent.new(
                user: previous_presenter,
                show_name: false,
                link: false,
                size: "mini",
                classes: "op-principal_flex ml-2",
                hover_card: { active: false }
              )
            ) %>
      <% end %>
    <% end %>
    <% if previous_slide? %>
      <div class="op-meeting-presentation--footer-agenda-item">
        <%= render(Primer::Beta::Text.new(font_weight: :bold, color: :subtle)) { current_item.display_title } %>:
        <%= render(Primer::Beta::Text.new(color: :subtle)) { slide_text(@current_slide - 1) } %>
      </div>
    <% elsif previous_item %>
      <div class="op-meeting-presentation--footer-agenda-item">
        <% if previous_item.meeting_section != current_section %>
          <%= render(Primer::Beta::Text.new(font_weight: :bold, color: :subtle)) { previous_item.meeting_section.title.presence || t("meeting_section.untitled_title") } %>:
        <% end %>
        <%= render(Primer::Beta::Text.new(color: :subtle)) { previous_item.display_title } %>
      </div>
    <% end %>
  </div>

  <div class="op-meeting-presentation--progress">
    <div class="op-meeting-presentation--progress-text">
      <%= progress_text %>
      <% if slide_progress_text %>
        &middot;
        <%= render(Primer::Beta::Text.new(color: :subtle, font_weight: :normal, test_selector: "meeting-presentation-slide-progress")) { slide_progress_text } %>
      <% end %>
    </div>
    <div class="op-meeting-presentation--timer">
      <%= running_time %>
    </div>
  </div>

  <div class="op-meeting-presentation--footer-right">
    <%= render(
          Primer::Box.new(display: :flex, align_items: :center, justify_content: :flex_end)
        ) do %>
      <% if next_presenter %>
        <%= render(
              Users::AvatarComponent.new(
                user: next_presenter,
                show_name: false,
                link: false,
                size: "mini",
                classes: "op-principal_flex mr-2",
                hover_card: { active: false }
              )
            ) %>
      <% end %>
      <%= render(
            Primer::Beta::Button.new(
              tag: :a,
              scheme: :link,
              color: :default,
              underline: false,
              href: navigation_path("next"),
              data: { "meetings--presentation-target": "nextButton" },
              disabled: !has_next?
            )
          ) do |button| %>
        <%= t("meeting.presentation_mode.next") %>
        <% button.with_trailing_visual_icon(icon: :"chevron-right") %>
      <% end %>
    <% end %>
    <div class="op-meeting-presentation--footer-agenda-item">
      <% if next_slide? %>
        <%= render(Primer::Beta::Text.new(font_weight: :bold, color: :subtle)) { current_item.display_title } %>:
        <%= render(Primer::Beta::Text.new(color: :subtle)) { slide_text(@current_slide + 1) } %>
      <% elsif next_item %>
        <% if next_item.meeting_section != current_section %>
          <%= render(Primer::Beta::Text.new(font_weight: :bold, color: :subtle)) { next_item.meeting_section.title.presence || t("meeting_section.untitled_title") } %>:
        <% end %>
        <%= render(Primer::Beta::Text.new(color: :subtle)) { next_item.display_title } %>
      <% end %>
    </div>
  </div>
<% end %>
