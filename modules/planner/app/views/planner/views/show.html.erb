<% html_title(@view.title, t("label_planner")) -%>

<%=
  render(Primer::OpenProject::PageHeader.new) do |header|
    header.with_title { @view.title }
    header.with_description { t("planner.description") }
    header.with_breadcrumbs([{ href: planner_path, text: t("label_planner") }, @view.title])
  end
%>

<% if @component.add_todo_defaults || @view.filterable? %>
  <%=
    render(Primer::OpenProject::SubHeader.new) do |subheader|
      if @view.filterable?
        subheader.with_quick_filter do
          render(Planner::FilterMenuComponent.new(view: @view.name, filter: @component.filter))
        end
      end

      if @component.add_todo_defaults
        subheader.with_action_button(
          scheme: :primary,
          leading_icon: :plus,
          label: t("planner.add_todo"),
          tag: :a,
          href: new_dialog_planner_tasks_path(view: @view.name, **@component.add_todo_defaults),
          data: { controller: "async-dialog" }
        ) do
          t("planner.add_todo")
        end
      end
    end
  %>
<% end %>

<%= render(@component) %>
