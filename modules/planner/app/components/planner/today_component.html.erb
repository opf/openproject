<%= component_wrapper(data: { test_selector: "planner-today" }) do %>
  <%= render(Primer::Beta::Text.new(tag: :p, color: :muted, test_selector: "planner-summary")) { summary } %>

  <%= form_with(url: planner_tasks_path, scope: :task, method: :post, class: "mt-2", data: { test_selector: "planner-quick-add" }) do %>
    <%= flex_layout(align_items: :center) do |row| %>
      <% row.with_column(flex: 1, mr: 2) do %>
        <%= render(Primer::Alpha::TextField.new(**subject_field_arguments)) %>
      <% end %>
      <% row.with_column(mr: 2) do %>
        <div data-controller="filter--segmented-control" data-action="itemActivated->filter--segmented-control#activate">
          <%= hidden_field_tag "task[day_part]", today.current_day_part, id: nil, data: { "filter--segmented-control-target": "field" } %>
          <%= render(Primer::Alpha::SegmentedControl.new("aria-label": t("planner.day_part.name"), size: :small)) do |control| %>
            <% Planner::DayPartField::DAY_PARTS.each do |day_part| %>
              <% control.with_item(label: t("planner.day_part.#{day_part}"), selected: day_part == today.current_day_part, data: { value: day_part }) %>
            <% end %>
          <% end %>
        </div>
      <% end %>
      <% row.with_column do %>
        <%= render(Primer::Beta::Button.new(type: :submit, scheme: :primary, size: :small)) { t("planner.quick_add.submit") } %>
      <% end %>
    <% end %>
  <% end %>

  <% today.sections.each do |section| %>
    <% scheme = COLOR_SCHEMES.fetch(section.day_part) %>
    <%= render(Primer::Box.new(mt: 3, test_selector: "planner-section-#{section.day_part}")) do %>
      <%= flex_layout(align_items: :center, px: 2, pb: 1, border: :bottom, border_color: :"#{scheme}_emphasis") do |header| %>
        <% header.with_column(mr: 2) do %>
          <%= render(Primer::Beta::Heading.new(tag: :h3, font_size: 5)) { t("planner.day_part.#{section.day_part}") } %>
        <% end %>
        <% header.with_column(mr: 2) do %>
          <%= render(Primer::Beta::Text.new(color: :muted, font_size: :small)) { t("planner.time_range.#{section.day_part}") } %>
        <% end %>
        <% if today.now?(section.day_part) %>
          <% header.with_column do %>
            <%= render(Primer::Beta::Label.new(scheme:, test_selector: "planner-now")) { t("planner.now") } %>
          <% end %>
        <% end %>
        <% header.with_column(ml: :auto) do %>
          <%= render(Primer::Beta::Text.new(color: :muted, font_size: :small)) { counts(section) } %>
        <% end %>
      <% end %>

      <% section.meetings.each do |meeting| %>
        <%= render(Primer::Box.new(**row_arguments(section.day_part, bg: :subtle, test_selector: "planner-meeting-#{section.day_part}"))) do %>
          <%= render(Planner::MeetingRowComponent.new(meeting:, user: today.user, scheme:, lead_width:)) %>
        <% end %>
      <% end %>

      <% section.work_packages.each do |work_package| %>
        <%= render(Primer::Box.new(**row_arguments(section.day_part, test_selector: "planner-task-#{section.day_part}"))) do %>
          <%= render(Planner::TaskRowComponent.new(work_package:, lead_width:, references: today.references, day_part: section.day_part)) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
