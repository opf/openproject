<%= render(Primer::Beta::Details.new(open:, reset: true, test_selector: "planner-add-todo-#{group}")) do |details| %>
  <% details.with_summary(button: false, color: :muted, font_size: :small) do %>
    <%= render(Primer::Beta::Octicon.new(:plus, mr: 1)) %><%= t("planner.add_todo") %>
  <% end %>
  <% details.with_body(mt: 2) do %>
    <%= form_with(url: planner_tasks_path, scope: :task, method: :post) do %>
      <%= hidden_field_tag :adding, group, id: nil %>
      <% if view_param %>
        <%= hidden_field_tag :view, view_param, id: nil %>
      <% end %>
      <% task_fields.each do |name, value| %>
        <%= hidden_field_tag "task[#{name}]", value, id: nil %>
      <% end %>
      <%= flex_layout(align_items: :center) do |row| %>
        <% row.with_column(flex: 1, mr: 2) do %>
          <%= render(Primer::Alpha::TextField.new(**subject_field_arguments)) %>
        <% end %>
        <% row.with_column do %>
          <%= render(Primer::Beta::Button.new(type: :submit, scheme: :primary, size: :small)) { t("planner.quick_add.submit") } %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
