<%= flex_layout(align_items: :center) do |row| %>
  <% row.with_column(mr: 3, text_align: :right, font_family: :mono, font_size: :small, style: "width: #{lead_width}; flex-shrink: 0") do %>
    <%= render(Primer::Beta::Text.new(font_weight: :bold, color: scheme)) { start_time } %><%= render(Primer::Beta::Text.new(color: :muted)) { "–#{end_time}" } %>
  <% end %>
  <% row.with_column(flex: 1, mr: 3, classes: "min-width-0") do %>
    <%= render(Primer::Beta::Truncate.new) do %>
      <%= render(Primer::Beta::Link.new(href: meeting_path(meeting), scheme: :primary, font_weight: :semibold)) { meeting.title } %>
      <%= render(Primer::Beta::Text.new(color: :muted, font_size: :small, ml: 1, test_selector: "planner-meeting-duration")) { "· #{duration}" } %>
      <% if starts_in %>
        <%= render(Primer::Beta::Text.new(color: :danger, font_size: :small, font_weight: :semibold, ml: 2)) { starts_in } %>
      <% end %>
    <% end %>
  <% end %>
  <% row.with_column(mr: 2, flex_shrink: 0) do %>
    <%= render(Primer::Beta::Label.new(scheme: :secondary)) { kind } %>
  <% end %>
  <% if participants.any? %>
    <% row.with_column(mr: 2, flex_shrink: 0, test_selector: "planner-meeting-participants") do %>
      <%= render(Primer::OpenProject::AvatarStack.new(**avatar_stack_arguments)) do |stack| %>
        <% shown_participants.each { |participant| stack.with_avatar_with_fallback(**avatar_options(participant)) } %>
      <% end %>
    <% end %>
    <% if hidden_participants_count.positive? %>
      <% row.with_column(mr: 2, flex_shrink: 0) do %>
        <%= render(Primer::Beta::Text.new(color: :muted, font_size: :small)) { "+#{hidden_participants_count}" } %>
      <% end %>
    <% end %>
  <% end %>
  <% row.with_column(flex_shrink: 0) do %>
    <%= render(Primer::Beta::Button.new(tag: :a, href: meeting_path(meeting), scheme: :invisible, size: :small)) { t("planner.agenda") } %>
  <% end %>
<% end %>
