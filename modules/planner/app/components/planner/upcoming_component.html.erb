<%= component_wrapper(data: { test_selector: "planner-upcoming", **sortable_root_data(:upcoming) }) do %>
  <% upcoming.days.each do |day| %>
    <% group = day.date.iso8601 %>
    <%= render(Primer::Beta::BorderBox.new(**day_box_arguments(day))) do |box| %>
      <% box.with_header(px: 3, py: 3) do %>
        <%= render(Planner::SectionHeaderComponent.new(title: day_name(day.date), subtitle: subtitle(day), counts: counts(day))) %>
      <% end %>

      <% day.meetings.each do |occurrence| %>
        <% box.with_row(test_selector: "planner-upcoming-meeting") do %>
          <%= render(Planner::MeetingRowComponent.new(occurrence:, user: upcoming.user)) %>
        <% end %>
      <% end %>

      <% day.work_packages.each do |work_package| %>
        <% box.with_row(test_selector: "planner-upcoming-task", data: sortable_item_data(work_package)) do %>
          <%= render(Planner::TaskRowComponent.new(work_package:, references: upcoming.references, view: :upcoming)) %>
        <% end %>
      <% end %>

      <% box.with_row(px: 3) do %>
        <%= render(Planner::AddTodoComponent.new(group:, view: :upcoming, open: adding?(group), task_fields: { date: group })) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
