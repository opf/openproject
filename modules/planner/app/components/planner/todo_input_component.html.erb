<%= form_with(url: planner_tasks_path, scope: :task, method: :post, data: { test_selector: "planner-todo-input-#{group}" }) do %>
  <%= hidden_field_tag :adding, group, id: nil %>
  <% if view_param %>
    <%= hidden_field_tag :view, view_param, id: nil %>
  <% end %>
  <% task_fields.each do |name, value| %>
    <%= hidden_field_tag "task[#{name}]", value, id: nil %>
  <% end %>
  <%= flex_layout(align_items: :center) do |row| %>
    <% if handle_space? %>
      <% row.with_column(mr: 2, flex_shrink: 0, display: :flex, style: "visibility: hidden") do %>
        <%= render(Primer::Beta::Octicon.new(:grabber)) %>
      <% end %>
    <% end %>
    <% row.with_column(flex: 1, mr: 2) do %>
      <%= render(Primer::Alpha::TextField.new(**subject_field_arguments)) %>
    <% end %>
    <% row.with_column(mr: 2) do %>
      <%= render(Primer::Beta::Button.new(type: :submit, scheme: :primary)) { t("planner.quick_add.submit") } %>
    <% end %>
    <% row.with_column do %>
      <%= render(Primer::Beta::Button.new(tag: :a, href: cancel_path, data: { turbo_stream: true }, test_selector: "planner-todo-input-cancel")) { t(:button_cancel) } %>
    <% end %>
  <% end %>
<% end %>
