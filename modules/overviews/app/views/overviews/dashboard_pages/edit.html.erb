<% editing = !@dashboard&.new_record? %>
<% title = editing ? t("overviews.dashboards.configure") : t("overviews.dashboards.new") %>
<% html_title(title) %>
<%= render(Primer::OpenProject::PageHeader.new) do |header| %>
  <% header.with_title { title } %>
  <% header.with_breadcrumbs(
       [
         { href: project_overview_path(@project), text: @project.name },
         *(editing ? [{ href: settings_project_dashboard_pages_path(@project), text: t("overviews.dashboards.title") }] : []),
         title
       ]
     ) %>
<% end %>

<% unless editing %>
  <%= primer_form_with(model: @dashboard, scope: :dashboard_page, url: project_dashboard_pages_path(@project)) do |form| %>
    <%= render(Overviews::DashboardNameForm.new(form)) %>
    <%= render(Primer::Beta::Button.new(type: :submit, scheme: :primary)) { t(:button_save) } %>
  <% end %>
<% end %>

<% if editing %>
  <%= render(Overviews::DashboardComponent.new(project: @project, current_user:, dashboard: @dashboard, configuration: true)) %>
<% end %>
