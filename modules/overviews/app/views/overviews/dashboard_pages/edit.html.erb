<% title = @dashboard.persisted? ? t("overviews.dashboards.configure") : t("overviews.dashboards.new") %>
<% html_title(title) %>
<%= render(Primer::OpenProject::PageHeader.new) do |header| %>
  <% header.with_title { title } %>
  <% header.with_breadcrumbs([{ href: project_overview_path(@project), text: @project.name }, title]) %>
<% end %>

<% action = @dashboard.persisted? ? project_dashboard_page_path(@project, @dashboard) : project_dashboard_pages_path(@project) %>
<%= form_with model: @dashboard, scope: :dashboard_page, url: action do |form| %>
  <%= render "overviews/dashboard_pages/name_field", form:, dashboard: @dashboard %>
  <%= render(Primer::Beta::Button.new(type: :submit, scheme: :primary)) { t(:button_save) } %>
<% end %>

<% if @dashboard.persisted? %>
  <%= render(Overviews::DashboardComponent.new(project: @project, current_user:, dashboard: @dashboard, configuration: true)) %>
<% end %>
