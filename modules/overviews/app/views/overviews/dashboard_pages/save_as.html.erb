<% html_title(t(:button_save_as)) %>
<%= render(Primer::OpenProject::PageHeader.new) do |header| %>
  <% header.with_title { t(:button_save_as) } %>
  <% header.with_breadcrumbs([{ href: project_overview_path(@project), text: @project.name }, t(:button_save_as)]) %>
<% end %>

<%= primer_form_with(model: @copy, scope: :dashboard_page, url: action, method: :post) do |form| %>
  <%= error_messages_for(@copy) %>
  <%= render(Overviews::DashboardNameForm.new(form)) %>
  <%= render(Overviews::DashboardCopyForm.new(form, projects: @target_projects)) %>
  <%= render(Primer::Beta::Button.new(type: :submit, scheme: :primary)) { t(:button_save) } %>
<% end %>
