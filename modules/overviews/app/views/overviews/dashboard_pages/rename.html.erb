<% title = t("overviews.dashboards.rename") %>
<% html_title(title) %>
<%= render(Primer::OpenProject::PageHeader.new) do |header| %>
  <% header.with_title { title } %>
  <% header.with_breadcrumbs([{ href: project_overview_path(@project), text: @project.name }, title]) %>
<% end %>

<%= primer_form_with(model: @dashboard, scope: :dashboard_page, url: action) do |form| %>
  <%= render(Overviews::DashboardNameForm.new(form)) %>
  <%= render(Primer::Beta::Button.new(type: :submit, scheme: :primary)) { t(:button_rename) } %>
<% end %>
