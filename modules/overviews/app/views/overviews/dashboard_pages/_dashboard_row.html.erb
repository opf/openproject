<tr>
  <td>
    <%= name %>
    <% if badge %>
      <%= render(Primer::Beta::Label.new(scheme: :secondary, ml: 2)) { badge } %>
    <% end %>
  </td>
  <td><%= t(active ? "overviews.dashboards.active" : "overviews.dashboards.inactive") %></td>
  <td>
    <% if !active && activate_path %>
      <%= form_with url: activate_path, method: :patch do %>
        <%= render(Primer::Beta::Button.new(type: :submit)) { t("overviews.dashboards.activate") } %>
      <% end %>
    <% end %>
  </td>
</tr>
