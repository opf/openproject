<%= render "admin/dashboard_pages/header", active_tab: :projects %>

<%= primer_form_with(
      model: @dashboard,
      scope: :dashboard_page,
      url: project_activation_admin_dashboard_page_path(@dashboard),
      method: :patch
    ) do |form| %>
  <%= render(Overviews::DashboardProjectActivationForm.new(form)) %>
  <%= render(Primer::Beta::Button.new(scheme: :primary, type: :submit, mt: 2)) { t(:button_save) } %>
<% end %>

<% unless @dashboard.active_in_all_projects? %>
  <%= render "projects/assignments",
             id: "standard-dashboard",
             candidates: @candidate_projects,
             rows: @projects,
             add_path: projects_admin_dashboard_page_path(@dashboard),
             remove_path: ->(project) { project_admin_dashboard_page_path(@dashboard, project) },
             empty_title: t("overviews.dashboards.projects_empty") %>
<% end %>
