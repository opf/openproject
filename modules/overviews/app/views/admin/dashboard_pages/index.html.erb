<% html_title(t(:label_administration), t("overviews.dashboards.title")) %>

<%= render(Primer::OpenProject::PageHeader.new) do |header| %>
  <% header.with_title { t("overviews.dashboards.title") } %>
  <% header.with_breadcrumbs(
       [
         { href: admin_index_path, text: t(:label_administration) },
         t(:label_project_plural),
         t("overviews.dashboards.title")
       ]
     ) %>
<% end %>

<%= turbo_frame_tag "standard-dashboard-list", target: "_top" do %>
  <%=
    render(
      Primer::OpenProject::SubHeader.new(
        data: {
          controller: "filter--filters-form",
          filter__filters_form_output_format_value: "json",
          filter__filters_form_turbo_frame_request_value: "standard-dashboard-list",
          filter__filters_form_current_filters_value: OpPrimer::QuickFilter.serialize(@query.filters).to_json,
          filter__filters_form_clear_button_id_value: "standard-dashboard-clear-search"
        }
      )
    ) do |subheader|
      subheader.with_filter_input(
        name: :name,
        id: "standard-dashboard-name-search",
        label: t(:label_search_by_name),
        placeholder: t(:label_search_by_name),
        value: @query.find_active_filter(:name)&.values&.first,
        leading_visual: { icon: :search, size: :small },
        show_clear_button: true,
        clear_button_id: "standard-dashboard-clear-search",
        data: {
          turbo_permanent: true,
          filter_name: "name",
          filter_type: "string",
          filter_operator: "~",
          filter__filters_form_target: "simpleFilter filterValueContainer simpleValue"
        }
      )
      label = t("overviews.dashboards.new")
      subheader.with_action_button(
        tag: :a, href: new_admin_dashboard_page_path, scheme: :primary, leading_icon: :plus, label:
      ) { label }
    end
  %>

  <%= render(Overviews::StandardDashboardsTableComponent.new(rows: @dashboards)) %>
<% end %>
