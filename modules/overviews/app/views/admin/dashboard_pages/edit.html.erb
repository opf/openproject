<%= render "admin/dashboard_pages/header", active_tab: :settings %>

<% action = @dashboard.persisted? ? admin_dashboard_page_path(@dashboard) : admin_dashboard_pages_path %>
<%= form_with model: @dashboard, scope: :dashboard_page, url: action do |form| %>
  <%= render "overviews/dashboard_pages/name_field", form:, dashboard: @dashboard %>
  <%= render(Primer::Beta::Button.new(type: :submit, scheme: :primary)) { t(:button_save) } %>
<% end %>

<% if @dashboard.persisted? %>
  <%= render(Overviews::DashboardComponent.new(project: nil, current_user:, dashboard: @dashboard, configuration: true)) %>
<% end %>
