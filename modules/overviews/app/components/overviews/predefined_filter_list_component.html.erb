<% grouped_work_packages = groups.presence || { @filter.display_name => [] } %>

<% grouped_work_packages.each_with_index do |(group, work_packages), index| %>
  <%= render(
        OpPrimer::BorderBoxListComponent.new(
          container: dom_target(@project, :predefined_filter, index.to_s),
          current_user: @current_user, scheme: :transparent, padding: :condensed, header_padding: :condensed, mb: 3
        )
      ) do |list| %>
    <% list.with_header(title: group_label(group), count: work_packages.size, count_arguments: { scheme: :secondary }) do |header| %>
      <% if @current_user.allowed_globally?(:manage_filters) %>
        <% header.with_menu do |menu| %>
          <% menu.with_item(
               tag: :a,
               href: configuration_admin_predefined_work_package_filter_path(@filter),
               label: t("js.toolbar.settings.configure_filter")
             ) do |item| %>
            <% item.with_leading_visual_icon(icon: :gear) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
    <% if work_packages.empty? %>
      <% list.with_empty_state(title: t("predefined_work_package_filters.empty")) %>
    <% end %>
    <% work_packages.each do |work_package| %>
      <% list.with_work_package_item(work_package:, project: @project) %>
    <% end %>
  <% end %>
<% end %>
