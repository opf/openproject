<%= render(
      Primer::OpenProject::DangerDialog.new(
        title: t("overviews.dashboards.delete"),
        confirm_button_text: t(:button_delete),
        cancel_button_text: t(:button_cancel),
        form_arguments: { action: admin_dashboard_page_path(@dashboard), method: :delete }
      )
    ) do |dialog| %>
  <% dialog.with_confirmation_message do |message| %>
    <% message.with_heading(tag: :h2) { @dashboard.name } %>
    <% message.with_description_content(t("overviews.dashboards.delete_description")) %>
  <% end %>
  <% dialog.with_confirmation_check_box_content(t("overviews.dashboards.delete_confirmation")) %>
<% end %>
