<div id="dashboard-widgets" class="op-grid-page">
  <%= render(
        Overviews::DashboardToolbarComponent.new(
          project:,
          dashboard:,
          current_user:,
          show_actions: project.present? && !@configuration,
          add_widgets: allowed_to_manage?
        )
      ) %>

  <%= angular_component_tag(
        "opce-dashboard",
        inputs: {
          projectIdentifier: project&.identifier,
          gridId: dashboard&.id,
          layoutOnly: dashboard&.central? && @configuration,
          readOnly: dashboard.present? && !@configuration
        }.compact
      ) %>
</div>
