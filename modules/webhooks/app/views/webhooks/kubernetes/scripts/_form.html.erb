<fieldset class="form--fieldset" data-controller="webhooks--code-editor">
  <div class="form--field -required">
    <%= f.text_field :name, required: true, container_class: "-middle" %>
  </div>

  <div class="form--field">
    <%= f.text_area :description, rows: 2, container_class: "-wide" %>
  </div>

  <div class="form--field -required">
    <%= f.select :kubernetes_connection_id,
                 Webhooks::KubernetesConnection.order(:name).pluck(:name, :id),
                 { include_blank: true },
                 required: true,
                 container_class: "-middle" %>
  </div>

  <div class="form--field -required">
    <%= f.text_field :image, required: true, container_class: "-middle" %>
    <div class="form--field-instructions">
      <%= t("webhooks.kubernetes.scripts.form.image") %>
    </div>
  </div>

  <div class="form--field -required">
    <%= f.text_field :command,
                     required: true,
                     container_class: "-middle",
                     data: {
                       webhooks__code_editor_target: "command",
                       action: "input->webhooks--code-editor#updateMode"
                     } %>
    <div class="form--field-instructions">
      <%= t("webhooks.kubernetes.scripts.form.command") %>
    </div>
  </div>

  <div class="form--field -required">
    <%= f.number_field :timeout_seconds, min: 1, required: true, container_class: "-slim" %>
  </div>

  <div class="form--field -required">
    <%= f.text_area :body,
                    rows: 20,
                    container_class: "-xxwide",
                    class: "-monospace",
                    spellcheck: false,
                    data: { webhooks__code_editor_target: "textarea" } %>
    <div class="form--field-instructions">
      <%= t("webhooks.kubernetes.scripts.form.body") %>
    </div>
  </div>
</fieldset>

<fieldset class="form--fieldset" data-controller="checkable">
  <legend class="form--fieldset-legend">
    <%= t("webhooks.outgoing.form.events.title") %>
  </legend>
  <p><%= t("webhooks.kubernetes.scripts.form.events") %></p>
  <div class="form--toolbar">
    <span class="form--toolbar-item">
      <%= check_all_links %>
    </span>
  </div>

  <%= hidden_field_tag "kubernetes_script[event_names][]", "" %>
  <% OpenProject::Webhooks::EventResources.available_events_map.each do |resource_label, events| %>
    <div class="form--field">
      <label class="form--label"><%= resource_label %></label>
      <div class="form--field-container -vertical">
        <% events.each do |key, label| %>
          <label class="form--label-with-check-box">
            <%= styled_check_box_tag "kubernetes_script[event_names][]",
                                     key,
                                     @script.event_names.include?(key),
                                     data: { checkable_target: "checkbox" } -%>
            <%= label %>
          </label>
        <% end %>
      </div>
    </div>
  <% end %>
</fieldset>

<fieldset class="form--fieldset">
  <legend class="form--fieldset-legend">
    <%= t("webhooks.kubernetes.scripts.form.manual_legend") %>
  </legend>
  <p><%= t("webhooks.kubernetes.scripts.form.manual_explanation") %></p>

  <div class="form--field">
    <%= f.check_box :manual %>
  </div>

  <div class="form--field">
    <%= f.text_field :button_label, container_class: "-middle", placeholder: @script.name %>
    <div class="form--field-instructions">
      <%= t("webhooks.kubernetes.scripts.form.button_label") %>
    </div>
  </div>

  <div class="form--field">
    <label class="form--label"><%= Webhooks::KubernetesScript.human_attribute_name(:type_ids) %></label>
    <div class="form--field-container -vertical">
      <%= hidden_field_tag "kubernetes_script[type_ids][]", "" %>
      <% ::Type.order(:position).each do |type| %>
        <label class="form--label-with-check-box">
          <%= styled_check_box_tag "kubernetes_script[type_ids][]", type.id, @script.type_ids.include?(type.id) -%>
          <%= type.name %>
        </label>
      <% end %>
    </div>
    <div class="form--field-instructions">
      <%= t("webhooks.kubernetes.scripts.form.type_ids") %>
    </div>
  </div>

  <div class="form--field" data-controller="webhooks--code-editor" data-webhooks--code-editor-mode-value="json"
       data-webhooks--code-editor-height-value="20rem">
    <%= f.text_area :input_schema,
                    value: @script.input_schema_text,
                    rows: 14,
                    container_class: "-xxwide",
                    class: "-monospace",
                    spellcheck: false,
                    data: { webhooks__code_editor_target: "textarea" } %>
    <div class="form--field-instructions">
      <%= t("webhooks.kubernetes.scripts.form.input_schema") %>
    </div>
  </div>
</fieldset>
