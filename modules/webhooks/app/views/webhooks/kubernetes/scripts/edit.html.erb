<% html_title t(:label_administration), t("webhooks.kubernetes.scripts.plural"), @script.name %>

<%=
  render(Primer::OpenProject::PageHeader.new) do |header|
    header.with_title { @script.name }
    header.with_breadcrumbs(
      [{ href: admin_index_path, text: t("label_administration") },
       { href: admin_settings_api_path, text: t("menus.admin.api_and_webhooks") },
       { href: admin_kubernetes_scripts_path, text: t("webhooks.kubernetes.scripts.plural") },
       @script.name]
    )
  end
%>

<%= render partial: "tabs", locals: { script: @script, selected: :general } %>

<%= error_messages_for @script %>

<%= labelled_tabular_form_for @script,
                              url: admin_kubernetes_script_path(@script),
                              method: :patch,
                              as: "kubernetes_script",
                              html: { class: "form", autocomplete: "off" } do |f| %>
  <%= render partial: "form", locals: { f: } %>
  <p>
    <%= styled_button_tag t(:button_save), class: "-primary -with-icon icon-checkmark" %>
    <%= link_to t(:button_cancel), admin_kubernetes_scripts_path, class: "button -with-icon icon-cancel" %>
  </p>
<% end %>

<% saved_schema = Webhooks::ManualScriptSchema.new(@script.attribute_in_database(:input_schema)) %>
<% if @script.manual_in_database && saved_schema.errors.empty? %>
  <%=
    render(Primer::Beta::Subhead.new(mt: 6)) do |subhead|
      subhead.with_heading(tag: :h3, size: :medium) { t("webhooks.kubernetes.scripts.preview.title") }
      subhead.with_description { t("webhooks.kubernetes.scripts.preview.description") }
    end
  %>
  <%=
    render(Primer::Beta::BorderBox.new(test_selector: "manual-script-form-preview")) do |box|
      box.with_header { @script.label }
      box.with_body do
        if saved_schema.fields.empty?
          render(Primer::Beta::Text.new(color: :muted)) { t("webhooks.kubernetes.scripts.preview.no_fields") }
        else
          primer_form_with(model: Webhooks::ManualScriptInputForm.model_for(saved_schema.fields),
                           url: "#", scope: :input, html: { onsubmit: "return false" }) do |form|
            render(Webhooks::ManualScriptInputForm.new(form, fields: saved_schema.fields))
          end
        end
      end
    end
  %>
<% end %>
