<% html_title t(:label_administration), t("webhooks.kubernetes.scripts.plural") %>

<%=
  render(Primer::OpenProject::PageHeader.new) do |header|
    header.with_title { t("webhooks.kubernetes.scripts.plural") }
    header.with_breadcrumbs(
      [{ href: admin_index_path, text: t("label_administration") },
       { href: admin_settings_api_path, text: t("menus.admin.api_and_webhooks") },
       t("webhooks.kubernetes.scripts.plural")]
    )
    header.with_description { t("webhooks.kubernetes.scripts.explanation") }
  end
%>

<%=
  render(Primer::OpenProject::SubHeader.new) do |subheader|
    subheader.with_action_button(
      scheme: :primary,
      leading_icon: :plus,
      label: t("webhooks.kubernetes.scripts.label_add_new"),
      tag: :a,
      href: new_admin_kubernetes_script_path
    ) do
      t("webhooks.kubernetes.scripts.singular")
    end
  end
%>

<%=
  render(Primer::Beta::BorderBox.new) do |box|
    if @scripts.empty?
      box.with_row { t("webhooks.kubernetes.scripts.no_results") }
    end

    @scripts.each do |script|
      box.with_row(display: :flex, align_items: :center) do
        concat(
          render(Primer::Box.new(flex: 1)) do
            concat(render(Primer::Beta::Link.new(href: edit_admin_kubernetes_script_path(script))) { script.name })
            concat(
              render(Primer::Beta::Text.new(tag: :div, font_size: :small, color: :muted)) do
                [
                  script.kubernetes_connection.name,
                  script.image,
                  t("webhooks.outgoing.label_x_events", count: script.event_names.size),
                  (t("webhooks.kubernetes.scripts.manual") if script.manual?)
                ].compact.join(" · ")
              end
            )
          end
        )
        concat(
          render(
            Primer::Beta::IconButton.new(
              icon: :trash,
              scheme: :danger,
              tag: :a,
              href: admin_kubernetes_script_path(script),
              "aria-label": t(:button_delete),
              data: { turbo_method: :delete, turbo_confirm: t(:text_are_you_sure) }
            )
          )
        )
      end
    end
  end
%>
