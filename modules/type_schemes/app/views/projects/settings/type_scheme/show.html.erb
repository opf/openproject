<% html_title @project.name, t("type_schemes.project_settings.title") %>
<%=
  render Primer::OpenProject::PageHeader.new do |header|
    header.with_title { t("type_schemes.project_settings.title") }
    header.with_description { t("type_schemes.project_settings.description") }
    header.with_breadcrumbs(
      [{ href: project_overview_path(@project.id), text: @project.name },
       { href: project_settings_general_path(@project.id), text: t("label_project_settings") },
       t("type_schemes.project_settings.title")]
    )
  end
%>
<% current = ::TypeSchemes::Resolver.for_project(@project) %>
<% enabled_ids = @project.enabled_types.pluck(:id) %>
<% missing = current ? current.types.reject { |type| enabled_ids.include?(type.id) } : [] %>
<% available = ::TypeSchemes::Resolver.allowed_types(@project, default_first: false).to_a %>
<% item_colors = current ? current.items.index_by(&:type_id) : {} %>
<% scheme_options = @schemes.map { |scheme| [scheme.is_default ? t("type_schemes.project_settings.default_option", name: scheme.name) : scheme.name, scheme.id] } %>

<%= form_tag project_settings_type_scheme_path(@project), method: :patch do %>
  <div class="form--field">
    <%= label_tag "scheme_id", t("type_schemes.project_settings.scheme"), class: "form--label" %>
    <span class="form--field-container">
      <%= select_tag "scheme_id", options_for_select(scheme_options, current&.id), class: "form--select" %>
    </span>
  </div>
  <div class="form--field">
    <%= render(Primer::Beta::Button.new(scheme: :primary, type: :submit)) { t(:button_save) } %>
  </div>
<% end %>

<% if missing.any? %>
  <%= render Primer::Beta::Flash.new(scheme: :warning, mt: 3, mb: 3) do %>
    <%= t("type_schemes.project_settings.missing_types", types: missing.map(&:name).to_sentence) %>
    <% if User.current.allowed_in_project?(:manage_types, @project) %>
      <%= link_to t("type_schemes.project_settings.manage_types"), project_settings_work_packages_types_path(@project) %>
    <% end %>
  <% end %>
<% end %>

<h2 id="available-types-heading" class="mt-4"><%= t("type_schemes.project_settings.available_types") %></h2>
<p><%= t("type_schemes.project_settings.available_types_hint") %></p>
<% if available.any? %>
  <ol id="available-types" aria-labelledby="available-types-heading">
    <% available.each do |type| %>
      <li>
        <%= icon_for_color(item_colors[type.id]&.color, class: "mr-1") if item_colors[type.id]&.color %>
        <%= type.name %>
        <% if current&.default_type == type %>
          <%= render(Primer::Beta::Label.new(scheme: :primary, ml: 1)) { t(:label_default) } %>
        <% end %>
      </li>
    <% end %>
  </ol>
<% else %>
  <p id="available-types"><%= t("type_schemes.project_settings.no_types") %></p>
<% end %>
