<%
  type = local_assigns.fetch(:type)
  item = local_assigns[:item]
  key = type.id.to_s
  id_prefix = "type_scheme_types_#{type.id}"
  mode_name = "type_scheme[types][#{type.id}][color_mode]"
  id_name = "type_scheme[types][#{type.id}][color_id]"
  hex_name = "type_scheme[types][#{type.id}][color_hex]"

  selected_id = params.dig(:type_scheme, :types, key, :color_id).presence&.to_i || item&.color_id
  selected_hex = params.dig(:type_scheme, :types, key, :color_hex).presence || item&.color&.hexcode
  mode = (params.dig(:type_scheme, :types, key, :color_mode).presence || "palette").to_s
  custom = mode == "custom"

  color_options = Color.order(:name).map do |color|
    option = { name: color.name, value: color.id }
    option[:selected] = true if color.id == selected_id
    option
  end
  colors_json = color_options.to_json
  color_hex_map = Color.order(:name).each_with_object({}) { |color, map| map[color.id] = color.hexcode }.to_json
%>

<div data-controller="type-schemes--color"
     data-type-schemes--color-colors-value="<%= color_hex_map %>"
     class="type-scheme-color">
  <span class="type-scheme-color--modes" role="group" aria-label="<%= t("type_schemes.form.color_of", type: type.name) %>">
    <label class="type-scheme-color--mode">
      <%= radio_button_tag mode_name, "palette", !custom,
                           id: "#{id_prefix}_color_mode_palette",
                           data: { type_schemes__color_target: "mode",
                                   action: "change->type-schemes--color#modeChanged" } %>
      <span><%= t("type_schemes.form.color_mode_palette") %></span>
    </label>
    <label class="type-scheme-color--mode">
      <%= radio_button_tag mode_name, "custom", custom,
                           id: "#{id_prefix}_color_mode_custom",
                           data: { type_schemes__color_target: "mode",
                                   action: "change->type-schemes--color#modeChanged" } %>
      <span><%= t("type_schemes.form.color_mode_custom") %></span>
    </label>
  </span>

  <span class="color--preview"
        data-type-schemes--color-target="swatch"
        style="background-color: <%= selected_hex.presence || 'transparent' %>"
        aria-hidden="true"></span>

  <span class="type-scheme-color--control"
        data-type-schemes--color-target="palette"
        <%= "hidden" if custom %>>
    <%= hidden_field_tag id_name, selected_id, id: "#{id_prefix}_color_id",
                         data: { type_schemes__color_target: "select",
                                 action: "change->type-schemes--color#selectChanged" } %>
    <%= content_tag("opce-colors-autocompleter", "",
                    class: "colors-autocomplete form--select-container",
                    data: { colors: colors_json,
                            classes: "ng-select--primerized",
                            update_input: id_name }) %>
  </span>

  <span class="type-scheme-color--control"
        data-type-schemes--color-target="custom"
        <%= "hidden" unless custom %>>
    <%= color_field_tag hex_name, selected_hex.presence || "#000000",
                        id: "#{id_prefix}_color_hex",
                        data: { type_schemes__color_target: "picker",
                                action: "input->type-schemes--color#pickerChanged" } %>
  </span>
</div>
