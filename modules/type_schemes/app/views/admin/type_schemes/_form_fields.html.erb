<%
  items = scheme.items.index_by(&:type_id)
  all_types = Type.order(:position)
%>
<div class="form--field -required">
  <%= label_tag "type_scheme_name", TypeScheme.human_attribute_name(:name), class: "form--label" %>
  <span class="form--field-container"><%= text_field_tag "type_scheme[name]", scheme.name, id: "type_scheme_name", class: "form--text-field", required: true %></span>
</div>
<div class="form--field">
  <%= label_tag "type_scheme_description", TypeScheme.human_attribute_name(:description), class: "form--label" %>
  <span class="form--field-container"><%= text_area_tag "type_scheme[description]", scheme.description, id: "type_scheme_description", class: "form--text-area", rows: 3 %></span>
</div>
<div class="form--field">
  <%= label_tag "type_scheme_is_default", t("type_schemes.form.is_default"), class: "form--label" %>
  <span class="form--field-container"><%= check_box_tag "type_scheme[is_default]", "1", scheme.is_default, id: "type_scheme_is_default" %></span>
</div>
<table class="generic-table">
  <thead>
    <tr>
      <th><%= t("type_schemes.form.enabled") %></th>
      <th><%= Type.model_name.human %></th>
      <th><%= t("type_schemes.form.position") %></th>
      <th><%= t("type_schemes.form.default") %></th>
    </tr>
  </thead>
  <tbody>
    <% all_types.each_with_index do |type, index| %>
      <% item = items[type.id] %>
      <tr>
        <td><%= check_box_tag "type_scheme[types][#{type.id}][enabled]", "1", item.present?, id: "type_scheme_types_#{type.id}_enabled", "aria-label": type.name %></td>
        <td><%= type.name %></td>
        <td><%= number_field_tag "type_scheme[types][#{type.id}][position]", item&.position || index + 1, id: "type_scheme_types_#{type.id}_position", min: 1, "aria-label": "#{t("type_schemes.form.position")}: #{type.name}" %></td>
        <td><%= radio_button_tag "type_scheme[default_type_id]", type.id, item&.is_default, id: "type_scheme_default_type_#{type.id}", "aria-label": "#{t("type_schemes.form.default")}: #{type.name}" %></td>
      </tr>
    <% end %>
  </tbody>
</table>
