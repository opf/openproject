<% html_title t(:label_administration), t("type_schemes.plural") %>

<%=
  render Primer::OpenProject::PageHeader.new do |header|
    header.with_title { t("type_schemes.plural") }
    header.with_description { t("type_schemes.index.description") }
    header.with_breadcrumbs(
      [{ href: admin_index_path, text: t(:label_administration) },
       t("type_schemes.plural")]
    )
  end
%>

<%=
  render Primer::OpenProject::SubHeader.new do |subheader|
    subheader.with_action_button(
      scheme: :primary,
      leading_icon: :plus,
      label: t("type_schemes.new"),
      tag: :a,
      href: new_admin_type_scheme_path,
      test_selector: "type-schemes-new-button"
    ) { t("type_schemes.new") }
  end
%>

<% if @schemes.empty? %>
  <%=
    render Primer::Beta::Blankslate.new(border: true) do |blankslate|
      blankslate.with_visual_icon(icon: :checklist)
      blankslate.with_heading(tag: :h2).with_content(t("type_schemes.index.blank_heading"))
      blankslate.with_description { t("type_schemes.index.blank_description") }
    end
  %>
<% else %>
  <div class="generic-table--container">
    <div class="generic-table--results-container">
      <table class="generic-table">
        <caption class="sr-only"><%= t("type_schemes.plural") %></caption>
        <thead>
          <tr>
            <th scope="col"><%= t(:label_name) %></th>
            <th scope="col"><%= t("type_schemes.index.projects") %></th>
            <th scope="col"><%= t(:label_status) %></th>
            <th scope="col"><span class="sr-only"><%= t("type_schemes.index.actions") %></span></th>
          </tr>
        </thead>
        <tbody>
          <% @schemes.each do |scheme| %>
            <tr>
              <th scope="row">
                <%= link_to scheme.name, edit_admin_type_scheme_path(scheme) %>
                <% if scheme.is_default %>
                  <%= render(Primer::Beta::Label.new(scheme: :primary, ml: 1)) { t(:label_default) } %>
                <% end %>
                <% if scheme.description.present? %>
                  <div class="color-fg-muted"><%= scheme.description %></div>
                <% end %>
              </th>
              <td><%= scheme.project_assignments.size %></td>
              <td><%= scheme.active ? t(:label_active) : t(:label_inactive) %></td>
              <td>
                <%= render(Primer::Beta::Button.new(tag: :a, href: edit_admin_type_scheme_path(scheme), size: :small, mr: 2, mb: 1, "aria-label": t("type_schemes.index.action_on", action: t(:button_edit), scheme: scheme.name))) { t(:button_edit) } %>
                <%= render "scheme_action", scheme:, path: clone_admin_type_scheme_path(scheme), caption: t("type_schemes.index.clone"), confirm: nil %>
                <% if scheme.active && !scheme.is_default %>
                  <%= render "scheme_action", scheme:, path: deactivate_admin_type_scheme_path(scheme), caption: t("type_schemes.index.deactivate"),
                                              confirm: t("type_schemes.index.deactivate_confirm", count: scheme.project_assignments.size) %>
                <% elsif !scheme.active %>
                  <%= render "scheme_action", scheme:, path: activate_admin_type_scheme_path(scheme), caption: t("type_schemes.index.activate"), confirm: nil %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
