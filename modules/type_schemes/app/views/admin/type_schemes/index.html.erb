<% html_title t(:label_administration), t("type_schemes.plural") %>
<%= render Primer::OpenProject::PageHeader.new { |h| h.with_title { t("type_schemes.plural") } } %>
<p><%= link_to t("type_schemes.new"), new_admin_type_scheme_path, class: "button -primary" %></p>
<table class="generic-table">
  <thead>
    <tr>
      <th><%= t(:label_name) %></th>
      <th><%= t("type_schemes.index.projects") %></th>
      <th><%= t(:label_status) %></th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @schemes.each do |scheme| %>
      <tr>
        <td><%= scheme.name %><%= " (#{t('type_schemes.index.default_scheme')})" if scheme.is_default %></td>
        <td><%= @project_counts.fetch(scheme.id, 0) %></td>
        <td><%= scheme.active ? t(:label_active) : t(:label_inactive) %></td>
        <td>
          <%= link_to t(:button_edit), edit_admin_type_scheme_path(scheme) %>
          <%= button_to t("type_schemes.index.clone"), clone_admin_type_scheme_path(scheme), method: :post, form: { style: "display:inline" } %>
          <% if scheme.active && !scheme.is_default %>
            <%= button_to t("type_schemes.index.deactivate"), deactivate_admin_type_scheme_path(scheme), method: :post, form: { style: "display:inline", data: { turbo_confirm: t(:text_are_you_sure) } } %>
          <% elsif !scheme.active %>
            <%= button_to t("type_schemes.index.activate"), activate_admin_type_scheme_path(scheme), method: :post, form: { style: "display:inline" } %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
