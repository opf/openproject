<%=
  widget_wrapper do
    if progress_percent.nil?
      render(Primer::Beta::Text.new(color: :muted)) { t("grids.widgets.project_progress.not_set") }
    else
      flex_layout do |flex|
        flex.with_row(mb: 1, aria: { hidden: true }) do
          render(Primer::Beta::Text.new(font_weight: :bold)) do
            number_to_percentage(progress_percent, precision: 0)
          end
        end

        flex.with_row do
          render(
            Primer::Beta::ProgressBar.new(
              role: "progressbar",
              aria: { label: title, valuenow: progress_percent, valuemin: 0, valuemax: 100 }
            )
          ) do |bar|
            bar.with_item(percentage: progress_percent)
          end
        end
      end
    end
  end
%>
