<%=
  component_wrapper do
    primer_form_with(
      model: resolved_oauth_client,
      url: form_url,
      method: form_method
    ) do |form|
      flex_layout do |oauth_client_row|
        oauth_client_row.with_row(mb: 3) do
          render(Primer::Beta::Text.new) do
            helpers.link_translate(
              "wikis.admin.wiki_providers.#{wiki_provider}.oauth.provider_oauth_configuration",
              links: { xwiki_oidc_link: xwiki_oidc_admin_url },
              external: true
            )
          end
        end

        oauth_client_row.with_row(mb: 3) do
          render(Primer::OpenProject::InputGroup.new(input_width: :large)) do |input_group|
            input_group.with_text_input(
              readonly: false,
              id: "oauth_client_client_id",
              name: "oauth_client[client_id]",
              label: t(".client_id"),
              visually_hide_label: false,
              value: resolved_oauth_client.client_id,
              required: true,
              validation_message: validation_message_for(:client_id)
            )
            input_group.with_trailing_action_clipboard_copy_button(
              for: "oauth_client_client_id",
              aria: { label: t("button_copy_to_clipboard") }
            )
          end
        end

        oauth_client_row.with_row(mb: 3) do
          render(Primer::OpenProject::InputGroup.new(input_width: :large)) do |input_group|
            input_group.with_text_input(
              readonly: false,
              id: "oauth_client_client_secret",
              name: "oauth_client[client_secret]",
              label: t(".client_secret"),
              visually_hide_label: false,
              value: resolved_oauth_client.client_secret,
              required: true,
              validation_message: validation_message_for(:client_secret)
            )
            input_group.with_trailing_action_clipboard_copy_button(
              for: "oauth_client_client_secret",
              aria: { label: t("button_copy_to_clipboard") }
            )
          end
        end

        oauth_client_row.with_row(mb: 3) do
          render(Primer::OpenProject::InputGroup.new(input_width: :large)) do |input_group|
            input_group.with_text_input(
              id: "oauth_client_redirect_uri",
              name: "oauth_client[redirect_uri]",
              label: t(".redirect_uri"),
              visually_hide_label: false,
              value: redirect_uri_or_instructions
            )
            input_group.with_trailing_action_clipboard_copy_button(
              for: "oauth_client_redirect_uri",
              aria: { label: t("button_copy_to_clipboard") }
            )
            input_group.with_caption { t(".redirect_uri_caption") }
          end
        end

        oauth_client_row.with_row do
          render(
            Wikis::Admin::SubmitOrCancelForm.new(
              form, wiki_provider:,
                    cancel_button_options: { href: cancel_button_path }
            )
          )
        end
      end
    end
  end
%>
