<% html_title(t("my_page.label")) -%>

<%=
  render(Primer::OpenProject::PageHeader.new) do |header|
    header.with_title { t("my_page.label") }
    header.with_breadcrumbs(nil)

    if my_day
      header.with_tab_nav(label: t("my_page.label"), test_selector: "my-page-tabs") do |tab_nav|
        tab_nav.with_tab(selected: tab == "today", href: my_page_path) do |item|
          item.with_text { t("my_day.today") }
        end
        tab_nav.with_tab(selected: tab == "inbox", href: my_page_path(tab: :inbox)) do |item|
          item.with_text { t("my_day.inbox.title") }
          item.with_counter(
            count: MyDay::Inbox.for(current_user)&.count.to_i,
            hide_if_zero: true,
            id: MyDay::InboxCounter::ID
          )
        end
        tab_nav.with_tab(selected: tab == "dashboard", href: my_page_path(tab: :dashboard)) do |item|
          item.with_text { t("my_day.dashboard") }
        end
      end
    end
  end
%>

<% if today %>
  <%= render(MyDay::TodayComponent.new(today:)) %>
<% elsif inbox %>
  <%= render(MyDay::InboxComponent.new(inbox:)) %>
<% else %>
  <%= angular_component_tag "opce-my-page" %>
<% end %>
