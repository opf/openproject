<% html_title(t("my_page.label")) -%>

<%=
  render(Primer::OpenProject::PageHeader.new) do |header|
    header.with_title { t("my_page.label") }
    header.with_breadcrumbs(nil)

    if my_day
      header.with_tab_nav(label: t("my_page.label"), test_selector: "my-page-tabs") do |tab_nav|
        tab_nav.with_tab(selected: tab == "today", href: my_page_path) do |item|
          item.with_text { t("my_day.today") }
        end
        tab_nav.with_tab(selected: tab == "upcoming", href: my_page_path(tab: :upcoming)) do |item|
          item.with_text { t("my_day.upcoming.title") }
        end
        tab_nav.with_tab(selected: tab == "unplanned", href: my_page_path(tab: :unplanned)) do |item|
          item.with_text { t("my_day.unplanned.title") }
          item.with_counter(**MyDay::UnplannedComponent.counter_arguments(current_user))
        end
        tab_nav.with_tab(selected: tab == "dashboard", href: my_page_path(tab: :dashboard)) do |item|
          item.with_text { t("my_day.dashboard") }
        end
      end
    end
  end
%>

<% if today %>
  <%= render(MyDay::TodayComponent.new(today:)) %>
<% elsif upcoming %>
  <%= render(MyDay::UpcomingComponent.new(upcoming:)) %>
<% elsif unplanned %>
  <%= render(MyDay::UnplannedComponent.new(unplanned:)) %>
<% else %>
  <%= angular_component_tag "opce-my-page" %>
<% end %>
