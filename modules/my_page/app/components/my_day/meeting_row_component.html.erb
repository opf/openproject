<%= flex_layout(align_items: :flex_start) do |row| %>
  <% row.with_column(mr: 3, text_align: :right, style: "width: #{LEAD_WIDTH}; flex-shrink: 0") do %>
    <%= render(Primer::Beta::Text.new(tag: :div, font_family: :mono, font_weight: :bold, color: scheme)) { start_time } %>
    <%= render(Primer::Beta::Text.new(tag: :div, font_family: :mono, color: :muted)) { end_time } %>
  <% end %>
  <% row.with_column(flex: 1) do %>
    <%= render(Primer::Beta::Link.new(href: meeting_path(meeting), scheme: :primary, font_weight: :semibold)) { meeting.title } %>
    <% if starts_in %>
      <%= render(Primer::Beta::Text.new(color: :danger, font_size: :small, font_weight: :semibold, ml: 2)) { starts_in } %>
    <% end %>
    <%= flex_layout(align_items: :center, mt: 1) do |meta| %>
      <% meta.with_column(mr: 2) do %>
        <%= render(Primer::Beta::Label.new(scheme: :secondary)) { kind } %>
      <% end %>
      <% if participants.any? %>
        <% meta.with_column do %>
          <%= render(Primer::OpenProject::AvatarStack.new(tooltipped: true, body_arguments: { label: participants.map(&:name).join(", ") })) do |stack| %>
            <% participants.each { |participant| stack.with_avatar_with_fallback(**avatar_options(participant)) } %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
  <% row.with_column do %>
    <%= render(Primer::Beta::Button.new(tag: :a, href: meeting_path(meeting), scheme: :invisible, size: :small)) { t("my_day.agenda") } %>
  <% end %>
<% end %>
