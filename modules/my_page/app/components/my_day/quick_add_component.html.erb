<%= form_with(url: my_day_tasks_path, scope: :task, method: :post, data: { test_selector: "my-day-quick-add" }) do %>
  <%= flex_layout(align_items: :center) do |row| %>
    <% row.with_column(flex: 1, mr: 2) do %>
      <%= render(Primer::Alpha::TextField.new(**subject_field_arguments)) %>
    <% end %>
    <% row.with_column(mr: 2) do %>
      <div data-controller="filter--segmented-control" data-action="itemActivated->filter--segmented-control#activate">
        <%= hidden_field_tag "task[day_part]", selected, id: nil, data: { "filter--segmented-control-target": "field" } %>
        <%= render(Primer::Alpha::SegmentedControl.new("aria-label": t("my_day.day_part.name"))) do |control| %>
          <% day_parts.each do |day_part| %>
            <% control.with_item(label: t("my_day.day_part.#{day_part}"), selected: day_part == selected, data: { value: day_part }) %>
          <% end %>
        <% end %>
      </div>
    <% end %>
    <% row.with_column do %>
      <%= render(Primer::Beta::Button.new(type: :submit, scheme: :primary)) { t("my_day.quick_add.submit") } %>
    <% end %>
  <% end %>
<% end %>
