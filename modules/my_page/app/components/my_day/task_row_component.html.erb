<%= flex_layout(align_items: :flex_start) do |row| %>
  <% row.with_column(mr: 3, style: "width: #{MyDay::MeetingRowComponent::LEAD_WIDTH}; flex-shrink: 0", display: :flex, justify_content: :flex_end) do %>
    <%= render(Primer::Alpha::CheckBox.new(**check_box_arguments)) %>
  <% end %>
  <% row.with_column(flex: 1) do %>
    <%= render(Primer::Beta::Link.new(**subject_link_arguments)) { work_package.subject } %>
    <%= flex_layout(mt: 1) do |meta| %>
      <% meta.with_column(mr: 3) do %>
        <%= render(Primer::Beta::Text.new(font_family: :mono, color: :muted, font_size: :small)) { work_package.formatted_id } %>
      <% end %>
      <% meta.with_column(mr: 3) do %>
        <%= render(Primer::Beta::Text.new(color: :muted, font_size: :small)) { work_package.type.name } %>
      <% end %>
      <% meta.with_column do %>
        <%= render(Primer::Beta::Text.new(color: :muted, font_size: :small)) { work_package.status.name } %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
