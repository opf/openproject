<%= flex_layout(align_items: :center) do |row| %>
  <% row.with_column(mr: 3, font_family: :mono, font_size: :small, style: "width: #{lead_width}; flex-shrink: 0", display: :flex, justify_content: :flex_end) do %>
    <%= form_with(url: my_day_task_path(work_package), method: :patch) do %>
      <%= hidden_field_tag :done, !closed?, id: nil %>
      <% if view_param %>
        <%= hidden_field_tag :view, view_param, id: nil %>
      <% end %>
      <%= render(Primer::Beta::IconButton.new(**toggle_button_arguments)) %>
    <% end %>
  <% end %>
  <% row.with_column(flex: 1, mr: 3, classes: "min-width-0") do %>
    <%= render(Primer::Beta::Truncate.new) do %>
      <% if planned_work_package %>
        <%= render(Primer::Beta::Link.new(**subject_link_arguments, test_selector: "my-day-planned")) { planned_work_package.subject } %>
      <% else %>
        <% subject_parts.each do |part| %>
          <% if part.is_a?(WorkPackage) %>
            <%= render(Primer::Beta::Link.new(href: work_package_path(part), border: true, border_radius: 2, px: 1, bg: :subtle, test_selector: "my-day-reference")) do %>
              <%= render(Primer::Beta::Text.new(font_family: :mono, font_size: :small)) { part.formatted_id } %>
              <%= render(Primer::Beta::Text.new(font_size: :small, color: :muted, text_transform: :uppercase)) { part.status.name } %>
              <%= render(Primer::Beta::Text.new(color: :default)) { part.subject } %>
            <% end %>
          <% elsif part.present? %>
            <%= render(Primer::Beta::Link.new(**subject_link_arguments)) { part } %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
  <% row.with_column(mr: 2, flex_shrink: 0) do %>
    <%= flex_layout(align_items: :center, test_selector: "my-day-task-meta") do |meta| %>
      <% if unplanned? %>
        <% meta.with_column(**meta_cell(:planned_for)) do %>
          <% if work_package.due_date %>
            <%= render(Primer::Beta::Text.new(color: :severe, font_size: :small)) { t("my_day.planned_for", date: helpers.format_date(work_package.due_date)) } %>
          <% end %>
        <% end %>
      <% end %>
      <% meta.with_column(**meta_cell(:kind)) do %>
        <% if planned_work_package %>
          <%= render(Primer::Beta::Truncate.new) do %>
            <%= render(WorkPackages::HighlightedTypeComponent.new(work_package: planned_work_package, font_size: :small)) %>
          <% end %>
        <% else %>
          <%= render(Primer::Beta::Label.new(scheme: :accent)) { t("my_day.quick_task") } %>
        <% end %>
      <% end %>
      <% meta.with_column(**meta_cell(:id)) do %>
        <%= render(Primer::Beta::Truncate.new(font_family: :mono, color: :muted, font_size: :small)) { shown_work_package.formatted_id } %>
      <% end %>
      <% meta.with_column(**meta_cell(:project)) do %>
        <% if planned_work_package %>
          <%= render(Primer::Beta::Truncate.new(color: :muted, font_size: :small)) { planned_work_package.project.name } %>
        <% end %>
      <% end %>
      <% meta.with_column(**meta_cell(:status)) do %>
        <% if planned_work_package %>
          <%= render(WorkPackages::StatusBadgeComponent.new(status: planned_work_package.status)) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
  <% row.with_column(flex_shrink: 0) do %>
    <%= render(Primer::Alpha::ActionMenu.new(anchor_align: :end, test_selector: "my-day-move-menu")) do |menu| %>
      <% menu.with_show_button(icon: "kebab-horizontal", "aria-label": t("my_day.task_actions"), scheme: :invisible, size: :small) %>
      <% move_targets.each do |to, label| %>
        <% menu.with_item(label:, href: plan_path(to), form_arguments: plan_form_arguments) %>
      <% end %>
      <% if can_unplan? %>
        <% menu.with_divider %>
        <% menu.with_item(label: t("my_day.move_to.remove"), href: plan_path(:remove), form_arguments: plan_form_arguments) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
