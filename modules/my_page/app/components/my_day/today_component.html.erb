<%= component_wrapper(data: { test_selector: "my-day-today" }) do %>
  <%= render(Primer::Beta::Text.new(tag: :p, color: :muted, test_selector: "my-day-summary")) { summary } %>

  <%= render(Primer::Box.new(mt: 2)) do %>
    <%= render(MyDay::QuickAddComponent.new(selected: today.current_day_part)) %>
  <% end %>

  <% today.sections.each do |section| %>
    <% scheme = COLOR_SCHEMES.fetch(section.day_part) %>
    <%= render(Primer::Box.new(mt: 3, test_selector: "my-day-section-#{section.day_part}")) do %>
      <%= render(MyDay::SectionHeaderComponent.new(section:, scheme:, now: today.now?(section.day_part))) %>

      <% section.meetings.each do |meeting| %>
        <%= render(Primer::Box.new(**row_arguments(section.day_part, bg: :subtle, test_selector: "my-day-meeting-#{section.day_part}"))) do %>
          <%= render(MyDay::MeetingRowComponent.new(meeting:, user: today.user, scheme:, lead_width:)) %>
        <% end %>
      <% end %>

      <% section.work_packages.each do |work_package| %>
        <%= render(Primer::Box.new(**row_arguments(section.day_part, test_selector: "my-day-task-#{section.day_part}"))) do %>
          <%= render(MyDay::TaskRowComponent.new(work_package:, lead_width:, references: today.references, day_part: section.day_part)) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
