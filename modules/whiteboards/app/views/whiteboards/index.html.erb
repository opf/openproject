<%=
  render(Primer::OpenProject::PageHeader.new) do |header|
    header.with_title { t(:label_whiteboard_plural) }
    header.with_breadcrumbs(
      [{ href: project_overview_path(@project.id), text: @project.name },
       t(:label_whiteboard_plural)]
    )

    if User.current.allowed_in_project?(:manage_whiteboards, @project)
      header.with_action_button(
        tag: :a,
        scheme: :primary,
        mobile_icon: :plus,
        mobile_label: t(:label_whiteboard),
        href: project_whiteboards_path(@project),
        data: { turbo_method: :post, test_selector: "new-whiteboard-button" }
      ) do |button|
        button.with_leading_visual_icon(icon: :plus)
        t(:label_whiteboard)
      end
    end
  end
%>

<% if @whiteboards.empty? %>
  <%=
    render(Primer::Beta::Blankslate.new(border: true)) do |component|
      component.with_visual_icon(icon: :paintbrush)
      component.with_heading(tag: :h2).with_content(t("whiteboards.blankslate.heading"))
      component.with_description_content(t("whiteboards.blankslate.description"))
    end
  %>
<% else %>
  <%=
    render(Primer::Beta::BorderBox.new(test_selector: "whiteboards-list")) do |box|
      @whiteboards.each do |whiteboard|
        box.with_row do
          flex_layout(justify_content: :space_between, align_items: :center) do |row|
            row.with_column do
              render(Primer::Beta::Link.new(href: whiteboard_path(whiteboard), font_weight: :bold, data: { turbo: false })) do
                whiteboard.title
              end
            end
            row.with_column do
              render(Primer::Beta::Text.new(color: :subtle, font_size: :small)) do
                t("whiteboards.updated_by", author: whiteboard.author.name, time: time_ago_in_words(whiteboard.updated_at))
              end
            end
          end
        end
      end
    end
  %>
<% end %>

<% html_title(t(:label_whiteboard_plural)) %>
