<% html_title(t(:label_whiteboard_plural), @whiteboard.title) %>

<% if @token_payload.present? %>
  <%
    collaboration_provider_controller(
      resource_url: @resource_url,
      token_payload: @token_payload,
      token_expires_in_seconds: @token_expires_in_seconds,
      refresh_url: project_whiteboard_refresh_token_path(@project, @whiteboard)
    )
  %>
  <%= content_tag "op-whiteboard",
                  "",
                  class: "op-whiteboard",
                  "whiteboard-title": @whiteboard.title,
                  "read-only": @readonly.to_s,
                  "leave-url": project_whiteboards_path(@project),
                  "active-user": {
                    id: User.current.id,
                    name: User.current.name,
                    avatarUrl: avatar_url(User.current).presence
                  }.to_json,
                  "lang-code": I18n.locale.to_s,
                  "excalidraw-asset-path": excalidraw_asset_path,
                  data: { test_selector: "whiteboard-canvas" } %>
<% else %>
  <%=
    render(Primer::Beta::Blankslate.new(border: true, m: 4)) do |component|
      component.with_visual_icon(icon: :alert)
      component.with_heading(tag: :h2).with_content(t("whiteboards.collaboration_unavailable.heading"))
      component.with_description_content(t("whiteboards.collaboration_unavailable.description"))
      component.with_secondary_action(href: project_whiteboards_path(@project)) do
        t("whiteboards.leave")
      end
    end
  %>
<% end %>
