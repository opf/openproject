<%=
  component_wrapper do
    flex_layout(align_items: :center, text_align: :center, p: 3) do |body|
      if overbooked?
        body.with_row(mb: 2) do
          render(Primer::Beta::Octicon.new(:hourglass, size: :medium, color: :danger))
        end

        body.with_row(mb: 2) do
          render(Primer::Beta::Heading.new(tag: :h2, font_size: 4)) { overbooking_heading }
        end

        body.with_row(mb: working_schedule? ? 1 : 3) do
          render(Primer::Beta::Text.new(tag: :p, color: :muted, m: 0)) { overbooking_description }
        end

        if working_schedule?
          body.with_row(mb: 3) do
            render(Primer::Beta::Text.new(tag: :p, color: :muted, m: 0)) { schedule_note }
          end
        end

        body.with_row(w: :full, mb: 2, text_align: :left) do
          if unplannable?
            render(Primer::Beta::Text.new(tag: :p, m: 0)) { unplannable_note }
          else
            content_tag(:table, class: "generic-table") do
              thead = content_tag(:thead) do
                content_tag(:tr) do
                  safe_join(%i[date working_hours planned added overtime].map { |column| content_tag(:th, column_caption(column)) })
                end
              end

              tbody = content_tag(:tbody) do
                safe_join(
                  overbooked_days.map do |day|
                    content_tag(:tr) do
                      safe_join(
                        [
                          content_tag(:td, helpers.format_date(day.date)),
                          content_tag(:td, format_hours(day.working_minutes)),
                          content_tag(:td, format_hours(day.planned_minutes)),
                          content_tag(:td, format_hours(day.added_minutes)),
                          content_tag(:td, format_hours(day.overtime_minutes))
                        ]
                      )
                    end
                  end
                )
              end

              tfoot = content_tag(:tfoot) do
                content_tag(:tr) do
                  safe_join(
                    [
                      content_tag(:td, t("resource_management.allocate_resource_dialog.overbooking.total")),
                      content_tag(:td, format_hours(overbooked_days.sum(&:working_minutes))),
                      content_tag(:td, format_hours(overbooked_days.sum(&:planned_minutes))),
                      content_tag(:td, format_hours(overbooked_days.sum(&:added_minutes))),
                      content_tag(:td, format_hours(overbooked_days.sum(&:overtime_minutes)))
                    ]
                  )
                end
              end

              thead + tbody + tfoot
            end
          end
        end
      end

      body.with_row(w: :full) do
        form_with(
          url: form_url,
          method: form_method,
          id: form_id,
          data: { turbo_stream: true }
        ) do
          if hidden_fields
            safe_join(hidden_fields.map { |name, value| hidden_field_tag(name, value) })
          else
            safe_join(
              [
                (hidden_field_tag("filters", @filters) if @filters.present?),
                *@form_values.map { |name, value| hidden_field_tag("resource_allocation[#{name}]", value) }
              ].compact
            )
          end
        end
      end
    end
  end
%>
