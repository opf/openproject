<%= flex_layout(align_items: :center) do |row| %>
  <% row.with_column(mr: 2) do %>
    <%= radio_button_tag("principal_id", user.id, false, id: radio_id) %>
  <% end %>

  <% row.with_column(mr: 2) do %>
    <%= render(Users::AvatarComponent.new(user:, show_name: false, link: false, hover_card: { active: true })) %>
  <% end %>

  <% row.with_column(flex: 1) do %>
    <%= label_tag(radio_id, user.name, class: "FormControl-label") %>
  <% end %>

  <% if capacity_known? %>
    <% row.with_column(mr: fits? ? 0 : 1) do %>
      <%= render(Primer::Beta::Text.new(font_size: :small, color: :muted)) { available_label } %>
    <% end %>

    <% unless fits? %>
      <% row.with_column(display: :flex) do %>
        <%= warning_indicator(color: :danger, id: overbooked_tooltip_id, message: overbooked_message) %>
      <% end %>
    <% end %>
  <% else %>
    <%# No work schedule: we cannot tell whether the allocation fits. %>
    <% row.with_column(display: :flex) do %>
      <%= warning_indicator(color: :attention, id: no_schedule_tooltip_id, message: no_schedule_message) %>
    <% end %>
  <% end %>
<% end %>
