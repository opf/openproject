<%= component_wrapper do %>
  <% sections.each do |project, allocations| %>
    <%= render(
          Primer::OpenProject::CollapsibleSection.new(
            id: body_id(project),
            collapsed: allocations.empty?
          )
        ) do |section| %>
      <% section.with_title { project.name } %>
      <% section.with_additional_information do %>
        <%= render(Primer::Beta::Counter.new(count: allocations.size, scheme: :primary)) %>
      <% end %>
      <% section.with_collapsible_content do %>
        <%= render(table_for(allocations)) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
