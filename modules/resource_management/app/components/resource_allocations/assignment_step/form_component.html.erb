<%= component_wrapper do %>
  <% if error.present? %>
    <%= render(Primer::Beta::Flash.new(scheme: :danger, mb: 3)) { error } %>
  <% end %>

  <% if work_package %>
    <%= render(Primer::Box.new(mb: 3)) do %>
      <%= detail_label(t("resource_management.staffing.columns.work_package")) %>
      <%= render(WorkPackages::InfoLineComponent.new(work_package:, show_subject: true, show_status: true)) %>
    <% end %>
  <% end %>
  <%= detail_block(t("resource_management.assignment_dialog.requested_for"), period_label) %>
  <%= detail_block(t("resource_management.staffing.columns.requested_time"), requested_value) %>

  <% unless filter_summary.empty? %>
    <%= detail_block(t("resource_management.assignment_dialog.filter_criteria"), filter_summary.to_s) %>
  <% end %>

  <% if candidates.empty? %>
    <%= render(Primer::Beta::Blankslate.new(border: true)) do |blankslate|
          blankslate.with_visual_icon(icon: :people)
          blankslate.with_heading(tag: :h2) { t("resource_management.assignment_dialog.no_candidates.title") }
          blankslate.with_description { t("resource_management.assignment_dialog.no_candidates.description") }
        end %>
  <% else %>
    <%= form_with(url: form_url, method: :put, id: form_id, data: { turbo_stream: true }) do %>
      <%= render(Primer::Beta::BorderBox.new) do |box|
            candidates.each do |candidate|
              box.with_row do
                render(ResourceAllocations::AssignmentCandidateComponent.new(allocation:, user: candidate))
              end
            end
          end %>
    <% end %>
  <% end %>
<% end %>
