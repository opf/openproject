<%= flex_layout(align_items: :center, justify_content: :space_between, classes: "op-rm-timeline-resource") do |row| %>
  <% row.with_column(flex: 1, mr: 2) do %>
    <%= avatar(
          user,
          size: "default",
          hide_name: false,
          link: false,
          hover_card: { active: true }
        ) %>
  <% end %>
  <% if overbooked? %>
    <% row.with_column do %>
      <%= render(Primer::Beta::Octicon.new(icon: :alert, color: :danger, "aria-label": overbooked_label)) %>
    <% end %>
  <% elsif schedule_missing? %>
    <% row.with_column do %>
      <%= render Primer::Beta::Octicon.new(
            icon: :"alert-fill",
            color: :danger,
            id: no_work_schedule_tooltip_id,
            "aria-label": no_work_schedule_message
          ) %>
      <%= render Primer::Alpha::Tooltip.new(
            for_id: no_work_schedule_tooltip_id,
            type: :description,
            text: no_work_schedule_message,
            direction: :e
          ) %>
    <% end %>
  <% end %>
<% end %>
