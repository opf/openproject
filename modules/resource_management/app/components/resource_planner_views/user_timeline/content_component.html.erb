<%= content_tag(:div, container_attributes) do %>
  <%= render(
        ResourcePlannerViews::UserTimeline::SubHeaderComponent.new(
          project: @project, resource_planner: @resource_planner, view: @view
        )
      ) %>
  <% if users.empty? %>
    <%= render(Primer::Beta::Blankslate.new(border: true)) do |blankslate| %>
      <% blankslate.with_visual_icon(icon: :people) %>
      <% blankslate.with_heading(tag: :h2) { t("resource_management.user_timeline.blank.title") } %>
      <% blankslate.with_description { blank_description } %>
      <% if @view.manually_picked? %>
        <% blankslate.with_primary_action(
             label: t("resource_management.user_timeline.blank.add_user"),
             href: add_user_path,
             data: { controller: "async-dialog" }
           ) do |button| %>
          <% button.with_leading_visual_icon(icon: :plus) %>
          <%= t("resource_management.user_timeline.blank.add_user") %>
        <% end %>
      <% else %>
        <% blankslate.with_primary_action(
             label: t("resource_management.user_timeline.blank.configure_view"),
             href: configure_view_path,
             data: { controller: "async-dialog" }
           ) do |button| %>
          <% button.with_leading_visual_icon(icon: :gear) %>
          <%= t("resource_management.user_timeline.blank.configure_view") %>
        <% end %>
      <% end %>
    <% end %>
  <% else %>
    <div class="op-rm-timeline-canvas">
      <div class="op-rm-timeline" data-resource-management--resource-timeline-target="calendar"></div>
      <div class="op-rm-timeline-loading" data-resource-management--resource-timeline-target="loading">
        <%= render(Primer::Beta::Spinner.new(size: :large)) %>
        <span class="op-rm-timeline-loading--label"><%= t(:label_loading) %></span>
      </div>
    </div>
  <% end %>
<% end %>
