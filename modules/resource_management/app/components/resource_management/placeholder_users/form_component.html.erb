<%=
  component_wrapper do
    primer_form_with(
      model: @placeholder_user,
      scope: :placeholder_user,
      url: form_url,
      method: :post,
      html: {
        data: form_data,
        id: ResourceManagement::PlaceholderUsers::NewDialogComponent::FORM_ID
      }
    ) do |f|
      banner = if criteria_errors.any?
                 render(Primer::Alpha::Banner.new(icon: :stop, scheme: :danger, mb: 3)) do
                   criteria_errors.to_sentence
                 end
               end

      criteria = content_tag(:div, class: "op-filters-form -expanded") do
        render(criteria_form(f))
      end

      safe_join(
        [
          banner,
          render(ResourceManagement::PlaceholderUsers::Forms::DetailsForm.new(f)),
          criteria
        ].compact
      )
    end
  end
%>
