<%#
  Without the enterprise feature the planners index only shows an upsell banner,
  so there is nothing to navigate — skip the submenu and keep the plain project
  menu.

  `origin_controller` is forwarded so the lazily-loaded menu can highlight a
  static entry (e.g. Staffing); planner entries highlight via the `id` param.
%>
<% if EnterpriseToken.allows_to?(:resource_management) %>
  <% menu_src = menu_project_resource_planners_path(@project, **params.permit(:id), origin_controller: params[:controller]) %>
  <%= turbo_frame_tag "resource_planners_sidemenu",
                      src: menu_src,
                      target: "_top",
                      data: { turbo: false, query_param: "id" },
                      loading: :lazy %>
<% end %>
