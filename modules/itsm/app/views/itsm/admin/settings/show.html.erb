<% html_title t(:label_administration), t(:label_helpdesk), t(:label_setting_plural) %>

<%= render(ITSM::Admin::PageHeaderComponent.new) %>

<%=
  render(Primer::BaseComponent.new(tag: :div, mb: 3, classes: "op-admin-settings-form-wrapper")) do
    render(
      Primer::Forms::ToggleSwitchForm.new(
        name: :enable_helpdesk,
        label: I18n.t("admin.enable_helpdesk"),
        src: enable_helpdesk_itsm_admin_settings_path,
        csrf_token: form_authenticity_token,
        status_label_position: :start,
        checked: @helpdesk_enabled,
        enabled: @helpdesk_feature_writable,
        caption: @helpdesk_feature_writable ? "" : I18n.t("admin.helpdesk_set_by_environment"),
        data: { turbo: true },
        test_selector: "toggle-helpdesk-enabled",
        input_width: :large
      )
    )
  end
%>

<%= render(ITSM::Admin::HelpdeskSettingsComponent.new(enabled: @helpdesk_enabled)) %>
