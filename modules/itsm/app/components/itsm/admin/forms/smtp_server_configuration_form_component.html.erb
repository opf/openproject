<%=
  component_wrapper do
    flex_layout(mb: 3) do |container|
      container.with_row do
        render(Primer::Beta::Text.new(font_weight: :bold)) { t("itsm.admin.server_configuration_form.smtp.title") }
      end

      container.with_row do
        render(Primer::Beta::Text.new(test_selector: "smtp-server-configuration-instructions")) do
          t("itsm.admin.server_configuration_form.smtp.instruction")
        end
      end

      container.with_row(mt: 3) do
        settings_primer_form_with(
          model:,
          url: itsm_admin_settings_path,
          method: :put
        ) do |form|
          render(ITSM::Admin::ServerConfigurationForm.new(form))
        end
      end
    end
  end
