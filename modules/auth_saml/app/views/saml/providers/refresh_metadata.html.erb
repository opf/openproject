<% html_title(t(:label_administration), t("saml.providers.metadata_refresh.title"), @provider.display_name) %>

<%= render(Primer::OpenProject::PageHeader.new) do |header| %>
  <% header.with_title { t("saml.providers.metadata_refresh.title") } %>
  <% header.with_breadcrumbs(
       [{ href: admin_index_path, text: t(:label_administration) },
        { href: saml_providers_path, text: t("saml.providers.plural") },
        { href: saml_provider_path(@provider), text: @provider.display_name },
        t("saml.providers.metadata_refresh.title")]
     ) %>
  <% header.with_description { t("saml.providers.metadata_refresh.description") } %>
<% end %>

<% if @metadata_changes.empty? %>
  <%= render(Primer::Alpha::Banner.new) { t("saml.providers.metadata_refresh.no_changes") } %>
<% else %>
  <%= render(Saml::Providers::MetadataChanges::TableComponent.new(rows: @metadata_changes.to_a, provider: @provider)) %>
<% end %>

<%= form_with(url: apply_metadata_saml_provider_path(@provider), method: :post) do %>
  <%= hidden_field_tag :metadata_token, @metadata_token %>
  <%= flex_layout(align_items: :center, mt: 3) do |actions|
        actions.with_column(mr: 2) do
          render(Primer::Beta::Button.new(type: :submit, scheme: :primary)) { t("saml.providers.metadata_refresh.apply") }
        end
        actions.with_column do
          render(Primer::Beta::Button.new(tag: :a, href: saml_provider_path(@provider))) { t(:button_cancel) }
        end
      end %>
<% end %>
