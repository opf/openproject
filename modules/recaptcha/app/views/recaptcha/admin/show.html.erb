<% html_title(t(:label_administration), t("recaptcha.label_recaptcha")) -%>

<%=
  render Primer::OpenProject::PageHeader.new do |header|
    header.with_title { I18n.t("recaptcha.label_recaptcha") }
    header.with_breadcrumbs(
      [{ href: admin_index_path, text: t(:label_administration) },
       { href: admin_settings_authentication_path, text: t(:label_authentication) },
       I18n.t("recaptcha.label_recaptcha")]
    )
  end
%>

<%
  type_caption = t(
    "recaptcha.settings.captcha_description_html",
    hcaptcha_link: link_to("https://docs.hcaptcha.com/switch/", "https://docs.hcaptcha.com/switch/", target: "_blank"),
    recaptcha_link: link_to("https://www.google.com/recaptcha", "https://www.google.com/recaptcha", target: "_blank"),
    turnstile_link: link_to("https://developers.cloudflare.com/turnstile/", "https://developers.cloudflare.com/turnstile/", target: "_blank")
  )
%>
<%= settings_primer_form_with(
    scope: :settings,
    model: false,
    method: :patch,
    url: { action: :update },
    id: "update-recaptcha-settings-form"
  ) do |f| %>
  <%= render(Admin::Settings::RecaptchaSettingsForm.new(f, type_caption:)) %>
<% end %>
