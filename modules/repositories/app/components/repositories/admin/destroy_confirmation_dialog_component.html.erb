<%=
  render(
    Primer::OpenProject::DangerDialog.new(
      title: t(".title"),
      form_arguments:,
      size: :large,
      test_selector: "repository-provider-destroy-dialog"
    )
  ) do |dialog|
    dialog.with_confirmation_message do |message|
      message.with_heading(tag: :h2) { t(".heading") }
    end
    dialog.with_additional_details do
      flex_layout do |flex|
        flex.with_row { t(".description_html", provider: content_tag(:strong, @provider.name)) }
        flex.with_row do
          content_tag(:ul) do
            safe_join(
              %i[issues merge_requests branches_and_commits].map { content_tag(:li, t(".delete_result.#{it}")) }
            )
          end
        end
      end
    end
    dialog.with_confirmation_check_box_content(t(:text_permanent_delete_confirmation_checkbox_label))
  end
%>
