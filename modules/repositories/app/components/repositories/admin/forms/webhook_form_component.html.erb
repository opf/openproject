<%=
  component_wrapper do
    flex_layout(mb: 3) do |rows|
      rows.with_row do
        render(Primer::Beta::Text.new(font_weight: :bold)) { title }
      end

      rows.with_row do
        render(Primer::Beta::Text.new(color: :subtle)) { t("repositories.admin.steps.webhook.form_description") }
      end

      rows.with_row(mt: 3) do
        render(Primer::OpenProject::InputGroup.new(input_width: :xlarge)) do |input_group|
          input_group.with_text_input(
            name: :webhook_url,
            label: t("repositories.admin.steps.webhook.url"),
            visually_hide_label: false,
            value: webhook_url,
            readonly: true
          )
          input_group.with_trailing_action_clipboard_copy_button(value: webhook_url, aria: { label: t(:button_copy_to_clipboard) })
          input_group.with_caption { t("repositories.admin.steps.webhook.url_caption") }
        end
      end

      rows.with_row(mt: 3) do
        render(Primer::OpenProject::InputGroup.new(input_width: :xlarge)) do |input_group|
          input_group.with_text_input(
            name: :webhook_secret,
            label: t("repositories.admin.steps.webhook.secret"),
            visually_hide_label: false,
            value: provider.webhook_secret,
            readonly: true,
            test_selector: "repository-provider-webhook-secret"
          )
          input_group.with_trailing_action_clipboard_copy_button(
            value: provider.webhook_secret.to_s,
            aria: { label: t(:button_copy_to_clipboard) }
          )
          input_group.with_caption { t("repositories.admin.steps.webhook.secret_caption") }
        end
      end

      rows.with_row(mt: 3) do
        flex_layout(justify_content: :flex_start) do |buttons|
          buttons.with_column(mr: 2) do
            render(Primer::Beta::Button.new(scheme: :primary, tag: :a, href: done_path, data: { turbo_frame: "_top" })) do
              t(:button_finish_setup)
            end
          end

          unless in_wizard
            buttons.with_column do
              render(
                Primer::Beta::Button.new(
                  scheme: :danger,
                  tag: :a,
                  href: regenerate_path,
                  test_selector: "repository-provider-regenerate-webhook-secret-button",
                  data: { turbo_frame: "_top", controller: "async-dialog" }
                )
              ) do |button|
                button.with_leading_visual_icon(icon: :sync)
                t("repositories.admin.steps.webhook.regenerate_secret")
              end
            end
          end
        end
      end
    end
  end
%>
