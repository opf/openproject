<%=
  component_wrapper do
    grid_layout("op-repositories-step-info--row", tag: :div, align_items: :center) do |grid|
      grid.with_area(:item, tag: :div, mr: 3) do
        concat(render(Primer::Beta::Text.new(font_weight: :bold, mr: 1)) { title })
        if completed?
          concat(render(Primer::Beta::Label.new(scheme: :success)) { t(:label_completed) })
        else
          concat(render(Primer::Beta::Label.new(scheme: :attention)) { t(:label_incomplete) })
        end
      end

      grid.with_area(:description, classes: "wb-break-word", tag: :div, color: :subtle) do
        description
      end

      if provider.persisted?
        grid.with_area(:"icon-button", tag: :div, color: :muted) do
          flex_layout(justify_content: :flex_end) do |icons|
            icons.with_column do
              render(
                Primer::Beta::IconButton.new(
                  icon: :pencil,
                  tag: :a,
                  scheme: :invisible,
                  href: edit_path,
                  aria: { label: t("repositories.admin.steps.#{self.class.step_name}.edit") },
                  test_selector: "repository-provider-edit-#{self.class.step_name}-button",
                  data: { turbo_stream: true }
                )
              )
            end
          end
        end
      end
    end
  end
%>
