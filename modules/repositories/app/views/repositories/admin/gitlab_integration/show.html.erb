<% html_title t(:label_administration), "GitLab" %>

<% content_for :content_header do %>
  <%= render(Primer::OpenProject::PageHeader.new) do |header| %>
    <% header.with_title { I18n.t("repositories.provider_types.gitlab.name") } %>
    <% header.with_breadcrumbs(
         [
           { href: admin_index_path, text: t(:label_administration) },
           I18n.t("repositories.provider_types.gitlab.name")
         ]
       ) %>
  <% end %>
<% end %>

<%=
  render(Primer::Alpha::Banner.new(scheme: :default, icon: :info, test_selector: "gitlab-integration-moved-banner")) do |banner|
    banner.with_action_button(tag: :a, href: admin_settings_repository_providers_path) do
      t("repositories.admin.gitlab_integration.go_to_repositories")
    end

    t("repositories.admin.gitlab_integration.moved_notice")
  end
%>
