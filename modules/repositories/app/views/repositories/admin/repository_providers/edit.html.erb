<% html_title t(:label_administration), t("repositories.admin.menu"), @provider.name %>

<%= turbo_frame_tag "repository-provider", data: { turbo_action: "advance" } do %>
  <%= render(Primer::OpenProject::PageHeader.new) do |header| %>
    <% header.with_title do %>
      <%= @provider.name %>
      <%= render(Primer::Beta::Text.new(tag: :span, font_weight: :light, color: :muted)) do %>
        (<%= t("repositories.provider_types.#{@provider}.name") %>)
      <% end %>
    <% end %>

    <% header.with_breadcrumbs(
         [
           { href: admin_index_path, text: t(:label_administration) },
           { href: admin_settings_repository_providers_path, text: t("repositories.admin.menu") },
           @provider.name
         ]
       ) %>

    <%
      header.with_action_button(
        tag: :a,
        scheme: :danger,
        mobile_icon: :trash,
        mobile_label: t(:button_delete),
        size: :medium,
        href: confirm_destroy_admin_settings_repository_provider_path(@provider),
        aria: { label: t(:button_delete) },
        title: t(:button_delete),
        test_selector: "repository-provider-delete-button",
        data: { turbo_frame: "_top", controller: "async-dialog" }
      ) do |button|
        button.with_leading_visual_icon(icon: :trash)
        t(:button_delete)
      end
    %>
  <% end %>

  <%= render(Repositories::Admin::ProviderViewComponent.new(@provider, wizard: @wizard)) %>
<% end %>
