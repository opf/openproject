<% page_title = t("repositories.admin.label_new_provider", provider_type: t("repositories.provider_types.#{@provider}.name")) %>
<% html_title t(:label_administration), t("repositories.admin.menu"), page_title %>

<%= turbo_frame_tag "repository-provider", data: { turbo_action: "advance" } do %>
  <%= render(Primer::OpenProject::PageHeader.new) do |header| %>
    <% header.with_title(test_selector: "repository-provider-new-page-header--title") { page_title } %>

    <% header.with_breadcrumbs(
         [
           { href: admin_index_path, text: t(:label_administration) },
           { href: admin_settings_repository_providers_path, text: t("repositories.admin.menu") },
           page_title
         ]
       ) %>
  <% end %>

  <%= render(Repositories::Admin::ProviderViewComponent.new(@provider, wizard: @wizard, wizard_step: @target_step)) %>
<% end %>
