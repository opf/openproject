{
  "name": "op-blocknote-extensions",
  "private": true,
  "version": "0.2.3",
  "type": "module",
  "module": "./dist/op-blocknote-extensions.es.js",
  "types": "./dist/index.d.ts",
  "main": "./dist/op-blocknote-extensions.cjs.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/op-blocknote-extensions.es.js",
      "require": "./dist/op-blocknote-extensions.cjs.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/op-blocknote-extensions-server.es.js",
      "require": "./dist/op-blocknote-extensions-server.cjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "buildExternals": [
    "react",
    "react-dom",
    "@blocknote/core",
    "@blocknote/react",
    "@blocknote/mantine",
    "yjs",
    "use-sync-external-store"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -b tsconfig.lib.json",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "coverage": "vitest run --coverage",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mantine/core": "^9.5.2",
    "@mantine/hooks": "^9.4.1",
    "@mantine/utils": "^6.0.22",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/styled-components": "^5.1.36",
    "@blocknote/core": "^0.51.3",
    "@blocknote/mantine": "^0.51.3",
    "@blocknote/react": "^0.51.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  },
  "peerDependencies": {
    "@blocknote/core": ">=0.51.3",
    "@blocknote/mantine": ">=0.51.3",
    "@blocknote/react": ">=0.51.3"
  },
  "peerDependenciesMeta": {
    "@blocknote/mantine": { "optional": true },
    "@blocknote/react": { "optional": true }
  },
  "dependencies": {
    "@primer/octicons-react": "^19.33.0",
    "i18next": "^26.4.0",
    "react-i18next": "^17.0.12",
    "styled-components": "^6.5.3",
    "use-sync-external-store": "^1.6.0"
  }
}
