{
  "name": "op-blocknote-extensions",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "module": "./dist/op-blocknote-extensions.es.js",
  "types": "./dist/index.d.ts",
  "main": "./dist/op-blocknote-extensions.cjs.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/op-blocknote-extensions.es.js",
      "require": "./dist/op-blocknote-extensions.cjs.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/op-blocknote-extensions-server.es.js",
      "require": "./dist/op-blocknote-extensions-server.cjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -b tsconfig.lib.json",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "coverage": "vitest run --coverage",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@mantine/core": "^8.3.6",
    "@mantine/hooks": "^8.3.5",
    "@mantine/utils": "^6.0.22",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.9.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/styled-components": "^5.1.35",
    "@blocknote/core": "^0.51.3",
    "@blocknote/mantine": "^0.51.3",
    "@blocknote/react": "^0.51.3",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "@types/testing-library__react": "^10.0.1",
    "@types/testing-library__user-event": "^4.1.1",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.4.0",
    "jsdom": "^29.0.1",
    "msw": "^2.12.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.12",
    "vitest": "^4.0.18",
    "vitest-browser-react": "^2.0.5"
  },
  "peerDependencies": {
    "@blocknote/core": ">=0.51.3",
    "@blocknote/mantine": ">=0.51.3",
    "@blocknote/react": ">=0.51.3"
  },
  "peerDependenciesMeta": {
    "@blocknote/mantine": { "optional": true },
    "@blocknote/react": { "optional": true }
  },
  "dependencies": {
    "@primer/octicons-react": "^19.20.0",
    "i18next": "^25.6.3",
    "react-i18next": "^16.3.5",
    "styled-components": "^6.1.19"
  }
}
