{
  "name": "@openproject/blocknote-extensions",
  "version": "0.3.4",
  "description": "Extensions for BlockNote for integrating with OpenProject",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opf/openproject.git",
    "directory": "extensions/blocknote-extensions"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "module": "./dist/blocknote-extensions.es.js",
  "types": "./dist/index.d.ts",
  "main": "./dist/blocknote-extensions.cjs.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/blocknote-extensions.es.js",
      "require": "./dist/blocknote-extensions.cjs.js"
    },
    "./editor.css": "./dist/blocknote-extensions.css",
    "./primer": {
      "types": "./dist/primer.d.ts",
      "import": "./dist/blocknote-extensions-primer.es.js",
      "require": "./dist/blocknote-extensions-primer.cjs.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/blocknote-extensions-server.es.js",
      "require": "./dist/blocknote-extensions-server.cjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "buildExternals": [
    "@floating-ui/react",
    "@primer/react",
    "react",
    "react-dom",
    "@blocknote/core",
    "@blocknote/react",
    "yjs",
    "use-sync-external-store",
    "prosemirror-model",
    "prosemirror-state",
    "flatpickr",
    "luxon"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -b tsconfig.lib.json",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "coverage": "vitest run --coverage",
    "changelog": "node scripts/changelog.ts",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@primer/primitives": "^11.10.0",
    "@primer/react": "38.46.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/styled-components": "^5.1.36",
    "@blocknote/core": "^0.55.0",
    "@blocknote/react": "^0.55.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "msw": "^3.0.2",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.5",
    "vitest-browser-react": "^2.3.0"
  },
  "peerDependencies": {
    "@primer/react": "^38.46.0",
    "@blocknote/core": ">=0.55.0",
    "@blocknote/react": ">=0.55.0",
    "prosemirror-model": "^1.25.11",
    "prosemirror-state": "^1.4.4"
  },
  "peerDependenciesMeta": {
    "@primer/react": { "optional": true },
    "@blocknote/react": { "optional": true }
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@primer/octicons-react": "^19.38.0",
    "flatpickr": "^4.6.13",
    "i18next": "^26.4.2",
    "luxon": "^3.7.2",
    "react-i18next": "^17.0.15",
    "styled-components": "^6.5.3",
    "use-sync-external-store": "^1.7.0"
  }
}
