<%= render(Primer::Forms::FormControl.new(input: @input)) do %>
  <%= content_tag(:div, **field_wrap_arguments, data: { controller: "file-field" }) do %>
    <%=
      builder.file_field(
        name,
        hidden: true,
        accept:,
        disabled: @input.disabled?,
        data: {
          "file-field-target": "file",
          action: file_input_actions
        }
      )
    %>

    <%=
      content_tag(
        :button,
        type: "button",
        class: "FormControl-file-field-drop-zone",
        disabled: @input.disabled?,
        "aria-label": label,
        data: {
          "file-field-target": "dropBox",
          action: "click->file-field#openFilePicker
                   dragover->file-field#dragOver
                   dragleave->file-field#dragLeave
                   drop->file-field#dropFile"
        }
      ) do
    %>
      <%= content_tag(:img, nil, **preview_attributes) %>
      <span class="FormControl-file-field-placeholder">
        <%= render(Primer::Beta::Octicon.new(icon:, classes: "FormControl-file-field-icon")) %>
        <span class="FormControl-file-field-label"
              data-file-field-target="filename"
              data-empty="<%= label %>"><%= displayed_label %></span>
        <% if description.present? %>
          <span class="FormControl-caption"><%= description %></span>
        <% end %>
      </span>
    <% end %>

    <% if has_attachment? && !@input.disabled? %>
      <span class="FormControl-file-field-menu">
        <%= render(Primer::Alpha::ActionMenu.new) do |menu| %>
          <% menu.with_show_button(icon: "kebab-horizontal", "aria-label": menu_label, scheme: :invisible) %>
          <% menu.with_item(**replace_item_arguments) { |item| item.with_leading_visual_icon(icon: :sync) } %>
          <% if delete_path.present? %>
            <% menu.with_item(**delete_item_arguments) { |item| item.with_leading_visual_icon(icon: :trash) } %>
          <% end %>
        <% end %>
      </span>
    <% end %>
  <% end %>
<% end %>
