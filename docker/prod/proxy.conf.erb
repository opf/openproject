<% server_name = ENV.fetch("SERVER_NAME") { "_default_" } %>
<% unless server_name == "_default_" %>
<VirtualHost *:80>
  ServerName _default_
  DocumentRoot /var/www/html
</VirtualHost>
<% end %>

<VirtualHost *:80>
  ServerName <%= server_name %>
  DocumentRoot <%= ENV.fetch("APP_PATH") %>/public

  ProxyRequests off
  ProxyPreserveHost On

  <% location = ENV.fetch("OPENPROJECT_RAILS__RELATIVE__URL__ROOT", "").chomp("/") %>
  <Location <%= location == "" ? "/" : location %>>
    ProxyPass http://<%= ENV.fetch("APP_HOST", "127.0.0.1") %>:8080<%= location %>/ retry=0
    ProxyPassReverse http://<%= ENV.fetch("APP_HOST", "127.0.0.1") %>:8080<%= location %>/
  </Location>

  # If the request is for a file in public/, do not send it to Puma.
  # Apache serves the file from disk.
  SetEnvIfExpr "%{REQUEST_URI} =~ m#^<%= location %>(/.+)$# && -f '<%= ENV.fetch("APP_PATH") %>/public$1'" no-proxy=1

  Alias <%= location %>/ <%= ENV.fetch("APP_PATH") %>/public/

  <Directory <%= ENV.fetch("APP_PATH") %>/public>
    Options -Indexes
    Require all granted
  </Directory>

  <Directory <%= ENV.fetch("APP_PATH") %>/public/assets>
    # The file names contain a content hash. Thus browsers can keep the files for one year.
    Header set Cache-Control "public, max-age=31536000, immutable"

    # Send the .br or .gz file if the browser accepts it and the file exists.
    RewriteEngine On
    RewriteBase <%= location %>/assets/
    RewriteCond %{HTTP:Accept-Encoding} \bbr\b
    RewriteCond %{REQUEST_FILENAME}.br -s
    RewriteRule ^(.+\.(js|css|svg))$ $1.br [L]
    RewriteCond %{HTTP:Accept-Encoding} \bgzip\b
    RewriteCond %{REQUEST_FILENAME}.gz -s
    RewriteRule ^(.+\.(js|css|svg))$ $1.gz [L]

    # Set the content type of the original file.
    # Do not let mod_deflate compress the file again.
    RewriteRule \.js\.(br|gz)$ - [T=text/javascript,E=no-gzip:1,E=no-brotli:1]
    RewriteRule \.css\.(br|gz)$ - [T=text/css,E=no-gzip:1,E=no-brotli:1]
    RewriteRule \.svg\.(br|gz)$ - [T=image/svg+xml,E=no-gzip:1,E=no-brotli:1]

    # Tell the browser how the file is compressed.
    # Tell caches that the response changes with Accept-Encoding.
    <FilesMatch "\.(js|css|svg)\.br$">
      Header set Content-Encoding br
    </FilesMatch>
    <FilesMatch "\.(js|css|svg)\.gz$">
      Header set Content-Encoding gzip
    </FilesMatch>
    <FilesMatch "\.(js|css|svg)(\.br|\.gz)?$">
      Header append Vary Accept-Encoding
    </FilesMatch>
  </Directory>

  <Directory <%= ENV.fetch("APP_PATH") %>/public/assets/frontend/assets>
    # Angular copies frontend/src/assets to this folder.
    # These files are fonts, images etc. and have no content hash. Do not mark them as immutable.
    Header set Cache-Control "public, max-age=31536000"
  </Directory>

  <Location /hocuspocus>
    ProxyPass http://<%= ENV.fetch("APP_HOST", "127.0.0.1") %>:1234/ upgrade=websocket
    ProxyPassReverse http://<%= ENV.fetch("APP_HOST", "127.0.0.1") %>:1234/
  </Location>
</VirtualHost>
