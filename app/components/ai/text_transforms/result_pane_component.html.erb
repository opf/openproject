<%= component_wrapper(data: wrapper_data) do %>
  <%=
    render(
      Primer::BaseComponent.new(
        tag: :div,
        role: :dialog,
        aria: { label: label(:title) },
        tabindex: -1,
        data: target(:pane),
        position: :fixed,
        display: :flex,
        direction: :column,
        classes: "op-ai-result-pane"
      )
    ) do
      safe_join(
        [
          render(Primer::Beta::BorderBox.new(flex: 1, overflow: :hidden, display: :flex, direction: :column, box_shadow: :extra_large)) do |box|
            box.with_header(classes: "op-ai-result-pane--handle", data: action(beginDrag: :pointerdown)) do
              flex_layout(align_items: :center, justify_content: :space_between) do |header|
                header.with_column { render(Title.new(pane:)) }
                header.with_column do
                  render(Primer::Beta::CloseButton.new("aria-label": label(:close), data: action(close: :click)))
                end
              end
            end
            box.with_body(flex: 1, overflow: :auto) { render(Body.new(pane:)) }
            box.with_footer(bg: :subtle) { render(Footer.new(pane:)) }
          end,
          *RESIZE_HANDLES.map do |edge, icon|
            render(
              Primer::BaseComponent.new(
                tag: :span,
                classes: "op-ai-result-pane--resize op-ai-result-pane--resize_#{edge}",
                data: { edge:, **action(beginResize: :pointerdown) },
                "aria-hidden": true
              )
            ) do
              render(Primer::Beta::Octicon.new(icon:, color: :muted))
            end
          end
        ]
      )
    end
  %>
<% end %>
