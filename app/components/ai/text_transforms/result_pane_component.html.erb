<%= component_wrapper(data: wrapper_data) do %>
  <%=
    render(
      Primer::BaseComponent.new(
        tag: :div,
        role: :dialog,
        aria: { label: label(:title) },
        position: :fixed,
        display: :flex,
        direction: :column,
        classes: "op-ai-result-pane",
        data: target(:pane)
      )
    ) do
      safe_join(
        [
          render(Primer::Beta::BorderBox.new(flex: 1, overflow: :hidden, display: :flex, direction: :column, box_shadow: :extra_large)) do |box|
            box.with_header(data: action(:beginDrag, event: "pointerdown"), classes: "op-ai-result-pane--handle") do
              flex_layout(align_items: :center, justify_content: :space_between) do |header|
                header.with_column { section(:title) }
                header.with_column do
                  render(Primer::Beta::CloseButton.new("aria-label": label(:close), type: :submit, form: CLOSE_FORM_ID))
                end
              end
            end
            box.with_body(flex: 1, overflow: :auto) { section(:body) }
            box.with_footer(bg: :subtle) { section(:footer) }
          end,
          *EDGES.map do |edge|
            render(
              Primer::BaseComponent.new(
                tag: :span,
                classes: "op-ai-result-pane--resize op-ai-result-pane--resize_#{edge}",
                data: action(:beginResize, event: "pointerdown").merge(edge:),
                "aria-hidden": true
              )
            )
          end
        ]
      )
    end
  %>
<% end %>
