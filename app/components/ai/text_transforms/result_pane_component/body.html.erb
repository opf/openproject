<%= component_wrapper do %>
  <%=
    flex_layout(direction: :column) do |body|
      if banner_scheme
        body.with_row(mb: 3) do
          render(Primer::Alpha::Banner.new(scheme: banner_scheme, description: banner_description)) { banner_title }
        end
      end
      if done?
        body.with_row(mb: 3, hidden: true, test_selector: "ai-text-transform-pane-apply-failed") do
          render(Primer::Alpha::Banner.new(scheme: :danger)) do
            render(Primer::Beta::Text.new(tag: :span)) { "" }
          end
        end
      end
      if text?
        body.with_row do
          render(Primer::BaseComponent.new(tag: :div, classes: "op-uc-container")) { output }
        end
      end
      if done?
        body.with_row { content_tag(:template, pane.text) }
      end
    end
  %>
<% end %>
