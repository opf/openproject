<%= component_wrapper do %>
  <%=
    flex_layout(align_items: :center, classes: "op-ai-result-pane--footer") do |bar|
      bar.with_column(mr: 2, classes: "op-ai-result-pane--grip", data: action(beginDrag: :pointerdown)) do
        render(Primer::Beta::Octicon.new(icon: :grabber, color: :muted))
      end
      bar.with_column(flex: 1) do
        case state
        when "generating"
          flex_layout(align_items: :center, justify_content: :space_between) do |footer|
            footer.with_column do
              render(Primer::Beta::Text.new(color: :muted)) { label(:generating) }
            end
            footer.with_column do
              render(Primer::Beta::Button.new) { label(:cancel) }
            end
          end
        when "done"
          flex_layout(align_items: :center) do |footer|
            footer.with_column(flex: 1) do
              render(Primer::Beta::ClipboardCopyButton.new(scheme: :invisible, value: pane.text, "aria-label": label(:copy)))
            end
            footer.with_column(mr: 2) do
              render(Primer::Beta::Button.new) { label(:discard) }
            end
            footer.with_column do
              render(Primer::Beta::Button.new(scheme: :primary)) { label(:replace) }
            end
          end
        else
          flex_layout(align_items: :center, justify_content: :flex_end) do |footer|
            if pane.run
              footer.with_column(mr: 2) do
                render(Primer::Beta::Button.new) { label(:try_again) }
              end
            end
            footer.with_column do
              render(Primer::Beta::Button.new) { label(:close) }
            end
          end
        end
      end
    end
  %>
<% end %>
