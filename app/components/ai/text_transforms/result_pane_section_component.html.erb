<%= component_wrapper do %>
  <% case section %>
  <% when :title %>
    <%=
      flex_layout(align_items: :center) do |header|
        header.with_column(mr: 2) do
          render(Primer::Beta::Octicon.new(icon: :copilot, color: :done, size: :medium))
        end
        header.with_column do
          render(Primer::Beta::Heading.new(tag: :h2, font_size: 4)) { pane.label }
        end
      end
    %>
  <% when :body %>
    <%=
      flex_layout(direction: :column) do |body|
        body.with_row(mb: 3, text_align: :right) do
          render(Primer::Beta::Label.new(scheme: :done, size: :large)) { context_label }
        end
        if state == "stopped"
          body.with_row(mb: 3) do
            render(Primer::Alpha::Banner.new(scheme: :warning, description: label(:stopped_description))) { label(:stopped_title) }
          end
        end
        if state == "failed"
          body.with_row(mb: 3) do
            render(Primer::Alpha::Banner.new(scheme: :danger)) do
              safe_join(
                [
                  render(Primer::Beta::Text.new(tag: :p, font_weight: :bold, mb: 1)) { label(:failed_title) },
                  render(Primer::Beta::Text.new(tag: :span)) { pane.error_message }
                ]
              )
            end
          end
        end
        if state == "done"
          body.with_row(mb: 3, hidden: true, data: target(:applyFailed)) do
            render(Primer::Alpha::Banner.new(scheme: :danger)) do
              render(Primer::Beta::Text.new(tag: :span, data: target(:applyFailedMessage))) { "" }
            end
          end
        end
        if %w[generating done].include?(state)
          body.with_row do
            render(Primer::BaseComponent.new(tag: :div, classes: "op-uc-container")) { output }
          end
        end
        if state == "done"
          body.with_row { content_tag(:template, pane.text, data: target(:raw)) }
        end
      end
    %>
  <% when :footer %>
    <%= content_tag(:span, nil, hidden: true, data: state_data) %>
    <%= form(id: CLOSE_FORM_ID, url: helpers.ai_text_transform_pane_path(pane.uuid), method: :delete) %>
    <%= form(id: APPLY_FORM_ID, url: helpers.apply_ai_text_transform_pane_path(pane.uuid), method: :post) if state == "done" %>
    <%= form(id: RETRY_FORM_ID, url: helpers.ai_text_transform_panes_path, method: :post, fields: retry_params) if pane.run && %w[failed stopped].include?(state) %>
    <%=
      flex_layout(align_items: :center, classes: "op-ai-result-pane--footer") do |bar|
        bar.with_column(mr: 2, classes: "op-ai-result-pane--grip", data: action(:beginDrag, event: "pointerdown")) do
          render(Primer::Beta::Octicon.new(icon: :grabber, color: :muted))
        end
        bar.with_column(flex: 1) do
          case state
          when "generating"
            flex_layout(align_items: :center, justify_content: :space_between) do |footer|
              footer.with_column do
                render(Primer::Beta::Text.new(color: :muted)) { label(:generating) }
              end
              footer.with_column do
                render(Primer::Beta::Button.new(type: :submit, form: CLOSE_FORM_ID)) { label(:cancel) }
              end
            end
          when "done"
            flex_layout(align_items: :center) do |footer|
              footer.with_column(flex: 1) do
                render(Primer::Beta::Button.new(scheme: :invisible, data: action(:copy))) do |button|
                  button.with_leading_visual_icon(icon: :copy)
                  content_tag(:span, label(:copy), data: target(:copyLabel))
                end
              end
              footer.with_column(mr: 2) do
                render(Primer::Beta::Button.new(type: :submit, form: CLOSE_FORM_ID)) { label(:discard) }
              end
              footer.with_column do
                render(Primer::Beta::Button.new(scheme: :primary, type: :submit, form: APPLY_FORM_ID)) { label(:replace) }
              end
            end
          else
            flex_layout(align_items: :center, justify_content: :flex_end) do |footer|
              if pane.run
                footer.with_column(mr: 2) do
                  render(Primer::Beta::Button.new(type: :submit, form: RETRY_FORM_ID)) do |button|
                    button.with_leading_visual_icon(icon: :sync)
                    label(:try_again)
                  end
                end
              end
              footer.with_column do
                render(Primer::Beta::Button.new(type: :submit, form: CLOSE_FORM_ID)) { label(:close) }
              end
            end
          end
        end
      end
    %>
  <% end %>
<% end %>
