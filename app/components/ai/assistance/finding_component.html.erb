<%= component_wrapper(data: { test_selector: "ai-assistance-finding" }) do %>
  <%= flex_layout(align_items: :flex_start) do |row| %>
    <% row.with_column(flex: 1) do %>
      <%= render(Primer::Beta::Label.new(scheme: severity_scheme, mr: 2)) { severity_label } %>
      <%= render(Primer::Beta::Text.new(color: :muted, font_size: :small)) { area_label } %>
      <%= render(Primer::Beta::Text.new(tag: :p, mt: 1, mb: 1, color: text_color)) { finding.text } %>
      <ul class="mb-0 pl-3" data-test-selector="ai-assistance-evidence">
        <% finding.evidence.each do |item| %>
          <li>
            <% if evidence_href(item) %>
              <%= render(Primer::Beta::Link.new(**evidence_link_arguments(item))) { item["text"] } %>
            <% else %>
              <%= render(Primer::Beta::Text.new(color: :muted)) { item["text"] } %>
            <% end %>
          </li>
        <% end %>
      </ul>
      <% if error %>
        <%= render(Primer::Alpha::Banner.new(scheme: error == :conflict ? :warning : :danger, mt: 2, data: { test_selector: "ai-assistance-apply-error" })) do %>
          <%= t("ai_assistance.apply.errors.#{error}") %>
        <% end %>
      <% end %>
      <%= render(AI::Assistance::ProposalComponent.new(proposal: finding, apply_path:)) %>
    <% end %>
    <% row.with_column do %>
      <% if finding.open? %>
        <%= render(Primer::Alpha::ActionMenu.new(anchor_align: :end)) do |menu| %>
          <% menu.with_show_button(size: :small, scheme: :invisible, data: { test_selector: "ai-assistance-dismiss" }) do |button| %>
            <% button.with_trailing_action_icon(icon: :"triangle-down") %>
            <%= t("ai_assistance.finding.dismiss") %>
          <% end %>
          <% menu.with_item(label: t("ai_assistance.finding.dismiss"), href: dismiss_path, form_arguments: { method: :post }) %>
          <% menu.with_divider %>
          <% dismiss_reasons.each do |reason| %>
            <% menu.with_item(label: t("ai_assistance.finding.dismiss_reasons.#{reason}"), href: dismiss_path(reason), form_arguments: { method: :post }) %>
          <% end %>
        <% end %>
      <% elsif finding.dismissed? %>
        <%= render(Primer::Beta::Label.new(scheme: :secondary)) { t("ai_assistance.finding.dismissed") } %>
      <% elsif finding.applied? %>
        <%= render(Primer::Beta::Label.new(scheme: :success)) { t("ai_assistance.finding.applied") } %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
