<%= component_wrapper(data: { test_selector: "ai-assistance-proposal" }) do %>
  <%= flex_layout(align_items: :flex_start) do |row| %>
    <% row.with_column(flex: 1) do %>
      <% if proposal.finding? %>
        <%= render(Primer::Beta::Label.new(scheme: severity_scheme, mr: 2)) { severity_label } %>
        <%= render(Primer::Beta::Text.new(color: :muted, font_size: :small)) { area_label } %>
      <% end %>
      <% if proposal.text.present? %>
        <%= render(Primer::Beta::Text.new(tag: :p, mt: proposal.finding? ? 1 : 0, mb: 1, color: text_color)) { proposal.text } %>
      <% end %>
      <% if proposal.evidence.any? %>
        <ul class="mb-0 pl-3" data-test-selector="ai-assistance-evidence">
          <% proposal.evidence.each do |item| %>
            <li>
              <% if evidence_href(item) %>
                <%= render(Primer::Beta::Link.new(**evidence_link_arguments(item))) { item["text"] } %>
              <% else %>
                <%= render(Primer::Beta::Text.new(color: :muted)) { item["text"] } %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
      <%= render(AI::Assistance::ProposalComponent.new(proposal:, apply_path: (apply_path unless read_only))) %>
    <% end %>
    <% row.with_column do %>
      <% if proposal.open? && !read_only %>
        <%= render(Primer::Alpha::ActionMenu.new(anchor_align: :end)) do |menu| %>
          <% menu.with_show_button(size: :small, scheme: :invisible, data: { test_selector: "ai-assistance-dismiss" }) do |button| %>
            <% button.with_trailing_action_icon(icon: :"triangle-down") %>
            <%= t("ai_assistance.proposal.dismiss") %>
          <% end %>
          <% menu.with_item(label: t("ai_assistance.proposal.dismiss"), href: dismiss_path, form_arguments: { method: :post }) %>
          <% menu.with_divider %>
          <% dismiss_reasons.each do |reason| %>
            <% menu.with_item(label: t("ai_assistance.proposal.dismiss_reasons.#{reason}"), href: dismiss_path(reason), form_arguments: { method: :post }) %>
          <% end %>
        <% end %>
      <% elsif proposal.dismissed? %>
        <%= render(Primer::Beta::Label.new(scheme: :secondary)) { t("ai_assistance.proposal.dismissed") } %>
      <% elsif proposal.applied? %>
        <%= render(Primer::Beta::Label.new(scheme: :success)) { t("ai_assistance.proposal.applied") } %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
