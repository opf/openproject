<%= render(Primer::Beta::BorderBox.new(mt: 2, data: { test_selector: "ai-assistance-change-set" })) do |box| %>
  <% changes.each do |change| %>
    <% box.with_row do %>
      <%= render(Primer::Beta::Text.new(tag: :p, font_weight: :bold, font_size: :small, mb: 1)) { change[:label] } %>
      <% if change.key?(:html) %>
        <div class="op-uc-container"><%= change[:html] %></div>
      <% else %>
        <%= render(Primer::Beta::Text.new(tag: :del, color: :muted)) { change[:from].presence || t("ai_assistance.apply.empty") } %>
        <%= render(Primer::Beta::Octicon.new(icon: :"arrow-right", mx: 1, color: :muted)) %>
        <%= render(Primer::Beta::Text.new(font_weight: :bold)) { change[:to] } %>
      <% end %>
    <% end %>
  <% end %>
  <% box.with_footer do %>
    <% if lost_references.any? %>
      <%= render(Primer::Beta::Text.new(tag: :p, color: :attention, font_size: :small)) { t("ai_assistance.apply.lost_content") } %>
    <% end %>
    <% if apply_path %>
      <%= primer_form_with(url: apply_path, method: :post) do %>
        <%= render(Primer::Beta::Button.new(type: :submit, scheme: :primary, size: :small, disabled: !can_apply?, data: { test_selector: "ai-assistance-apply" })) do %>
          <%= t("ai_assistance.apply.button") %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
