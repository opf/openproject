<%= component_wrapper(data: wrapper_data, class: "position-relative") do %>
  <%= render(Primer::Beta::Text.new(tag: :p, color: :muted, font_size: :small, mb: 3)) do %>
    <%= t("ai_assistance.run.started_at", time: started_at) %>
  <% end %>

  <% if run.ai_running? && findings.any? %>
    <%= render(Primer::Box.new(display: :flex, align_items: :center, mb: 3, data: { test_selector: "ai-assistance-review-running" })) do %>
      <%= render(Primer::Beta::Spinner.new(size: :small, mr: 2)) %>
      <%= render(Primer::Beta::Text.new(color: :muted)) { t("ai_assistance.run.review_running") } %>
    <% end %>
  <% end %>

  <% if findings.empty? && run.ai_running? %>
    <%= render(Primer::Beta::Blankslate.new(border: true, data: { test_selector: "ai-assistance-review-running" })) do |slate| %>
      <% slate.with_visual_spinner(size: :large) %>
      <% slate.with_heading(tag: :h3).with_content(t("ai_assistance.run.review_running_title")) %>
      <% slate.with_description { t("ai_assistance.run.review_running_description") } %>
    <% end %>
  <% elsif findings.empty? %>
    <%= render(Primer::Beta::Blankslate.new(border: true, data: { test_selector: "ai-assistance-no-findings" })) do |slate| %>
      <% slate.with_visual_icon(icon: :"check-circle") %>
      <% slate.with_heading(tag: :h3).with_content(t("ai_assistance.run.no_findings")) %>
      <% slate.with_description do %>
        <%= not_checked.any? ? t("ai_assistance.run.no_findings_partly_checked") : t("ai_assistance.run.no_findings_description") %>
      <% end %>
    <% end %>
  <% else %>
    <%= render(Primer::Beta::BorderBox.new(data: { test_selector: "ai-assistance-findings" })) do |box| %>
      <% findings.each do |finding| %>
        <% box.with_row do %>
          <%= render(AI::Assistance::FindingComponent.new(finding:)) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <% if not_checked.any? %>
    <%= render(Primer::Beta::Heading.new(tag: :h4, font_size: :normal, mt: 4, mb: 2)) { t("ai_assistance.run.not_checked") } %>
    <ul class="mb-0 pl-3" data-test-selector="ai-assistance-not-checked">
      <% not_checked.each do |line| %>
        <li><%= render(Primer::Beta::Text.new(color: :muted)) { line } %></li>
      <% end %>
    </ul>
  <% end %>

  <%= render(AI::Assistance::RunEventsComponent.new(events: run.events)) %>
<% end %>
