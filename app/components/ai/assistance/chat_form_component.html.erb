<%= component_wrapper(class: "width-full") do %>
  <% if read_only %>
    <%= render(Primer::Box.new(display: :flex, align_items: :center, data: { test_selector: "ai-assistance-chat-read-only" })) do %>
      <%= render(Primer::Beta::Text.new(color: :muted, font_size: :small, flex: 1)) { t("ai_assistance.chat.not_offered") } %>
      <%= render(Primer::Beta::Button.new(type: :button, ml: 2, data: { close_dialog_id: dialog_id })) { t(:button_close) } %>
    <% end %>
  <% else %>
    <%= primer_form_with(url: send_path, method: :post, html: { class: "mb-0" }, data: { test_selector: "ai-assistance-chat-form" }) do %>
      <%= hidden_field_tag :skill_id, skill.id %>
      <% if chat %>
        <%= hidden_field_tag :chat_id, chat.id %>
      <% end %>
      <%= render(Primer::Alpha::TextArea.new(name: :content, label: t("ai_assistance.chat.question"), visually_hide_label: true,
                                             placeholder: t("ai_assistance.chat.placeholder", id: work_package.formatted_id),
                                             rows: 2, full_width: true, disabled: pending?)) %>
      <%= render(Primer::Box.new(display: :flex, align_items: :center, mt: 2)) do %>
        <%= render(Primer::Beta::Button.new(type: :submit, scheme: :invisible, formaction: new_chat_path, formnovalidate: true,
                                            data: { test_selector: "ai-assistance-new-chat" })) do |button| %>
          <% button.with_leading_visual_icon(icon: :plus) %>
          <%= t("ai_assistance.chat.new") %>
        <% end %>
        <% if rerun? %>
          <%= render(Primer::Beta::Button.new(type: :submit, scheme: :invisible, formaction: rerun_path, formnovalidate: true,
                                              disabled: pending?, data: { test_selector: "ai-assistance-rerun" })) do |button| %>
            <% button.with_leading_visual_icon(icon: :sync) %>
            <%= t("ai_assistance.chat.rerun") %>
          <% end %>
        <% end %>
        <%= render(Primer::Box.new(flex: 1)) %>
        <%= render(Primer::Beta::Button.new(type: :button, mr: 2, data: { close_dialog_id: dialog_id })) { t(:button_close) } %>
        <%= render(Primer::Beta::Button.new(type: :submit, scheme: :primary, disabled: pending?, data: { test_selector: "ai-assistance-chat-send" })) do |button| %>
          <% button.with_leading_visual_icon(icon: :"paper-airplane") %>
          <%= t("ai_assistance.chat.send") %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
