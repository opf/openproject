<%# position: relative keeps absolutely positioned form labels inside the scrolling body;
    without it they stretch the dialog and give it a second scrollbar. %>
<%= component_wrapper(data: wrapper_data, class: "position-relative") do %>
  <% if messages.empty? %>
    <%= render(Primer::Beta::Blankslate.new(data: { test_selector: "ai-assistance-chat-empty" })) do |slate| %>
      <% slate.with_visual_icon(icon: :sparkle) %>
      <% slate.with_heading(tag: :h3).with_content(t("ai_assistance.chat.empty_title")) %>
      <% slate.with_description { read_only? ? t("ai_assistance.chat.empty_description_read_only") : t("ai_assistance.chat.empty_description") } %>
    <% end %>
  <% end %>

  <% messages.each_with_index do |message, index| %>
    <% last = index == messages.size - 1 %>
    <% if message.from_user? %>
      <%= render(Primer::Box.new(display: :flex, justify_content: :flex_end, mb: 2)) do %>
        <%= render(Primer::Box.new(bg: :accent, border_radius: 2, p: 2, style: "max-width: 85%; white-space: pre-wrap;", data: { test_selector: "ai-assistance-chat-question" })) { message.content } %>
      <% end %>
    <% else %>
      <%= render(Primer::Box.new(mb: 3, data: { test_selector: "ai-assistance-chat-answer", controller: (last ? "scroll-into-view" : nil) })) do %>
        <% if message.pending? %>
          <%= render(Primer::Beta::Text.new(color: :muted)) do %>
            <%= render(Primer::Beta::Spinner.new(size: :small, mr: 1)) %><%= t("ai_assistance.chat.thinking") %>
          <% end %>
        <% elsif message.failed? %>
          <%= render(Primer::Alpha::Banner.new(scheme: :danger)) { t("ai_assistance.chat.failed") } %>
        <% else %>
          <div class="op-uc-container"><%= helpers.format_text(message.content) %></div>
          <%= render(Primer::Beta::ClipboardCopyButton.new(id: "ai-assistance-copy-#{message.id}", value: message.content,
                                                           aria: { label: t("ai_assistance.chat.copy") },
                                                           scheme: :invisible, size: :small,
                                                           data: { test_selector: "ai-assistance-chat-copy" })) %>
          <% message.proposals.each do |proposal| %>
            <%= render(AI::Assistance::ProposalComponent.new(proposal:, apply_path: apply_path(proposal))) %>
            <% if proposal.applied? %>
              <%= render(Primer::Beta::Label.new(scheme: :success, mt: 1)) { t("ai_assistance.finding.applied") } %>
            <% end %>
          <% end %>
        <% end %>
        <%= render(AI::Assistance::RunEventsComponent.new(events: message.events)) %>
      <% end %>
    <% end %>
  <% end %>

<% end %>
