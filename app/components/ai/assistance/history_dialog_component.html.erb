<%= render(Primer::Alpha::Dialog.new(id: DIALOG_ID, title: t("ai_assistance.history.title"), size: :medium, data: { test_selector: "ai-assistance-history-dialog" })) do |dialog| %>
  <% dialog.with_header(variant: :large) %>
  <% dialog.with_body do %>
    <% if runs.empty? %>
      <%= render(Primer::Beta::Blankslate.new) do |slate| %>
        <% slate.with_heading(tag: :h3).with_content(t("ai_assistance.history.empty")) %>
      <% end %>
    <% else %>
      <%= render(Primer::Beta::BorderBox.new) do |box| %>
        <% runs.each do |run| %>
          <% box.with_row do %>
            <%= render(Primer::Beta::Link.new(href: run_path(run), data: { controller: "async-dialog", turbo_stream: true })) { run_label(run) } %>
            <%= render(Primer::Beta::Text.new(color: :muted, font_size: :small, ml: 2)) do %>
              <%= helpers.format_time(run.created_at) %> · <%= t("ai_assistance.history.findings", count: run.findings.size) %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
