<%= render(
      Primer::Alpha::Dialog.new(
        id: dialog_id,
        title: title,
        size: :medium
      )
    ) do |dialog| %>
  <% dialog.with_body do %>
    <%= render(Primer::Beta::Text.new(tag: :h2, mb: 2)) { heading } %>
    <%= render(Primer::Beta::Text.new(tag: :p)) { description } %>
  <% end %>
  <% dialog.with_footer do %>
    <%= form_with(url: form_action, method: form_method, data: { turbo: false }) do %>
      <% ids.each do |id| %>
        <%= hidden_field_tag "ids[]", id %>
      <% end %>
      <%= hidden_field_tag :back_url, back_url if back_url.present? %>
      <%= render(Primer::Beta::Button.new(type: :submit, scheme: button_scheme)) { button_label } %>
    <% end %>
  <% end %>
<% end %>
