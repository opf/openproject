<%= flex_layout do |fields|
      fields.with_row(mt: 0) do
        render Primer::Alpha::TextField.new(
          name: :footer_text,
          label: I18n.t("pdf_generator.dialog.footer_center.label"),
          caption: footer_text_caption,
          visually_hide_label: false,
          value: footer_text,
          input_width: :large,
          disabled: disabled
        )
      end
      fields.with_row(mt: 3) do
        render(
          Primer::Alpha::Select.new(
            name: "page_orientation",
            label: I18n.t("pdf_generator.dialog.page_orientation.label"),
            caption: I18n.t("pdf_generator.dialog.page_orientation.caption"),
            input_width: :large,
            disabled: disabled
          )
        ) do |component|
          page_orientation_options.each do |entry|
            component.option(label: entry[:label], value: entry[:value], selected: entry[:value] == page_orientation)
          end
        end
      end
      fields.with_row(mt: 3) do
        render(
          WorkPackages::Exports::Generate::Templates::HyphenationFieldsComponent.new(
            template_id: TEMPLATE_ID,
            enabled: hyphenation_enabled,
            language: hyphenation_language,
            disabled: disabled
          )
        )
      end
    end %>
