<%= render(
      Primer::Alpha::Dialog.new(
        title: I18n.t("pdf_generator.dialog.title"),
        id: MODAL_ID,
        size: :medium_portrait,
        data: {
          controller: "work-packages--export--generate-pdf-form"
        }
      )
    ) do |dialog| %>
  <% dialog.with_header(variant: :large) %>
  <% dialog.with_body do %>
    <%= flex_layout do |modal_body|
          modal_body.with_row(mt: 0) do
            render(
              Primer::Alpha::Select.new(
                name: "template",
                label: I18n.t("pdf_generator.dialog.templates.label"),
                caption: templates_default&.caption || I18n.t("pdf_generator.dialog.templates.none_enabled"),
                disabled: templates_default.nil?,
                input_width: :large,
                data: {
                  "work-packages--export--generate-pdf-form-target": "templates",
                  action: "change->work-packages--export--generate-pdf-form#templatesChanged"
                }
              )
            ) do |component|
              selected = templates_default&.id
              templates_options.each do |entry|
                component.option(
                  label: entry.label,
                  value: entry.id,
                  selected: selected == entry.id,
                  data: {
                    caption: entry.caption
                  }
                )
              end
            end
          end
          modal_body.with_row(
            mt: 3,
            classes: templates_default&.id == "artefact" ? nil : "d-none",
            data: {
              template: "artefact",
              "work-packages--export--generate-pdf-form-target": "inputGroups"
            }
          ) do
            primer_form_with(
              url: generate_pdf_work_package_path(work_package),
              data: { turbo: false },
              id: template_form_id("artefact")
            ) do
              safe_join(
                [
                  hidden_field_tag(:template, "artefact", id: nil),
                  render(WorkPackages::Exports::Generate::Templates::ArtefactSettingsComponent.new(settings: artefact_settings))
                ]
              )
            end
          end
          modal_body.with_row(
            mt: 3,
            classes: templates_default&.id == "attributes" ? nil : "d-none",
            data: {
              template: "attributes",
              "work-packages--export--generate-pdf-form-target": "inputGroups"
            }
          ) do
            primer_form_with(
              url: generate_pdf_work_package_path(work_package),
              data: { turbo: false },
              id: template_form_id("attributes")
            ) do
              safe_join(
                [
                  hidden_field_tag(:template, "attributes", id: nil),
                  render(WorkPackages::Exports::Generate::Templates::AttributesSettingsComponent.new(settings: attributes_settings))
                ]
              )
            end
          end
          modal_body.with_row(
            mt: 3,
            classes: templates_default&.id == "contract" ? nil : "d-none",
            data: {
              template: "contract",
              "work-packages--export--generate-pdf-form-target": "inputGroups"
            }
          ) do
            primer_form_with(
              url: generate_pdf_work_package_path(work_package),
              data: { turbo: false },
              id: template_form_id("contract")
            ) do
              safe_join(
                [
                  hidden_field_tag(:template, "contract", id: nil),
                  render(WorkPackages::Exports::Generate::Templates::ContractSettingsComponent.new(settings: contract_settings))
                ]
              )
            end
          end
        end %>
  <% end %>
  <% dialog.with_footer do %>
    <%= render(Primer::Beta::Button.new(data: { "close-dialog-id": MODAL_ID })) { I18n.t(:button_cancel) } %>
    <%= render(
          Primer::Beta::Button.new(
            scheme: :primary,
            type: :submit,
            form: templates_default && template_form_id(templates_default.id),
            disabled: templates_default.nil?,
            data: {
              "close-dialog-id": MODAL_ID,
              "work-packages--export--generate-pdf-form-target": "submit"
            }
          )
        ) { I18n.t("pdf_generator.dialog.submit") } %>
  <% end %>
<% end %>
