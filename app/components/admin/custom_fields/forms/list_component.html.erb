<%= component_wrapper do %>
  <% if forms.any? %>
    <%= render(Primer::Beta::BorderBox.new(test_selector: "custom-field-forms-list")) do |box| %>
      <% box.with_header do %>
        <%= render(Primer::Beta::Text.new(font_weight: :semibold, color: :muted)) { header_label } %>
      <% end %>
      <% forms.each do |form| %>
        <% box.with_row(test_selector: "custom-field-form-row-#{form.id}") do %>
          <%= render(Primer::Beta::Link.new(href: helpers.edit_polymorphic_path(form), font_weight: :bold)) { form.name } %>
          <% if form.description.present? %>
            <%= render(Primer::Beta::Text.new(tag: :div, font_size: :small, color: :muted)) { form.description } %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
    <%= helpers.pagination_links_full(forms, params: { action: "forms" }, allowed_params: %w[filters]) %>
  <% else %>
    <%= render(Primer::Beta::Blankslate.new(border: true)) do |blank_slate| %>
      <% blank_slate.with_visual_icon(icon: blank_icon, size: :medium) %>
      <% blank_slate.with_heading(tag: :h2) { blank_title } %>
      <% blank_slate.with_description { blank_description } %>
    <% end %>
  <% end %>
<% end %>
