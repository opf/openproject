<%=
  component_wrapper do
    primer_form_with(**form_arguments) do |f|
      component_collection do |collection|
        collection.with_component(Primer::Alpha::Dialog::Body.new) do
          render(::CustomFields::ProjectSpecificValues::ValueForm.new(f, custom_field:, project:, value:, values:, errors:))
        end

        collection.with_component(Primer::Alpha::Dialog::Footer.new) do
          component_collection do |footer|
            footer.with_component(
              Primer::Beta::Button.new(
                data: { close_dialog_id: Admin::CustomFields::Projects::ValueDialogComponent::DIALOG_ID }
              )
            ) do
              t(:button_cancel)
            end

            footer.with_component(Primer::Beta::Button.new(scheme: :primary, type: :submit)) do
              submit_label
            end
          end
        end
      end
    end
  end
%>
