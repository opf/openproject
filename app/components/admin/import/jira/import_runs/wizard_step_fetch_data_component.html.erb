<%= flex_layout do |box|
  box.with_row do
    flex_layout do |row|
      row.with_column(flex: 1) do
        concat(
          render(Primer::Beta::Text.new(font_weight: :bold, tag: :div)) do
            I18n.t(:"admin.jira.run.wizard.sections.fetch_data.title")
          end
        )
        if model.status_equal_or_after?(:instance_meta_done)
          concat(
            render(Primer::Beta::Text.new(font_size: :small, color: :subtle)) do
              I18n.t(:"admin.jira.run.wizard.sections.fetch_data.caption_done")
            end
          )
        end
      end
    end
  end
  if model.in_state?(:initial)
    box.with_row(mb: 3) do
      render(Primer::Beta::Text.new) do
        I18n.t(:"admin.jira.run.wizard.sections.fetch_data.description")
      end
    end
    box.with_row(mb: 3) do
      render(
        Primer::Alpha::TextField.new(
          name: "jira-url",
          label: "Jira server/Data center URL",
          value: model.jira.url,
          required: true,
          disabled: true
        )
      )
    end
    box.with_row do
      render(Primer::Alpha::Stack.new(direction: :horizontal)) do
        concat(
          render(
            Primer::Beta::Button.new(
              scheme: :primary,
              tag: :a,
              size: :medium,
              href: continue_admin_import_jira_run_path(jira_id: model.jira.id, id: model.id, step: "fetch_instance_meta"),
              loading: true,
              data: { turbo_stream: true }
            )
          ) do
            "Check available data"
          end
        )
        concat(
          render(
            Primer::Beta::Button.new(
              tag: :a,
              size: :medium,
              href: admin_import_jira_path(id: model.jira.id)
            )
          ) do
            "Cancel"
          end
        )
      end
    end
  elsif model.in_state?(:instance_meta_error)
    box.with_row(mt: 3) do
      render(Admin::Import::Jira::ImportRuns::ErrorBannerComponent.new(model, "fetch_instance_meta"))
    end
  elsif model.in_state?(:instance_meta_fetching)
    box.with_row(mb: 3) do
      render(Primer::Beta::Text.new) do
        I18n.t(:"admin.jira.run.wizard.sections.fetch_data.description")
      end
    end
    box.with_row(mb: 3) do
      render(
        Primer::Alpha::TextField.new(
          name: "jira-url",
          label: "Jira server/Data center URL",
          value: model.jira.url,
          required: true,
          disabled: true
        )
      )
    end
    job_status_icon = case model.state_machine.last_transition_to(:instance_meta_fetching).actual_job.status
                      when :running
                        { icon: :"kebab-horizontal", color: :muted }
                      when :queued,
                        :retried,
                        :scheduled
                        { icon: :clock, color: :muted }
                      when :succeeded
                        { icon: :"check-circle-fill", color: :success }
                      when :discarded
                        { icon: :"x-circle-fill", color: :danger }
                      end
    box.with_row do
      render(Primer::Alpha::Stack.new(direction: :horizontal)) do
        concat(
          render(
            Primer::Beta::Button.new(
              scheme: :primary,
              tag: :a,
              size: :medium,
              disabled: true,
              href: continue_admin_import_jira_run_path(jira_id: model.jira.id, id: model.id, step: "fetch_instance_meta"),
              data: { turbo_stream: true }
            )
          ) do |button|
            button.with_leading_visual_icon(**job_status_icon)
            "Fetching availabled metadata"
          end
        )
      end
    end
  end
end
%>
