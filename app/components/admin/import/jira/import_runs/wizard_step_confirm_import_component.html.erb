<%= flex_layout do |box|
      box.with_row do
        concat(
          content_tag(:div, class: "d-flex flex-items-center") do
            concat(
              render(Primer::Beta::Text.new(font_weight: :bold)) do
                I18n.t(:"admin.jira.run.wizard.sections.confirm_import.title")
              end
            )
            if model.state_equal_or_after?(:imported)
              concat(
                render(Primer::Beta::Label.new(size: :medium, font_weight: :bold, color: :success, ml: 1)) do
                  I18n.t(:"admin.jira.run.wizard.sections.confirm_import.caption_done")
                end
              )
            end
          end
        )
        if model.state_before?(:projects_meta_done)
          concat(
            render(Primer::Beta::Text.new(font_size: :small, color: :subtle)) do
              I18n.t(:"admin.jira.run.wizard.sections.confirm_import.caption")
            end
          )
        elsif model.state_equal_or_after?(:imported)
          concat(
            render(Primer::Beta::Text.new(font_size: :small, color: :subtle)) do
              I18n.t(:"admin.jira.run.wizard.sections.confirm_import.caption_done_info")
            end
          )
        end
      end
      if model.in_state?(:import_error, :import_aborting, :importing)
        box.with_row(mb: 3) do
          render(Primer::Beta::Text.new) do
            I18n.t(:"admin.jira.run.wizard.sections.confirm_import.info_importing")
          end
        end
        box.with_row(mb: 3) do
          render(Admin::Import::Jira::ImportRuns::BatchStatusComponent.new(batch: model.state_machine.last_transition_to(:importing).actual_batch))
        end
      end
      if model.in_state?(:projects_meta_done)
        box.with_row(mb: 3) do
          render(Primer::Beta::Text.new) do
            I18n.t(:"admin.jira.run.wizard.sections.confirm_import.description")
          end
        end
        box.with_row(mb: 3) do
          render(
            Admin::Import::Jira::ImportRuns::InfoListBoxComponent.new(
              title: I18n.t(:"admin.jira.run.wizard.sections.confirm_import.label_available_data"),
              list: import_selection,
              show_icon: true,
              icon: :"check-circle",
              icon_color: :success
            )
          )
        end
        box.with_row(display: :flex, align_items: :center) do
          concat(
            render(
              Primer::Beta::Button.new(
                scheme: :primary,
                tag: :a,
                size: :medium,
                mr: 2,
                href: import_modal_admin_import_jira_run_path(jira_id: model.jira.id, id: model.id),
                data: { controller: "async-dialog" }
              )
            ) { I18n.t(:"admin.jira.run.wizard.sections.confirm_import.button_start") }
          )
          concat(
            render(
              Primer::Beta::Button.new(
                tag: :a,
                size: :medium,
                href: admin_import_jira_path(model.jira)
              )
            ) do
              I18n.t(:button_cancel)
            end
          )
        end
      elsif model.in_state?(:import_error)
        box.with_row do
          render(Primer::Alpha::Stack.new(direction: :horizontal)) do
            concat(
              render(
                Primer::Beta::Button.new(
                  href: continue_admin_import_jira_run_path(jira_id: model.jira.id, id: model.id, step: "import"),
                  data: { turbo_stream: true },
                  tag: :a
                )
              ) do |button|
                button.with_leading_visual_icon(icon: :sync)
                I18n.t(:"admin.jira.run.wizard.button_retry")
              end
            )
            concat(
              render(
                Primer::Beta::Button.new(
                  scheme: :danger,
                  tag: :a,
                  size: :medium,
                  href: continue_admin_import_jira_run_path(jira_id: model.jira.id, id: model.id, step: "revert"),
                  data: { turbo_stream: true }
                )
              ) do
                I18n.t(:"admin.jira.run.wizard.sections.confirm_import.button_revert")
              end
            )
            concat(
              render(
                Primer::Beta::Button.new(
                  tag: :a,
                  size: :medium,
                  href: admin_import_jira_path(id: model.jira.id)
                )
              ) do
                I18n.t(:button_close)
              end
            )
          end
        end
      elsif model.in_state?(:import_aborting)
        box.with_row do
          render(Primer::Alpha::Stack.new(direction: :horizontal)) do
            concat(
              render(
                Primer::Beta::Button.new(
                  scheme: :primary,
                  href: continue_admin_import_jira_run_path(jira_id: model.jira.id, id: model.id, step: "import"),
                  data: { turbo_stream: true },
                  disabled: true,
                  tag: :a
                )
              ) do |button|
                button.with_leading_visual_icon(icon: :sync)
                I18n.t(:"admin.jira.run.wizard.sections.confirm_import.button_importing")
              end
            )
            concat(
              render(
                Primer::Beta::Button.new(
                  scheme: :danger,
                  tag: :a,
                  size: :medium,
                  href: continue_admin_import_jira_run_path(jira_id: model.jira.id, id: model.id, step: "abort_import"),
                  disabled: true,
                  data: { turbo_stream: true }
                )
              ) do |button|
                button.with_leading_visual_icon(icon: :sync, animation: :rotate)
                I18n.t(:"admin.jira.run.wizard.button_abort")
              end
            )
            concat(
              render(
                Primer::Beta::Button.new(
                  tag: :a,
                  size: :medium,
                  href: admin_import_jira_path(id: model.jira.id)
                )
              ) do
                I18n.t(:button_cancel)
              end
            )
          end
        end
      elsif model.in_state?(:importing)
        box.with_row do
          render(Primer::Alpha::Stack.new(direction: :horizontal)) do
            concat(
              render(
                Primer::Beta::Button.new(
                  scheme: :primary,
                  disabled: true
                )
              ) do |button|
                button.with_leading_visual_icon(icon: :sync, animation: :rotate)
                I18n.t(:"admin.jira.run.wizard.sections.confirm_import.button_importing")
              end
            )
            concat(
              render(
                Primer::Beta::Button.new(
                  scheme: :danger,
                  tag: :a,
                  size: :medium,
                  href: continue_admin_import_jira_run_path(jira_id: model.jira.id, id: model.id, step: "abort_import"),
                  data: { turbo_stream: true }
                )
              ) do
                I18n.t(:"admin.jira.run.wizard.button_abort")
              end
            )
            concat(
              render(
                Primer::Beta::Button.new(
                  tag: :a,
                  size: :medium,
                  href: admin_import_jira_path(id: model.jira.id)
                )
              ) do
                I18n.t(:button_cancel)
              end
            )
          end
        end
      end
    end %>
