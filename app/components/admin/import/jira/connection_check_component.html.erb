<%=
  component_wrapper do
    render(Primer::OpenProject::SidePanel::Section.new) do |section|
      section.with_title(tag: :h3) { I18n.t("admin.jira.connection_check.title") }

      flex_layout do |container|
        container.with_row do
          render(Primer::Beta::Text.new(font_size: :small, color: :muted)) { report_state }
        end

        if report
          container.with_row(mt: 3) do
            render(
              HealthReports::ReportComponent.new(
                report,
                i18n_scope: "admin.jira.connection_check",
                docs_href: ::OpenProject::Static::Links.url_for(:jira_migration_docs, :connection_check)
              )
            )
          end
        end

        if test_connection?
          container.with_row(mt: 4) do
            render(Primer::Beta::Button.new(**test_connection_button_arguments)) do |button|
              button.with_leading_visual_icon(icon: :plug)
              I18n.t("admin.jira.form.button_test_connection")
            end
          end
        end
      end
    end
  end
%>
