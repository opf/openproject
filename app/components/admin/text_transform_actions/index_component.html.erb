<%= component_wrapper(data: wrapper_data_attributes) do %>
  <% unless assistant_enabled? %>
    <%=
      render(
        Primer::Alpha::Banner.new(
          scheme: :warning,
          mb: 3,
          test_selector: "text-transform-actions-disabled-banner"
        )
      ) do
        t(".disabled_warning")
      end
    %>
  <% end %>

  <%=
    render(
      OpenProject::Common::BorderBoxListComponent.new(
        container: "text-transform-actions",
        empty_state_behavior: :dynamic,
        test_selector: "text-transform-actions-list",
        data: list_data
      )
    ) do |list|
      list.with_header(title: t(".title")) do |header|
        header.with_action_button(
          tag: :a,
          href: enable_all_admin_text_transform_actions_path,
          disabled: !assistant_enabled?,
          scheme: :invisible,
          font_weight: :bold,
          color: :subtle,
          aria: { label: t(".label_enable_all") },
          test_selector: "enable-all-text-transform-actions",
          data: { turbo_method: :put, turbo_stream: true }
        ) do |button|
          button.with_leading_visual_icon(icon: "check-circle", color: :subtle)
          t(".label_enable_all")
        end
        header.with_action_button(
          tag: :a,
          href: disable_all_admin_text_transform_actions_path,
          disabled: !assistant_enabled?,
          scheme: :invisible,
          font_weight: :bold,
          color: :subtle,
          aria: { label: t(".label_disable_all") },
          test_selector: "disable-all-text-transform-actions",
          data: { turbo_method: :put, turbo_stream: true }
        ) do |button|
          button.with_leading_visual_icon(icon: "x-circle", color: :subtle)
          t(".label_disable_all")
        end
      end

      list.with_empty_state(
        title: t(".blank_slate.title"),
        description: t(".blank_slate.description"),
        icon: :sparkle
      )

      text_transform_actions.each do |text_transform_action|
        list.with_item(
          test_selector: "text-transform-action-row-#{text_transform_action.id}",
          data: item_data(text_transform_action)
        ) do
          render(
            Admin::TextTransformActions::RowComponent.new(
              text_transform_action,
              toggles_enabled: assistant_enabled?
            )
          )
        end
      end
    end
  %>
<% end %>
