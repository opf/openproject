<%=
component_wrapper(data: wrapper_data_attributes) do
  flex_layout do |flex|
    flex.with_row do
      render(Primer::OpenProject::SubHeader.new) do |subheader|
        subheader.with_action_button(
          scheme: :primary,
          leading_icon: :plus,
          label: t(:button_add),
          tag: :a,
          href: helpers.url_for(action: :new),
          test_selector: "add-enumeration-button"
        ) do
          I18n.t(:button_add)
        end
      end
    end

    flex.with_row do
      render(
        OpPrimer::BorderBoxListComponent.new(
          container: "#{wrapper_key}-box",
          position: :relative,
          data: list_data
        )
      ) do |list|
        list.with_header(
          title_tag: :h3,
          title: enumeration_title
        )

        list.with_empty_state(
          title: t(:no_results_title_text),
          icon: :alert,
          spacious: true
        )

        enumerations.each do |enumeration|
          list.with_item(test_selector: "enumeration-row-#{enumeration.id}", data: item_data(enumeration)) do
            render(item_component_class.new(enumeration:))
          end
        end
      end
    end
  end
end
%>
