<%=
  render(
    Primer::OpenProject::DangerDialog.new(
      id:,
      title:,
      confirm_button_text:,
      size: :medium_portrait,
      form_arguments: {
        action: perform_token_reset_admin_backups_path,
        method: :post,
        data: password_confirmation_data_attribute({ turbo: true })
      }
    )
  ) do |dialog|
    dialog.with_confirmation_message do |message|
      message.with_heading(tag: :h2) { title }
      message.with_description do
        flex_layout do |flex|
          flex.with_row(mb: 3, text_align: :center) do
            render Primer::Beta::Text.new(color: :muted) do
              t("backup.reset_token.implications")
            end
          end
          if show_warning?
            flex.with_row(text_align: :center) do
              render Primer::Beta::Text.new(color: :muted) do
                t("backup.reset_token.warning")
              end
            end
          end
        end
      end
    end

    dialog.with_confirmation_check_box_content(checkbox_confirmation)
  end
%>
