<%= render(
      Primer::Box.new(
        classes: "op-admin-settings-search",
        data: { controller: "admin--settings-search", test_selector: "op-admin-settings-search" }
      )
    ) do %>
  <%= render(
        Primer::OpenProject::FilterableTreeView.new(
          src: helpers.tree_admin_settings_search_path,
          classes: "op-sidemenu-filterable-tree",
          show_search_highlighting: false,
          include_sub_items_check_box_arguments: { hidden: true },
          filter_mode_control_arguments: { hidden: true },
          filter_input_arguments: {
            name: :settings_search_query,
            label: t("admin.settings_search.title"),
            type: :text,
            show_clear_button: false,
            autofocus: @autofocus,
            autocomplete: "off",
            placeholder: t("admin.settings_search.filter_placeholder"),
            data: {
              test_selector: "op-admin-settings-search--filter",
              admin__settings_search_target: "input",
              action: "input->admin--settings-search#update keydown.esc->admin--settings-search#clear"
            }
          },
          no_results_node_arguments: { label: t("admin.settings_search.no_results") }
        )
      ) %>
<% end %>
