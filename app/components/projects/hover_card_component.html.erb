<%=
  flex_layout(classes: "op-project-hover-card", data: { test_selector: "project-hover-card-#{@project.id}" }) do |flex|
    if breadcrumb_items.present?
      flex.with_row do
        render(Primer::Beta::Breadcrumbs.new) do |breadcrumbs|
          breadcrumb_items.each do |item|
            breadcrumbs.with_item(href: item[:href]) do
              render(Primer::Beta::Truncate.new) do |truncate|
                truncate.with_item(max_width: 135) { item[:text] }
              end
            end
          end
        end
      end

      flex.with_row do

      end
    end
  end
%>
