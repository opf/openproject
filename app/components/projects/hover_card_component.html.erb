<%=
  flex_layout(classes: "op-project-hover-card", data: { test_selector: "project-hover-card-#{@id}" }) do |flex|
    if breadcrumb_items.present?
      flex.with_row(mb: 1) do
        render(Primer::Beta::Breadcrumbs.new) do |breadcrumbs|
          breadcrumb_items.each_with_index do |item, i|
            breadcrumbs.with_item(href: item[:href], font_weight: i == breadcrumb_items.size - 1 ? :bold : nil) do
              render(Primer::Beta::Truncate.new) do |truncate|
                truncate.with_item(max_width: 135) { item[:text] }
              end
            end
          end
        end
      end
    end

    flex.with_row(mb: 1) do
      render(Primer::Beta::Text.new(tag: :h3)) { @name }
    end

    flex.with_row(flex_layout: true, align_items: :center) do |row|
      row.with_column(mr: 2) do
        render(Projects::WorkspaceLabelComponent.new(project: @project))
      end

      if @project.archived?
        row.with_column(mr: 2) do
          render(Primer::Beta::Label.new(scheme: :secondary)) { t('project.archive.archived') }
        end
      end

      row.with_column do
        render(Projects::StatusBadgeComponent.new(project: @project, size: :large, with_icon: true))
      end
    end
  end
%>
