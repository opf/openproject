<%=
  flex_layout do |container|
    container.with_row do
      render(
        OpPrimer::StatusButtonComponent.new(
          current_status: build_item(@status),
          items: build_items,
          button_arguments: {
            icon_only: true,
            classes: "op-phase-status-button",
            size: :medium,
            scheme: :invisible,
            style: :foreground,
            icon: @status.icon,
            title: @status.name,
            "aria-label": @status.name
          },
          readonly: !edit_enabled?,
          menu_arguments: {
            data: { test_selector: "phase-status-action-menu-#{@phase.id}" },
            size: :medium
          }
        )
      )
    end
  end
%>
