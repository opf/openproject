<%=
  render(Primer::Alpha::ActionMenu::List.new(menu_id:)) do |menu|
    menu_items.each_with_index do |group, index|
      menu.with_divider if index.positive?

      group.each do |item|
        menu.with_item(
          scheme: item[:scheme],
          label: item[:label],
          test_selector: "project-list-row--action-menu-item",
          content_arguments: item.except(:scheme, :label, :icon)
        ) do |list_item|
          list_item.with_leading_visual_icon(icon: item[:icon]) if item[:icon]
        end
      end
    end
  end
%>
