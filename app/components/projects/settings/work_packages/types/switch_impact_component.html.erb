<%#-- Empty until a different variant is chosen: the field above already says to choose one. --%>
<%= component_wrapper(data: { test_selector: "project-types-switch-impact" }) do %>
  <% unless impact.nil? %>
    <%= flex_layout(direction: :column) do |preview| %>
      <% preview.with_row(mb: 2) do %>
        <%= render(Primer::Beta::Link.new(href: all_path, target: "_blank", font_weight: :semibold)) do %>
          <%= t("projects.settings.types.switch.impact.work_packages", count: impact.work_package_count) %>
        <% end %>
      <% end %>

      <% unless impact.anything_affected? %>
        <% preview.with_row do %>
          <%= render(Primer::Beta::Text.new(color: :muted)) do %>
            <%= t("projects.settings.types.switch.impact.nothing_affected") %>
          <% end %>
        <% end %>
      <% end %>

      <%# First and expanded: the only section whose consequence outlives the dialog. %>
      <% if impact.missing_statuses.any? %>
        <% preview.with_row(mb: 2) do %>
          <%= render(
                OpenProject::Common::BorderBoxListComponent.new(
                  container: "project-types-switch-missing-statuses",
                  collapsible: true
                )
              ) do |list| %>
            <% list.with_header(count: true) do |header| %>
              <% header.with_title do %>
                <%= render(Primer::Beta::Octicon.new(:alert, color: :attention, mr: 1)) %>
                <%= t("projects.settings.types.switch.impact.missing_statuses_heading") %>
              <% end %>
              <% header.with_description do %>
                <%= t("projects.settings.types.switch.impact.missing_statuses_description") %>
              <% end %>
            <% end %>
            <% impact.missing_statuses.each do |status, count| %>
              <% list.with_item do %>
                <%= render(Primer::Beta::Text.new) { status.name } %>
                <%= render(Primer::Beta::Link.new(href: status_path(status), target: "_blank", ml: 2)) do %>
                  <%= t("projects.settings.types.switch.impact.status_count", count:) %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% field_sections.each do |section| %>
        <% preview.with_row(mb: 2) do %>
          <%= render(
                OpenProject::Common::BorderBoxListComponent.new(
                  container: "project-types-switch-#{section.id}-fields",
                  collapsible: true
                )
              ) do |list| %>
            <% list.with_header(title: section.heading, count: true, collapsed: true) %>
            <% section.fields.each do |field| %>
              <% list.with_item do %>
                <%= render(Primer::Beta::Text.new) { field.label } %>
                <% if (suffix = field_suffix(field)) %>
                  <% if field.kind == :custom_field %>
                    <%= render(Primer::Beta::Link.new(href: field_path(field), target: "_blank", ml: 2)) { suffix } %>
                  <% else %>
                    <%= render(Primer::Beta::Text.new(color: :muted, ml: 2)) { suffix } %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

    <% end %>
  <% end %>
<% end %>
