<%=
  render Primer::OpenProject::PageHeader.new do |header|
    header.with_title { t("projects.settings.life_cycle.header.title") }
    header.with_description do
      t(
        "projects.settings.life_cycle.header.description_html",
        overview_url: project_path(project),
        admin_settings_url: admin_settings_project_phase_definitions_path
      )
    end
    header.with_breadcrumbs(breadcrumb_items)
    header.with_action_button(
      mobile_icon: :book,
      mobile_label: t("contextual_help.life_cycle.open"),
      data: { show_dialog_id: Help::ProjectLifeCycleDialogComponent::DIALOG_ID },
      test_selector: "project-life-cycle-contextual-help",
      aria: { haspopup: "dialog" }
    ) { t("contextual_help.life_cycle.open") }
  end
%>
<%= render Help::ProjectLifeCycleDialogComponent.new %>
