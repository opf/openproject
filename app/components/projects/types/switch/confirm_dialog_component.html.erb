<%= render(
      Primer::OpenProject::DangerDialog.new(
        id: DIALOG_ID,
        title: t("projects.settings.types.switch.confirm_title"),
        size: :large,
        classes: "Overlay--size-large-portrait",
        confirm_button_text: t("projects.settings.types.switch.confirm_submit"),
        form_arguments:
      )
    ) do |dialog| %>
  <% dialog.with_confirmation_message do |message| %>
    <% message.with_heading(tag: :h2) { t("projects.settings.types.switch.confirm_title") } %>
    <% message.with_description do %>
      <%= t("projects.settings.types.switch.confirm_description", type: target.composite_name) %>
    <% end %>
  <% end %>

  <% dialog.with_additional_details(display: :block) do %>
    <% if listed_projects.any? %>
      <%= render(Primer::Beta::Text.new(tag: :p)) do %>
        <%= t("projects.settings.types.switch.listed_projects", count: listed_projects.size) %>
      <% end %>
      <%= render(Projects::Types::ProjectListComponent.new(projects: listed_projects, type: target.type)) %>
    <% end %>
    <%= hidden_field_tag(:target_id, target.id, id: nil) %>
    <%= render(Projects::Types::Switch::HiddenParamsComponent.new(params:)) %>
  <% end %>

  <% dialog.with_confirmation_check_box_content(t("projects.settings.types.switch.confirmation")) %>
<% end %>
