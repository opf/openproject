<%= component_wrapper do %>
  <%= primer_form_with(url: confirmation_url, method: :get, data: form_data) do |form| %>
    <%= render(Projects::Types::Switch::HiddenParamsComponent.new(params:)) %>

    <%= render(Primer::Alpha::Dialog::Body.new) do %>
      <%= render(
            Projects::Types::Switch::FieldsComponent.new(
              form:, targets: selection.targets, selected:, validation_message:, impact: selection.impact(selected)
            )
          ) %>
    <% end %>

    <%= render(Primer::Alpha::Dialog::Footer.new) do %>
      <%= render(Primer::Beta::Button.new(data: { "close-dialog-id": dialog_id })) { t(:button_cancel) } %>
      <%= render(Primer::Beta::Button.new(scheme: :primary, type: :submit)) do %>
        <%= t("projects.settings.types.switch.submit") %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
