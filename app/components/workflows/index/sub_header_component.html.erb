<%= component_wrapper do %>
  <%= render(
        Primer::OpenProject::SubHeader.new(
          test_selector: "workflows-sub-header",
          data: filters_form_attributes
        )
      ) do |sub_header| %>
    <%
      sub_header.with_filter_input(
        name: name_filter_key,
        label: t("workflows.index.filters.name"),
        value: name_filter_value,
        placeholder: t("workflows.index.filters.name_placeholder"),
        leading_visual: { icon: :search, size: :small },
        clear_button_id:,
        data: name_filter_attributes
      )
    %>

    <% sub_header.with_quick_filter(display: :flex, classes: "gap-2") do %>
      <%= render(type_filter_component) %>
      <%= render(projects_filter_component) %>
    <% end %>
  <% end %>
<% end %>
