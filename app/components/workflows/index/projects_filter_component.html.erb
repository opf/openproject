<div data-controller="quick-filter--tree-panel"
     data-quick-filter--tree-panel-base-url-value="<%= base_url %>"
     data-quick-filter--tree-panel-filter-key-value="<%= @filter_key %>"
     data-quick-filter--tree-panel-operator-value="<%= @operator %>">
  <%= render(
        Primer::Beta::Button.new(
          scheme: :secondary,
          data: { "show-dialog-id": DIALOG_ID, test_selector: "quick-filter-tree-panel-button" }
        )
      ) do |button| %>
    <% button.with_trailing_visual_counter(count: current_values.size) if current_values.any? %>
    <% button.with_trailing_action_icon(icon: :"triangle-down", color: current_values.empty? ? :muted : :default) %>
    <%= button_label %>
  <% end %>

  <%= render(Primer::Alpha::Dialog.new(id: DIALOG_ID, title: @name, size: :medium_portrait)) do |dialog| %>
    <% dialog.with_header(variant: :large) %>

    <% dialog.with_body(classes: "Overlay-body_autocomplete_height") do %>
      <%= render(
            Primer::OpenProject::FilterableTreeView.new(
              src: tree_src,
              filter_input_arguments: {
                autocomplete: "off",
                placeholder: t("workflows.index.filters.projects_placeholder"),
                data: { test_selector: "workflows-projects-filter-search" }
              },
              no_results_node_arguments: { label: t("filterable_tree_view.no_results_text") }
            )
          ) %>
    <% end %>

    <% dialog.with_footer(show_divider: true) do %>
      <%= render(
            Primer::Beta::Button.new(
              data: { action: "click->quick-filter--tree-panel#clear", test_selector: "quick-filter-clear-button" }
            )
          ) { t(:button_clear) } %>
      <%= render(
            Primer::Beta::Button.new(
              scheme: :primary,
              data: { action: "click->quick-filter--tree-panel#apply", test_selector: "quick-filter-apply-button" }
            )
          ) { t(:button_apply) } %>
    <% end %>
  <% end %>
</div>
