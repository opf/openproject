<%= render(
      Primer::OpenProject::DangerDialog.new(
        id: DIALOG_ID,
        test_selector: DIALOG_ID,
        size: :medium_portrait,
        title: t("workflows.change.confirm.title", name: variant.composite_name),
        confirm_button_text: t(:button_confirm),
        form_arguments:
      )
    ) do |dialog| %>
  <% dialog.with_confirmation_message do |message| %>
    <% message.with_heading(tag: :h2) { t("workflows.change.confirm.title", name: variant.composite_name) } %>
    <% message.with_description_content(description) %>
  <% end %>

  <% dialog.with_additional_details(display: :block) do %>
    <% hidden_fields.each do |name, value| %>
      <%= hidden_field_tag name, value %>
    <% end %>

    <% unless target_empty? %>
      <%= render(OpPrimer::InsetBoxComponent.new(mb: 3, test_selector: "change-workflow-missing-statuses")) do %>
        <% missing_statuses.each do |status| %>
          <%= render(Primer::Beta::Text.new(tag: :div, font_weight: :bold)) { status.name } %>
        <% end %>
      <% end %>
    <% end %>

    <%= render(Primer::Beta::Text.new(tag: :p)) { t("workflows.change.confirm.consequence") } %>
  <% end %>
<% end %>
