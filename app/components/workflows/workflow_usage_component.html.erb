<%= render(Primer::Alpha::Banner.new(scheme: banner_scheme, mb: 3, test_selector: "workflow-usage-banner")) do |banner| %>
  <% if list_users? %>
    <% banner.with_action_content do %>
      <%= render(Primer::Alpha::Dialog.new(id: dialog_id, title: t("workflows.usage.dialog.title"), subtitle: dialog_caption, size: :medium_portrait)) do |dialog| %>
        <% dialog.with_show_button { t("workflows.usage.dialog.button") } %>
        <% dialog.with_body do %>
          <% if types.any? %>
            <%= render(Primer::Beta::BorderBox.new(mb: 3, test_selector: "workflow-usage-types")) do |box| %>
              <% box.with_header { t(:label_type_plural) } %>
              <% types.each do |variant| %>
                <% box.with_row { variant_link(variant) } %>
              <% end %>
            <% end %>
          <% end %>
          <% if named_variants.any? %>
            <%= render(Primer::Beta::BorderBox.new(test_selector: "workflow-usage-variants")) do |box| %>
              <% box.with_header { t("workflows.usage.dialog.variants") } %>
              <% named_variants.each do |variant| %>
                <% box.with_row do %>
                  <%= variant_link(variant) %>
                  <%= render(Primer::Beta::Text.new(color: :muted, ml: 1)) { t("workflows.usage.dialog.variant_of", type: variant.type.name) } %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
  <%= caption %>
<% end %>
