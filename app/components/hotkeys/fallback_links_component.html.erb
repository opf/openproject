<% new_work_package_href = new_work_package_path_for_user %>
<% if new_work_package_href %>
  <%= link_to(
        t(".new_work_package"),
        new_work_package_href,
        accesskey: new_work_package_access_key,
        tabindex: -1,
        class: "sr-only",
        data: { hotkey: new_work_package_key, hotkey_fallback: true }
      ) %>
<% end %>
<div hidden>
  <% wiki_start_href = wiki_start_path %>
  <% if wiki_start_href %>
    <%= link_to t(".wiki"), wiki_start_href, data: { hotkey: wiki_key } %>
  <% end %>
  <%= link_to(
        t(".shortcuts_help"),
        keyboard_shortcuts_help_path,
        target: "_blank",
        rel: "noopener",
        data: { hotkey: shortcuts_help_key }
      ) %>
  <button type="button" data-hotkey="j" data-hotkey-action="next-list-item" data-hotkey-repeat>
    <%= t(".next_list_item") %>
  </button>
  <button type="button" data-hotkey="k" data-hotkey-action="previous-list-item" data-hotkey-repeat>
    <%= t(".previous_list_item") %>
  </button>
</div>
