<% new_work_package_href = new_work_package_path_for_user %>
<% if new_work_package_href %>
  <%= render(
        Primer::Beta::Link.new(
          href: new_work_package_href,
          accesskey: new_work_package_access_key,
          tabindex: -1,
          data: { hotkey: new_work_package_key, hotkey_fallback: true },
          classes: "sr-only"
        )
      ) { t(".new_work_package") } %>
<% end %>
<%= render(Primer::Box.new(hidden: true)) do %>
  <% wiki_start_href = wiki_start_path %>
  <% if wiki_start_href %>
    <%= render(
          Primer::Beta::Link.new(
            href: wiki_start_href,
            data: { hotkey: wiki_key, hotkey_fallback: true }
          )
        ) { t(".wiki") } %>
  <% end %>
  <%= render(
        Primer::Beta::Link.new(
          href: keyboard_shortcuts_help_path,
          target: "_blank",
          data: { hotkey: shortcuts_help_key }
        )
      ) { t(".shortcuts_help") } %>
  <%= render(
        Primer::Beta::Button.new(
          type: :button,
          data: { hotkey: "j", hotkey_action: "next-list-item", hotkey_repeat: true }
        )
      ) { t(".next_list_item") } %>
  <%= render(
        Primer::Beta::Button.new(
          type: :button,
          data: { hotkey: "k", hotkey_action: "previous-list-item", hotkey_repeat: true }
        )
      ) { t(".previous_list_item") } %>
<% end %>
