<%= render(
      Primer::Alpha::Dialog.new(
        id: DIALOG_ID,
        title: t("recurring_work_packages.dialog.title"),
        subtitle: work_package_title,
        size: :medium_portrait
      )
    ) do |dialog| %>
  <% dialog.with_header(variant: :large) %>
  <% dialog.with_body do %>
    <% if existing_series %>
      <%= render(Primer::Beta::Blankslate.new(spacious: true)) do |blankslate| %>
        <% blankslate.with_visual_icon(icon: :sync) %>
        <% blankslate.with_heading(tag: :h3).with_content(t("recurring_work_packages.dialog.already_recurring")) %>
        <% blankslate.with_description { existing_series.schedule_in_words } %>
        <% blankslate.with_primary_action(href: project_recurring_work_package_path(existing_series.project, existing_series)) do %>
          <%= t("recurring_work_packages.dialog.open_series") %>
        <% end %>
      <% end %>
    <% else %>
      <%= render(RecurringWorkPackages::FormComponent.new(work_package:, series: new_series)) %>
    <% end %>
  <% end %>
  <% dialog.with_footer do %>
    <%= render(Primer::Beta::Button.new(data: { close_dialog_id: DIALOG_ID })) do %>
      <%= existing_series ? t(:button_close) : t(:button_cancel) %>
    <% end %>
    <% unless existing_series %>
      <%= render(Primer::Beta::Button.new(scheme: :primary, type: :submit, form: RecurringWorkPackages::FormComponent::FORM_ID)) do %>
        <%= t("recurring_work_packages.dialog.submit") %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
