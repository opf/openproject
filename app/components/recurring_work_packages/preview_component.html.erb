<%= component_wrapper do %>
  <%= render(Primer::Box.new(bg: :subtle, border: true, border_radius: 2, p: 3)) do %>
    <% if previewable? %>
      <%= flex_layout(align_items: :center, mb: 2) do |title| %>
        <% title.with_column(mr: 2) { render(Primer::Beta::Octicon.new(icon: :sync, color: :accent)) } %>
        <% title.with_column do %>
          <%= render(Primer::Beta::Text.new(font_weight: :bold, test_selector: "recurrence-preview-schedule")) do %>
            <%= series.schedule_in_words %>
          <% end %>
        <% end %>
      <% end %>

      <%= render(Primer::Beta::Text.new(tag: :p, color: :muted, font_size: :small, mb: 1)) do %>
        <%= t("recurring_work_packages.preview.upcoming") %>
      <% end %>
      <ul class="recurring-work-packages--preview-dates">
        <% upcoming_dates.each_with_index do |date, index| %>
          <li>
            <%= render(Primer::Beta::Text.new(font_size: :small)) { format_date(date) } %>
            <% if index.zero? %>
              <%= render(Primer::Beta::Label.new(scheme: :secondary, size: :medium, ml: 1)) do %>
                <%= t("recurring_work_packages.preview.this_work_package") %>
              <% end %>
            <% end %>
          </li>
        <% end %>
      </ul>

      <%= render(Primer::Beta::Text.new(tag: :p, color: :muted, font_size: :small, mt: 2, mb: 0)) do %>
        <%= t("recurring_work_packages.preview.trigger") %>
      <% end %>
    <% else %>
      <%= render(Primer::Beta::Text.new(color: :muted, font_size: :small)) do %>
        <%= t("recurring_work_packages.preview.incomplete") %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
