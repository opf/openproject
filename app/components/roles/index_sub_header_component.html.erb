<%= render(Primer::OpenProject::SubHeader.new(collapsed_search: false, data: sub_header_data_attributes)) do |subheader| %>
  <% subheader.with_filter_input(
       name: "name",
       id: filter_input_id,
       label: t("roles.index.filter_label"),
       visually_hide_label: true,
       value: filter_input_value,
       placeholder: t("roles.index.filter_label"),
       leading_visual: { icon: :search, size: :small },
       show_clear_button: true,
       clear_button_id:,
       data: filter_input_data_attributes
     ) %>

  <% subheader.with_quick_filter do %>
    <%= render(
          OpPrimer::QuickFilter::SegmentedControlComponent.new(
            name: t("roles.index.filter_label"),
            query:,
            filter_key: :type,
            path_args: %i[roles]
          )
        ) do |control| %>
      <% control.with_item(label: t("roles.index.types.all"), value: nil) %>
      <% control.with_item(label: t("roles.index.types.global"), value: "global") %>
      <% control.with_item(label: t("roles.index.types.project"), value: "project") %>
    <% end %>
  <% end %>

  <% subheader.with_action_button(
       scheme: :primary,
       leading_icon: :plus,
       label: t(:label_role_new),
       tag: :a,
       test_selector: "roles--create-button",
       href: new_role_path
     ) do %>
    <%= Role.model_name.human %>
  <% end %>
<% end %>
