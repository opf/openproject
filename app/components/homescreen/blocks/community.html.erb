<%= widget_wrapper do %>
  <%= render(Primer::Alpha::ActionList.new(role: :list)) do |list| %>
    <% links.each do |link| %>
      <% list.with_item(
           label: link_label(link),
           href: link_href(link),
           content_arguments: { target: "_blank", rel: "noopener", data: { allow_external_link: true } }
         ) do |item| %>
        <% item.with_trailing_visual_icon(icon: "link-external") %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
