<%= render Primer::BaseComponent.new(tag: :section, hidden: true, aria: { live: :polite }, data: { color_contrast_target: "preview" }) do %>
  <%= render Primer::Beta::Subhead.new(mt: 0, mb: 3) do |subhead| %>
    <% subhead.with_heading(tag: :h3, size: :medium) { t("colors.contrast.title") } %>
    <% subhead.with_actions do %>
      <%= render Primer::Beta::Text.new(color: :muted, data: { color_contrast_target: "summary" }) %>
    <% end %>
  <% end %>
  <%= flex_layout(direction: [:column, nil, :row], align_items: :stretch, classes: "gap-3") do |modes| %>
    <% %w[light dark].each do |mode| %>
      <% modes.with_column(flex: 1) do %>
        <%= render OpenProject::Common::BorderBoxListComponent.new(container: "contrast-preview-#{mode}") do |list| %>
          <% list.with_header(title_tag: :h4) do |header| %>
            <% header.with_title do %>
              <%= render Primer::Beta::Octicon.new(icon: mode == "light" ? :sun : :moon, mr: 2) %>
              <%= t("colors.contrast.#{mode}") %>
            <% end %>
          <% end %>
          <% %w[foreground background].each do |usage| %>
            <% list.with_item(data: { color_contrast_target: "card" }) do %>
              <%= render Colors::ContrastPreviewRowComponent.new(mode:, usage:, hexcode_id:) %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
  <%= render Primer::Beta::Text.new(tag: :p, color: :muted, mt: 3, mb: 0) do %>
    <%= t("colors.contrast.caption") %>
    <%= helpers.static_link_to :wcag_contrast_minimum, ml: 1 %>
  <% end %>
<% end %>
