<%= render(Primer::Beta::Heading.new(tag: :h5, font_size: :normal, mb: 2)) { t("colors.contrast.used_as_#{usage}") } %>
<%= render Primer::Box.new(
      display: :flex, align_items: :center, justify_content: :center,
      border: true, border_radius: 2, p: 3, classes: "color-contrast--surface",
      data: { color_mode: mode, "#{mode}_theme": mode }
    ) do %>
  <%= render(
        Primer::Beta::Text.new(
          display: :inline_block, font_size: 3, font_weight: :semibold, py: 2, px: 3, border_radius: 2,
          classes: "__hl_#{usage}",
          data: { color_contrast_target: "sample" }
        )
      ) { t("colors.contrast.sample") } %>
<% end %>
<%= render Primer::Box.new(mt: 3, display: :flex, direction: :column, classes: "gap-2") do %>
  <% { foreground: :text, background: :background }.each do |value, label_key| %>
    <%= render Primer::Box.new(display: :flex, justify_content: :space_between, align_items: :center) do %>
      <%= render(Primer::Beta::Text.new(color: :muted, font_size: :small)) { t("colors.contrast.#{label_key}") } %>
      <%= render Primer::Beta::Text.new(font_family: :mono, font_size: :small, data: { contrast_value: value }) %>
    <% end %>
  <% end %>
<% end %>
<%= render Primer::Box.new(display: :flex, justify_content: :space_between, align_items: :center, mt: 3) do %>
  <% %w[pass fail].each do |verdict| %>
    <%= render Primer::Beta::Text.new(hidden: true, color: verdict == "pass" ? :success : :danger, data: { contrast_verdict: verdict }) do %>
      <%= render Primer::Beta::Octicon.new(icon: verdict == "pass" ? :"check-circle" : :"x-circle", mr: 1) %>
      <%= t("colors.contrast.#{verdict}") %>
    <% end %>
  <% end %>
  <%= render Primer::Box.new(tag: :span) do %>
    <span class="sr-only"><%= t("colors.contrast.ratio") %>: </span>
    <%= render Primer::Beta::Text.new(font_family: :mono, font_size: :small, data: { contrast_value: "ratio" }) %>
  <% end %>
<% end %>
