<%=
  flex_layout(
    id: self.class.dom_id(gap.after_id, gap.before_id),
    border: :left,
    pt: 3,
    classes: "op-forum-thread-gap",
    data: { test_selector: "forum-thread-gap" }
  ) do |gap_layout|
    if single_step?
      branch(gap_layout) { load_link(:all, t("forums.topic.gap.load_all_html", count: gap.count)) }
    else
      branch(gap_layout) { load_link(:next, t("forums.topic.gap.load_next_html", count: next_size)) }
      if uncovered_count.positive?
        branch(gap_layout) do
          render(Primer::Beta::Text.new(color: :subtle)) do
            t("forums.topic.gap.in_between_html", hidden: uncovered_count, total: topic.replies_count)
          end
        end
      end
      branch(gap_layout) { load_link(:previous, t("forums.topic.gap.load_previous_html", count: previous_size)) }
    end
  end
%>
