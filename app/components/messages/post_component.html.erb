<%= render(Primer::Box.new(border: :left, classes: "op-forum-post-stem")) if reply? %>
<%=
  render(
    border_box_container(
      id: "message-#{message.id}",
      classes: "op-forum-post",
      data: { test_selector: "forum-post-#{message.id}" }
    )
  ) do |box|
    box.with_header do
      flex_layout(align_items: :center, justify_content: :space_between) do |header|
        header.with_column(flex_layout: true, flex_wrap: :wrap, align_items: :center) do |byline|
          if message.author
            byline.with_column(mr: 2) do
              render(Users::AvatarComponent.new(user: message.author, show_name: false, size: :mini))
            end
            byline.with_column(mr: 2) do
              helpers.primer_link_to_user(message.author, scheme: :primary, font_weight: :bold, hover_card: true)
            end
          end
          if reply?
            byline.with_column(mr: 2, classes: "ellipsis") do
              render(
                Primer::Beta::Link.new(
                  href: helpers.message_anchor_path(message),
                  scheme: :secondary,
                  underline: false,
                  font_size: :small,
                  data: { turbo: false }
                )
              ) { message.subject }
            end
          end
          byline.with_column do
            render(Primer::Beta::Text.new(font_size: :small, color: :subtle)) { helpers.format_time(message.created_at) }
          end
        end
        header.with_column(ml: 1) { action_menu }
      end
    end

    box.with_body do
      concat(content_tag(:div, helpers.format_text(message, :content, attachments: message.attachments), class: "op-uc-container"))
      if message.attachments.any?
        concat(helpers.list_attachments(helpers.message_attachment_representer(message)))
      end
    end
  end
%>
