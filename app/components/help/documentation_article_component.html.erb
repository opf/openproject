<%= helpers.turbo_frame_tag Help::DocumentationDialogComponent.frame_id(@context) do %>
  <% if @article %>
    <article class="contextual-help-article">
      <p class="contextual-help-source"><%= t("contextual_help.source") %></p>
      <h1 tabindex="-1"><%= @article.title %></h1>
      <% if @article.enterprise_feature? %>
        <p class="contextual-help-source"><%= t("contextual_help.enterprise_notice") %></p>
      <% end %>
      <% if headings.any? %>
        <details class="contextual-help-contents">
          <summary><%= t("contextual_help.contents") %></summary>
          <nav aria-label="<%= t("contextual_help.contents") %>">
            <ul>
              <% headings.each do |heading| %>
                <li><%= link_to heading.text, "##{heading['id']}", data: { action: "documentation-help#jump" } %></li>
              <% end %>
            </ul>
          </nav>
        </details>
      <% end %>
      <div class="op-uc-container contextual-help-prose"><%= body %></div>
      <%= link_to t("contextual_help.full_documentation"), @article.url, target: "_blank", rel: "noopener noreferrer" %>
      <hr>
      <h2><%= t("contextual_help.related") %></h2>
      <ul class="contextual-help-article-list">
        <% @articles.reject { |article| article.id == @article.id }.each do |article| %>
          <li><%= link_to t("contextual_help.articles.#{article.id}"),
                          documentation_article_help_path(article_id: article.id, context: @context),
                          data: { help_article: true } %></li>
        <% end %>
      </ul>
    </article>
  <% else %>
    <section class="contextual-help-article">
      <h1 tabindex="-1"><%= t("contextual_help.#{@context}.title") %></h1>
      <p><%= t("contextual_help.introduction") %></p>
      <ul class="contextual-help-article-list">
        <% @articles.each do |article| %>
          <li><%= link_to t("contextual_help.articles.#{article.id}"),
                          documentation_article_help_path(article_id: article.id, context: @context),
                          data: { help_article: true } %></li>
        <% end %>
      </ul>
    </section>
  <% end %>
<% end %>
