<%= render(Primer::OpenProject::PageHeader.new) do |header| %>
  <% header.with_title { record.name } %>
  <% header.with_description { record.description } if record.description.present? %>
  <% header.with_breadcrumbs(breadcrumbs) %>

  <% header.with_action_menu(
       menu_arguments: { anchor_align: :end },
       button_arguments: {
         icon: "kebab-horizontal",
         "aria-label": t(:label_more),
         data: { "test-selector": test_selector("actions") }
       }
     ) do |menu| %>
    <% menu.with_item(
         tag: :a,
         label: t(:button_edit),
         href: helpers.polymorphic_path([:edit_dialog, record]),
         content_arguments: { data: { controller: "async-dialog" } },
         test_selector: test_selector("edit-action")
       ) do |item| %>
      <% item.with_leading_visual_icon(icon: :pencil) %>
    <% end %>

    <% menu.with_divider %>

    <% menu.with_item(
         scheme: :danger,
         label: t(:button_delete),
         href: helpers.polymorphic_path(record),
         form_arguments: { method: :delete, data: { turbo_confirm: t(:text_are_you_sure) } },
         test_selector: test_selector("delete-action")
       ) do |item| %>
      <% item.with_leading_visual_icon(icon: :trash) %>
    <% end %>
  <% end %>
<% end %>
