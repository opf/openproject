<%= render(
      Primer::Alpha::Dialog.new(
        id: DIALOG_ID,
        title: t("types.edit.reuse_mode.dependents.dialog.title"),
        size: :medium_portrait
      )
    ) do |dialog| %>
  <% dialog.with_header(variant: :large) %>

  <%= render(Primer::Alpha::Dialog::Body.new) do %>
    <%= render(Primer::Beta::Text.new(tag: :p, mb: 3)) { t("types.edit.reuse_mode.dependents.dialog.description") } %>

    <% { direct: direct_dependents, indirect: indirect_dependents }.each do |group, members| %>
      <% next if members.empty? %>

      <%= render(
            OpenProject::Common::BorderBoxListComponent.new(
              container: "dependents-#{group}",
              padding: :condensed,
              mb: 3,
              test_selector: "#{group}-dependents-list"
            )
          ) do |list| %>
        <% list.with_header(title: t("types.edit.reuse_mode.dependents.dialog.#{group}_heading")) %>
        <% members.each do |dependent| %>
          <% list.with_item do %>
            <%= dependent_link(dependent, bold_font: true) %>
            <% if (relation = relation(dependent)) %>
              <%= render(Primer::Beta::Text.new(color: :muted, ml: 1)) { relation } %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= render(Primer::Alpha::Dialog::Footer.new) do %>
    <%= render(Primer::Beta::Button.new(data: { "close-dialog-id": DIALOG_ID })) { t(:button_close) } %>
  <% end %>
<% end %>
