<%= render(
      Primer::Alpha::Dialog.new(
        id: DIALOG_ID,
        title: t("types.edit.reuse_mode.mirrored_by.dialog.title"),
        size: :medium_portrait
      )
    ) do |dialog| %>
  <% dialog.with_header(variant: :large) %>

  <%= render(Primer::Alpha::Dialog::Body.new) do %>
    <%= render(Primer::Beta::Text.new(tag: :p, mb: 3)) { t("types.edit.reuse_mode.mirrored_by.dialog.description") } %>

    <%= render(OpenProject::Common::BorderBoxListComponent.new(container: "dependents", padding: :condensed, test_selector: "dependents-list")) do |list| %>
      <% dependents.each do |dependent| %>
        <% list.with_item do %>
          <%= render(Primer::Beta::Link.new(href: dependent_path(dependent), data: { turbo_frame: "_top" })) do %>
            <%= dependent.composite_name %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= render(Primer::Alpha::Dialog::Footer.new) do %>
    <%= render(Primer::Beta::Button.new(data: { "close-dialog-id": DIALOG_ID })) { t(:button_close) } %>
  <% end %>
<% end %>
