<%= render(
      Primer::OpenProject::DangerDialog.new(
        id: DIALOG_ID,
        title:,
        size: :large,
        confirm_button_text: t("types.edit.projects.bulk_remove.submit"),
        form_arguments:
      )
    ) do |dialog| %>
  <% dialog.with_confirmation_message do |message| %>
    <% message.with_heading(tag: :h2) { title } %>
    <% message.with_description { t("types.edit.projects.bulk_remove.description") } %>
  <% end %>

  <% dialog.with_additional_details(display: :block) do %>
    <%= render(WorkPackageTypes::ProjectsTab::BulkProjectListComponent.new(projects:, type: variant.type)) %>
    <% projects.each do |project| %>
      <%= hidden_field_tag("project_ids[]", project.id, id: nil) %>
    <% end %>
  <% end %>

  <% dialog.with_confirmation_check_box_content(t("types.edit.projects.bulk_remove.confirmation")) %>
<% end %>
