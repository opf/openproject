<%= render(OpPrimer::InsetBoxComponent.new(mb: 3, test_selector: "type-projects-bulk-list")) do %>
  <%= render(Primer::Box.new(tag: :ul, m: 0, classes: "list-style-none")) do %>
    <% projects.each do |project| %>
      <%= render(Primer::Box.new(tag: :li, py: 1)) do %>
        <%= render(Primer::Beta::Link.new(href: project_path(project), font_weight: :semibold, mr: 2)) { project.name } %>
        <%= render(Primer::Beta::Text.new(color: :muted, font_size: :small)) { variant_name(project) } %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
