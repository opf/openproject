<%= render(
      Primer::OpenProject::DangerDialog.new(
        id: DIALOG_ID,
        test_selector: DIALOG_ID,
        title: t("types.edit.projects.switch_dialog.title"),
        size: :medium_portrait,
        confirm_button_text: t(:button_change),
        form_arguments: {
          action: url,
          method: :post,
          data: { turbo_stream: true }
        }
      )
    ) do |dialog| %>
  <% dialog.with_confirmation_message do |message| %>
    <% message.with_heading(tag: :h2) { t("types.edit.projects.switch_dialog.title") } %>
    <% message.with_description_content(description) %>
  <% end %>

  <% dialog.with_additional_details(display: :block) do %>
    <%= render(Primer::OpenProject::InsetBox.new(test_selector: "type-projects-switching")) do %>
      <% switching.each do |project_type| %>
        <%= render(Primer::Beta::Text.new(tag: :div)) do %>
          <%= project_type.project.name %>
          <%= render(Primer::Beta::Text.new(color: :subtle)) { project_type.variant.display_name } %>
        <% end %>
      <% end %>
    <% end %>

    <% project_ids.each do |project_id| %>
      <%= hidden_field_tag "project_ids[]", node_payload(project_id), id: nil %>
    <% end %>
    <%= hidden_field_tag :confirm_switch, "1" %>
  <% end %>
<% end %>
