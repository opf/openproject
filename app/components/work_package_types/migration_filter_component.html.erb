<%= hidden_field_tag(
      :created_by_migration, param_value,
      data: { "filter--segmented-control-target": "field", action: "change->auto-submit#submit" }
    ) %>

<%= render(
      Primer::Alpha::SegmentedControl.new(
        "aria-label": t(:label_filter_plural),
        full_width: false,
        test_selector:
      )
    ) do |control| %>
  <% control.with_item(
       label: t("types.edit.variants.created_by_migration_filter.all"),
       selected: !migrated?,
       data: { value: "" }
     ) %>
  <% control.with_item(
       label: t("types.edit.variants.created_by_migration_filter.migrated"),
       selected: migrated?,
       data: { value: MIGRATED }
     ) %>
<% end %>
