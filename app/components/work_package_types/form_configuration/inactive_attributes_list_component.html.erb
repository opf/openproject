<%= component_wrapper(id: "type-form-configuration-inactive-container", data: container_data) do %>
  <%= render(
        OpenProject::Common::BorderBoxListComponent.new(
          container: "type-form-configuration-inactive-list",
          empty_state_behavior: :dynamic,
          padding: :condensed,
          data: list_data
        )
      ) do |list| %>
    <% @inactive_attributes.each do |attribute| %>
      <% list.with_item(data: item_data(attribute)) do %>
        <%= flex_layout(align_items: :center) do |row| %>
          <% row.with_column(mr: 2, classes: "hide-when-print") do %>
            <%= render(
                  Primer::OpenProject::DragHandle.new(
                    classes: "attribute-handle",
                    "aria-label": t("types.edit.form_configuration.drag_to_reorder"),
                    test_selector: "type-form-configuration-attribute-handle-#{attribute[:key]}",
                    data: { sortable_lists__item_target: "handle" }
                  )
                ) %>
          <% end %>
          <% row.with_column(flex: 1) do %>
            <%= render(Primer::Beta::Text.new) { attribute[:translation] } %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% list.with_empty_state(
         title: t("types.edit.form_configuration.no_inactive_attributes"),
         drop_target_label: t("types.edit.form_configuration.inactive_drop_label")
       ) %>
  <% end %>
<% end %>
