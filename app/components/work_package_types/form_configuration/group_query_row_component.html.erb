<%= component_wrapper(data: { group_query: @group[:query] }) do %>
  <%= flex_layout(justify_content: :space_between, align_items: :flex_start) do |row| %>
    <% row.with_column(flex_layout: true, align_items: :flex_start, flex: 1) do |left| %>
      <% left.with_column(mr: 2, classes: "type-form-configuration-page--row-alignment-spacer") %>
      <% left.with_column(flex: 1) do %>
        <%= render(Primer::Beta::Text.new(color: :subtle)) do %>
          <%= t("types.edit.form_configuration.query_group_label") %>
        <% end %>
        <%= render(WorkPackageTypes::FormConfiguration::QuerySummaryComponent.new(rows: @group[:query_summary])) %>
      <% end %>
    <% end %>
    <% if exclusion_toggle.render? %>
      <% row.with_column(py: 1, mr: 2) do %>
        <%= render(exclusion_toggle) %>
      <% end %>
    <% end %>
    <% if ee_available? && !readonly? %>
      <% row.with_column(classes: "hide-when-print type-form-configuration-page--actions") do %>
        <%=
          render(
            Primer::Beta::IconButton.new(
              icon: :pencil,
              scheme: :invisible,
              size: :small,
              tooltip_direction: :w,
              classes: "type-form-configuration-page--actions-button",
              test_selector: "type-form-configuration-edit-query-#{@group[:key]}",
              data: { action: "click->admin--type-form-configuration--main#editQuery" },
              "aria-label": t("types.edit.form_configuration.edit_query")
            )
          )
        %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
