<%= component_wrapper(data: wrapper_data) do %>
  <%= render(
        OpenProject::Common::BorderBoxListComponent.new(
          container: list_container,
          empty_state_behavior:,
          padding: :condensed,
          mt: 3,
          mb: (last? ? 3 : 0),
          data: box_data
        )
      ) do |list| %>
    <%# The group item resolves its menu as the first action-menu inside it: the header stays above the rows. %>
    <% list.with_header(**header_arguments) do |header| %>
      <% unless readonly? %>
        <% header.with_menu(**group_menu_arguments) { |menu| group_menu_items(menu) } %>
        <% header.with_title_form(**title_form_arguments) %>
      <% end %>
    <% end %>

    <% if query_group? %>
      <% list.with_item do |item| %>
        <% if ee_available? && !readonly? %>
          <% item.with_menu(**query_menu_arguments) { |menu| query_menu_items(menu) } %>
        <% end %>
        <%= render(
              WorkPackageTypes::FormConfiguration::GroupQueryRowComponent.new(
                group: @group,
                ee_available: ee_available?,
                readonly: readonly?,
                exclusions:
              )
            ) %>
      <% end %>
    <% else %>
      <% attributes.each do |attribute| %>
        <% list.with_item(data: attribute_item_data(attribute)) do |item| %>
          <% row = attribute_row(attribute) %>
          <% if row.menu? %>
            <% item.with_menu(**row.menu_arguments) { |menu| row.menu_items(menu) } %>
          <% end %>
          <%= render(row) %>
        <% end %>
      <% end %>

      <% if droppable_list? %>
        <% list.with_empty_state(
             title: t("types.edit.form_configuration.empty_group_title"),
             description: t("types.edit.form_configuration.empty_group_hint"),
             drop_target_label: t("types.edit.form_configuration.empty_group_drop_label")
           ) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
