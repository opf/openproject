<%= render(OpPrimer::AttributesGroupComponent.new(scheme: :tabular, label_color: :muted, mt: 2)) do |group| %>
  <% @rows.each do |row| %>
    <% group.with_attribute(key: row.fetch(:label)) do |attribute| %>
      <% row.fetch(:values).each do |value| %>
        <% attribute.with_value { value } %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
