<%= render(
      Primer::OpenProject::DangerDialog.new(
        id: DIALOG_ID,
        test_selector: DIALOG_ID,
        title: t("types.index.delete.title"),
        size: :medium_portrait,
        form_arguments: {
          action: type_path(type),
          method: :delete
        }
      )
    ) do |dialog| %>
  <% dialog.with_confirmation_message do |message|
       message.with_heading(tag: :h2) { t("types.index.delete.heading", name: type.name) }
       message.with_description_content(t("types.index.delete.description"))
     end %>

  <% if affected_projects.any? %>
    <% dialog.with_additional_details(display: :block) do %>
      <%= render(Primer::Beta::Text.new(tag: :p, mb: 2)) do %>
        <%= t("types.index.delete.projects", count: affected_projects.size) %>
      <% end %>
      <%= render(OpPrimer::InsetBoxComponent.new(test_selector: "type-deletion-projects")) do %>
        <% affected_projects.each do |project| %>
          <%= render(Primer::Beta::Text.new(tag: :div)) { project.name } %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
