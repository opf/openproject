<%= render(OpPrimer::InsetBoxComponent.new(scheme:, h: :full, test_selector: "reuse-mode-dependents")) do |box| %>
  <% box.with_title_icon(icon:) %>
  <% box.with_title { title } %>
  <% if any_dependents? %>
    <% box.with_action_button(
         tag: :a,
         href: dialog_path,
         data: { controller: "async-dialog", test_selector: "reuse-mode-view-dependents" }
       ) { t("types.edit.reuse_mode.dependents.view") } %>
  <% end %>
  <%= description %>
<% end %>
