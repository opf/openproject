<%= render(Primer::Beta::Subhead.new(mb: 3)) do |subhead| %>
  <% subhead.with_heading(tag: :h3, size: :medium) { I18n.t("types.creation_wizard.reuse_mode.title") } %>
<% end %>

<%= flex_layout(mb: 4) do |row| %>
  <% modes.each do |mode| %>
    <% row.with_column(flex: 1, mr: 3) do %>
      <%= render(
            Primer::Box.new(
              border: true,
              border_radius: 2,
              border_color: mode.enabled ? :accent : :default,
              p: 3,
              display: :flex,
              align_items: :flex_start,
              justify_content: :space_between
            )
          ) do %>
        <%= render(Primer::Box.new(mr: 2)) do %>
          <%= flex_layout(align_items: :center, mb: 1) do |header| %>
            <% header.with_column(mr: 2) do %>
              <%= render(
                    Primer::Alpha::RadioButton.new(
                      name: "reuse_mode",
                      value: mode.key.to_s,
                      label: title(mode),
                      checked: mode.enabled,
                      disabled: !mode.enabled,
                      visually_hide_label: true
                    )
                  ) %>
            <% end %>
            <% header.with_column do %>
              <%= render(Primer::Beta::Text.new(font_weight: :bold, color: mode.enabled ? :default : :muted)) { title(mode) } %>
            <% end %>
          <% end %>
          <%= render(Primer::Beta::Text.new(tag: :p, font_size: :small, color: :muted, mb: 0)) { description(mode) } %>
        <% end %>
        <%= render(Primer::Beta::Octicon.new(icon: mode.icon, color: mode.enabled ? :accent : :muted)) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
