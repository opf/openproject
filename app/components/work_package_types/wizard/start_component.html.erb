<%= render(Primer::Beta::Heading.new(tag: :h3, font_size: 4, mb: 3)) { t_scoped(:heading) } %>
<%= render(Primer::Beta::Text.new(tag: :p, mb: 3)) { t_scoped(:lead_html) } %>
<%= render(Primer::Beta::Text.new(tag: :p, mb: 3)) { t_scoped(:description) } %>
<%= render(Primer::Beta::Text.new(tag: :p, mb: 4)) { t_scoped(:step_by_step) } %>

<% if show_reuse? %>
  <%= render(Primer::Beta::Heading.new(tag: :h3, font_size: 4, mb: 2)) { t_start(:reuse_heading) } %>
  <%= render(Primer::Beta::Text.new(tag: :p, mb: 3)) { t_start(:reuse_intro) } %>
  <%= render(Primer::Beta::Text.new(tag: :p, mb: 3)) { t_start(:reuse_named) } %>
  <%= render(Primer::Beta::Text.new(tag: :p, mb: 3)) { t_start(:reuse_inherit) } %>

  <%= flex_layout(align_items: :stretch, classes: "gap-3", direction: [:column, nil, :row]) do |modes| %>
    <% modes.with_box(flex: 1) do %>
      <%= render(OpPrimer::InsetBoxComponent.new(h: :full)) do |box| %>
        <% box.with_title { t_start(:inherit_title) } %>
        <%= render(Primer::Beta::Text.new(tag: :p, color: :muted)) { t_start(:inherit_description) } %>
        <%# Temporary placeholder, replaced by the mode illustration soon (MAW-3949) %>
        <%= render(Primer::Box.new(mt: 3, py: 6, text_align: :center, color: :muted)) { "Illustration" } %>
      <% end %>
    <% end %>

    <% modes.with_box(flex: 1) do %>
      <%= render(OpPrimer::InsetBoxComponent.new(h: :full)) do |box| %>
        <% box.with_title { t_start(:manual_title) } %>
        <%= render(Primer::Beta::Text.new(tag: :p, color: :muted)) { t_start(:manual_description) } %>
        <%# Temporary placeholder, replaced by the mode illustration soon (MAW-3949) %>
        <%= render(Primer::Box.new(mt: 3, py: 6, text_align: :center, color: :muted)) { "Illustration" } %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
