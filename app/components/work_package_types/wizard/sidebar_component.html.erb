<%= render(Primer::Alpha::TreeView.new(node_variant: :anchor, expanded: true)) do |tree| %>
  <% steps.each do |step| %>
    <% tree.with_leaf(
         label: title(step),
         href: href_for(step),
         current: current?(step),
         data: { turbo_frame: "_top" },
         test_selector: "wizard-step-#{step}"
       ) do |leaf| %>
      <% leaf.with_leading_visual_icon(icon: leading_icon(step), color: current?(step) ? :accent : :muted) %>
      <% if (status = status_icon(step)) %>
        <% leaf.with_trailing_visual_icon(icon: status.fetch(:icon), color: status.fetch(:color)) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
