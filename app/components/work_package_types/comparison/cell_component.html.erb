<% case format %>
<% when :plain %>
  <% case row.key %>
  <% when :availability %>
    <% if variant.project_owned? %>
      <%= render(Primer::Beta::Link.new(href: owner_path)) { variant.project.name } %>
    <% else %>
      <%= muted(t("types.comparison.values.global")) %>
    <% end %>
  <% when :enabled_in_new_projects %>
    <% if variant.enabled_in_new_projects? %>
      <%= render(Primer::Beta::Octicon.new(:check, color: :success)) %>
    <% else %>
      <%= muted("-") %>
    <% end %>
  <% when :projects %>
    <% if variant.project_owned? || profile.project_count.zero? %>
      <%= muted(profile.project_count.to_s) %>
    <% else %>
      <%= render(Primer::Beta::Link.new(href: projects_path)) { profile.project_count.to_s } %>
    <% end %>
  <% end %>
<% when :same_as_base %>
  <% if same_as_base.nil? %>
    <%= muted("-") %>
  <% elsif same_as_base %>
    <%= render(
          Primer::Beta::Octicon.new(
            :check, color: :success,
                    "aria-label": t("types.comparison.values.same_as_base")
          )
        ) %>
  <% else %>
    <%= render(
          Primer::Beta::Octicon.new(
            :dash, color: :muted,
                   "aria-label": t("types.comparison.values.differs_from_base")
          )
        ) %>
  <% end %>
<% when :mode %>
  <% if linked? %>
    <%= muted(t("types.comparison.values.inheriting_from")) %>
    <%= render(Primer::Beta::Link.new(href: source_path, font_weight: :bold)) { source.composite_name } %>
  <% else %>
    <%= render(Primer::Beta::Text.new(font_weight: :bold)) { t("types.edit.overview.mode.manual") } %>
  <% end %>
<% else %>
  <%= render(Primer::Beta::Text.new(font_weight: :bold)) { count.to_s } %>
<% end %>
