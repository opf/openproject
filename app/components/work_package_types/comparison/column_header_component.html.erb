<%= flex_layout(direction: :column, align_items: :flex_start) do |column| %>
  <% column.with_row do %>
    <%= render(Primer::Beta::Link.new(href: configuration_path, font_weight: :bold)) { name } %>
  <% end %>

  <% if profile.base? %>
    <% column.with_row(mt: 1) do %>
      <%= render(Primer::Beta::Text.new(color: :muted, font_size: :small)) do %>
        <%= t("types.comparison.labels.parent_type") %>
      <% end %>
    <% end %>
  <% end %>

  <% if same_as_type? %>
    <% column.with_row(mt: 1) do %>
      <%= render(Primer::OpenProject::InlineMessage.new(scheme: :warning, size: :small)) do %>
        <%= t("types.comparison.labels.same_as_type") %>
      <% end %>
    <% end %>
  <% end %>

  <% if duplicate? %>
    <% column.with_row(mt: 1) do %>
      <%= render(
            Primer::OpenProject::InlineMessage.new(
              scheme: :warning,
              size: :small,
              title: t("types.comparison.labels.duplicate_of", names: duplicate_names)
            )
          ) do %>
        <%= t("types.comparison.labels.duplicate") %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
