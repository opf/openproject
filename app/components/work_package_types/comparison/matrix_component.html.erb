<%= content_tag(:div, class: "type-variant-comparison--scroll", data: { test_selector: "variant-comparison" }) do %>
  <div class="type-variant-comparison--grid type-variant-comparison--head" style="<%= grid_style %>">
    <div class="type-variant-comparison--label"></div>
    <% columns.each do |profile| %>
      <div data-test-selector="comparison-column-<%= profile.id %>">
        <%= render(
              WorkPackageTypes::Comparison::ColumnHeaderComponent.new(
                profile:, duplicates: duplicates_of(profile), same_as_type: same_as_type?(profile)
              )
            ) %>
      </div>
    <% end %>
  </div>

  <% sections.each do |section, rows| %>
    <%= render(
          OpenProject::Common::BorderBoxListComponent.new(
            container: "comparison-#{section}",
            padding: :condensed,
            header_padding: :condensed,
            collapsible: true,
            mb: 3,
            test_selector: "comparison-section-#{section}"
          )
        ) do |list| %>
      <% list.with_header(title: section_label(section)) %>

      <% rows.each do |row| %>
        <% list.with_item(
             id: row_id(row),
             classes: "type-variant-comparison--grid",
             style: grid_style
           ) do %>
          <div class="<%= row_classes(row) %>"><%= row_label(row) %></div>
          <% columns.each do |profile| %>
            <div data-test-selector="comparison-cell-<%= profile.id %>">
              <%= render(
                    WorkPackageTypes::Comparison::CellComponent.new(
                      cell: comparison.cell(profile, row)
                    )
                  ) %>
            </div>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
