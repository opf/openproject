<%= component_wrapper(data: stimulus_data) do %>
  <%= render(Primer::Beta::Text.new(tag: :p, color: :muted, mb: 3)) { t("my_account.push_notifications.description") } %>

  <% if available? %>
    <%= render(
          Primer::BaseComponent.new(
            tag: :div,
            classes: "sr-only",
            role: "status",
            data: { "my--push-subscription-target": "liveRegion" }
          )
        ) { banner_message(initial_scheme) } %>
    <% %i[default warning success danger].each do |scheme| %>
      <% action = BANNERS.fetch(scheme) %>
      <%= render(
            Primer::Alpha::Banner.new(
              scheme:,
              dismiss_scheme: :none,
              mb: 3,
              hidden: !banner_visible?(scheme),
              data: { "my--push-subscription-target": "banner", scheme: }
            )
          ) do |banner| %>
        <%= render(
              Primer::Beta::Text.new(data: { "my--push-subscription-target": "message", scheme: })
            ) { banner_message(scheme) } %>
        <% if action %>
          <% banner.with_action_button(
               disabled: true,
               aria: action[:aria_label] ? { label: t(action[:aria_label]) } : {},
               data: {
                 "my--push-subscription-target": "action",
                 scheme:,
                 action: "my--push-subscription##{action[:action]}"
               }
             ) { t(action[:label]) } %>
        <% end %>
      <% end %>
    <% end %>
  <% else %>
    <%= render(Primer::Alpha::Banner.new(scheme: :warning, dismiss_scheme: :none, mb: 3)) do %>
      <%= t("my_account.push_notifications.unavailable") %>
    <% end %>
  <% end %>

  <%= render(My::PushSubscriptions::TableComponent.new(rows: subscriptions, current_session:)) %>
<% end %>
