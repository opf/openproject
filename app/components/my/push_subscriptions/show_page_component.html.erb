<%= component_wrapper(data: stimulus_data) do %>
  <%= render(Primer::Beta::Text.new(tag: :p, color: :muted, mb: 3)) { t("my_account.push_notifications.description") } %>

  <%= render(Primer::Beta::BorderBox.new(mb: 4)) do |box| %>
    <% box.with_body do %>
      <%= render(Primer::Alpha::Stack.new(direction: :horizontal, align: :center, justify: :space_between)) do %>
        <% if available? %>
          <%= render(
                Primer::Beta::Text.new(
                  role: "status",
                  aria: { live: "polite" },
                  data: { "my--push-subscription-target": "status" }
                )
              ) { t("my_account.push_notifications.status_checking") } %>
          <%= render(Primer::Alpha::Stack.new(direction: :horizontal, gap: :condensed)) do %>
            <%= render(
                  Primer::Beta::Button.new(
                    scheme: :primary,
                    hidden: true,
                    disabled: true,
                    data: { "my--push-subscription-target": "enable", action: "my--push-subscription#enable" }
                  )
                ) { t("my_account.push_notifications.enable") } %>
            <%= render(
                  Primer::Beta::Button.new(
                    hidden: true,
                    disabled: true,
                    data: { "my--push-subscription-target": "disable", action: "my--push-subscription#disable" }
                  )
                ) { t("my_account.push_notifications.disable") } %>
          <% end %>
        <% else %>
          <%= render(Primer::Beta::Text.new(role: "status")) { t("my_account.push_notifications.unavailable") } %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= render(My::PushSubscriptions::TableComponent.new(rows: subscriptions, current_session:)) %>
<% end %>
