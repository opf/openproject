<%= render(
      Primer::Alpha::Dialog.new(
        id: "accessibility-settings-dialog",
        title: t(:label_accessibility_and_interface_settings),
        position: :right,
        size: :medium,
        test_selector: "op-my--accessibility-settings-dialog"
      )
    ) do |dialog| %>
  <% dialog.with_body do %>
    <%= primer_form_with(
          model: user.pref,
          scope: :pref,
          namespace: :accessibility_settings,
          url: my_settings_path,
          method: :patch,
          data: { turbo: false, controller: "my--look-and-feel" }
        ) do |form|
          render(My::LookAndFeelForm.new(form, show_activity_sorting: false))
        end %>
    <%= primer_form_with(
          model: user.pref,
          scope: :pref,
          namespace: :accessibility_settings,
          url: my_settings_path,
          method: :patch,
          data: { turbo: false }
        ) do |form|
          render(My::AlertsForm.new(form))
        end %>
  <% end %>
<% end %>
