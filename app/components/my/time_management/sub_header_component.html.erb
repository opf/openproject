<%= render(Primer::OpenProject::SubHeader.new) do |component|
      component.with_filter_component(display: :flex, classes: "gap-2") do
        safe_join([render(mode_switcher), (render(entries_filter) if entries_filter?)].compact)
      end

      component.with_text { title }

      component.with_action_button_group do |group|
        group.with_button(icon: "arrow-left", tag: :a, data: link_data.merge(test_selector: "my-time-management-previous"), **previous_attrs)
        group.with_button(icon: "arrow-right", tag: :a, data: link_data.merge(test_selector: "my-time-management-next"), **next_attrs)
      end

      component.with_action_button(
        tag: :a,
        href: today_href,
        data: link_data,
        leading_icon: :"op-calendar-day",
        label: I18n.t(:label_today)
      ) do
        I18n.t(:label_today_capitalized)
      end

      if can_create_time_entry?
        component.with_action_button(
          scheme: :primary,
          leading_icon: :plus,
          label: I18n.t(:button_log_time),
          data: { "turbo-stream" => true },
          tag: :a,
          href: dialog_time_entries_path(onlyMe: true, date: date.iso8601)
        ) do
          t(:button_add_time_entry)
        end
      end
    end %>
