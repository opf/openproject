<%= component_wrapper(class: "op-user-custom-field-section-container", data: { test_selector: "user-custom-field-section-container-#{@user_custom_field_section.id}" }) do %>
  <%=
    render(
      OpenProject::Common::BorderBoxListComponent.new(
        container: "user-custom-field-section-#{@user_custom_field_section.id}",
        mt: 3,
        empty_state_behavior: :none,
        data: field_list_data
      )
    ) do |list|
      list.with_header(
        title: @user_custom_field_section.name,
        title_arguments: { font_weight: :bold },
        show_drag_handle: true,
        drag_handle_arguments: { classes: "handle", data: { sortable_lists__item_target: "handle" } }
      ) do |header|
        header.with_menu(
          button_aria_label: t(".label_section_actions"),
          data: { test_selector: "user-custom-field-section-action-menu" }
        ) do |menu|
          edit_action_item(menu)
          with_move_submenu(menu)
          if @ordered_attributes.empty?
            delete_action_item(menu)
          else
            disabled_delete_action_item(menu)
          end

          menu.with_divider

          menu.with_sub_menu_item(
            label: t("settings.user_custom_fields.label_new_attribute"),
            content_arguments: {
              aria: { label: t(".label_add_attribute") },
              data: { test_selector: "new-user-custom-field-in-section-submenu" }
            }
          ) do |sub_menu|
            sub_menu.with_leading_visual_icon(icon: :plus)
            available_formats.each do |format|
              action_menu_item_for_custom_field_format(sub_menu, format)
            end
          end
        end
      end

      if @ordered_attributes.empty?
        list.with_item(data: { "empty-list-item": true, "filter--filter-list-target": "searchItem" }) do
          flex_layout(align_items: :center, justify_content: :space_between) do |empty_list_container|
            empty_list_container.with_column(ml: 4, mr: 2) do
              render(Primer::Beta::Text.new(color: :subtle)) { t(".label_no_user_custom_fields") }
            end
            empty_list_container.with_column do
              render(Primer::Alpha::ActionMenu.new(data: { test_selector: "new-user-custom-field-in-section-button" })) do |menu|
                menu.with_show_button(
                  scheme: :secondary,
                  "aria-label": t("settings.user_custom_fields.label_new_attribute")
                ) do |btn|
                  btn.with_leading_visual_icon(icon: :plus)
                  btn.with_trailing_visual_icon(icon: :"triangle-down")

                  t("settings.user_custom_fields.label_new_attribute")
                end

                available_formats.each do |format|
                  action_menu_item_for_custom_field_format(menu, format)
                end
              end
            end
          end
        end
      else
        @ordered_attributes.each do |key|
          if UserCustomFieldSection::BUILT_IN_ATTRIBUTES.include?(key)
            list.with_item(data: field_item_data_for_built_in(key).merge("filter--filter-list-target": "searchItem")) do
              render(
                Settings::UserCustomFieldSections::BuiltInAttributeRowComponent.new(
                  attribute_key: key,
                  other_sections: @other_sections
                )
              )
            end
          elsif (cf = @custom_fields_by_key[key])
            list.with_item(data: field_item_data_for_custom_field(cf).merge("filter--filter-list-target": "searchItem")) do
              render(
                custom_field_row_component_class.new(
                  user_custom_field: cf,
                  other_sections: @other_sections
                )
              )
            end
          end
        end
      end
    end
  %>

  <%=
    render(
      Primer::Alpha::Dialog.new(
        id: "user-custom-field-section-dialog#{@user_custom_field_section.id}",
        title: t("settings.user_custom_fields.label_new_section"),
        size: :medium_portrait,
        data: { "keep-open-on-submit": true }
      )
    ) do |_dialog|
      render(Settings::UserCustomFieldSections::DialogBodyFormComponent.new(user_custom_field_section: @user_custom_field_section))
    end
  %>
<% end %>
