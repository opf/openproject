<%= component_wrapper(data: wrapper_data_attributes) do %>
  <% if @user_custom_field_sections.any? %>
    <%= render(Primer::Alpha::Stack.new(gap: :normal, mt: 3, data: sections_list_data)) do %>
      <% @user_custom_field_sections.each do |section| %>
        <%= stack_item(data: section_item_data(section)) do %>
          <%= render(row_component_class.new(user_custom_field_section: section, sections: @user_custom_field_sections)) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
