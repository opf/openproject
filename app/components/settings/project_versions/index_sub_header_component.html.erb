<%=
  render(Primer::OpenProject::SubHeader.new(collapsed_search: filter_input_value.blank?, data: sub_header_data_attributes)) do |subheader|
    if User.current.allowed_in_project?(:manage_versions, project)
      subheader.with_action_button(
        scheme: :primary,
        leading_icon: :plus,
        label: t(:label_version_new),
        tag: :a,
        test_selector: "versions-create-button",
        href: url_for({ controller: "/versions", action: "new", project_id: project })
      ) do
        Version.model_name.human
      end
    end

    subheader.with_filter_input(
      name: "name",
      id: filter_input_id,
      label: t("versions.index.filter_label"),
      visually_hide_label: true,
      value: filter_input_value,
      placeholder: t("versions.index.filter_label"),
      leading_visual: { icon: :search, size: :small },
      show_clear_button: true,
      clear_button_id:,
      data: filter_input_data_attributes
    )

    subheader.with_quick_filter do
      render(
        OpPrimer::QuickFilter::SegmentedControlComponent.new(
          name: t("versions.index.filter_label"),
          query:,
          filter_key: :status,
          path_args: [project, :settings, :versions]
        )
      ) do |control|
        control.with_item(label: t("versions.filter_status_labels.open"), value: "open")
        control.with_item(label: t("versions.filter_status_labels.locked"), value: "locked")
        control.with_item(label: t("versions.filter_status_labels.closed"), value: "closed")
      end
    end
  end
%>
