<%=
  primer_form_with(**form_arguments) do |form|
    # render_inline_form evaluates its block on the form object, where the
    # component's methods are out of reach.
    hidden = hidden_fields
    input = input_arguments
    cancel = cancel_arguments

    render_inline_form(form) do |title_form|
      hidden.each { |name, value| title_form.hidden(name:, value:) }

      title_form.group(layout: :horizontal) do |row|
        row.text_field(**input)
        row.submit(name: :submit, label: I18n.t(:button_save), scheme: :primary)
        row.button(**cancel)
      end
    end
  end
%>
