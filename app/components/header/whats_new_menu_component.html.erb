<%= render(Primer::BaseComponent.new(tag: :div, classes: "op-app-menu--item hidden-for-mobile", position: :relative, px: 1)) do %>
  <%= render(
        Primer::Alpha::Overlay.new(
          title:,
          visually_hide_title: true,
          anchor_side: :outside_bottom,
          anchor_align: :end,
          anchor_offset: :spacious,
          "alignment-offset": -16,
          size: :medium_portrait,
          padding: :none,
          role: :dialog,
          classes: "op-whats-new-menu"
        )
      ) do |overlay| %>
    <% overlay.with_show_button(
         icon: :gift,
         scheme: :invisible,
         classes: "op-app-header--primer-button",
         test_selector: "op-header-whats-new-button",
         aria: { label: title }
       ) %>

    <% overlay.with_body do %>
      <%= helpers.turbo_frame_tag Header::WhatsNewComponent.wrapper_key,
                                  src: header_whats_new_path,
                                  loading: :lazy,
                                  target: "_top" do %>
        <%= render(Header::WhatsNewSkeletonComponent.new(item_count:)) %>
      <% end %>
    <% end %>
  <% end %>

  <% unless seen? %>
    <%= render(
          Primer::BaseComponent.new(
            tag: :span,
            classes: "op-bubble op-bubble_mini op-whats-new-menu--badge",
            test_selector: "op-header-whats-new-badge",
            data: { whats_new_badge: true }
          )
        ) %>
  <% end %>
<% end %>
