<%= render(Primer::BaseComponent.new(tag: :div, classes: "op-app-menu--item hidden-for-mobile", pl: 1)) do %>
  <%= render(
        Primer::Alpha::Overlay.new(
          title: t(".title"),
          visually_hide_title: true,
          anchor_side: :outside_bottom,
          anchor_align: :end,
          anchor_offset: :spacious,
          size: :medium,
          role: :dialog,
          classes: "op-whats-new-menu"
        )
      ) do |overlay| %>
    <% overlay.with_show_button(
         icon: :gift,
         scheme: :invisible,
         classes: "op-app-header--primer-button",
         test_selector: "op-header-whats-new-button",
         aria: { label: t(".title") }
       ) %>

    <% overlay.with_body do %>
      <%= helpers.turbo_frame_tag Header::WhatsNewComponent::FRAME_ID,
                                  src: header_whats_new_path,
                                  loading: :lazy,
                                  target: "_top" %>
    <% end %>
  <% end %>
<% end %>
