<header class="<%= header_classes %>">
  <div class="op-app-header--start">
    <%# skip-navigation-link is revealed on focus in frontend/src/global_styles/content/_links.sass. %>
    <%# herb:disable a11y-no-visually-hidden-interactive-elements 1 %>
    <a href="#content" class="sr-only skip-navigation-link"
       id="skip-navigation--content"
       aria-label="<%= I18n.t("js.work_packages.jump_marks.label_content") %>">
      <%= I18n.t("js.work_packages.jump_marks.content") %>
    </a>
    <%= helpers.render_top_menu_left %>
  </div>
  <div class="op-app-header--center op-app-header--center_mobile-end">
    <%= helpers.render_top_menu_center %>
  </div>
  <div class="op-app-header--end">
    <%= helpers.call_hook :view_layouts_base_top_menu %>
    <%= helpers.render_top_menu_right %>
  </div>
  <%= render Hotkeys::FallbackLinksComponent.new(project: @project, user: @user, can_add_work_packages: can_add_work_packages?) %>
</header>
