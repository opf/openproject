<%= component_wrapper(tag: "turbo-frame") do %>
  <%= render(
        Primer::BaseComponent.new(
          tag: :div,
          text_align: :left,
          pb: 3,
          test_selector: "op-header-whats-new-content",
          data: {
            controller: "header--whats-new",
            "header--whats-new-read-url-value": read_header_whats_new_path,
            "header--whats-new-seen-url-value": seen_url
          }
        )
      ) do %>
    <% if show_header_row? %>
      <%= render(Primer::Box.new(display: :flex, align_items: :center, justify_content: :space_between, px: 3, pt: 3, pb: 2)) do %>
        <% if show_title? %>
          <%= render(Primer::Beta::Heading.new(tag: :h2, font_size: 4)) { title } %>
        <% end %>
        <% if video_url.present? %>
          <%= render(
                Primer::Beta::Link.new(
                  href: video_url,
                  target: "_blank",
                  rel: "noopener",
                  data: { allow_external_link: true },
                  test_selector: "op-header-whats-new-video"
                )
              ) do |link| %>
            <% link.with_leading_visual_icon(icon: :video) %>
            <%= t("header.whats_new.view_release_video") %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if image %>
      <%= render(Primer::Box.new(px: 3, pb: 2)) do %>
        <%= helpers.image_tag(image, alt: "", class: "op-whats-new--image") %>
      <% end %>
    <% end %>

    <%= render(Primer::BaseComponent.new(tag: :ul, classes: "op-whats-new--list")) do %>
      <%= render(Header::WhatsNewItemComponent.with_collection(items, unread_keys:)) %>
    <% end %>
  <% end %>
<% end %>
