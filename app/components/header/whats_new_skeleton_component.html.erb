<%= render(Primer::Box.new(pb: 3, test_selector: "op-header-whats-new-skeleton")) do %>
  <%= render(Primer::Box.new(display: :flex, justify_content: :space_between, px: 3, pt: 3, pb: 2)) do %>
    <%= render(Primer::Alpha::SkeletonBox.new(width: "40%", height: "20px")) %>
    <%= render(Primer::Alpha::SkeletonBox.new(width: "30%", height: "20px")) %>
  <% end %>
  <% @item_count.times do |index| %>
    <% if index.positive? %>
      <%= render(OpPrimer::DividerComponent.new(mt: 0, mb: 0)) %>
    <% end %>
    <%= render(Primer::Box.new(px: 3, py: 2)) do %>
      <%= render(Primer::Alpha::SkeletonBox.new(width: "35%", height: "16px", mb: 2)) %>
      <%= render(Primer::Alpha::SkeletonBox.new(width: "75%", height: "16px")) %>
    <% end %>
  <% end %>
<% end %>
