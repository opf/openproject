<%= render(
      Primer::Alpha::Dialog.new(
        id: DIALOG_ID,
        title: t("admin_elevation.dialog.title", project: project.name),
        test_selector: "admin-elevation-dialog"
      )
    ) do |dialog| %>
  <%= primer_form_with(url: project_admin_elevation_path(project), scope: :admin_elevation, method: :post) do |form| %>
    <%= render(Primer::Alpha::Dialog::Body.new) do %>
      <%= render(Primer::Beta::Text.new(tag: :p)) do %>
        <%= t("admin_elevation.dialog.description", minutes: idle_timeout_minutes) %>
      <% end %>

      <%= render(Primer::Beta::Text.new(tag: :p, color: :muted, test_selector: "admin-elevation-dialog-confirmation")) do %>
        <%= t("admin_elevation.dialog.confirmation_placeholder") %>
      <% end %>

      <%= render(AdminElevationSessions::Form.new(form, back_url:)) %>
    <% end %>

    <%= render(Primer::Alpha::Dialog::Footer.new) do %>
      <%= render(Primer::Beta::Button.new(data: { "close-dialog-id": DIALOG_ID })) { t(:button_cancel) } %>
      <%= render(Primer::Beta::Button.new(scheme: :primary, type: :submit)) { t("admin_elevation.dialog.submit") } %>
    <% end %>
  <% end %>
<% end %>
