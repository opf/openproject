<% if Setting.passkey_authentication_enabled? %>
  <div class="webauthn-login"
       data-controller="webauthn--login"
       data-webauthn--login-options-url-value="<%= account_webauthn_authentication_options_path %>"
       data-webauthn--login-authenticate-url-value="<%= account_webauthn_authenticate_path %>"
       data-webauthn--login-back-url-value="<%= back_url_to_current_page %>">
    <%= render(Primer::Beta::Button.new(
          scheme: :default,
          block: true,
          data: { action: "webauthn--login#signIn", test_selector: "webauthn-login--button" }
        )) do |button|
          button.with_leading_visual_icon(icon: :key)
          t("webauthn_credentials.sign_in_with_passkey")
        end %>
    <p class="webauthn-credentials--error" data-webauthn--login-target="errorDisplay"></p>
  </div>
<% end %>
