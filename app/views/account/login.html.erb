<% html_title "Entrar" %>

<div class="mngt-login-page">
  <div class="mngt-login-card">

    <div class="mngt-login-brand">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40" width="40" height="40" fill="none">
        <rect width="40" height="40" rx="10" fill="#1a9641"/>
        <path d="M10 28 L20 12 L30 28" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
        <path d="M15 22 L25 22" stroke="#fff" stroke-width="3" stroke-linecap="round"/>
      </svg>
      <span class="mngt-login-brand-name">MNGT</span>
    </div>

    <div class="mngt-login-text">
      <h1 class="mngt-login-title">Bem-vindo</h1>
      <p class="mngt-login-subtitle">Use sua conta corporativa Google para entrar</p>
    </div>

    <% if flash[:error].present? %>
      <div class="mngt-login-alert mngt-login-alert--error"><%= flash[:error] %></div>
    <% end %>
    <% if flash[:notice].present? %>
      <div class="mngt-login-alert mngt-login-alert--notice"><%= flash[:notice] %></div>
    <% end %>

    <a href="<%= omni_auth_start_path(:google_oauth2, script_name: OpenProject::Configuration.rails_relative_url_root) %>"
       class="mngt-google-btn">
      <svg class="mngt-google-btn-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="20" height="20" aria-hidden="true">
        <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
        <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
        <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
        <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
      </svg>
      <span>Entrar com o Google</span>
    </a>

  </div>
</div>
