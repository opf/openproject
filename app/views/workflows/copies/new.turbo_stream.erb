<%= turbo_stream.dialog do
      title = t(".title", source_type: @source_variant.composite_name)
      dialog_id = "copy_from_type_dialog"
      type_variants_enabled = OpenProject::FeatureDecisions.type_variants_active?
      another_type_at_first = @source_role.nil?

      dialog_data = type_variants_enabled ? {} : { controller: "show-when-value-selected" }

      render(Primer::Alpha::Dialog.new(title:, size: :large, classes: "Overlay--size-large-portrait", id: dialog_id, data: dialog_data)) do |d|
        d.with_header(variant: :large)
        d.with_body(classes: type_variants_enabled ? "Overlay-body_autocomplete_height" : nil) do
          settings_primer_form_with(id: "copy_form") do |f|
            render(Workflows::Copies::Form.new(f, source_variant: @source_variant, source_role: @source_role, other_variants: @other_variants, all_roles: @all_roles, append_to: "##{dialog_id}"))
          end
        end
        d.with_footer do
          if type_variants_enabled
            render(Primer::Beta::Button.new(data: { "close-dialog-id": dialog_id })) { t(:button_cancel) } +
            render(
              Primer::Beta::Button.new(
                scheme: :primary,
                tag: :button,
                type: :submit,
                form: "copy_form",
                formaction: type_workflow_copy_from_role_path(type_id: @source_variant.type_id, variant_id: @source_variant.id, source_role_id: @source_role&.id),
                data: { turbo: true }
              )
            ) do
              t(:button_copy)
            end
          else
            # TODO: Remove with type_variants feature flag
            render(Primer::Beta::Button.new(data: { "close-dialog-id": dialog_id })) { t(:button_cancel) } +
            render(
              Primer::Beta::Button.new(
                hidden: !another_type_at_first,
                scheme: :primary,
                tag: :button,
                type: :submit,
                form: "copy_form",
                formaction: type_workflow_copy_from_variant_path(type_id: @source_variant.type_id, variant_id: @source_variant.id),
                data: {
                  target_name: "mode",
                  value: "from_type",
                  "show-when-value-selected-target": "effect",
                  turbo: true
                }
              )
            ) do
              t(:button_copy)
            end +
            render(
              Primer::Beta::Button.new(
                hidden: another_type_at_first,
                scheme: :primary,
                tag: :button,
                type: :submit,
                form: "copy_form",
                formaction: type_workflow_copy_from_role_path(type_id: @source_variant.type_id, variant_id: @source_variant.id, source_role_id: @source_role&.id),
                data: {
                  target_name: "mode",
                  value: "from_role",
                  "show-when-value-selected-target": "effect",
                  turbo: true
                }
              )
            ) do
              t(:button_copy)
            end
          end
        end
      end
    end %>
