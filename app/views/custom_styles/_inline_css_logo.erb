<style type="text/css" data-turbo-track="reload">
  <%
  is_ru = I18n.locale == :ru
  cs = apply_custom_styles? ? CustomStyle.current : nil

  desktop_light_logo_url = asset_path(is_ru ? "logo-white-bg-ua.png" : "logo_openproject_white_big.png")
  desktop_light_high_contrast_logo_url = if OpenProject::Configuration.bim?
                                           asset_path("bim/logo_openproject_bim_big_coloured.png")
                                         else
                                           asset_path(is_ru ? "logo-black-bg-ua.png" : "logo_openproject.png")
                                         end
  desktop_dark_logo_url = desktop_light_logo_url

  mobile_light_logo_url = asset_path("icon_logo_white.svg")
  mobile_light_high_contrast_logo_url = asset_path("icon_logo.svg")
  mobile_dark_logo_url = mobile_light_logo_url

  if cs
    desktop_logos = [
      cs.logo_for(color_mode: :light),
      cs.logo_for(color_mode: :light, high_contrast: true),
      cs.logo_for(color_mode: :dark)
    ]

    unless desktop_logos.any?(&:present?)
      desktop_logos = [
        cs.logo_for(color_mode: :light, mobile: true),
        cs.logo_for(color_mode: :light, high_contrast: true, mobile: true),
        cs.logo_for(color_mode: :dark, mobile: true)
      ]
    end

    theme_logo_url = asset_path(cs.theme_logo) if cs.theme_logo.present?

    desktop_light_logo_url = custom_logo_url(cs, desktop_logos[0]) || theme_logo_url || desktop_light_logo_url
    desktop_light_high_contrast_logo_url = custom_logo_url(cs, desktop_logos[1]) ||
      desktop_light_high_contrast_logo_url
    desktop_dark_logo_url = custom_logo_url(cs, desktop_logos[2]) || theme_logo_url || desktop_dark_logo_url

    mobile_light_logo_url = custom_logo_url(cs, cs.logo_for(color_mode: :light, mobile: true)) || mobile_light_logo_url
    mobile_light_high_contrast_logo_url = custom_logo_url(
      cs,
      cs.logo_for(color_mode: :light, high_contrast: true, mobile: true)
    ) || mobile_light_high_contrast_logo_url
    mobile_dark_logo_url = custom_logo_url(cs, cs.logo_for(color_mode: :dark, mobile: true)) || mobile_dark_logo_url
  end
  %>

  .op-logo--link {
    background-image: url(<%= desktop_light_logo_url %>);
  }

  .op-logo--link_high_contrast {
    background-image: url(<%= desktop_light_high_contrast_logo_url %>);
  }

  .op-logo--icon,
  .op-logo--icon_white {
    background-image: url(<%= mobile_light_logo_url %>);
  }

  [data-light-theme="light_high_contrast"] .op-logo--link {
    background-image: url(<%= desktop_light_high_contrast_logo_url %>);
  }

  [data-light-theme="light_high_contrast"] .op-logo--icon {
    background-image: url(<%= mobile_light_high_contrast_logo_url %>);
  }

  [data-color-mode="dark"] .op-logo--link {
    background-image: url(<%= desktop_dark_logo_url %>);
  }

  [data-color-mode="dark"] .op-logo--icon {
    background-image: url(<%= mobile_dark_logo_url %>);
  }
</style>
