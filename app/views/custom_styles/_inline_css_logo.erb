<style type="text/css" data-turbo-track="reload">
  <% logo_urls = resolved_logo_urls %>

  .op-logo--link {
    background-image: url(<%= logo_urls.dig(:desktop, :light) %>);
  }

  .op-logo--link_high_contrast {
    background-image: url(<%= logo_urls.dig(:desktop, :light_high_contrast) %>);
  }

  .op-logo--icon {
    background-image: url(<%= logo_urls.dig(:mobile, :light) %>);
  }

  .op-logo--icon_white {
    background-image: url(<%= logo_urls[:mobile_white_class] %>);
  }

  [data-light-theme="light_high_contrast"] .op-logo--link {
    background-image: url(<%= logo_urls.dig(:desktop, :light_high_contrast) %>);
  }

  [data-light-theme="light_high_contrast"] .op-logo--icon {
    background-image: url(<%= logo_urls.dig(:mobile, :light_high_contrast) %>);
  }

  [data-color-mode="dark"] .op-logo--link {
    background-image: url(<%= logo_urls.dig(:desktop, :dark) %>);
  }

  [data-color-mode="dark"] .op-logo--icon {
    background-image: url(<%= logo_urls.dig(:mobile, :dark) %>);
  }
</style>
