<%=
  primer_form_with(
    model: @custom_style,
    url: custom_style_path,
    multipart: true,
    data: { controller: "auto-submit" }
  ) do |f|
    render_inline_form(f) do |form|
      form.file_field(
        name: image[:field],
        label: image[:label],
        description: image[:instructions],
        accept: image[:accept],
        preview_url: (image[:source] if image[:present]),
        preview_class: image[:img_class],
        required: true,
        auto_submit: true,
        delete_path: (image[:delete_path] if image[:present]),
        delete_button_arguments: {
          data: {
            turbo_method: :delete,
            test_selector: "delete-custom-style-image-#{image[:field]}"
          }
        }
      )
    end
  end
%>
