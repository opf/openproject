<%=
  primer_form_with(
    model: @custom_style,
    url: custom_style_path,
    multipart: true,
    class: "form -vertical",
    data: { controller: "auto-submit" }
  ) do |f|
    render_inline_form(f) do |form|
      form.file_field(
        name: font[:field],
        label: font[:label],
        description: font[:instructions],
        accept: "font/ttf",
        filename: font[:filename],
        required: true,
        auto_submit: true,
        delete_path: (font[:delete_path] if font[:present]),
        delete_button_arguments: {
          data: { turbo_method: :delete }
        }
      )
    end
  end
%>
