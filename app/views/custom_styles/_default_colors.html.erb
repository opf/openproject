<%=
  render(Primer::OpenProject::SubHeader.new) do |subheader|
    subheader.with_action_button(
      scheme: :primary,
      leading_icon: :plus,
      label: I18n.t("colors.index.label_new_color"),
      tag: :a,
      href: new_color_path
    ) do
      t(:button_add)
    end
  end
%>

<%= render(
      OpenProject::Common::BorderBoxListComponent.new(
        container: :default_colors,
        mb: 3,
        test_selector: "default-colors-list"
      )
    ) do |list| %>
  <% list.with_header(title: t(:label_color_plural)) %>
  <% list.with_empty_state(title: t("colors.index.no_results_title_text")) %>

  <% @colors.each do |color| %>
    <% list.with_item(display: :flex, justify_content: :space_between, align_items: :center) do %>
      <%= render(Primer::Beta::Link.new(href: edit_color_path(color), font_weight: :bold)) { color.name } %>
      <%= render(Primer::Beta::Text.new(display: :flex, align_items: :center, font_size: :small)) do %>
        <%= render(Colors::SwatchComponent.new(hexcode: color.hexcode, show_value: true)) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
