<%= render(Primer::Beta::Subhead.new(spacious: false)) do |subhead| %>
  <% subhead.with_heading(tag: :h3, size: :medium) { t("admin.custom_styles.export.title") } %>
  <% subhead.with_description { t("admin.custom_styles.export.description") } %>
<% end %>

<%= flex_layout(flex_wrap: :wrap, classes: "gap-3") do |flex| %>
  <% flex.with_column(flex: 1, classes: "custom-style--growing-logo-form") do %>
    <%= render partial: "custom_styles/uploads/image", locals: { image: {
          field: :export_logo,
          label: I18n.t(:label_custom_export_logo),
          present: @custom_style.id && @custom_style.export_logo.present?,
          source: if @custom_style.id && @custom_style.export_logo.present?
                    custom_style_export_logo_path(digest: @custom_style.digest, filename: @custom_style.export_logo_identifier)
                  end,
          img_class: "custom-export-logo-preview",
          accept: "image/png, image/jpeg",
          delete_path: custom_style_export_logo_delete_path,
          instructions: I18n.t("text_custom_export_logo_instructions")
        } } %>
  <% end %>

  <% flex.with_column(flex: 1, classes: "custom-style--growing-logo-form") do %>
    <%= render partial: "custom_styles/uploads/image", locals: { image: {
          field: :export_cover,
          label: I18n.t(:label_custom_export_cover),
          present: @custom_style.id && @custom_style.export_cover.present?,
          source: if @custom_style.id && @custom_style.export_cover.present?
                    custom_style_export_cover_path(digest: @custom_style.digest, filename: @custom_style.export_cover_identifier)
                  end,
          img_class: "custom-export-cover-preview",
          accept: "image/png, image/jpeg",
          delete_path: custom_style_export_cover_delete_path,
          instructions: I18n.t("text_custom_export_cover_instructions")
        } } %>
  <% end %>

  <% if OpenProject::FeatureDecisions.minutes_styling_meeting_pdf_active? %>
    <% flex.with_column(flex: 1, classes: "custom-style--growing-logo-form") do %>
      <%= render partial: "custom_styles/uploads/image", locals: { image: {
            field: :export_footer,
            label: I18n.t(:label_custom_export_footer),
            present: @custom_style.id && @custom_style.export_footer.present?,
            source: if @custom_style.id && @custom_style.export_footer.present?
                      custom_style_export_footer_path(digest: @custom_style.digest, filename: @custom_style.export_footer_identifier)
                    end,
            img_class: "custom-export-footer-preview",
            accept: "image/png, image/jpeg",
            delete_path: custom_style_export_footer_delete_path,
            instructions: I18n.t("text_custom_export_footer_instructions")
          } } %>
    <% end %>
  <% end %>
<% end %>

<%= render(Primer::Beta::Subhead.new(spacious: false)) do |subhead| %>
  <% subhead.with_heading(tag: :h3, size: :medium, mt: 4) { t("label_custom_export_font") } %>
<% end %>

<%= flex_layout(flex_wrap: :wrap, classes: "gap-3", mb: 3) do |flex| %>
  <% export_fonts_fields(@custom_style).each do |font| %>
    <% flex.with_column(flex: 1, classes: "custom-style--growing-logo-form") do %>
      <%= render partial: "custom_styles/uploads/font", locals: { font: } %>
    <% end %>
  <% end %>
<% end %>

<%
  design_color_hex = @custom_style.export_cover_text_color.presence
  instruction_key = "admin.custom_styles.instructions.export_cover_text_color"
  text_color_label = I18n.t(:label_custom_export_cover_text_color)
  text_color_instruction = I18n.t(instruction_key) if I18n.exists?(instruction_key, :en)
%>

<%= render(OpenProject::Common::BorderBoxListComponent.new(container: "export-cover-text-color", mb: 3)) do |list| %>
  <% list.with_header(title: I18n.t(:label_custom_export_font_colors)) %>

  <% list.with_item do %>
    <%= render(
          CustomStyles::ColorListItemComponent.new(
            label: text_color_label,
            instruction: text_color_instruction,
            hexcode: design_color_hex || "#000000",
            show_value: design_color_hex.present?,
            dialog_arguments: {
              variable: "export_cover_text_color",
              label: text_color_label,
              instruction: text_color_instruction,
              value: design_color_hex,
              placeholder: "#000",
              form_url: update_custom_style_export_cover_text_color_path,
              param_name: :export_cover_text_color
            }
          )
        ) %>
  <% end %>
<% end %>

<%=
  render(
    Primer::Beta::Button.new(
      target: "_blank",
      data: { turbo: false },
      tag: :a,
      mt: 3,
      href: export_demo_pdf_download_custom_style_path
    )
  ) do |_c|
    t("export.demo.button_text")
  end
%>
