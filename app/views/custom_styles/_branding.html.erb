<%= render(Primer::Beta::Subhead.new(spacious: true)) do |subhead| %>
  <% subhead.with_heading(tag: :h2) { t("admin.custom_styles.branding.desktop.title") } %>
  <% subhead.with_description { t("admin.custom_styles.branding.desktop.description") } %>
<% end %>

<% custom_logo_uploads(@custom_style).each do |image| %>
  <%= render partial: "custom_styles/uploads/image", locals: { image: } %>
<% end %>

<%= render(Primer::Beta::Subhead.new(spacious: true)) do |subhead| %>
  <% subhead.with_heading(tag: :h2) { t("admin.custom_styles.branding.mobile.title") } %>
  <% subhead.with_description { t("admin.custom_styles.branding.mobile.description") } %>
<% end %>

<% custom_logo_uploads(@custom_style, mobile: true).each do |image| %>
  <%= render partial: "custom_styles/uploads/image", locals: { image: } %>
<% end %>

<%
  favicon_present = @custom_style.persisted? && @custom_style.favicon.present?
  favicon_source = if favicon_present
                     custom_style_favicon_path(
                       digest: @custom_style.digest,
                       filename: @custom_style.favicon_identifier
                     )
                   end
%>
<%= render partial: "custom_styles/uploads/image", locals: { image: {
      field: :favicon,
      label: I18n.t(:label_custom_favicon),
      present: favicon_present,
      source: favicon_source,
      img_class: "custom-favicon-preview",
      accept: "image/*",
      delete_path: custom_style_favicon_delete_path,
      instructions: I18n.t("text_custom_favicon_instructions")
    } } %>

<%
  touch_icon_present = @custom_style.persisted? && @custom_style.touch_icon.present?
  touch_icon_source = if touch_icon_present
                        custom_style_touch_icon_path(
                          digest: @custom_style.digest,
                          filename: @custom_style.touch_icon_identifier
                        )
                      end
%>
<%= render partial: "custom_styles/uploads/image", locals: { image: {
      field: :touch_icon,
      label: I18n.t(:label_custom_touch_icon),
      present: touch_icon_present,
      source: touch_icon_source,
      img_class: "custom-touch-icon-preview",
      accept: "image/*",
      delete_path: custom_style_touch_icon_delete_path,
      instructions: I18n.t("text_custom_touch_icon_instructions")
    } } %>
