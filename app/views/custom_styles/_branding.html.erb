<%= render(Primer::Beta::Subhead.new(spacious: false)) do |subhead| %>
  <% subhead.with_heading(tag: :h3, size: :medium, mt: 4) { t("admin.custom_styles.branding.desktop.title") } %>
  <% subhead.with_description { t("admin.custom_styles.branding.desktop.description") } %>
<% end %>

<%= flex_layout(flex_wrap: :wrap, classes: "gap-3") do |flex| %>
  <% custom_logo_uploads(@custom_style).each do |image| %>
    <% flex.with_column(flex: 1, classes: "custom-style--growing-logo-form") do %>
      <%= render partial: "custom_styles/uploads/image", locals: { image: } %>
    <% end %>
  <% end %>
<% end %>

<%= render(Primer::Beta::Subhead.new(spacious: false)) do |subhead| %>
  <% subhead.with_heading(tag: :h3, size: :medium, mt: 4) { t("admin.custom_styles.branding.mobile.title") } %>
  <% subhead.with_description { t("admin.custom_styles.branding.mobile.description") } %>
<% end %>

<%= flex_layout(flex_wrap: :wrap, classes: "gap-3") do |flex| %>
  <% custom_logo_uploads(@custom_style, mobile: true).each do |image| %>
    <% flex.with_column(flex: 1, classes: "custom-style--growing-logo-form") do %>
      <%= render partial: "custom_styles/uploads/image", locals: { image: } %>
    <% end %>
  <% end %>
<% end %>

<%= render(Primer::Beta::Subhead.new(spacious: false)) do |subhead| %>
  <% subhead.with_heading(tag: :h3, size: :medium, mt: 4) { t("admin.custom_styles.branding.favicon.title") } %>
  <% subhead.with_description { t("admin.custom_styles.branding.favicon.title_description") } %>
<% end %>

<%
  favicon_present = @custom_style.persisted? && @custom_style.favicon.present?
  favicon_source = if favicon_present
                     custom_style_favicon_path(
                       digest: @custom_style.digest,
                       filename: @custom_style.favicon_identifier
                     )
                   end
%>
<%= render partial: "custom_styles/uploads/image", locals: { image: {
      field: :favicon,
      label: t("admin.custom_styles.branding.favicon.field"),
      instructions: t("admin.custom_styles.branding.favicon.field_description"),
      present: favicon_present,
      source: favicon_source,
      img_class: "custom-favicon-preview",
      accept: "image/*",
      delete_path: custom_style_favicon_delete_path
    } } %>

<%= render(Primer::Beta::Subhead.new(spacious: false)) do |subhead| %>
  <% subhead.with_heading(tag: :h3, size: :medium, mt: 4) { t("admin.custom_styles.branding.touch_icon.title") } %>
  <% subhead.with_description { t("admin.custom_styles.branding.touch_icon.title_description") } %>
<% end %>

<%
  touch_icon_present = @custom_style.persisted? && @custom_style.touch_icon.present?
  touch_icon_source = if touch_icon_present
                        custom_style_touch_icon_path(
                          digest: @custom_style.digest,
                          filename: @custom_style.touch_icon_identifier
                        )
                      end
%>
<%= render partial: "custom_styles/uploads/image", locals: { image: {
      field: :touch_icon,
      label: t("admin.custom_styles.branding.touch_icon.field"),
      instructions: t("admin.custom_styles.branding.touch_icon.field_description"),
      present: touch_icon_present,
      source: touch_icon_source,
      img_class: "custom-touch-icon-preview",
      accept: "image/*",
      delete_path: custom_style_touch_icon_delete_path
    } } %>
