<% html_title t(:label_work_package_plural), t("work_packages.import.title") %>

<%=
  render Primer::OpenProject::PageHeader.new do |header|
    header.with_title { t("work_packages.import.title") }
    header.with_description { t("work_packages.import.intro") }
    header.with_breadcrumbs(
      [{ href: project_overview_path(@project.id), text: @project.name },
       { href: project_work_packages_path(@project), text: t(:label_work_package_plural) },
       t("work_packages.import.title")]
    )
  end
%>

<%
  max_size = Setting.attachment_max_size.to_i.kilobytes
  too_large = t("work_packages.import.csv.file.too_large_before_upload", limit: number_to_human_size(max_size))
%>

<%=
  render Primer::Box.new(
    data: {
      controller: "work-packages--csv-import",
      work_packages__csv_import_max_size_value: max_size,
      work_packages__csv_import_too_large_value: too_large
    }
  ) do
%>
  <%= render Primer::Box.new(id: "import_announcement", classes: "sr-only", aria: { live: :polite }) %>
  <%= render partial: "work_packages/import/report" %>
  <%= render partial: "work_packages/import/form" %>
<% end %>
