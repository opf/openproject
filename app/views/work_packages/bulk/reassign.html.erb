<%= error_messages_for work_packages.first %>

<%= render(Primer::Beta::Subhead.new) do |subhead|
      subhead.with_heading(tag: :h3) { t("work_package.destroy.title") }
    end %>

<p class="bold"><%= t(:text_destroy_with_associated) %></p>

<ul>
  <% associated.each do |ac| %>
    <li><%= ac.model_name.human %></li>
  <% end %>
</ul>

<%= render(Primer::Beta::Text.new(tag: :p, mt: 3, mb: 2)) do %>
  <strong><%= t(:text_destroy_what_to_do) %></strong>
<% end %>

<%=
  primer_form_with(
    url: work_packages_bulk_path,
    method: :delete,
    scope: :to_do,
    data: { controller: "show-when-value-selected" }
  ) do |f|
    raw_back_url = (params[:back_url] || request.env["HTTP_REFERER"]).presence
    cancel_url = RedirectPolicy.new(raw_back_url, hostname: request.host, default: work_packages_path).redirect_url
    back_url = back_url_is_wp_show? ? nil : raw_back_url&.then { |url| CGI.escape(CGI.unescape(url.to_s)) }

    render_inline_form(f) do |form|
      form.hidden(name: "back_url", value: back_url, scope_name_to_model: false) if back_url

      work_packages.each do |wp|
        form.hidden(name: "ids[]", value: wp.id, scope_name_to_model: false)
      end

      form.radio_button_group(
        name: :action,
        label: helpers.t("work_package.destroy.title"),
        visually_hide_label: true
      ) do |group|
        group.radio_button(
          value: "destroy",
          label: helpers.t(:text_destroy),
          data: { show_when_value_selected_target: "cause", target_name: "action" }
        )
        group.radio_button(
          value: "nullify",
          label: helpers.t(:text_assign_to_project),
          data: { show_when_value_selected_target: "cause", target_name: "action" }
        )
        group.radio_button(
          value: "reassign",
          label: helpers.t(:text_reassign),
          data: { show_when_value_selected_target: "cause", target_name: "action" }
        ) do |radio|
          radio.nested_form(
            hidden: true,
            data: { show_when_value_selected_target: "effect", target_name: "action", value: "reassign" }
          ) do |builder|
            helpers.inline_form(builder) do |nested|
              nested.work_package_autocompleter(
                name: :reassign_to_id,
                label: helpers.t(:text_reassign),
                visually_hide_label: true,
                input_width: :large,
                autocomplete_options: {
                  url: ::API::V3::Utilities::PathHelper::ApiV3Path.work_packages,
                  openDirectly: false,
                  focusDirectly: false
                }
              )
            end
          end
        end
      end

      form.group(layout: :horizontal) do |row|
        row.submit(name: :submit, label: helpers.t(:button_delete), scheme: :danger)
        row.button(name: :cancel, tag: :a, label: helpers.t(:button_cancel), href: cancel_url)
      end
    end
  end
%>
