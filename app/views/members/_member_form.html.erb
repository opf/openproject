<%=
  render(
    Primer::OpenProject::InsetBox.new(
      id: "members_add_form",
      data: {
        "members-form-target": "addMemberForm",
        controller: "user-limit",
        "user-limit-open-seats-value": OpenProject::Enterprise.open_seats_count,
        "user-limit-member-autocompleter-value": true
      }
    )
  ) do
%>
  <%= primer_form_with(
        scope: :member,
        url: main_app.project_members_path,
        method: :post,
        class: "form -vertical"
      ) do |f| %>

      <div id="new-member-message"></div>
      <%
        user_id_title = I18n.t(:label_principal_search)

        if current_user.admin?
          user_id_title = "#{user_id_title}#{I18n.t(:label_principal_invite_via_email)}"
        end
      %>
      <% preview_role_permissions = Roles::PermissionsDialogComponent.visible_to?(current_user) %>
      <%= render_inline_form(f) do |form|
            form.group(
              layout: :horizontal,
              direction: %i[column column column row],
              classes: "row-gap-3",
              data: { controller: ("roles--permissions-preview" if preview_role_permissions) }
            ) do |group|
              group.autocompleter(
                name: :user_ids,
                label: user_id_title,
                wrapper_data_attributes: { "user-limit-target": "inviteUserForm" },
                autocomplete_options: {
                  component: "opce-members-autocompleter",
                  inputBindValue: "id",
                  url: "#{helpers.autocomplete_for_member_project_members_path}.json",
                  multiple: true
                }
              )

              group.select_list(
                name: "member[role_ids][]",
                scope_name_to_model: false,
                id: "member_role_ids",
                input_width: :medium,
                label: render(OpPrimer::AttributeLabelComponent.new(attribute: "members", model: Project, tag: nil)) do
                  render(Primer::Beta::Text.new) { helpers.t(:label_role_search) }
                end,
                caption: (
                  if preview_role_permissions
                    render(
                      Primer::Beta::Button.new(
                        scheme: :link,
                        type: :button,
                        font_size: :small,
                        data: { action: "roles--permissions-preview#open" },
                        test_selector: "op-members--role-preview-link"
                      )
                    ) { helpers.t("roles.permissions_dialog.preview_action") }
                  end
                ),
                data: { "roles--permissions-preview-target": "select" }
              ) do |select|
                roles.each do |role|
                  select.option(
                    label: role.name,
                    value: role.id,
                    data: { permissions_dialog_path: helpers.role_permissions_dialog_path(role) }
                  )
                end
              end
            end

            form.group(
              layout: :horizontal
            ) do |group|
              group.button(
                name: :cancel,
                label: helpers.t(:button_cancel),
                data: { action: "members-form#hideAddMemberForm" }
              )

              group.submit(
                name: :submit,
                label: helpers.t(:button_add),
                scheme: :primary,
                id: "add-member--submit-button"
              )
            end
          end %>
  <% end %>

  <% if OpenProject::Enterprise.user_limit.present? %>
    <%=
      render(
        Primer::Alpha::Banner.new(
          scheme: :warning,
          icon: :alert,
          mt: 2,
          classes: "d-none",
          data: { "user-limit-target": "limitWarning" }
        )
      ) do
    %>
      <%=
        link_translate(
          "warning_user_limit_reached#{'_admin_html' if current_user.admin?}",
          links: { upgrade_url: OpenProject::Enterprise.upgrade_url }
        )
      %>
    <% end %>
  <% end %>
<% end %>
