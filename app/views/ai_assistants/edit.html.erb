<% title = @assistant.name %>
<% html_title(*pages.html_title_parts, title) %>

<%=
  render(Primer::OpenProject::PageHeader.new) do |header|
    header.with_title { title }
    header.with_breadcrumbs(pages.breadcrumbs(title))

    header.with_action_button(
      scheme: :danger,
      mobile_icon: :trash,
      mobile_label: t("button_delete"),
      tag: :a,
      href: pages.assistant_path(@assistant),
      data: { turbo_method: :delete, turbo_confirm: t("admin.ai_assistants.delete.confirm"),
              test_selector: "ai-assistant-delete" }
    ) do |button|
      button.with_leading_visual_icon(icon: :trash)
      t("button_delete")
    end
  end
%>

<% if pages.admin? && @assistant.owned? %>
  <%= render(Primer::Alpha::Banner.new(mb: 4, icon: @assistant.group? ? :people : :person)) do %>
    <% if @assistant.group? %>
      <%= t("admin.ai_assistants.edit.group_banner", group: @assistant.principal.name) %>
    <% else %>
      <%= t("admin.ai_assistants.edit.personal_banner", user: @assistant.principal.name) %>
    <% end %>
  <% end %>
<% end %>

<%= render "ai_assistants/form", url: pages.assistant_path(@assistant), method: :patch %>

<%= render(Primer::Beta::Subhead.new(mt: 6)) do |subhead| %>
  <% subhead.with_heading(tag: :h2) { t("admin.ai_assistants.skills.title") } %>
  <% subhead.with_actions do %>
    <%= render(Primer::Beta::Button.new(tag: :a, href: pages.new_skill_path(@assistant))) do |button| %>
      <% button.with_leading_visual_icon(icon: :plus) %>
      <%= t("admin.ai_assistants.skills.add") %>
    <% end %>
  <% end %>
<% end %>

<%= render(Primer::Beta::BorderBox.new) do |box| %>
  <% if @assistant.skills.empty? %>
    <% box.with_body { t("admin.ai_assistants.skills.empty") } %>
  <% end %>
  <% @assistant.skills.each do |skill| %>
    <% box.with_row(data: { test_selector: "ai-assistant-skill-row" }) do %>
      <%= flex_layout(align_items: :center) do |row| %>
        <% row.with_column(flex: 1) do %>
          <%= render(Primer::Beta::Link.new(href: pages.edit_skill_path(@assistant, skill))) { skill.display_label } %>
          <% if skill.skill_type && skill.skill_type.kind_label != skill.display_label %>
            <%= render(Primer::Beta::Label.new(scheme: :secondary, ml: 2)) { skill.skill_type.kind_label } %>
          <% end %>
          <% if skill.prompt.blank? %>
            <%= render(Primer::Beta::Label.new(scheme: :attention, ml: 2)) do %>
              <%= skill.skill_type&.prompt_required? ? t("admin.ai_assistants.skills.no_prompt_not_offered") : t("admin.ai_assistants.skills.no_prompt") %>
            <% end %>
          <% end %>
          <% if skill.conditions.present? %>
            <%= render(Primer::Beta::Label.new(scheme: :accent, ml: 2, data: { test_selector: "ai-skill-conditions" })) do %>
              <%= skill.conditions.map { |key, ids| t("admin.ai_assistants.skills.conditions.count.#{key}", count: ids.size) }.join(" · ") %>
            <% end %>
          <% end %>
          <% unless skill.active? %>
            <%= render(Primer::Beta::Label.new(scheme: :secondary, ml: 2)) { t("admin.ai_assistants.inactive") } %>
          <% end %>
        <% end %>
        <% row.with_column do %>
          <%= button_to t(:button_delete),
                        pages.skill_path(@assistant, skill),
                        method: :delete,
                        class: "Button Button--invisibleVariant Button--small",
                        form: { data: { turbo_confirm: t("admin.ai_assistants.skills.delete_confirm") } } %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
