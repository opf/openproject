<% html_title(*pages.html_title_parts) %>

<%=
  render(Primer::OpenProject::PageHeader.new) do |header|
    header.with_title { pages.title }
    header.with_description { pages.admin? ? t("admin.ai_assistants.index.description") : t("my_account.ai_assistants.description") }
    header.with_breadcrumbs(pages.breadcrumbs)
  end
%>

<%=
  render(Primer::OpenProject::SubHeader.new) do |subheader|
    if pages.admin?
      subheader.with_quick_filter do
        render(Primer::Alpha::SegmentedControl.new("aria-label": t("admin.ai_assistants.index.owner_filter"))) do |control|
          [[nil, t("admin.ai_assistants.index.owners.all")],
           ["global", t("admin.ai_assistants.index.owners.global")],
           ["groups", t("admin.ai_assistants.index.owners.groups")],
           ["personal", t("admin.ai_assistants.index.owners.personal")]].each do |value, label|
            control.with_item(tag: :a, href: pages.assistants_path(owner: value), label:, selected: owner_filter == value)
          end
        end
      end
    end

    subheader.with_action_button(
      scheme: :primary,
      leading_icon: :plus,
      label: t("admin.ai_assistants.index.add"),
      tag: :a,
      href: pages.new_assistant_path
    ) do
      t("admin.ai_assistants.index.add")
    end
  end
%>

<% if @assistants.empty? %>
  <%= render(Primer::Beta::Blankslate.new(border: true)) do |slate| %>
    <% slate.with_visual_icon(icon: :sparkle) %>
    <% slate.with_heading(tag: :h2).with_content(t("admin.ai_assistants.index.empty")) %>
    <% unless pages.admin? %>
      <% slate.with_description { t("my_account.ai_assistants.empty_description") } %>
    <% end %>
  <% end %>
<% else %>
  <%= render(Primer::Beta::BorderBox.new) do |box| %>
    <% @assistants.each do |assistant| %>
      <% box.with_row(data: { test_selector: "ai-assistant-row" }) do %>
        <%= flex_layout(align_items: :center) do |row| %>
          <% row.with_column(mr: 2) { render(Primer::Beta::Octicon.new(icon: assistant.icon.presence || :sparkle)) } %>
          <% row.with_column(flex: 1) do %>
            <%= render(Primer::Beta::Link.new(href: pages.edit_assistant_path(assistant), font_weight: :bold)) { assistant.name } %>
            <% unless assistant.active? %>
              <%= render(Primer::Beta::Label.new(scheme: :secondary, ml: 2)) { t("admin.ai_assistants.inactive") } %>
            <% end %>
            <% assistant.skills.each do |skill| %>
              <%= render(Primer::Beta::Label.new(ml: 2)) { skill.display_label } %>
            <% end %>
            <% if assistant.description.present? %>
              <%= render(Primer::Beta::Text.new(tag: :p, color: :muted, font_size: :small, mb: 0)) { assistant.description } %>
            <% end %>
          <% end %>
          <% if pages.admin? %>
            <% row.with_column(ml: 2, data: { test_selector: "ai-assistant-owner" }) do %>
              <%= render(Primer::Beta::Text.new(color: :muted, font_size: :small)) do %>
                <%= assistant.owned? ? assistant.principal.name : t("admin.ai_assistants.index.owners.global") %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
