<%= flex_layout(direction: [:column, nil, nil, :row], align_items: :stretch, classes: "gap-4") do |layout| %>
  <% layout.with_box(col: [12, nil, nil, 4], flex_shrink: 0) do %>
    <%= render Admin::Settings::ColorForm.new(form) %>
  <% end %>
