<div data-controller="mngt--avatar-crop"
     data-mngt--avatar-crop-upload-url-value="<%= edit_my_avatar_path %>"
     data-mngt--avatar-crop-csrf-token-value="<%= form_authenticity_token %>"
     style="margin-bottom: 2rem;">

  <%# Current avatar + change button %>
  <div style="display:flex; align-items:center; gap:1.25rem; margin-bottom:0.5rem;">
    <div style="width:80px; height:80px; border-radius:50%; overflow:hidden; background:#2d2d2d; flex-shrink:0;">
      <% if local_avatar?(@user) %>
        <img src="<%= user_avatar_path(@user) %>?v=<%= @user.updated_at.to_i %>"
             style="width:80px; height:80px; object-fit:cover; display:block;"
             alt="<%= @user.name %>">
      <% else %>
        <div style="width:80px;height:80px;border-radius:50%;background:#5a4fcf;display:flex;align-items:center;justify-content:center;font-size:2rem;color:#fff;font-weight:600;">
          <%= @user.firstname.to_s.first.upcase %>
        </div>
      <% end %>
    </div>

    <div style="display:flex; flex-direction:column; gap:0.5rem;">
      <label style="cursor:pointer; display:inline-flex; align-items:center; gap:0.4rem;
                    background:#5a4fcf; color:#fff; padding:0.45rem 1rem; border-radius:6px;
                    font-size:0.875rem; font-weight:500;">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
        Alterar foto
        <input type="file" accept="image/*" style="display:none;"
               data-mngt--avatar-crop-target="input"
               data-action="change->mngt--avatar-crop#fileSelected">
      </label>
      <% if local_avatar?(@user) %>
        <%= link_to "Remover foto",
                    edit_my_avatar_path,
                    data: { turbo_method: :delete, turbo_confirm: t(:are_you_sure_delete_avatar) },
                    style: "font-size:0.8rem; color:#aaa; text-decoration:underline;" %>
      <% end %>
    </div>
  </div>

  <%# Crop modal %>
  <div data-mngt--avatar-crop-target="modal"
       style="display:none; position:fixed; inset:0; z-index:9999;
              background:rgba(0,0,0,0.75); align-items:center; justify-content:center;">
    <div style="background:#1e1e1e; border-radius:12px; width:min(520px,95vw);
                max-height:90vh; overflow:hidden; display:flex; flex-direction:column;">

      <%# Header %>
      <div style="display:flex; align-items:center; justify-content:space-between;
                  padding:1rem 1.25rem; border-bottom:1px solid #333;">
        <span style="color:#fff; font-weight:600;">Recorte a imagem e clique em Salvar</span>
        <button type="button" data-action="click->mngt--avatar-crop#closeModal"
                style="background:none; border:none; color:#aaa; cursor:pointer; font-size:1.25rem; line-height:1;">✕</button>
      </div>

      <%# Cropper area %>
      <div style="flex:1; overflow:hidden; max-height:360px; background:#000;">
        <img data-mngt--avatar-crop-target="image"
             style="display:block; max-width:100%;" src="" alt="crop">
      </div>

      <%# Preview + Save %>
      <div style="display:flex; align-items:center; gap:1.5rem; padding:1rem 1.25rem; border-top:1px solid #333;">
        <div style="flex-shrink:0;">
          <div style="font-size:0.75rem; color:#888; margin-bottom:0.4rem;">Prévia</div>
          <div data-mngt--avatar-crop-target="preview"
               style="width:64px; height:64px; border-radius:50%; overflow:hidden; background:#333;"></div>
        </div>
        <div style="flex:1;"></div>
        <button type="button" data-action="click->mngt--avatar-crop#save"
                data-mngt--avatar-crop-target="uploadBtn"
                style="background:#f97316; color:#fff; border:none; border-radius:6px;
                       padding:0.5rem 1.5rem; font-weight:600; font-size:0.9rem; cursor:pointer;">
          Salvar
        </button>
      </div>
    </div>
  </div>
</div>
<% end %>

<%=
  settings_primer_form_with(
    model: @user,
    url: { action: "update_account" },
    lang: current_language,
    data: password_confirmation_data_attribute(
      { turbo: false,
        test_selector: "my-account-form" }
    )
  ) do |form|
    render(
      Primer::Forms::FormList.new(
        My::AccountForm.new(form, user: @user),
        My::CustomFieldsForm.new(form),
        My::AccountSubmitForm.new(form)
      )
    )
  end
%>
