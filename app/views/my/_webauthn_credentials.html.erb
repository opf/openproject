<% passkeys_enabled = Setting.passkey_authentication_enabled? %>
<% if passkeys_enabled || @user.webauthn_credentials.any? %>
  <%= render(Primer::Beta::Subhead.new(mt: 5)) do |subhead|
        subhead.with_heading(tag: :h3, size: :medium) { t("webauthn_credentials.plural") }
        subhead.with_description { t("webauthn_credentials.description") }
      end %>

  <section class="admin--edit-section">
    <% if @user.webauthn_credentials.any? %>
      <ul class="webauthn-credentials-list">
        <% @user.webauthn_credentials.order(:created_at).each do |credential| %>
          <li class="webauthn-credentials-list--item">
            <span class="webauthn-credentials-list--name"><%= credential.name %></span>
            <span class="light">
              <%= credential.last_used_at ? t("webauthn_credentials.last_used_on", date: format_time(credential.last_used_at)) : t("webauthn_credentials.never_used") %>
            </span>
            <%= delete_link my_webauthn_credential_path(credential) %>
          </li>
        <% end %>
      </ul>
    <% end %>

    <% if passkeys_enabled %>
      <div data-controller="webauthn--registration"
           data-webauthn--registration-options-url-value="<%= new_my_webauthn_credential_path %>"
           data-webauthn--registration-create-url-value="<%= my_webauthn_credentials_path %>">
        <%= render(Primer::Beta::Button.new(scheme: :default, data: { action: "webauthn--registration#register" })) do |button|
              button.with_leading_visual_icon(icon: :key)
              t("webauthn_credentials.register")
            end %>
        <p class="webauthn-credentials--error" data-webauthn--registration-target="errorDisplay"></p>
      </div>
    <% end %>
  </section>
<% end %>
