<% dialog_id = "#{id}-add-projects-dialog" %>
<% form_id = "#{id}-add-projects-form" %>

<% if candidates.exists? %>
  <%= render(Primer::OpenProject::SubHeader.new) do |subheader| %>
    <% subheader.with_action_button(
         scheme: :primary,
         leading_icon: :"op-include-projects",
         label: t(:label_add_projects),
         data: { "show-dialog-id": dialog_id }
       ) { t(:label_add_projects) } %>
  <% end %>

  <%= render(Primer::Alpha::Dialog.new(id: dialog_id, title: t(:label_add_projects), size: :medium_portrait)) do |dialog| %>
    <% dialog.with_header(variant: :large) %>
    <% dialog.with_body do %>
      <%= primer_form_with(url: add_path, method: :post, id: form_id) do |form| %>
        <%= render(Projects::AddAssignmentsForm.new(form, projects: candidates)) %>
      <% end %>
    <% end %>
    <% dialog.with_footer do %>
      <%= render(Primer::Beta::Button.new(data: { "close-dialog-id": dialog_id })) { t(:button_cancel) } %>
      <%= render(Primer::Beta::Button.new(scheme: :primary, type: :submit, form: form_id)) { t(:button_add) } %>
    <% end %>
  <% end %>
<% end %>

<%= render(Projects::AssignmentsTableComponent.new(rows:, remove_path:, empty_title:)) %>
