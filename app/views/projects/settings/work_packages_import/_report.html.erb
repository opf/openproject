<%= render Primer::Box.new(id: "import_report") do %>
  <% if import_running? %>
    <%=
      render Primer::Box.new(
        tag: :span,
        hidden: true,
        data: { work_packages__csv_import_target: "poll",
                url: status_project_settings_work_packages_import_path(@project, job: @status.job_id) }
      )
    %>
    <%= render partial: "projects/settings/work_packages_import/running" %>
  <% elsif @status.present? %>
    <%= render Primer::Box.new(tag: :span, hidden: true, data: { work_packages__csv_import_target: "finished" }) %>
    <%= render WorkPackages::Import::CSV::ReportComponent.new(status: @status, project: @project) %>
  <% end %>
<% end %>
