<table class="width-full f6" style="table-layout:fixed;">
  <thead>
    <tr>
      <% headers.each do |header| %>
        <th scope="col" class="text-left text-normal color-fg-muted px-3 py-2 border-bottom"><%= header %></th>
      <% end %>
    </tr>
  </thead>
  <tbody>
    <% rows.each do |cells| %>
      <tr>
        <% cells.each do |cell| %>
          <td class="<%= class_names("px-3 py-2 border-bottom", "width-25" => cell[:style] == :available) %>">
            <% case cell[:style] %>
            <% when :muted %>
              <%= render(Primer::Beta::Text.new(color: :muted)) { cell[:text].to_s } %>
            <% when :strong %>
              <%= render(Primer::Beta::Text.new(font_weight: :semibold)) { cell[:text].to_s } %>
            <% when :code %>
              <% if cell[:text].present? %>
                <%= render(Primer::Beta::Text.new(tag: :code)) { cell[:text].to_s } %>
              <% else %>
                <%= render(Primer::Beta::Text.new(tag: :code, color: :muted, font_style: :italic)) { t("work_packages.import.report.table.empty") } %>
              <% end %>
            <% when :available %>
              <% if cell[:values].present? %>
                <%= render(OpPrimer::ExpandableTextComponent.new(flex: 1)) do %>
                  <%= cell[:values].join(", ") %>
                <% end %>
              <% end %>
            <% else %>
              <%= cell[:text] %>
            <% end %>
          </td>
        <% end %>
      </tr>
    <% end %>
  </tbody>
</table>
