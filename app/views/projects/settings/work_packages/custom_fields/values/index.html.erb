<% html_title t(:label_project_settings), t(:label_work_package_plural), t(:label_custom_field_plural), custom_field.name %>

<%=
  render(Primer::OpenProject::PageHeader.new) do |header|
    header.with_title do
      safe_join(
        [
          custom_field.name,
          " ",
          render(Primer::Beta::Text.new(color: :muted)) { "(#{label_for_custom_field_format(custom_field.field_format)})" }
        ]
      )
    end
    header.with_breadcrumbs(
      [
        { href: project_overview_path(configured_project.id), text: configured_project.name },
        { href: project_settings_general_path(configured_project.id), text: t(:label_project_settings) },
        { href: project_settings_work_packages_path(configured_project.id), text: t(:label_work_package_plural) },
        { href: project_settings_work_packages_custom_fields_path(configured_project.id), text: t(:label_custom_field_plural) },
        custom_field.name
      ]
    )
  end
%>

<%=
  render(Primer::Beta::Text.new(tag: :p)) do
    t("projects.settings.custom_fields.values_description", custom_field: custom_field.name, project: configured_project.name)
  end
%>

<%= render(Admin::CustomFields::Projects::ValuesSubHeaderComponent.new(custom_field:)) %>

<%= render(Admin::CustomFields::Projects::ValuesComponent.new(custom_field:, project: configured_project)) %>
