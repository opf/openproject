const CACHE_PREFIX = <%== pwa_cache_prefix.to_json %>;

<% if OpenProject::FeatureDecisions.progressive_web_app_active? %>
const CACHE_NAME = <%== pwa_cache_name.to_json %>;
const OFFLINE_URL = <%== pwa_offline_path.to_json %>;
const HOME_URL = <%== root_path.to_json %>;
const PUSH_URL = <%== pwa_push_notification_path.to_json %>;
const SHOWN_URL = `${PUSH_URL}?shown`;
const STATE_CACHE = `${CACHE_PREFIX}push-state`;
const PUSH_TAG_PREFIX = "openproject-";
const PUSH_TAG = "openproject-unread";
const PUSH_MORE_TAG = "openproject-more";
const PUSH_FETCH_TIMEOUT_MS = 10000;
const PUSH_FALLBACK_TITLE = <%== I18n.t("pwa.push.fallback_title", locale: Setting.default_language).to_json %>;
const PUSH_ALL_READ_TITLE = <%== I18n.t("pwa.push.all_read_title", locale: Setting.default_language).to_json %>;
const PUSH_ICON = <%== image_path("pwa/icon-192.png").to_json %>;

// An error status or a redirect fails the install, which keeps the previous worker.
const precacheOfflinePage = async () => {
  const response = await fetch(new Request(OFFLINE_URL, { credentials: "omit", cache: "reload" }));
  if (!response.ok || response.redirected) throw new Error("Offline page unavailable");

  const cache = await caches.open(CACHE_NAME);
  await cache.put(OFFLINE_URL, response);
};

self.addEventListener("install", (event) => {
  event.waitUntil(
    precacheOfflinePage()
      .catch((error) => {
        console.warn("Offline page could not be precached", error);
        throw error;
      })
      .then(() => self.skipWaiting()),
  );
});

self.addEventListener("activate", (event) => {
  event.waitUntil(
    caches
      .keys()
      .then((names) =>
        Promise.all(
          names
            .filter((name) => name.startsWith(CACHE_PREFIX) && name !== CACHE_NAME && name !== STATE_CACHE)
            .map((name) => caches.delete(name)),
        ),
      )
      .then(() => self.registration.navigationPreload?.enable())
      .then(() => self.clients.claim()),
  );
});

// The URL stays the requested one so the offline page can retry it.
self.addEventListener("fetch", (event) => {
  const { request } = event;
  if (request.mode !== "navigate" || request.destination !== "document" || request.method !== "GET") return;

  event.respondWith(
    (async () => {
      try {
        return (await event.preloadResponse) || (await fetch(request));
      } catch {
        const cache = await caches.open(CACHE_NAME);
        return (await cache.match(OFFLINE_URL)) || Response.error();
      }
    })(),
  );
});

const fetchUnread = async () => {
  try {
    const response = await fetch(PUSH_URL, {
      credentials: "include",
      cache: "no-store",
      headers: { Accept: "application/json" },
      signal: AbortSignal.timeout(PUSH_FETCH_TIMEOUT_MS),
    });
    if (response.status === 401) return { signedOut: true };
    return response.ok ? await response.json() : null;
  } catch {
    return null;
  }
};

const showFallback = () =>
  self.registration.showNotification(PUSH_FALLBACK_TITLE, {
    tag: PUSH_TAG,
    icon: PUSH_ICON,
    silent: true,
    renotify: false,
    data: { url: HOME_URL, revision: "fallback" },
  });

const openNotifications = async () => {
  const notifications = await self.registration.getNotifications();
  return notifications.filter((notification) => notification.tag.startsWith(PUSH_TAG_PREFIX));
};

const closeExcept = (notifications, keep) =>
  notifications.filter((notification) => !keep.has(notification.tag)).forEach((notification) => notification.close());

// Digests of what was last shown per tag, so a dismissed notification stays dismissed until its content changes.
const readShown = async () => {
  const cache = await caches.open(STATE_CACHE);
  const stored = await cache.match(SHOWN_URL);
  return stored ? stored.json() : {};
};

const writeShown = async (shown) => {
  const cache = await caches.open(STATE_CACHE);
  await cache.put(SHOWN_URL, new Response(JSON.stringify(shown), { headers: { "Content-Type": "application/json" } }));
};

const digestOf = async (...parts) => {
  const bytes = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(JSON.stringify(parts)));
  return Array.from(new Uint8Array(bytes), (byte) => byte.toString(16).padStart(2, "0")).join("");
};

const same = (previous, current) => previous !== undefined && previous === current;

const groupOptions = (group) => ({
  body: group.body,
  tag: group.tag,
  icon: PUSH_ICON,
  data: { url: group.url, revision: group.revision },
});

const showGroup = (group) =>
  self.registration.showNotification(group.title, { ...groupOptions(group), renotify: true });

const refreshGroup = (group) =>
  self.registration.showNotification(group.title, { ...groupOptions(group), renotify: false });

const showMore = (more) =>
  self.registration.showNotification(more.title, {
    tag: PUSH_MORE_TAG,
    icon: PUSH_ICON,
    silent: true,
    data: { url: more.url, revision: more.title },
  });

const showGroups = async ({ groups, more }) => {
  const shown = await readShown();
  const keep = new Set(groups.map((group) => group.tag));
  if (more) keep.add(PUSH_MORE_TAG);
  const openBefore = await openNotifications();
  closeExcept(openBefore, keep);

  const next = {};
  let changed = false;
  const nothingOpen = openBefore.length === 0;

  if (more) {
    next[PUSH_MORE_TAG] = await digestOf(more.title);
    const moreOpen = openBefore.some((notification) => notification.tag === PUSH_MORE_TAG);
    if (!same(shown[PUSH_MORE_TAG], next[PUSH_MORE_TAG]) || !moreOpen) {
      await showMore(more);
      changed = true;
    }
  }

  for (const group of [...groups].reverse()) {
    next[group.tag] = await digestOf(group.revision, group.title, group.body || "");
    if (nothingOpen) {
      await refreshGroup(group);
      changed = true;
    } else if (!same(shown[group.tag], next[group.tag])) {
      await showGroup(group);
      changed = true;
    }
  }

  if (!changed) {
    if (openBefore.some((notification) => notification.tag === groups[0].tag)) await refreshGroup(groups[0]);
    else await showFallback();
  }
  await writeShown(more ? { ...shown, ...next } : next);
};

const closeAll = async () => {
  closeExcept(await openNotifications(), new Set());
  await writeShown({});
};

const renderUnread = async () => {
  const data = await fetchUnread();

  if (data?.signedOut) {
    await navigator.clearAppBadge?.().catch(() => undefined);
    await closeAll();
    return showFallback();
  }
  if (!data) return showFallback();

  if (data.count === 0) {
    await closeAll();
    await self.registration.showNotification(PUSH_ALL_READ_TITLE, {
      tag: PUSH_TAG,
      icon: PUSH_ICON,
      silent: true,
      data: { url: HOME_URL, revision: "all-read" },
    });
    return navigator.clearAppBadge?.().catch(() => undefined);
  }

  await navigator.setAppBadge?.(data.count).catch(() => undefined);
  return showGroups(data);
};

// A push has to end in a visible notification whatever went wrong on the way.
const showUnread = async () => {
  try {
    await renderUnread();
  } catch {
    await showFallback();
  }
};

let pushQueue = Promise.resolve();

self.addEventListener("push", (event) => {
  pushQueue = pushQueue.then(showUnread, showUnread).catch(() => undefined);
  event.waitUntil(pushQueue);
});

const sameOriginUrl = (url) => {
  const resolved = new URL(url, self.location.href);
  return resolved.origin === self.location.origin ? resolved.href : HOME_URL;
};

const openOrFocus = async (requestedUrl) => {
  const url = sameOriginUrl(requestedUrl);
  const windows = await self.clients.matchAll({ type: "window", includeUncontrolled: true });
  const clients = windows.filter((candidate) => candidate.url.startsWith(self.registration.scope));
  const client =
    clients.find((candidate) => candidate.visibilityState === "visible" || candidate.focused) || clients[0];
  if (!client) return self.clients.openWindow(url);

  let navigated;
  try {
    navigated = await client.navigate(url);
  } catch {
    return self.clients.openWindow(url);
  }
  return navigated?.focus();
};

self.addEventListener("notificationclick", (event) => {
  event.notification.close();
  event.waitUntil(openOrFocus(event.notification.data?.url || HOME_URL));
});
<% else %>
self.addEventListener("install", (event) => {
  event.waitUntil(self.skipWaiting());
});

self.addEventListener("activate", (event) => {
  event.waitUntil(
    caches
      .keys()
      .then((names) =>
        Promise.all(names.filter((name) => name.startsWith(CACHE_PREFIX)).map((name) => caches.delete(name))),
      )
      .then(() => self.registration.unregister()),
  );
});
<% end %>
