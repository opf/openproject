<%
  theme_color = header_bg_color

  manifest = {
    name: Setting.app_title,
    short_name: pwa_short_name,
    id: root_path,
    start_url: root_path,
    scope: root_path,
    display: "standalone",
    prefer_related_applications: true,
    related_applications: [
      { platform: "play",
        id: "org.openproject.app",
        url: "https://play.google.com/store/apps/details?id=org.openproject.app" }
    ],
    theme_color:,
    background_color: theme_color,
    icons: [192, 512, 1024].map do |size|
      { src: image_path("pwa/icon-#{size}.png"), sizes: "#{size}x#{size}", type: "image/png" }
    end + [{ src: image_path("pwa/icon.svg"), sizes: "any", type: "image/svg+xml" }]
  }.compact
%>
<%== JSON.pretty_generate(manifest) %>
