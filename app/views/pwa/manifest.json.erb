  manifest = {
    name: Setting.app_title,
    short_name: pwa_short_name,
    id: root_path,
    start_url: root_path,
    scope: root_path,
    display: "standalone",
    theme_color:,
    background_color: theme_color,
    icons: [192, 512].map do |size|
      { src: image_path("pwa/icon-#{size}.png"), sizes: "#{size}x#{size}", type: "image/png" }
    end
  }.compact
