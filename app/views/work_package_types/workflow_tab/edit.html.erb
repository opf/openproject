<% html_title variant_scope_title, t(:label_type_plural), @variant.composite_name -%>

<%= render ::Types::EditPageHeaderComponent.new(type: @type, variant: @variant, tabs: types_tabs) %>

<%= render(
      WorkPackageTypes::ReloadableConfigurationFrameComponent.new(
        reload_url: edit_type_workflow_path(**@variant.path_args)
      )
    ) do %>
  <%= render(WorkPackageTypes::ReuseModeBannerComponent.new(variant: @variant, aspect: TypeVariant::WORKFLOWS)) %>

  <% if @type && @roles.any? %>
    <%= form_tag(
          type_workflow_matrix_path(**@variant.path_args, tab: @current_tab),
          method: :patch,
          autocomplete: "off",
          class: "workflow-table--pinned-save-bar"
        ) do %>
      <%= turbo_frame_tag "workflow-table", src: type_workflow_matrix_path(**@variant.path_args, tab: @current_tab, role_ids: @roles.map(&:id), status_ids: params[:status_ids]) %>

      <% unless @variant.linked?(TypeVariant::WORKFLOWS) %>
        <div class="workflow-save-bar">
          <%=
            render Primer::Beta::Button.new(scheme: :primary, type: :submit, mt: 3, ml: 3, mb: 4) do
              t(:button_save)
            end
          %>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>
