<% html_title variant_scope_title, "#{t(:label_edit)} #{t(:label_work_package_types)} #{h @variant.composite_name}" %>

<%= render ::Types::EditPageHeaderComponent.new(type: @type, variant: @variant, tabs: types_tabs) %>

<% no_filter_query = ::API::V3::Queries::QueryParamsRepresenter.new(Query.new_default.tap { |q| q.filters = [] }).to_json %>
<%= render(
      WorkPackageTypes::ReloadableConfigurationFrameComponent.new(
        reload_url: edit_variant_form_configuration_path(variant_scope_project, @variant)
      )
    ) do %>
  <%= render(WorkPackageTypes::FormConfiguration::TabSubHeaderComponent.new(variant: @variant)) %>
  <%= render(WorkPackageTypes::FormConfiguration::ReadOnlyBannerComponent.new(context: form_editor_context)) %>
  <%= render(
        WorkPackageTypes::FormConfigurationComponent.new(
          context: form_editor_context,
          form_attributes: form_configuration_groups(form_editor_context),
          no_filter_query:
        )
      ) %>
<% end %>
