<% html_title variant_scope_title, "#{t(:label_edit)} #{t(:label_work_package_types)} #{h @variant.composite_name}" %>

<%= render ::Types::EditPageHeaderComponent.new(type: @type, variant: @variant, tabs: types_tabs) %>

<%= render(
      WorkPackageTypes::ReloadableConfigurationFrameComponent.new(
        reload_url: edit_type_project_attributes_path(**@variant.path_args)
      )
    ) do %>
  <%= render(WorkPackageTypes::ReuseModeBannerComponent.new(variant: @variant, aspect: TypeVariant::PROJECT_ATTRIBUTES)) %>

  <%= render WorkPackageTypes::ProjectAttributes::IndexComponent.new(
        variant: @variant,
        project_custom_field_sections: @project_custom_field_sections
      ) %>
<% end %>
