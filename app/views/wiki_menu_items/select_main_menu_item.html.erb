<%=
  render Primer::OpenProject::PageHeader.new do |header|
    header.with_title_content(@page.title)
    header.with_breadcrumbs(
      breadcrumb_for_page(@project, @page, t(:label_select_main_menu_item))
    )
  end
%>
<p><%= t :wiki_menu_item_new_main_item_explanation %></p>

<%= labelled_tabular_form_with model: false, scope: :wiki_page, url: { action: "replace_main_menu_item" } do |f| %>
  <fieldset class="form--fieldset" id="wiki_menu_item_setting">
    <legend class="form--fieldset-legend"><%= WikiPage.model_name.human %></legend>
    <p>
      <%= f.select :id,
                   wiki_page_options_for_select(@possible_wiki_pages),
                   { label: WikiPage.human_attribute_name(:title) },
                   { id: "main-menu-item-select" } %>
    </p>
  </fieldset>
  <%= submit_tag t(:button_save), class: "button -primary" %>
<% end %>
