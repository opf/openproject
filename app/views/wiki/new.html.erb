<% html_title t(:create_wiki_page) %>

<%=
  render Primer::OpenProject::PageHeader.new do |header|
    header.with_title { t(:create_wiki_page) }
    header.with_breadcrumbs(
      [{ href: project_overview_path(@project.id), text: @project.name },
       { href: url_for({ controller: "/wiki", action: "index", project_id: @project.identifier }), text: t("activerecord.models.wiki") },
       t(:create_wiki_page)]
    )
  end
%>
<%= primer_form_with(
      model: @page,
      scope: :page,
      url: create_project_wiki_index_path(project_id: @project),
      method: :post,
      data: { turbo: false }
    ) do |f| %>
  <%= render(Primer::Alpha::Layout.new(stacking_breakpoint: :lg)) do |layout| %>
    <% layout.with_main do %>
      <%= render WikiPages::Form.new(f, create: true) %>
    <% end %>
    <% layout.with_sidebar(col_placement: :end, row_placement: :end) do %>
      <%= render WikiPages::AttachmentsSidePanelComponent.new(@page) %>
    <% end %>
  <% end %>
<% end %>

<% content_for :header_tags do %>
  <%= robot_exclusion_tag %>
<% end %>

<% html_title @page.title %>
