<% html_title t(:label_administration), t("menus.admin.ai_assistants") %>

<%=
  render(Primer::OpenProject::PageHeader.new) do |header|
    header.with_title { t("menus.admin.ai_assistants") }
    header.with_description { t("admin.ai_assistants.index.description") }
    header.with_breadcrumbs(
      [{ href: admin_index_path, text: t(:label_administration) },
       { href: mcp_configurations_path, text: t("menus.admin.ai") },
       t("menus.admin.ai_assistants")]
    )
  end
%>

<%=
  render(Primer::OpenProject::SubHeader.new) do |subheader|
    subheader.with_action_button(scheme: :primary, leading_icon: :plus, label: t("admin.ai_assistants.index.add"),
                                 tag: :a, href: new_admin_ai_assistant_path) do
      t("admin.ai_assistants.index.add")
    end
  end
%>

<% if @assistants.empty? %>
  <%= render(Primer::Beta::Blankslate.new(border: true)) do |slate| %>
    <% slate.with_visual_icon(icon: :sparkle) %>
    <% slate.with_heading(tag: :h2).with_content(t("admin.ai_assistants.index.empty")) %>
  <% end %>
<% else %>
  <%= render(Primer::Beta::BorderBox.new) do |box| %>
    <% @assistants.each do |assistant| %>
      <% box.with_row(data: { test_selector: "ai-assistant-row" }) do %>
        <%= flex_layout(align_items: :center) do |row| %>
          <% row.with_column(mr: 2) { render(Primer::Beta::Octicon.new(icon: assistant.icon.presence || :sparkle)) } %>
          <% row.with_column(flex: 1) do %>
            <%= render(Primer::Beta::Link.new(href: edit_admin_ai_assistant_path(assistant), font_weight: :bold)) { assistant.name } %>
            <% unless assistant.active? %>
              <%= render(Primer::Beta::Label.new(scheme: :secondary, ml: 2)) { t("admin.ai_assistants.inactive") } %>
            <% end %>
            <% assistant.skills.each do |skill| %>
              <%= render(Primer::Beta::Label.new(ml: 2)) { skill.display_label } %>
            <% end %>
            <% if assistant.description.present? %>
              <%= render(Primer::Beta::Text.new(tag: :p, color: :muted, font_size: :small, mb: 0)) { assistant.description } %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
