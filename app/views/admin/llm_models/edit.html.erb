<% html_title t(:label_administration), t("menus.admin.llm_connection"), @llm_model.external_id %>

<%=
  render(Primer::OpenProject::PageHeader.new) do |header|
    header.with_title { @llm_model.external_id }
    header.with_description { t(".description") }
    header.with_breadcrumbs(
      [{ href: admin_index_path, text: t(:label_administration) },
       { href: mcp_configurations_path, text: t("menus.admin.ai") },
       { href: llm_connection_path, text: t("menus.admin.llm_connection") },
       @llm_model.external_id]
    )
  end
%>

<%= settings_primer_form_with(
      model: @llm_model,
      url: llm_model_path(@llm_model),
      method: :patch,
      data: { test_selector: "llm-model--edit-form" }
    ) do |f| %>
  <%= render(LlmModels::Form.new(f)) %>
<% end %>
