<% html_title t(:label_administration), t(:label_security_level_scheme_plural) %>

<%=
  render(Primer::OpenProject::PageHeader.new) do |header|
    header.with_title { t(:label_security_level_scheme_plural) }
    header.with_description { t("admin.security_level_schemes.description") }
    header.with_breadcrumbs(
      [{ href: admin_index_path, text: t(:label_administration) },
       t(:label_security_level_scheme_plural)]
    )
  end
%>

<%=
  render(Primer::OpenProject::SubHeader.new) do |subheader|
    subheader.with_action_button(
      scheme: :primary, leading_icon: :plus, tag: :a,
      href: new_admin_security_level_scheme_path,
      label: t("admin.security_level_schemes.new"),
      test_selector: "add-security-level-scheme"
    ) do
      SecurityLevelScheme.model_name.human
    end
  end
%>

<% if @schemes.empty? %>
  <%= render(Primer::Beta::Blankslate.new(border: true)) do |slate|
        slate.with_visual_icon(icon: :lock)
        slate.with_heading(tag: :h2).with_content(t("admin.security_level_schemes.blankslate_title"))
        slate.with_description { t("admin.security_level_schemes.description") }
      end %>
<% else %>
  <%= render(Primer::Beta::BorderBox.new(test_selector: "security-level-schemes")) do |box|
        @schemes.each do |scheme|
          box.with_row(display: :flex, align_items: :center) do %>
            <div class="flex-auto">
              <%= render(Primer::Beta::Link.new(href: edit_admin_security_level_scheme_path(scheme), font_weight: :bold)) { scheme.name } %>
              <%= render(Primer::Beta::Text.new(tag: :div, color: :subtle, font_size: :small)) do
                    t(
                      "admin.security_level_schemes.summary",
                      levels: scheme.security_levels.map(&:name).to_sentence.presence || "-",
                      projects: @project_counts.fetch(scheme.id, 0)
                    )
                  end %>
            </div>
            <%= render(
                  Primer::Beta::IconButton.new(
                    icon: :trash, scheme: :danger, tag: :a,
                    href: admin_security_level_scheme_path(scheme),
                    aria: { label: t(:button_delete) },
                    data: { turbo_method: :delete,
                            turbo_confirm: t("admin.security_level_schemes.delete_confirmation") }
                  )
                ) %>
          <% end
        end
      end %>
<% end %>
