<% html_title t(:label_administration), "#{CustomField.model_name.human} #{h @custom_field.name}", @configured_project.name %>

<%=
  render(
    Admin::CustomFields::EditFormHeaderComponent.new(
      custom_field: @custom_field,
      selected: :projects,
      section_label:,
      page_title: custom_field_page_title,
      project: @configured_project
    )
  )
%>

<%=
  render(Primer::Alpha::Banner.new(scheme: :default, icon: :info, mb: 3)) do
    link_translate(
      "custom_fields.admin.projects.editing_values_notice",
      i18n_args: { project: @configured_project.name },
      links: { project_url: project_path(@configured_project) },
      external: false
    )
  end
%>

<%= render(Admin::CustomFields::Projects::ValuesComponent.new(custom_field: @custom_field, project: @configured_project)) %>
