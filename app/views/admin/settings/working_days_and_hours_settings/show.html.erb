<% html_title t(:label_administration), t(:label_working_days_and_hours) %>

<%=
  render(Primer::OpenProject::PageHeader.new) do |header|
    header.with_title(test_selector: "op-working-days-admin-settings--title") { t(:label_working_days_and_hours) }
    header.with_breadcrumbs(
      [{ href: admin_index_path, text: t("label_administration") },
       { href: admin_settings_working_days_and_hours_path, text: t(:label_calendars_and_dates), skip_for_mobile: true },
       t(:label_working_days_and_hours)]
    )
  end
%>

<%= styled_form_tag(
      confirm_changes_admin_settings_working_days_and_hours_path,
      class: "op-working-days-admin-settings",
      data: { turbo_stream: true }
    ) do %>

  <section class="form--section">
    <fieldset class="form--fieldset">
      <%=
        render(
          Primer::Alpha::TextField.new(
            name: "settings[hours_per_day]",
            id: "settings_hours_per_day",
            label: t(:setting_hours_per_day),
            caption: t("setting_hours_per_day_explanation"),
            type: :number,
            value: Setting.hours_per_day,
            disabled: !Setting.hours_per_day_writable?,
            input_width: :small,
            mb: 3
          )
        )
      %>
      <%=
        render(
          Primer::Alpha::Select.new(
            name: "settings[duration_format]",
            id: "settings_duration_format",
            label: t(:setting_duration_format),
            caption: t("setting_duration_format_instructions"),
            disabled: !Setting.duration_format_writable?,
            input_width: :medium,
            mb: 3
          )
        ) do |select|
          Settings::Definition[:duration_format].allowed.each do |format|
            select.option(label: t("setting_duration_format_#{format}"), value: format, selected: Setting.duration_format == format)
          end
        end
      %>
    </fieldset>
  </section>

  <section class="form--section">
    <fieldset class="form--fieldset">
      <legend class="form--fieldset-legend"><%= t("settings.working_days.section_work_week") %></legend>
      <div class="op-toast -warning -with-bottom-spacing">
        <div class="op-toast--content">
          <p>
            <%= t("working_days.warning") %>
          </p>
        </div>
      </div>
      <p>
        <%= t("working_days.info") %>
      </p>

      <%= hidden_field_tag "settings[working_days][]", "", id: nil %>
      <%=
        render(
          Primer::Alpha::CheckBoxGroup.new(
            name: "settings[working_days]",
            label: t(:setting_working_days),
            visually_hide_label: true,
            id: "setting_working_days"
          )
        ) do |group|
          I18n.t("date.day_names").rotate.zip(WeekDay::DAY_RANGE).each do |day_name, day|
            group.check_box(
              label: day_name,
              value: day,
              checked: Setting.working_days.map(&:to_i).include?(day),
              disabled: !Setting.working_days_writable?
            )
          end
        end
      %>
    </fieldset>
  </section>

  <section class="form--section">
    <fieldset class="form--fieldset">
      <legend class="form--fieldset-legend"><%= t("settings.working_days.section_holidays_and_closures") %></legend>

      <p>
        <%= t("working_days.instance_wide_info") %>
      </p>
      <%= angular_component_tag "opce-non-working-days-list",
                                data: { modified_non_working_days: @modified_non_working_days } %>

    </fieldset>
  </section>

  <%= styled_button_tag t(:button_apply_changes), class: "-primary -with-icon icon-checkmark" %>
<% end %>
