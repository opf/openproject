<% html_title t(:label_administration), custom_field_page_title -%>

<%= render(Admin::CustomFields::IndexHeaderComponent.new(title: custom_field_page_title, section_label:, index_path:)) %>

<%= render(CustomFields::FormatSubHeaderComponent.new(customizable_name:)) %>

<% work_package = customizable_name == "WorkPackage" %>
<% if work_package %>
  <%= render(EnterpriseEdition::BannerComponent.new(:custom_field_hierarchies)) %>
<% end %>

<% if @custom_fields.blank? %>
  <%= no_results_box(display_action: false, custom_title: t("custom_fields.no_results_title_text")) %>
<% else %>
  <%= render partial: "admin/settings/custom_fields_base/table",
             locals: { custom_fields: @custom_fields, work_package: } %>
<% end %>
