<%=
  render(
    Admin::AttachmentsSettingsHeaderComponent.new(
      title: t("settings.antivirus.title"),
      selected: 2
    )
  )
%>

<%= render EnterpriseEdition::BannerComponent.new(:virus_scanning) %>

<%=
  settings_primer_form_with(
    url: admin_settings_virus_scanning_path,
    scope: :settings,
    method: :patch,
    data: { controller: "show-when-value-selected" }
  ) do |f|
    render_inline_settings_form(f) do |form|
      form.select_list(
        name: :antivirus_scan_mode,
        values: [
          [t(:label_disabled_uppercase), :disabled],
          ["ClamAV (Socket)", :clamav_socket],
          ["ClamAV (Host)", :clamav_host]
        ],
        disabled: !EnterpriseToken.allows_to?(:virus_scanning),
        input_width: :medium,
        caption: t(
          "settings.antivirus.modes.description_html",
          disabled_option: t(:label_disabled_uppercase),
          socket_option: "ClamAV (Socket)",
          host_option: "ClamAV (Host)"
        ),
        data: { show_when_value_selected_target: "cause", target_name: "antivirus_scan_mode" }
      )

      form.group(
        hidden: Setting.antivirus_scan_mode == :disabled,
        data: { show_when_value_selected_target: "effect", target_name: "antivirus_scan_mode", not_value: "disabled" }
      ) do |group|
        group.text_field(
          name: :antivirus_scan_target,
          input_width: :large,
          caption: safe_join(
            [
              t("settings.antivirus.modes.clamav_socket_html", example: content_tag(:code, "/var/run/clamav/clamd.ctl")),
              t("settings.antivirus.modes.clamav_host_html", example: content_tag(:code, "remotehost:1024"))
            ],
            tag.br
          )
        )

        group.select_list(
          name: :antivirus_scan_action,
          values: [[t("settings.antivirus.actions.quarantine"), :quarantine], [t("settings.antivirus.actions.delete"), :delete]],
          input_width: :medium,
          caption: t(
            "settings.antivirus.actions.instructions_html",
            quarantine_option: t("settings.antivirus.actions.quarantine"),
            delete_option: t("settings.antivirus.actions.delete")
          )
        )
      end

      form.submit(disabled: !EnterpriseToken.allows_to?(:virus_scanning))
    end
  end
%>
