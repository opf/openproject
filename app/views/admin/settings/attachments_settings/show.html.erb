<%=
  render(
    Admin::AttachmentsSettingsHeaderComponent.new(
      title: t(:"attributes.attachments"),
      selected: 1
    )
  )
%>

<%= settings_primer_form_with(
      url: admin_settings_attachments_path,
      scope: :settings,
      method: :patch
    ) do |f|
      render_inline_settings_form(f) do |form|
        form.check_box(
          name: :show_work_package_attachments,
          caption: t("settings.attachments.show_work_package_attachments")
        )

        form.text_field(
          name: :attachment_max_size,
          size: 6,
          input_width: :xsmall,
          trailing_visual: { text: { text: t(:"number.human.storage_units.units.kb") } }
        )

        form.text_area(
          name: :attachment_whitelist,
          caption: t(
            "settings.attachments.whitelist_text_html",
            ext_example: "*.jpg",
            mime_example: "image/jpeg"
          ),
          rows: 5
        )

        form.submit
      end
    end %>
