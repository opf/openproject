<% html_title t(:label_administration), t(:label_security_level_scheme_plural), @scheme.name, @level.name_was %>

<%=
  render(Primer::OpenProject::PageHeader.new) do |header|
    header.with_title { @level.name_was }
    header.with_breadcrumbs(
      [{ href: admin_index_path, text: t(:label_administration) },
       { href: admin_security_level_schemes_path, text: t(:label_security_level_scheme_plural) },
       { href: edit_admin_security_level_scheme_path(@scheme), text: @scheme.name },
       @level.name_was]
    )
  end
%>

<%= error_messages_for @level %>

<%= primer_form_with(model: @level, url: admin_security_level_scheme_security_level_path(@scheme, @level), method: :patch) do |f| %>
  <%= render(Admin::SecurityLevels::Form.new(f)) %>
<% end %>

<%= render(Primer::Beta::Heading.new(tag: :h3, mt: 6, mb: 2)) { t("admin.security_levels.members") } %>
<%= render(Primer::Beta::Text.new(tag: :p, color: :subtle)) { t("admin.security_levels.members_description") } %>

<%= primer_form_with(scope: :member, url: admin_security_level_scheme_security_level_members_path(@scheme, @level), method: :post) do |f| %>
  <%= render(Admin::SecurityLevels::MemberForm.new(f)) %>
<% end %>

<%= render(Primer::Beta::BorderBox.new(mt: 3, test_selector: "security-level-members")) do |box|
      if @members.empty?
        box.with_body { t("admin.security_levels.no_members") }
      end

      @level.security_level_principals.includes(:principal).sort_by { |m| m.principal.name }.each do |membership|
        box.with_row(display: :flex, align_items: :center) do %>
          <div class="flex-auto">
            <%= membership.principal.name %>
            <%= render(Primer::Beta::Label.new(ml: 2)) { membership.principal.model_name.human } %>
          </div>
          <%= render(
                Primer::Beta::IconButton.new(
                  icon: :x, scheme: :invisible, tag: :a,
                  href: admin_security_level_scheme_security_level_member_path(@scheme, @level, membership),
                  aria: { label: t(:button_remove) },
                  data: { turbo_method: :delete }
                )
              ) %>
        <% end
      end
    end %>
