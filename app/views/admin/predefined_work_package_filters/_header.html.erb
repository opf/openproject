<%= render(Primer::OpenProject::PageHeader.new) do |header| %>
  <% header.with_title { @filter.persisted? ? @filter.display_name : t("predefined_work_package_filters.new") } %>
  <% header.with_breadcrumbs(
       [
         { href: admin_index_path, text: t(:label_administration) },
         { href: admin_predefined_work_package_filters_path, text: t("predefined_work_package_filters.title") },
         @filter.display_name || t("predefined_work_package_filters.new")
       ]
     ) %>
  <% if @filter.persisted? %>
    <% header.with_tab_nav(label: t("predefined_work_package_filters.title")) do |nav| %>
      <% nav.with_tab(href: edit_admin_predefined_work_package_filter_path(@filter), selected: !projects) do |tab| %>
        <% tab.with_text { t(:label_general) } %>
      <% end %>
      <% nav.with_tab(href: projects_admin_predefined_work_package_filter_path(@filter), selected: projects) do |tab| %>
        <% tab.with_text { t(:label_project_plural) } %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
