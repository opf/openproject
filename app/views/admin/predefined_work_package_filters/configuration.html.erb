<%= render "admin/predefined_work_package_filters/header", active_tab: :configuration %>
<% errors = @filter.errors.full_messages + @query.errors.full_messages %>
<%= render "admin/predefined_work_package_filters/errors", errors: %>

<%=
  primer_form_with(
    url: configuration_admin_predefined_work_package_filter_path(@filter),
    method: :patch,
    data: { controller: "admin--predefined-filter-query" }
  ) do
%>
  <%= hidden_field_tag :query_props, @query_editor_properties.to_json, data: { admin__predefined_filter_query_target: "input" } %>

  <% edit_label = t("types.edit.form_configuration.edit_query") %>
  <%= render(Primer::OpenProject::SubHeader.new) do |subheader| %>
    <% subheader.with_action_button(
         label: edit_label,
         leading_icon: :pencil,
         type: :button,
         data: { action: "admin--predefined-filter-query#edit" }
       ) { edit_label } %>
  <% end %>

  <%= render(Primer::BaseComponent.new(tag: :div, id: "predefined-filter-query-summary", mb: 3)) do %>
    <%= render "admin/predefined_work_package_filters/query_summary", query: @query %>
  <% end %>
<% end %>
